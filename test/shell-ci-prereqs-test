#!/bin/sh
set -eu

REPO_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
PREREQS_DIR=$REPO_ROOT/.github/actions/shell-ci-prereqs

# shellcheck source=.github/actions/shell-ci-prereqs/lib.sh
. "$PREREQS_DIR/lib.sh"
# shellcheck source=.github/actions/shell-ci-prereqs/profiles.sh
. "$PREREQS_DIR/profiles.sh"
# shellcheck source=.github/actions/shell-ci-prereqs/dotfiles.sh
. "$PREREQS_DIR/dotfiles.sh"

# shellcheck disable=SC2329 # Sourced setup code invokes this test seam indirectly.
install_package_lists() {
  :
}

# shellcheck disable=SC2329 # Alpine setup invokes this test seam indirectly.
ensure_lua_command() {
  :
}

pinned_shellcheck_calls=0
install_pinned_shellcheck() {
  pinned_shellcheck_calls=$((pinned_shellcheck_calls + 1))
}

assert_eq() {
  expected=$1
  actual=$2
  label=$3

  if [ "$actual" != "$expected" ]; then
    printf 'not ok - %s: expected <%s>, got <%s>\n' \
      "$label" "$expected" "$actual" >&2
    return 1
  fi
}

assert_contains() {
  expected=$1
  actual=$2
  label=$3

  case "$actual" in
    *"$expected"*) ;;
    *)
      printf 'not ok - %s: expected to contain <%s>\n' \
        "$label" "$expected" >&2
      return 1
      ;;
  esac
}

export PROFILES=procps
brew_pkgs=
apt_pkgs=
arch_pkgs=
dnf_pkgs=
apk_pkgs=
install_profile_prereqs

assert_eq '' "$brew_pkgs" 'procps macOS packages'
assert_eq procps "$apt_pkgs" 'procps apt packages'
assert_eq procps-ng "$arch_pkgs" 'procps Arch packages'
assert_eq procps-ng "$dnf_pkgs" 'procps dnf packages'
assert_eq procps "$apk_pkgs" 'procps Alpine packages'

printf 'ok - procps profile package mapping\n'

export MATRIX_NAME=Debian
export PROFILES=cron,fd,ripgrep,hostname
install_profile_prereqs

assert_eq 'fd ripgrep' "$brew_pkgs" \
  'system-command profiles use built-in macOS cron and hostname'
assert_eq 'cron fd-find ripgrep hostname' "$apt_pkgs" \
  'system-command apt packages'
assert_eq 'cronie fd ripgrep inetutils' "$arch_pkgs" \
  'system-command Arch packages'
assert_eq 'cronie fd-find ripgrep hostname' "$dnf_pkgs" \
  'system-command dnf packages'
assert_eq 'dcron fd ripgrep' "$apk_pkgs" \
  'system-command Alpine packages'

printf 'ok - shared profiles map dotfiles system commands\n'

export MATRIX_NAME=Ubuntu
export PROFILES=shellcheck
pinned_shellcheck_calls=0
install_profile_prereqs
assert_eq '' "$apt_pkgs" 'Ubuntu ShellCheck is not installed from apt'
assert_eq 1 "$pinned_shellcheck_calls" 'Ubuntu installs pinned ShellCheck'

export MATRIX_NAME=Debian
pinned_shellcheck_calls=0
install_profile_prereqs
assert_eq shellcheck "$apt_pkgs" 'Debian keeps its native ShellCheck package'
assert_eq 0 "$pinned_shellcheck_calls" 'Debian does not install Ubuntu pinned ShellCheck'

printf 'ok - Ubuntu ShellCheck profile uses pinned installer\n'

# The profile assertions above inspect collected package lists without running
# a host package manager. Restore the production installer for the named-setup
# integration checks below, while keeping privilege and Lua effects inside the
# command fixtures.
unset -f install_package_lists
# shellcheck source=.github/actions/shell-ci-prereqs/lib.sh
. "$PREREQS_DIR/lib.sh"
sudo_if_available() {
  "$@"
}
ensure_lua_command() {
  :
}

mock_bin=$(mktemp -d)
trap 'rm -rf "$mock_bin"' EXIT HUP INT TERM
command_log=$mock_bin/commands.log
export command_log
for command in apt-get dnf apk; do
  cat >"$mock_bin/$command" <<'MOCK'
#!/bin/sh
printf '%s %s\n' "${0##*/}" "$*" >>"$command_log"
MOCK
  chmod +x "$mock_bin/$command"
done

PATH="$mock_bin:$PATH"
export PATH

export MATRIX_NAME=Debian
install_dotfiles_bootstrap_prereqs
assert_contains \
  'apt-get install -y git curl sudo openssh-client lsof netcat-openbsd procps cron fd-find ripgrep hostname' \
  "$(cat "$command_log")" 'dotfiles Debian installs required system commands'

: >"$command_log"
export MATRIX_NAME='CentOS Stream'
install_dotfiles_bootstrap_prereqs
assert_contains \
  'dnf install -y --allowerasing epel-release' \
  "$(cat "$command_log")" 'dotfiles CentOS enables capability packages'
assert_contains \
  'dnf install -y --allowerasing git curl sudo openssh-clients lsof nmap-ncat procps-ng cronie fd-find ripgrep hostname' \
  "$(cat "$command_log")" 'dotfiles dnf installs required system commands'

: >"$command_log"
export MATRIX_NAME=Alpine
install_dotfiles_bootstrap_prereqs
assert_contains \
  'apk add --no-cache git curl sudo bash coreutils shellcheck lua5.4 openssh-client lsof netcat-openbsd procps dcron fd ripgrep' \
  "$(cat "$command_log")" 'dotfiles Alpine installs required system commands'

printf 'ok - dotfiles setup composes shared system-command profiles\n'

(
  # Re-source the production helper after replacing commands used by the
  # upstream yq installer.
  # shellcheck source=.github/actions/shell-ci-prereqs/lib.sh
  . "$PREREQS_DIR/lib.sh"

  yq_tmp=$mock_bin/yq-install
  yq_mock_bin=$yq_tmp/bin
  mkdir -p "$yq_mock_bin"
  yq_log=$yq_tmp/commands.log
  export yq_log

  cat >"$yq_mock_bin/yq" <<'MOCK'
#!/bin/sh
echo 'yq version v3.4.1'
MOCK
  cat >"$yq_mock_bin/uname" <<'MOCK'
#!/bin/sh
case "$1" in
  -s) printf '%s\n' "${MOCK_UNAME_S:-Linux}" ;;
  -m) printf '%s\n' "${MOCK_UNAME_M:-x86_64}" ;;
  *) exit 2 ;;
esac
MOCK
  cat >"$yq_mock_bin/curl" <<'MOCK'
#!/bin/sh
printf 'curl %s\n' "$*" >>"$yq_log"
destination=
while [ "$#" -gt 0 ]; do
  if [ "$1" = -o ]; then
    shift
    destination=$1
    break
  fi
  shift
done
cat >"$destination" <<'YQ'
#!/bin/sh
printf 'yq version v%s\n' "${MOCK_YQ_VERSION:-4.53.3}"
YQ
chmod +x "$destination"
MOCK
  cat >"$yq_mock_bin/sha256sum" <<'MOCK'
#!/bin/sh
input=$(cat)
printf 'sha256sum %s %s\n' "$*" "$input" >>"$yq_log"
[ "${YQ_MOCK_SHA256_FAIL:-0}" -ne 1 ]
MOCK
  cat >"$yq_mock_bin/shasum" <<'MOCK'
#!/bin/sh
input=$(cat)
printf 'shasum %s %s\n' "$*" "$input" >>"$yq_log"
[ "${YQ_MOCK_SHA256_FAIL:-0}" -ne 1 ]
MOCK
  chmod +x "$yq_mock_bin/yq" "$yq_mock_bin/uname" \
    "$yq_mock_bin/curl" "$yq_mock_bin/sha256sum" "$yq_mock_bin/shasum"

  # Invoked indirectly by install_yq_v4 from the sourced production helper.
  # shellcheck disable=SC2329
  sudo_if_available() {
    printf 'sudo_if_available %s\n' "$*" >>"$yq_log"
  }

  # Each installer test owns an isolated command path and runner directory.
  # shellcheck disable=SC2030
  export PATH="$yq_mock_bin:$PATH"
  # shellcheck disable=SC2030
  export RUNNER_TEMP="$yq_tmp/runner"
  mkdir -p "$RUNNER_TEMP"
  install_yq_v4

  log=$(cat "$yq_log")
  assert_contains \
    'https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_linux_amd64' \
    "$log" 'pinned yq release URL'
  assert_contains \
    '--retry 3 --retry-all-errors --retry-delay 1' \
    "$log" 'pinned yq bounded download retry'
  assert_contains \
    'fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4' \
    "$log" 'pinned yq checksum'
  assert_contains \
    'sudo_if_available mv' "$log" 'verified yq install'

  : >"$yq_log"
  export MOCK_UNAME_S=Darwin MOCK_UNAME_M=arm64
  install_yq_v4
  unset MOCK_UNAME_S MOCK_UNAME_M
  log=$(cat "$yq_log")
  assert_contains \
    'https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_darwin_arm64' \
    "$log" 'pinned Darwin yq release URL'
  assert_contains \
    '877de31753a4dd2401aa048937aa9a7fc4d5f6ce858cf31508c5802954297213' \
    "$log" 'pinned Darwin yq checksum'
  assert_contains 'shasum -a 256 -c -' "$log" 'Darwin checksum command'

  : >"$yq_log"
  export YQ_MOCK_SHA256_FAIL=1
  set +e
  (
    set -e
    install_yq_v4
  )
  failure_status=$?
  set -e
  unset YQ_MOCK_SHA256_FAIL
  assert_eq 1 "$failure_status" 'yq checksum failure status'
  case "$(cat "$yq_log")" in
    *'sudo_if_available mv'*)
      printf 'not ok - yq checksum failure installed an unverified binary\n' >&2
      exit 1
      ;;
  esac

  : >"$yq_log"
  export MOCK_YQ_VERSION=4.52.0
  set +e
  (
    set -e
    install_yq_v4
  )
  failure_status=$?
  set -e
  unset MOCK_YQ_VERSION
  assert_eq 1 "$failure_status" 'yq version mismatch status'
  case "$(cat "$yq_log")" in
    *'sudo_if_available mv'*)
      printf 'not ok - yq version mismatch installed the wrong binary\n' >&2
      exit 1
      ;;
  esac
)

printf 'ok - pinned yq install is retried and verified\n'

(
  unset -f install_pinned_shellcheck
  # Re-source the production helper after the routing test's call-count stub.
  # shellcheck source=.github/actions/shell-ci-prereqs/lib.sh
  . "$PREREQS_DIR/lib.sh"

  install_tmp=$mock_bin/pinned-install
  install_mock_bin=$install_tmp/bin
  mkdir -p "$install_mock_bin"
  install_log=$install_tmp/commands.log
  export install_log

  cat >"$install_mock_bin/curl" <<'MOCK'
#!/bin/sh
printf 'curl %s\n' "$*" >>"$install_log"
while [ "$#" -gt 0 ]; do
  if [ "$1" = -o ]; then
    shift
    : >"$1"
    break
  fi
  shift
done
MOCK
  cat >"$install_mock_bin/sha256sum" <<'MOCK'
#!/bin/sh
input=$(cat)
printf 'sha256sum %s %s\n' "$*" "$input" >>"$install_log"
[ "${MOCK_SHA256_FAIL:-0}" -ne 1 ]
MOCK
  cat >"$install_mock_bin/tar" <<'MOCK'
#!/bin/sh
printf 'tar %s\n' "$*" >>"$install_log"
destination=
while [ "$#" -gt 0 ]; do
  if [ "$1" = -C ]; then
    shift
    destination=$1
    break
  fi
  shift
done
mkdir -p "$destination/shellcheck-v0.11.0"
cat >"$destination/shellcheck-v0.11.0/shellcheck" <<'SHELLCHECK'
#!/bin/sh
printf 'ShellCheck - shell script analysis tool\nversion: %s\n' \
  "${MOCK_SHELLCHECK_VERSION:-0.11.0}"
SHELLCHECK
chmod +x "$destination/shellcheck-v0.11.0/shellcheck"
MOCK
  chmod +x "$install_mock_bin/curl" "$install_mock_bin/sha256sum" \
    "$install_mock_bin/tar"

  # shellcheck disable=SC2031
  export PATH="$install_mock_bin:$PATH"
  # shellcheck disable=SC2031
  export RUNNER_TEMP="$install_tmp/runner"
  export GITHUB_PATH="$install_tmp/github-path"
  install_pinned_shellcheck

  log=$(cat "$install_log")
  assert_contains \
    'https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz' \
    "$log" 'pinned ShellCheck release URL'
  assert_contains \
    '--retry 3 --retry-all-errors --retry-delay 1' \
    "$log" 'pinned ShellCheck bounded download retry'
  assert_contains \
    '8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198' \
    "$log" 'pinned ShellCheck checksum'
  assert_eq \
    "$RUNNER_TEMP/shellcheck-v0.11.0" \
    "$(cat "$GITHUB_PATH")" 'pinned ShellCheck command path'

  : >"$install_log"
  rm -f "$GITHUB_PATH"
  export MOCK_SHA256_FAIL=1
  set +e
  (
    set -e
    install_pinned_shellcheck
  )
  failure_status=$?
  set -e
  unset MOCK_SHA256_FAIL
  assert_eq 1 "$failure_status" 'checksum failure status'
  case "$(cat "$install_log")" in
    *'tar '*)
      printf 'not ok - checksum failure extracted an unverified archive\n' >&2
      exit 1
      ;;
  esac
  [ ! -e "$GITHUB_PATH" ] || {
    printf 'not ok - checksum failure exported a command path\n' >&2
    exit 1
  }

  : >"$install_log"
  export MOCK_SHELLCHECK_VERSION=0.10.0
  set +e
  (
    set -e
    install_pinned_shellcheck
  )
  failure_status=$?
  set -e
  unset MOCK_SHELLCHECK_VERSION
  assert_eq 1 "$failure_status" 'version mismatch status'
  [ ! -e "$GITHUB_PATH" ] || {
    printf 'not ok - version mismatch exported a command path\n' >&2
    exit 1
  }
)

printf 'ok - pinned ShellCheck install is verified and exported\n'

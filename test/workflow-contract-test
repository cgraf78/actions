  check '.jobs.required.steps[0].run | contains("test \"$QUALITY_RESULT\" = success")' ci.yml

  # The consumer gate intentionally has no configurable paths: one canonical
  # lock plus release.conf auto-detection gives the fleet a smaller contract
  # and removes a caller-controlled bypass for vendored-script verification.
  yq -e '.inputs == null and
    .runs.steps[0].env.ACTION_REF == "${{ github.action_ref }}" and
    .runs.steps[0].run == "$GITHUB_ACTION_PATH/verify.sh"' \
    "$root/.github/actions/verify-consumer-sync/action.yml" >/dev/null || {
    echo 'workflow contract failed: verify-consumer-sync must stay zero-input and self-identifying' >&2
    return 1
  }

  for workflow in _shell-platforms.yml _rust-platforms.yml _termux-ci.yml; do
    check '.jobs.required == null' "$workflow"
  done

  yq -e '.updates[] | select(."package-ecosystem" == "github-actions") |
    [(.directory == "/"),
     (.schedule.interval == "weekly"),
     (.schedule.day == "monday"),
     (.schedule.time == "07:00"),
     (.schedule.timezone == "America/Chicago"),
     ([.ignore[] | select(."dependency-name" == "cgraf78/actions")] | length == 1)] |
    all' \
    "$root/.github/dependabot.yml" >/dev/null || {
    echo 'workflow contract failed: Dependabot must update Actions but ignore self-references' >&2
    return 1
  }
}

contracts
printf 'workflow-contract-test: ok\n'

#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
actions_lock=$(<"$root/.github/cgraf78-actions.lock")
[[ $actions_lock =~ ^[0-9a-f]{40}$ ]] || {
  printf 'workflow contract failed: invalid internal actions lock\n' >&2
  exit 1
}

check() {
  local expression=$1
  local workflow=$2

  if ! yq -e "$expression" "$root/.github/workflows/$workflow" >/dev/null; then
    printf 'workflow contract failed: %s: %s\n' "$workflow" "$expression" >&2
    return 1
  fi
}

check_file() {
  local expression=$1
  local file=$2

  if ! yq -e "$expression" "$root/$file" >/dev/null; then
    printf 'workflow contract failed: %s: %s\n' "$file" "$expression" >&2
    return 1
  fi
}

check_no_unsupervised_adb() {
  local workflow=$1
  local run

  run=$(yq -r \
    '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run' \
    "$root/.github/workflows/$workflow")
  if grep -Eq '(^|[[:space:]])adb[[:space:]]' <<<"$run"; then
    printf 'workflow contract failed: %s: unsupervised adb command\n' \
      "$workflow" >&2
    return 1
  fi
}

# The live Termux job reserves 20 minutes for caller code. Prove the explicit
# emulator boot and every sequential ADB window still leave five minutes for
# checkout, APK download, host preparation, and runner overhead under the cap.
termux_job_window=$((50 * 60))
termux_caller_window=1200
termux_emulator_boot_window=600
termux_adb_kill_window=5
termux_adb_window=$((\
  120 + termux_adb_kill_window + \
  30 + termux_adb_kill_window + \
  30 * (3 + termux_adb_kill_window + 1) + \
  30 + termux_adb_kill_window + \
  120 + termux_adb_kill_window + \
  2 * (30 + termux_adb_kill_window) + \
  120 + termux_adb_kill_window + \
  30 + termux_adb_kill_window + \
  termux_caller_window + termux_adb_kill_window))
termux_overhead=$((termux_job_window - termux_emulator_boot_window - \
  termux_adb_window))
if [[ "$termux_overhead" -lt 300 ]]; then
  printf 'workflow contract failed: Termux inner windows leave only %ss overhead\n' \
    "$termux_overhead" >&2
  exit 1
fi

# Setup commands need their own deadlines so a stalled network operation yields
# a useful failing step, while the job deadline remains the final backstop. Keep
# deliberate room outside setup for checkout, the actual checks, and teardown.
rust_quality_job_window=$((180 * 60))
rust_quality_setup_window=$(((10 + 15 + 5 + 10 + 15 + 10) * 60))
rust_quality_check_window=$(((10 + 15 + 20 + 20 + 10 + 15) * 60))
rust_quality_overhead=$((rust_quality_job_window - rust_quality_setup_window - \
  rust_quality_check_window))
[[ "$rust_quality_overhead" -ge $((15 * 60)) ]] || {
  echo 'workflow contract failed: Rust quality inner bounds leave under 15m overhead' >&2
  exit 1
}

rustsec_job_window=$((60 * 60))
rustsec_setup_window=$(((10 + 5 + 20 + 2 + 5) * 60))
rustsec_audit_window=$((10 * 60))
rustsec_overhead=$((rustsec_job_window - rustsec_setup_window - \
  rustsec_audit_window))
[[ "$rustsec_overhead" -ge $((5 * 60)) ]] || {
  echo 'workflow contract failed: RustSec inner bounds leave under 5m overhead' >&2
  exit 1
}

repo_quality_job_window=$((35 * 60))
repo_quality_setup_window=$(((5 + 10 + 10) * 60))
repo_quality_check_window=$((repo_quality_job_window - repo_quality_setup_window))
[[ "$repo_quality_check_window" -ge $((10 * 60)) ]] || {
  echo 'workflow contract failed: repo quality setup leaves under 10m for checks' >&2
  exit 1
}

bash32_job_window=$((45 * 60))
bash32_setup_window=$(((5 + 10) * 60))
bash32_caller_window=$((20 * 60))
bash32_overhead=$((bash32_job_window - bash32_setup_window - bash32_caller_window))
[[ "$bash32_overhead" -ge $((10 * 60)) ]] || {
  echo 'workflow contract failed: Bash 3.2 bounds leave under 10m overhead' >&2
  exit 1
}

shell_platform_job_window=$((60 * 60))
shell_platform_prereq_window=$((20 * 60))
shell_platform_bootstrap_window=$((25 * 60))
shell_platform_test_window=$((shell_platform_job_window - \
  shell_platform_prereq_window - shell_platform_bootstrap_window))
[[ "$shell_platform_test_window" -ge $((15 * 60)) ]] || {
  echo 'workflow contract failed: shell platform setup leaves under 15m for checkout and tests' >&2
  exit 1
}


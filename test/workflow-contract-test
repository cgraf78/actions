#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

check() {
  local expression=$1
  local workflow=$2

  if ! yq -e "$expression" "$root/.github/workflows/$workflow" >/dev/null; then
    printf 'workflow contract failed: %s: %s\n' "$workflow" "$expression" >&2
    return 1
  fi
}

# The yq programs intentionally compare literal GitHub and shell expressions;
# neither language should be expanded by this test process.
# shellcheck disable=SC2016
contracts() {
  local workflow

  check '.jobs.required.name == "Required"' shell-ci.yml
  check '.jobs.required.if == "${{ always() }}"' shell-ci.yml
  check '.jobs.required.needs | join(",") == "platforms,termux"' shell-ci.yml
  check '.jobs.required.env.PLATFORMS_RESULT == "${{ needs.platforms.result }}"' shell-ci.yml
  check '.jobs.required.env.TERMUX_RESULT == "${{ needs.termux.result }}"' shell-ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$PLATFORMS_RESULT\" = success")' shell-ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$TERMUX_RESULT\" = success")' shell-ci.yml
  check '.jobs.termux.if == null' shell-ci.yml
  check '.jobs.termux.uses == "./.github/workflows/termux-ci.yml"' shell-ci.yml
  check '.jobs.termux.with.command == "${{ inputs.termux-command != '"'"''"'"' && inputs.termux-command || inputs.test-command }}"' shell-ci.yml
  check '.jobs.termux.with.profiles == "${{ inputs.termux-profiles != '"'"''"'"' && inputs.termux-profiles || (inputs.profiles != '"'"''"'"' && inputs.profiles || '"'"'runtime'"'"') }}"' shell-ci.yml
  check '.jobs.termux.with.setup == "${{ inputs.setup }}"' shell-ci.yml
  check '.on.workflow_call.inputs.concurrency-scope.default == "default"' shell-ci.yml
  check '.concurrency.group == "shell-ci-${{ github.repository }}-${{ github.event_name }}-${{ github.event.pull_request.number || github.ref }}-${{ inputs.concurrency-scope }}"' shell-ci.yml
  check '.concurrency["cancel-in-progress"] == true' shell-ci.yml

  check '.jobs.required.name == "Required"' termux-ci.yml
  check '.jobs.required.if == "${{ always() }}"' termux-ci.yml
  check '.jobs.required.needs == "runtime"' termux-ci.yml
  check '.jobs.required.env.RUNTIME_RESULT == "${{ needs.runtime.result }}"' termux-ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$RUNTIME_RESULT\" = success")' termux-ci.yml
  check '.jobs.runtime.with.profiles == "${{ inputs.profiles }}"' termux-ci.yml
  check '.jobs.runtime.with.setup == "${{ inputs.setup }}"' termux-ci.yml
  check '.on.workflow_call.inputs.profiles.default == "runtime"' termux-ci.yml
  check '.on.workflow_call.inputs.profiles.default == "runtime"' _termux-ci.yml

  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("unsupported Termux setup mode")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("apt-get update")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("DEBIAN_FRONTEND=noninteractive")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("--force-confold")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("packages=(bash termux-exec)")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("if has_profile base; then\n  packages+=(git curl)\nelif ! has_profile runtime; then")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("termux-exec")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("LD_PRELOAD")' _termux-ci.yml
  check '.jobs.termux.steps[] | select(.name == "Prepare Termux host runner").run | contains("[[ \"$setup\" == none ]]") | not' _termux-ci.yml

  check '.jobs.required.name == "Required"' rust-ci.yml
  check '.jobs.required.if == "${{ always() }}"' rust-ci.yml
  check '.jobs.required.needs | join(",") == "platforms,quality,android-package,termux"' rust-ci.yml
  check '.jobs.required.env.PLATFORMS_RESULT == "${{ needs.platforms.result }}"' rust-ci.yml
  check '.jobs.required.env.QUALITY_RESULT == "${{ needs.quality.result }}"' rust-ci.yml
  check '.jobs.required.env.ANDROID_PACKAGE_RESULT == "${{ needs.android-package.result }}"' rust-ci.yml
  check '.jobs.required.env.TERMUX_RESULT == "${{ needs.termux.result }}"' rust-ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$PLATFORMS_RESULT\" = success")' rust-ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$QUALITY_RESULT\" = success")' rust-ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$ANDROID_PACKAGE_RESULT\" = success")' rust-ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$TERMUX_RESULT\" = success")' rust-ci.yml
  check '.jobs.required.steps[0].run | contains("skipped") | not' rust-ci.yml
  check '.on.workflow_call.inputs.android-package-smoke-command.required == true' rust-ci.yml
  check '.on.workflow_call.inputs.termux-command.required == true' rust-ci.yml
  check '.jobs.android-package.if == null' rust-ci.yml
  check '.jobs.termux.if == null' rust-ci.yml
  check '.jobs.termux.with.profiles == "runtime"' rust-ci.yml
  check '.on.workflow_call.inputs.concurrency-scope.default == "default"' rust-ci.yml
  check '.concurrency.group == "rust-ci-${{ github.repository }}-${{ github.event_name }}-${{ github.event.pull_request.number || github.ref }}-${{ inputs.concurrency-scope }}"' rust-ci.yml
  check '.concurrency["cancel-in-progress"] == true' rust-ci.yml

  check '.jobs.shell-smoke.with.termux-command != null' ci.yml
  check '.on.schedule[0].cron == "0 7 * * *"' ci.yml
  check '.on | has("workflow_dispatch")' ci.yml
  check '.jobs.shell-smoke.with.matrix-set == "auto"' ci.yml
  check '.jobs.rust-smoke.with.matrix-set == "auto"' ci.yml
  check '.jobs.rust-smoke.with.android-package-smoke-command != null' ci.yml
  check '.jobs.rust-smoke.with.termux-host-command != null' ci.yml
  check '.jobs.rust-smoke.with.termux-host-command | contains("--target-dir \"$RUNNER_TEMP/actions-rust-smoke-target\"")' ci.yml
  check '.jobs.rust-smoke.with.termux-command != null' ci.yml
  check '.jobs.termux-runtime == null' ci.yml
  check '.jobs.required.name == "Required"' ci.yml
  check '.jobs.required.if == "${{ always() }}"' ci.yml
  check '.jobs.required.needs | join(",") == "shell-smoke,rust-smoke,matrix-contract,android-rust-toolchain,quality"' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$SHELL_SMOKE_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$RUST_SMOKE_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$MATRIX_CONTRACT_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$ANDROID_TOOLCHAIN_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$QUALITY_RESULT\" = success")' ci.yml

  for workflow in _shell-platforms.yml _rust-platforms.yml _termux-ci.yml; do
    check '.jobs.required == null' "$workflow"
  done
}

contracts
printf 'workflow-contract-test: ok\n'

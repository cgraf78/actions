  check '.on.schedule[0].cron == "7 7 * * *"' ci.yml
  check '.on | has("workflow_dispatch")' ci.yml
  check '.on.workflow_dispatch.inputs.retry_canary.default == "none"' ci.yml
  check '.on.workflow_dispatch.inputs.retry_canary.type == "choice"' ci.yml
  check '.on.workflow_dispatch.inputs.retry_canary.options | join(",") == "none,infra,application"' ci.yml
  check '.jobs."retry-canary".if == "github.event_name == '\''workflow_dispatch'\'' && github.ref == format('\''refs/heads/{0}'\'', github.event.repository.default_branch) && inputs.retry_canary != '\''none'\''"' ci.yml
  check '.jobs."retry-canary".permissions.contents == "read"' ci.yml
  check '.jobs."retry-canary".steps[0].env.CANARY_MODE == "${{ inputs.retry_canary }}"' ci.yml
  # GitHub logs the full inline script before executing it. The application
  # canary must not expose the infra marker through an unexecuted case branch.
  check '.jobs."retry-canary".steps[0].run | contains("infra-stall: package command exhausted bounded retries") | not' ci.yml
  check '.jobs."retry-canary".steps[0].run | contains("printf '\''infra-stall: package command exhausted bounded %s\\n'\'' retries")' ci.yml
  check '.jobs."retry-canary".steps[0].run | contains("deliberate application failure")' ci.yml
  check '.jobs.shell-smoke.with.matrix-set == "full"' ci.yml
  check '.jobs.rust-smoke.with.matrix-set == "auto"' ci.yml
  check '.jobs.rust-smoke.with.android-package-smoke-command != null' ci.yml
  check '.jobs.rust-smoke.with.package-smoke-musl-target == "x86_64-unknown-linux-musl"' ci.yml
  check '.jobs.rust-smoke.with.package-smoke-command | contains("cargo build --release --locked --target \"$RUST_TARGET\"")' ci.yml
  check '.jobs.rust-smoke.with | has("package-smoke-install-musl-tools") | not' ci.yml
  check '.jobs.rust-smoke.with.termux-host-command != null' ci.yml
  check '.jobs.rust-smoke.with.termux-host-command | contains("--target-dir \"$RUNNER_TEMP/actions-rust-smoke-target\"")' ci.yml
  check '.jobs.rust-smoke.with.termux-command != null' ci.yml
  check '.jobs.termux-runtime == null' ci.yml
  check '.jobs.required.name == "Required"' ci.yml
  check '.jobs.required.if == "${{ always() }}"' ci.yml
  check '.jobs.required.needs | join(",") == "shell-smoke,rust-smoke,matrix-contract,android-rust-toolchain,release-installer-bash32,checkout-installer-bash32,release-asset-upload-bash32,quality"' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$SHELL_SMOKE_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$RUST_SMOKE_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$MATRIX_CONTRACT_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$ANDROID_TOOLCHAIN_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$RELEASE_INSTALLER_BASH32_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$CHECKOUT_INSTALLER_BASH32_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$RELEASE_ASSET_UPLOAD_BASH32_RESULT\" = success")' ci.yml
  check '.jobs.required.steps[0].run | contains("test \"$QUALITY_RESULT\" = success")' ci.yml

  # The consumer gate intentionally has no configurable paths: one canonical
  # lock plus release.conf auto-detection gives the fleet a smaller contract
  # and removes a caller-controlled bypass for vendored-script verification.
  yq -e '.inputs == null and
    .runs.steps[0].env.ACTION_REF == "${{ github.action_ref }}" and
    .runs.steps[0].run == "$GITHUB_ACTION_PATH/verify.sh"' \
    "$root/.github/actions/verify-consumer-sync/action.yml" >/dev/null || {
    echo 'workflow contract failed: verify-consumer-sync must stay zero-input and self-identifying' >&2
    return 1
  }

  for workflow in _shell-platforms.yml _rust-platforms.yml _termux-ci.yml; do
    check '.jobs.required == null' "$workflow"
  done

  yq -e '.updates[] | select(."package-ecosystem" == "github-actions") |
    [(.directory == "/"),
     (.schedule.interval == "weekly"),
     (.schedule.day == "monday"),
     (.schedule.time == "07:00"),
     (.schedule.timezone == "America/Chicago"),
     ([.ignore[] | select(."dependency-name" == "cgraf78/actions")] | length == 1)] |
    all' \
    "$root/.github/dependabot.yml" >/dev/null || {
    echo 'workflow contract failed: Dependabot must update Actions but ignore self-references' >&2
    return 1
  }
}

contracts
printf 'workflow-contract-test: ok\n'

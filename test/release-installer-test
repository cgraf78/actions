  fail "--require-attestation without gh did not explain how to verify: $strict_no_gh_out"
[[ ! -s "$tmp/strict-no-gh-curl.log" ]] ||
  fail "--require-attestation downloaded release data before checking for gh"

set +e
strict_archive_out=$(HOME="$tmp/strict-archive-home" \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  PATH="$fake_bin:$PATH" /bin/bash "$consumer/install.sh" \
  --require-attestation --archive "$archive1" 2>&1)
strict_archive_status=$?
set -e
[[ "$strict_archive_status" -ne 0 &&
  "$strict_archive_out" == *'applies only to online installs'* ]] ||
  fail "--require-attestation was accepted with an offline --archive"

cat >"$fake_bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
: "${FAKE_GH_LOG:=/dev/null}"
printf '%s\n' "$*" >>"$FAKE_GH_LOG"
if [[ "${1:-} ${2:-} ${3:-}" == "attestation verify --help" ]]; then
  # gh older than 2.49 has no attestation command at all.
  [[ "${FAKE_GH_ATTESTATION:-present}" == present ]] || exit 1
  exit 0
fi
if [[ "${1:-} ${2:-}" == "auth token" ]]; then
  # Logged in unless a case asks for a host without a github.com credential.
  [[ "${FAKE_GH_AUTH:-ok}" == ok ]] || exit 1
  printf 'fake-token\n'
  exit 0
fi
if [[ "${1:-} ${2:-}" != "attestation verify" ]]; then
  printf 'unexpected gh invocation: %s\n' "$*" >&2
  exit 1
fi
printf 'GH_HOST=%s\n' "${GH_HOST:-}" >>"$FAKE_GH_LOG"
[[ "${FAKE_GH_ATTESTATION_RESULT:-pass}" == pass ]] || exit 1
exit 0
EOF
chmod 0755 "$fake_bin/gh"

online_root="$tmp/online"
online_log="$tmp/online-curl.log"
online_args_log="$tmp/online-curl-args.log"
online_gh_log="$tmp/online-gh.log"
mkdir -p "$online_root/home"
FAKE_CURL_ARCHIVE="$archive1" FAKE_CURL_CHECKSUM="$archive1.sha256" \
  FAKE_CURL_VERSION="$version1" FAKE_CURL_LOG="$online_log" \
  FAKE_CURL_ARGS_LOG="$online_args_log" FAKE_GH_LOG="$online_gh_log" \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  GH_HOST=ghes.example.invalid \
  HOME="$online_root/home" PATH="$fake_bin:$PATH" \
  /bin/bash "$consumer/install.sh" \
  --data-home "$online_root/data" --bin-dir "$online_root/bin" \
  --man-dir "$online_root/man" >/dev/null 2>"$tmp/online-stderr" ||
  fail "online latest-release install failed"
if grep -Fq 'provenance not verified' "$tmp/online-stderr"; then
  fail "verified online install claimed provenance was unverified"
fi
grep -Fq "attestation verify" "$online_gh_log" ||
  fail "online install did not verify artifact attestation"
grep -Fxq 'auth token --hostname github.com' "$online_gh_log" ||
  fail "credential probe was not scoped to github.com"
grep -Fxq 'GH_HOST=github.com' "$online_gh_log" ||
  fail "attestation verification did not pin github.com"
grep -Fq -- "--repo example/example-tool" "$online_gh_log" ||
  fail "attestation verification omitted the release repository"
grep -Fq -- "--signer-repo cgraf78/actions" "$online_gh_log" ||
  fail "attestation verification omitted the signer repository"

attest_fail_root="$tmp/online-attest-fail"
mkdir -p "$attest_fail_root/home"
set +e
attest_fail_out=$(FAKE_CURL_ARCHIVE="$archive1" \
  FAKE_CURL_CHECKSUM="$archive1.sha256" FAKE_CURL_VERSION="$version1" \
  FAKE_CURL_LOG="$tmp/online-curl-fail.log" \
  FAKE_CURL_ARGS_LOG="$tmp/online-curl-args-fail.log" \
  FAKE_GH_LOG="$tmp/online-gh-fail.log" FAKE_GH_ATTESTATION_RESULT=fail \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  HOME="$attest_fail_root/home" PATH="$fake_bin:$PATH" \
  /bin/bash "$consumer/install.sh" \
  --data-home "$attest_fail_root/data" --bin-dir "$attest_fail_root/bin" \
  --man-dir "$attest_fail_root/man" 2>&1)
attest_fail_status=$?
set -e
[[ "$attest_fail_status" -ne 0 ]] ||
  fail "online install accepted a failed attestation verification"
[[ "$attest_fail_out" == *'attestation verification failed'* ]] ||
  fail "failed attestation did not report the verification failure"
# GitHub CLI present but without a github.com credential behaves like a host
# without gh: checksum-only by default, and no verify attempt that would fail
# for reasons unrelated to the release.
logged_out_root="$tmp/online-logged-out"
mkdir -p "$logged_out_root/home"
logged_out_out=$(FAKE_CURL_ARCHIVE="$archive1" \
  FAKE_CURL_CHECKSUM="$archive1.sha256" FAKE_CURL_VERSION="$version1" \
  FAKE_CURL_LOG="$tmp/logged-out-curl.log" \
  FAKE_CURL_ARGS_LOG="$tmp/logged-out-curl-args.log" \
  FAKE_GH_LOG="$tmp/logged-out-gh.log" FAKE_GH_AUTH=none \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  HOME="$logged_out_root/home" PATH="$fake_bin:$PATH" \
  /bin/bash "$consumer/install.sh" \
  --data-home "$logged_out_root/data" --bin-dir "$logged_out_root/bin" \
  --man-dir "$logged_out_root/man" 2>&1 >/dev/null) ||
  fail "logged-out gh blocked a checksum-verified install: $logged_out_out"
[[ "$logged_out_out" == *'provenance not verified'* ]] ||
  fail "logged-out install did not say provenance was unverified"
if grep -Fxq 'GH_HOST=github.com' "$tmp/logged-out-gh.log"; then
  fail "logged-out install attempted attestation verification"
fi
set +e
FAKE_CURL_ARCHIVE="$archive1" FAKE_CURL_CHECKSUM="$archive1.sha256" \
  FAKE_CURL_VERSION="$version1" FAKE_CURL_LOG="$tmp/logged-out-strict-curl.log" \
  FAKE_CURL_ARGS_LOG="$tmp/logged-out-strict-curl-args.log" \
  FAKE_GH_LOG="$tmp/logged-out-strict-gh.log" FAKE_GH_AUTH=none \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  HOME="$logged_out_root/home" PATH="$fake_bin:$PATH" \
  /bin/bash "$consumer/install.sh" --require-attestation \
  --data-home "$logged_out_root/data2" --bin-dir "$logged_out_root/bin2" \
  --man-dir "$logged_out_root/man2" >/dev/null 2>&1
logged_out_strict_status=$?
set -e
[[ "$logged_out_strict_status" -eq 1 ]] ||
  fail "--require-attestation accepted a logged-out gh"
[[ ! -s "$tmp/logged-out-strict-curl.log" ]] ||
  fail "--require-attestation downloaded release data with a logged-out gh"

# A logged-in gh older than 2.49 cannot verify: it must be treated like a host
# without gh, not fail the install as though the artifact were bad.
old_gh_root="$tmp/online-old-gh"
mkdir -p "$old_gh_root/home"
old_gh_out=$(FAKE_CURL_ARCHIVE="$archive1" \
  FAKE_CURL_CHECKSUM="$archive1.sha256" FAKE_CURL_VERSION="$version1" \
  FAKE_CURL_LOG="$tmp/old-gh-curl.log" \
  FAKE_CURL_ARGS_LOG="$tmp/old-gh-curl-args.log" \
  FAKE_GH_LOG="$tmp/old-gh.log" FAKE_GH_ATTESTATION=missing \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  HOME="$old_gh_root/home" PATH="$fake_bin:$PATH" \
  /bin/bash "$consumer/install.sh" \
  --data-home "$old_gh_root/data" --bin-dir "$old_gh_root/bin" \
  --man-dir "$old_gh_root/man" 2>&1 >/dev/null) ||
  fail "gh without attestation support blocked a checksum-verified install: $old_gh_out"
[[ "$old_gh_out" == *'too old'* ]] ||
  fail "old-gh install did not explain why provenance was unverified: $old_gh_out"
if grep -Fxq 'GH_HOST=github.com' "$tmp/old-gh.log"; then
  fail "old-gh install attempted attestation verification"
fi
grep -Fxq 'https://github.com/example/example-tool/releases/latest' \
  "$online_log" || fail "online install did not resolve the latest release"
online_base="https://github.com/example/example-tool/releases/download/$version1"
grep -Fxq "$online_base/$(basename "$archive1")" "$online_log" ||
  fail "online install requested the wrong archive URL"
grep -Fxq "$online_base/$(basename "$archive1").sha256" "$online_log" ||
  fail "online install requested the wrong checksum URL"
gh_args=$(grep -F 'attestation verify' "$online_gh_log")
case "$gh_args" in
  "attestation verify "*" --repo example/example-tool --signer-repo cgraf78/actions") ;;
  *) fail "online install used the wrong attestation policy: $gh_args" ;;
esac
[[ $("$online_root/bin/example-tool") == first ]] ||
  fail "online install did not activate the downloaded archive"

attestation_failure_root="$tmp/attestation-failure"
mkdir -p "$attestation_failure_root/home"
set +e
FAKE_CURL_ARCHIVE="$archive1" FAKE_CURL_CHECKSUM="$archive1.sha256" \
  FAKE_CURL_VERSION="$version1" FAKE_CURL_LOG="$tmp/failed-curl.log" \
  FAKE_CURL_ARGS_LOG="$tmp/failed-curl-args.log" \
  FAKE_GH_LOG="$tmp/failed-gh.log" FAKE_GH_ATTESTATION_RESULT=fail \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  HOME="$attestation_failure_root/home" PATH="$fake_bin:$PATH" \
  /bin/bash "$consumer/install.sh" --version "$version1" \
  --data-home "$attestation_failure_root/data" \
  --bin-dir "$attestation_failure_root/bin" \
  --man-dir "$attestation_failure_root/man" >/dev/null 2>&1
attestation_failure_status=$?
set -e
[[ "$attestation_failure_status" -eq 1 ]] ||
  fail "failed online attestation did not reject the release"
[[ ! -e "$attestation_failure_root/bin/example-tool" ]] ||
  fail "failed online attestation activated the release"

curl_invocations=$(wc -l <"$online_args_log")
[[ "$curl_invocations" -eq 3 ]] ||
  fail "online install did not make exactly three curl invocations"
while IFS= read -r curl_args; do
  for expected_curl_arg in '--connect-timeout 10' '--max-time 60' \
    '--speed-limit 1024' '--speed-time 30' '--retry 2' \
    '--retry-all-errors' '--retry-delay 1'; do
    case " $curl_args " in
      *" $expected_curl_arg "*) ;;
      *) fail "online curl invocation is missing $expected_curl_arg: $curl_args" ;;
    esac
  done
done <"$online_args_log"

# Curl's retry count excludes the initial attempt. Each invocation is bounded
# by three 60-second attempts plus two one-second retry delays. Resolving the
# latest tag and downloading its checksum and archive must fit within the
# installer's ten-minute network budget even when every attempt exhausts.
curl_max_time=60
curl_retry_delay=1
curl_retries=2
curl_invocation_budget=$(((curl_retries + 1) * curl_max_time + \
  curl_retries * curl_retry_delay))
online_network_budget=$((curl_invocations * curl_invocation_budget))
[[ "$online_network_budget" -le 600 ]] ||
  fail "online curl retry policy exceeds the ten-minute network budget"

parent_symlink_root="$tmp/parent-symlink"
mkdir -p "$parent_symlink_root/home"
HOME="$parent_symlink_root/home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --data-home "$parent_symlink_root/data" \
  --bin-dir "$parent_symlink_root/bin" --man-dir "$parent_symlink_root/man" \
  >/dev/null || fail "parent-symlink fixture install failed"
parent_control="$parent_symlink_root/data/cgraf78/.example-tool-standalone"
parent_current=$(readlink "$parent_control/current")
mv "$parent_control/releases" "$parent_control/releases-owned"
mkdir "$parent_symlink_root/outside-releases"
ln -s "$parent_symlink_root/outside-releases" "$parent_control/releases"
if HOME="$parent_symlink_root/home" \
  /bin/bash "$consumer/install.sh" --archive "$archive2" \
  --data-home "$parent_symlink_root/data" \
  --bin-dir "$parent_symlink_root/bin" --man-dir "$parent_symlink_root/man" \
  >/dev/null 2>&1; then
  fail "installer followed a symlinked internal releases directory"
fi
[[ $(readlink "$parent_control/current") == "$parent_current" ]] ||
  fail "symlinked releases directory changed the active link"
if find "$parent_symlink_root/outside-releases" -mindepth 1 -print -quit |
  grep -q .; then
  fail "installer copied archive bytes through a symlinked releases directory"
fi

rename_failure_root="$tmp/rename-failure"
rename_failure_bin="$tmp/rename-failure-bin"
mkdir -p "$rename_failure_root/home" "$rename_failure_bin"
HOME="$rename_failure_root/home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --data-home "$rename_failure_root/data" \
  --bin-dir "$rename_failure_root/bin" --man-dir "$rename_failure_root/man" \
  >/dev/null || fail "rename-failure fixture install failed"
cat >"$rename_failure_bin/mv" <<'EOF'
#!/usr/bin/env bash
case " $* " in
  *'/.current.'*) exit 1 ;;
  *) exec /bin/mv "$@" ;;
esac
EOF
chmod 0755 "$rename_failure_bin/mv"

first_activation_root="$tmp/first-activation-failure"
mkdir -p "$first_activation_root/home"
if HOME="$first_activation_root/home" PATH="$rename_failure_bin:$PATH" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --data-home "$first_activation_root/data" \
  --bin-dir "$first_activation_root/bin" --man-dir "$first_activation_root/man" \
  >/dev/null 2>&1; then
  fail "forced first activation rename failure unexpectedly succeeded"
fi
[[ ! -e "$first_activation_root/data/cgraf78/example-tool" &&
  ! -L "$first_activation_root/data/cgraf78/example-tool" ]] ||
  fail "first activation failure published a dangling stable root"
[[ ! -e "$first_activation_root/bin/example-tool" &&
  ! -L "$first_activation_root/bin/example-tool" ]] ||
  fail "first activation failure published a dangling command"
[[ ! -e "$first_activation_root/man/example-tool.1" &&
  ! -L "$first_activation_root/man/example-tool.1" ]] ||
  fail "first activation failure published a dangling manpage"
HOME="$first_activation_root/home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --data-home "$first_activation_root/data" \
  --bin-dir "$first_activation_root/bin" --man-dir "$first_activation_root/man" \
  >/dev/null || fail "retry after first activation failure did not recover"
[[ $("$first_activation_root/bin/example-tool") == first ]] ||
  fail "retry after first activation failure did not publish the command"

rename_control="$rename_failure_root/data/cgraf78/.example-tool-standalone"
rename_current=$(readlink "$rename_control/current")
if HOME="$rename_failure_root/home" PATH="$rename_failure_bin:$PATH" \
  /bin/bash "$consumer/install.sh" --archive "$archive2" \
  --data-home "$rename_failure_root/data" \
  --bin-dir "$rename_failure_root/bin" --man-dir "$rename_failure_root/man" \
  >/dev/null 2>&1; then
  fail "forced activation rename failure unexpectedly succeeded"
fi
[[ $(readlink "$rename_control/current") == "$rename_current" ]] ||
  fail "activation rename failure changed the previous current link"
if find "$rename_control" -maxdepth 1 -name '.current.*' -print -quit |
  grep -q .; then
  fail "activation rename failure left a temporary current link"
fi

publication_failure_bin="$tmp/publication-failure-bin"
mkdir -p "$publication_failure_bin"
cat >"$publication_failure_bin/ln" <<'EOF'
#!/usr/bin/env bash
destination=
for argument in "$@"; do
  destination=$argument
done
case "${RELEASE_INSTALLER_FAIL_PUBLICATION:-}:$destination" in
  command:*/bin/example-tool | man:*/man/example-tool.1) exit 1 ;;
esac
exec /bin/ln "$@"
EOF
chmod 0755 "$publication_failure_bin/ln"

for failed_publication in command man; do
  publication_root="$tmp/publication-$failed_publication-failure"
  mkdir -p "$publication_root/home"
  if HOME="$publication_root/home" \
    RELEASE_INSTALLER_FAIL_PUBLICATION="$failed_publication" \
    PATH="$publication_failure_bin:$PATH" \
    /bin/bash "$consumer/install.sh" --archive "$archive1" \
    --data-home "$publication_root/data" \
    --bin-dir "$publication_root/bin" --man-dir "$publication_root/man" \
    >/dev/null 2>&1; then
    fail "forced $failed_publication-link publication failure unexpectedly succeeded"
  fi
  [[ ! -e "$publication_root/data/cgraf78/example-tool" &&
    ! -L "$publication_root/data/cgraf78/example-tool" ]] ||
    fail "$failed_publication-link failure left the stable release root public"
  [[ ! -e "$publication_root/bin/example-tool" &&
    ! -L "$publication_root/bin/example-tool" ]] ||
    fail "$failed_publication-link failure left the command public"
  [[ ! -e "$publication_root/man/example-tool.1" &&
    ! -L "$publication_root/man/example-tool.1" ]] ||
    fail "$failed_publication-link failure left the manpage public"
  [[ -L "$publication_root/data/cgraf78/.example-tool-standalone/current" ]] ||
    fail "$failed_publication-link failure discarded retryable private state"

  HOME="$publication_root/home" \
    /bin/bash "$consumer/install.sh" --archive "$archive1" \
    --data-home "$publication_root/data" \
    --bin-dir "$publication_root/bin" --man-dir "$publication_root/man" \
    >/dev/null || fail "retry after $failed_publication-link failure did not recover"
  [[ $("$publication_root/bin/example-tool") == first ]] ||
    fail "retry after $failed_publication-link failure did not publish the command"
done

printf 'release-installer-test: ok\n'

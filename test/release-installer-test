while IFS= read -r curl_args; do
  for expected_curl_arg in '--connect-timeout 10' '--max-time 60' \
    '--speed-limit 1024' '--speed-time 30' '--retry 2' \
    '--retry-all-errors' '--retry-delay 1'; do
    case " $curl_args " in
      *" $expected_curl_arg "*) ;;
      *) fail "online curl invocation is missing $expected_curl_arg: $curl_args" ;;
    esac
  done
done <"$online_args_log"

# Curl's retry count excludes the initial attempt. Each invocation is bounded
# by three 60-second attempts plus two one-second retry delays. Resolving the
# latest tag and downloading its checksum and archive must fit within the
# installer's ten-minute network budget even when every attempt exhausts.
curl_max_time=60
curl_retry_delay=1
curl_retries=2
curl_invocation_budget=$(((curl_retries + 1) * curl_max_time + \
  curl_retries * curl_retry_delay))
online_network_budget=$((curl_invocations * curl_invocation_budget))
[[ "$online_network_budget" -le 600 ]] ||
  fail "online curl retry policy exceeds the ten-minute network budget"


process_is_live() {
  local pid=$1 state

  kill -0 "$pid" 2>/dev/null || return 1
  if [[ -r /proc/$pid/stat ]]; then
    state=$(sed -n 's/^[^)]*) \([^ ]\).*/\1/p' "/proc/$pid/stat")
    [[ "$state" != Z ]] || return 1
  fi
  return 0
}

assert_probe_stopped() {
  local probe_pid=$1 descendant_pid=${2:-} attempt=0

  while [[ "$attempt" -lt 100 ]]; do
    if ! process_is_live "$probe_pid" &&
      { [[ -z "$descendant_pid" ]] || ! process_is_live "$descendant_pid"; } &&
      ! kill -0 -- "-$probe_pid" 2>/dev/null; then
      return 0
    fi
    sleep 0.05
    attempt=$((attempt + 1))
  done
  fail "interrupted installer left its owned probe process group alive"
}

interrupt_install() {
  local behavior=$1 pid_file=$2 case_root=$3 archive installer_pid status
  local probe_pid descendant_pid='' attempt=0 interrupt_impl

  if [[ "$behavior" == fork-interrupt ]]; then
    interrupt_impl=$(
      cat <<EOF
if [ "\${1:-}" = --version ]; then (trap '' TERM; while :; do sleep 1; done) & printf '%s\n' "\$\$ \$!" >"$pid_file"; trap '' TERM; while :; do sleep 1; done; fi
echo $behavior
EOF
    )
  else
    interrupt_impl=$(
      cat <<EOF
if [ "\${1:-}" = --version ]; then printf '%s\n' "\$\$" >"$pid_file"; trap '' TERM; while :; do sleep 1; done; fi
echo $behavior
EOF
    )
  fi
  archive=$(make_archive "20260810-142900-5791ace4" \
    linux-x86_64-musl "$behavior" example/example-tool 1 \
    "$interrupt_impl")
  mkdir -p "$case_root/home"
  HOME="$case_root/home" XDG_DATA_HOME="$case_root/data" \
    /bin/bash "$consumer/install.sh" --archive "$archive" \
    --bin-dir "$case_root/bin" --man-dir "$case_root/man" \
    >/dev/null 2>&1 &
  installer_pid=$!
  while [[ ! -s "$pid_file" && "$attempt" -lt 200 ]]; do
    sleep 0.01
    attempt=$((attempt + 1))
  done
  [[ -s "$pid_file" ]] || {
    kill -KILL "$installer_pid" 2>/dev/null || true
    wait "$installer_pid" 2>/dev/null || true
    fail "interruption fixture did not reach the live probe"

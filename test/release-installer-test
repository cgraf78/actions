cat >"$fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

output=
write_out=
url=
printf '%s\n' "$*" >>"$FAKE_CURL_ARGS_LOG"
while [[ $# -gt 0 ]]; do
  case $1 in
    -o)
      output=$2
      shift 2
      ;;
    -w | --write-out)
      write_out=$2
      shift 2
      ;;
    -* )
      shift
      ;;
    http://* | https://*)
      url=$1
      shift
      ;;
    *)
      shift
      ;;
  esac
done

printf '%s\n' "$url" >>"$FAKE_CURL_LOG"
case "$url" in
  https://github.com/example/example-tool/releases/latest)
    [[ -z "$output" ]] || : >"$output"
    if [[ -n "$write_out" ]]; then
      printf 'https://github.com/example/example-tool/releases/tag/%s' \
        "$FAKE_CURL_VERSION"
    fi
    ;;
  *.sha256)
    cp "$FAKE_CURL_CHECKSUM" "$output"
    ;;
  *.tar.gz)
    cp "$FAKE_CURL_ARCHIVE" "$output"
    ;;
  *)
    printf 'unexpected URL: %s\n' "$url" >&2
    exit 1
    ;;
esac
EOF
chmod 0755 "$fake_bin/curl"


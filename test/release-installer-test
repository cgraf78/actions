  FAKE_CURL_VERSION="$version1" FAKE_CURL_LOG="$online_log" \
  FAKE_CURL_ARGS_LOG="$online_args_log" \
  FAKE_UNAME_S=Linux FAKE_UNAME_M=x86_64 FAKE_UNAME_O=GNU/Linux \
  HOME="$online_root/home" PATH="$fake_bin:$PATH" \

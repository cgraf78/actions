#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  printf 'release-installer-test: %s\n' "$1" >&2
  exit 1
}

# shellcheck source=test/release-installer-fixture.sh
. "$root/test/release-installer-fixture.sh"

consumer="$tmp/consumer"
mkdir -p "$consumer/scripts"

set +e
render_usage=$("$root/release-installer/render.sh" 2>&1)
render_usage_status=$?
set -e
[[ "$render_usage_status" -eq 2 && "$render_usage" == *'usage:'* ]] ||
  fail "renderer without a consumer did not return an actionable usage error"

write_fixture_config "$consumer"

"$root/release-installer/render.sh" "$consumer" >/dev/null ||
  fail "renderer did not generate an opted-in installer"

[[ -f "$consumer/install.sh" && ! -L "$consumer/install.sh" ]] ||
  fail "renderer did not create a regular top-level install.sh"
[[ -x "$consumer/install.sh" ]] ||
  fail "generated installer is not executable"
if grep -Eq '@[A-Z][A-Z0-9_]*@' "$consumer/install.sh"; then
  fail "generated installer retained a template token"
fi
grep -Fq '# Generated by cgraf78/actions release-installer. Do not edit.' \
  "$consumer/install.sh" ||
  fail "generated installer does not identify its provider"

help=$(/bin/bash "$consumer/install.sh" --help) ||
  fail "generated installer help failed"
[[ "$help" == *'usage: install.sh'* ]] ||
  fail "generated installer help omitted its usage"
[[ "$help" == *'example/example-tool'* ]] ||
  fail "generated installer help omitted its release repository"

no_cmp_bin="$tmp/no-cmp-bin"
mkdir -p "$no_cmp_bin"
cat >"$no_cmp_bin/cmp" <<'EOF'
#!/usr/bin/env bash
exit 99
EOF
chmod 0755 "$no_cmp_bin/cmp"
PATH="$no_cmp_bin:$PATH" \
  "$root/release-installer/render.sh" --check "$consumer" >/dev/null ||
  fail "freshly generated installer did not pass the render check"
printf '\n# local drift\n' >>"$consumer/install.sh"
if PATH="$no_cmp_bin:$PATH" \
  "$root/release-installer/render.sh" --check "$consumer" \
  >/dev/null 2>&1; then
  fail "drifted generated installer unexpectedly passed the render check"
fi
"$root/release-installer/render.sh" "$consumer" >/dev/null ||
  fail "renderer did not restore a drifted installer"

optout_consumer="$tmp/optout-consumer"
mkdir -p "$optout_consumer/scripts"
cp "$consumer/scripts/release.conf" "$optout_consumer/scripts/release.conf"
"$root/release-installer/render.sh" "$optout_consumer" >/dev/null ||
  fail "opt-out fixture did not first generate an installer"
sed 's/RELEASE_STANDALONE_INSTALLER=true/RELEASE_STANDALONE_INSTALLER=false/' \
  "$optout_consumer/scripts/release.conf" >"$optout_consumer/scripts/release.conf.tmp"
mv "$optout_consumer/scripts/release.conf.tmp" \
  "$optout_consumer/scripts/release.conf"
if "$root/release-installer/render.sh" --check "$optout_consumer" \
  >/dev/null 2>&1; then
  fail "disabled policy left a generated installer outside drift checks"
fi
"$root/release-installer/render.sh" "$optout_consumer" >/dev/null ||
  fail "renderer could not retire its disabled generated installer"
[[ ! -e "$optout_consumer/install.sh" ]] ||
  fail "renderer did not retire its disabled generated installer"
printf '#!/usr/bin/env bash\nprintf "custom\\n"\n' \
  >"$optout_consumer/install.sh"
chmod 0755 "$optout_consumer/install.sh"
"$root/release-installer/render.sh" "$optout_consumer" >/dev/null ||
  fail "disabled policy rejected a consumer-owned installer"
[[ $(/bin/bash "$optout_consumer/install.sh") == custom ]] ||
  fail "disabled policy changed a consumer-owned installer"

owned_installer_consumer="$tmp/owned-installer-consumer"
mkdir -p "$owned_installer_consumer/scripts"
cp "$consumer/scripts/release.conf" \
  "$owned_installer_consumer/scripts/release.conf"
printf '#!/usr/bin/env bash\nprintf "consumer owned\\n"\n' \
  >"$owned_installer_consumer/install.sh"
chmod 0755 "$owned_installer_consumer/install.sh"
if "$root/release-installer/render.sh" "$owned_installer_consumer" \
  >/dev/null 2>&1; then
  fail "renderer overwrote a consumer-owned installer under enabled policy"
fi
[[ $(/bin/bash "$owned_installer_consumer/install.sh") == 'consumer owned' ]] ||
  fail "renderer changed a consumer-owned installer under enabled policy"

invalid_consumer="$tmp/invalid-consumer"
mkdir -p "$invalid_consumer/scripts"
sed 's#RELEASE_BINARY_DEST=bin/example-tool#RELEASE_BINARY_DEST=..#' \
  "$consumer/scripts/release.conf" >"$invalid_consumer/scripts/release.conf"
if "$root/release-installer/render.sh" "$invalid_consumer" \
  >/dev/null 2>&1; then
  fail "renderer accepted a non-normalized binary destination"
fi
[[ ! -e "$invalid_consumer/install.sh" ]] ||
  fail "invalid binary destination left a generated installer"

keyed_consumer="$tmp/keyed-consumer"
mkdir -p "$keyed_consumer/scripts"
cp "$consumer/scripts/release.conf" "$keyed_consumer/scripts/release.conf"
cat >>"$keyed_consumer/scripts/release.conf" <<'EOF'
RELEASE_BINARY_VERSION_STYLE=commit
RELEASE_INSTALL_INIT_SUBCOMMAND=runinit
EOF
"$root/release-installer/render.sh" "$keyed_consumer" >/dev/null ||
  fail "renderer rejected version-style and init-subcommand policy"
grep -Fq "release_binary_version_style='commit'" \
  "$keyed_consumer/install.sh" ||
  fail "generated installer omitted the version-style policy"
grep -Fq "release_install_init_subcommand='runinit'" \
  "$keyed_consumer/install.sh" ||
  fail "generated installer omitted the init-subcommand policy"
/bin/bash "$keyed_consumer/install.sh" --help | grep -Fq -- '--init' ||
  fail "keyed installer help omitted the init option"
if /bin/bash "$consumer/install.sh" --help | grep -Fq -- '--init'; then
  fail "keyless installer help advertised the init option"
fi
if /bin/bash "$consumer/install.sh" --init >/dev/null 2>&1; then
  fail "keyless installer accepted --init"
fi

invalid_style="$tmp/invalid-style"
mkdir -p "$invalid_style/scripts"
cp "$consumer/scripts/release.conf" "$invalid_style/scripts/release.conf"
printf '%s\n' 'RELEASE_BINARY_VERSION_STYLE=bogus' \
  >>"$invalid_style/scripts/release.conf"
if "$root/release-installer/render.sh" "$invalid_style" \
  >/dev/null 2>&1; then
  fail "renderer accepted an unknown version style"
fi
[[ ! -e "$invalid_style/install.sh" ]] ||
  fail "invalid version style left a generated installer"

invalid_init="$tmp/invalid-init"
mkdir -p "$invalid_init/scripts"
cp "$consumer/scripts/release.conf" "$invalid_init/scripts/release.conf"
printf '%s\n' 'RELEASE_INSTALL_INIT_SUBCOMMAND=a/b' \
  >>"$invalid_init/scripts/release.conf"
if "$root/release-installer/render.sh" "$invalid_init" \
  >/dev/null 2>&1; then
  fail "renderer accepted an unsafe init subcommand"
fi
[[ ! -e "$invalid_init/install.sh" ]] ||
  fail "unsafe init subcommand left a generated installer"

linux_uname_bin="$tmp/linux-uname-bin"
mkdir -p "$linux_uname_bin"
cat >"$linux_uname_bin/uname" <<'EOF'
#!/usr/bin/env bash
case ${1:-} in
  -s) printf '%s\n' Linux ;;
  -m) printf '%s\n' x86_64 ;;
  -o) printf '%s\n' GNU/Linux ;;
  *) exit 2 ;;
esac
EOF
chmod 0755 "$linux_uname_bin/uname"
PATH="$linux_uname_bin:$PATH"
export PATH

version1=20260810-120000-1234abcd
archive1=$(make_archive "$version1" linux-x86_64-musl first)

keyed_version=20260810-120001-beef1234
keyed_commit_prefix=beef12341111
keyed_impl=$(
  cat <<EOF
if [ "\${1:-}" = --version ]; then echo "example-tool $keyed_commit_prefix"; exit 0; fi
if [ "\${1:-}" = runinit ]; then echo initialized >"\$2"; exit 0; fi
echo keyed-first
EOF
)
keyed_archive=$(make_archive "$keyed_version" linux-x86_64-musl keyed \
  example/example-tool 1 "$keyed_impl")

keyed_root="$tmp/keyed"
mkdir -p "$keyed_root/home"
keyed_marker="$keyed_root/init-marker"
HOME="$keyed_root/home" \
  /bin/bash "$keyed_consumer/install.sh" --archive "$keyed_archive" \
  --data-home "$keyed_root/data" --bin-dir "$keyed_root/bin" \
  --man-dir "$keyed_root/man" --init "$keyed_marker" >/dev/null ||
  fail "keyed install with --init failed"
[[ -f "$keyed_marker" ]] ||
  fail "--init did not run the configured init subcommand"
[[ $("$keyed_root/bin/example-tool") == keyed-first ]] ||
  fail "keyed install did not publish the working command"

plain_keyed_root="$tmp/plain-keyed"
mkdir -p "$plain_keyed_root/home"
HOME="$plain_keyed_root/home" \
  /bin/bash "$keyed_consumer/install.sh" --archive "$keyed_archive" \
  --data-home "$plain_keyed_root/data" --bin-dir "$plain_keyed_root/bin" \
  --man-dir "$plain_keyed_root/man" >/dev/null ||
  fail "keyed install without --init failed"
[[ ! -e "$plain_keyed_root/init-marker" ]] ||
  fail "install without --init ran the init subcommand"

mismatch_impl='echo "example-tool WRONGIDENTITY"'
mismatch_archive=$(make_archive "$keyed_version" linux-x86_64-musl keyed \
  example/example-tool 1 "$mismatch_impl")
mismatch_root="$tmp/mismatch"
mkdir -p "$mismatch_root/home"
set +e
mismatch_output=$(HOME="$mismatch_root/home" \
  /bin/bash "$keyed_consumer/install.sh" --archive "$mismatch_archive" \
  --data-home "$mismatch_root/data" --bin-dir "$mismatch_root/bin" \
  --man-dir "$mismatch_root/man" 2>&1)
mismatch_status=$?
set -e
[[ "$mismatch_status" -ne 0 ]] ||
  fail "installer accepted a binary whose --version hid the commit"
[[ "$mismatch_output" == *'does not identify'* ]] ||
  fail "commit mismatch did not report the identity failure"

version_consumer="$tmp/version-consumer"
mkdir -p "$version_consumer/scripts"
cp "$consumer/scripts/release.conf" "$version_consumer/scripts/release.conf"
printf '%s\n' 'RELEASE_BINARY_VERSION_STYLE=version' \
  >>"$version_consumer/scripts/release.conf"
"$root/release-installer/render.sh" "$version_consumer" >/dev/null ||
  fail "renderer rejected the version identity style"
version_impl=$(
  cat <<EOF
if [ "\${1:-}" = --version ]; then echo "example-tool $keyed_version"; exit 0; fi
echo version-first
EOF
)
version_archive=$(make_archive "$keyed_version" linux-x86_64-musl keyed \
  example/example-tool 1 "$version_impl")
version_root="$tmp/version-style"
mkdir -p "$version_root/home"
HOME="$version_root/home" \
  /bin/bash "$version_consumer/install.sh" --archive "$version_archive" \
  --data-home "$version_root/data" --bin-dir "$version_root/bin" \
  --man-dir "$version_root/man" >/dev/null ||
  fail "version-style install failed despite a matching --version"

init_argv_log="$tmp/init-argv-log"
init_argv_impl=$(
  cat <<EOF
if [ "\${1:-}" = --version ]; then echo "example-tool $keyed_commit_prefix"; exit 0; fi
if [ "\${1:-}" = runinit ]; then
  shift
  index=0
  for arg in "\$@"; do
    printf '%s' "\$arg" >"$init_argv_log.\$index"
    index=\$((index + 1))
  done
  printf '%s\n' "\$index" >"$init_argv_log.count"
  exit 0
fi
echo keyed-first
EOF
)
init_argv_archive=$(make_archive "$keyed_version" linux-x86_64-musl keyed \
  example/example-tool 1 "$init_argv_impl")
init_argv_root="$tmp/init-argv"
init_argv_control="$init_argv_root/data/cgraf78/.example-tool-standalone"
init_argv_command="$init_argv_root/bin/example-tool"
mkdir -p "$init_argv_root/home"
HOME="$init_argv_root/home" \
  /bin/bash "$keyed_consumer/install.sh" --archive "$init_argv_archive" \
  --data-home "$init_argv_root/data" --bin-dir "$init_argv_root/bin" \
  --man-dir "$init_argv_root/man" --init plain 'two words' '*' '' >/dev/null ||
  fail "keyed post-install init failed"
[[ $(<"$init_argv_log.count") == 4 && $(<"$init_argv_log.0") == plain &&
$(<"$init_argv_log.1") == 'two words' && $(<"$init_argv_log.2") == '*' &&
! -s "$init_argv_log.3" ]] ||
  fail "post-install init did not preserve argv exactly"
[[ -L "$init_argv_control/current" && -x "$init_argv_command" &&
  ! -e "$init_argv_control/lock" ]] ||
  fail "post-install init ran before unlocked activation"

init_fail_impl=$(
  cat <<EOF
if [ "\${1:-}" = --version ]; then echo "example-tool $keyed_commit_prefix"; exit 0; fi
if [ "\${1:-}" = runinit ]; then exit 42; fi
echo keyed-first
EOF
)
init_fail_archive=$(make_archive "$keyed_version" linux-x86_64-musl keyed \
  example/example-tool 1 "$init_fail_impl")
init_fail_root="$tmp/init-failure"
init_fail_control="$init_fail_root/data/cgraf78/.example-tool-standalone"
mkdir -p "$init_fail_root/home"
set +e
HOME="$init_fail_root/home" \
  /bin/bash "$keyed_consumer/install.sh" --archive "$init_fail_archive" \
  --data-home "$init_fail_root/data" --bin-dir "$init_fail_root/bin" \
  --man-dir "$init_fail_root/man" --init failing >/dev/null 2>&1
init_fail_status=$?
set -e
[[ "$init_fail_status" -eq 42 ]] ||
  fail "post-install init failure status was not preserved"
[[ -L "$init_fail_control/current" &&
  -x "$init_fail_root/bin/example-tool" &&
  ! -e "$init_fail_control/lock" ]] ||
  fail "post-install init failure rolled back the installed release"

overlap_equal="$tmp/overlap-equal"
mkdir -p "$overlap_equal/home"
if HOME="$overlap_equal/home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --data-home "$overlap_equal/data" \
  --bin-dir "$overlap_equal/data/cgraf78" \
  --man-dir "$overlap_equal/man" >/dev/null 2>&1; then
  fail "public command equal to the stable root unexpectedly installed"
fi
[[ ! -e "$overlap_equal/data" && ! -L "$overlap_equal/data" ]] ||
  fail "stable-root overlap mutated the destination before rejection"

overlap_nested="$tmp/overlap-nested"
mkdir -p "$overlap_nested/home"
if HOME="$overlap_nested/home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --data-home "$overlap_nested/data" \
  --bin-dir "$overlap_nested/data/cgraf78/example-tool/bin" \
  --man-dir "$overlap_nested/man" >/dev/null 2>&1; then
  fail "public command directory nested below the stable root unexpectedly installed"
fi
[[ ! -e "$overlap_nested/data" && ! -L "$overlap_nested/data" ]] ||
  fail "nested stable-root overlap mutated the destination before rejection"

dot_alias="$tmp/dot-alias"
mkdir -p "$dot_alias/home"
if HOME="$dot_alias/home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --data-home "$dot_alias/data" \
  --bin-dir "$dot_alias/bin/../bin" \
  --man-dir "$dot_alias/man" >/dev/null 2>&1; then
  fail "dot-segment destination alias unexpectedly installed"
fi
[[ ! -e "$dot_alias/data" && ! -L "$dot_alias/data" ]] ||
  fail "dot-segment destination alias mutated state before rejection"

home="$tmp/home"
data_home="$tmp/data"
mkdir -p "$home"

HOME="$home" XDG_DATA_HOME="$data_home" \
  /bin/bash "$consumer/install.sh" \
  --archive "$archive1" --checksum "$archive1.sha256" >/dev/null ||
  fail "offline install of a valid release archive failed"

stable_root="$data_home/cgraf78/example-tool"
control_root="$data_home/cgraf78/.example-tool-standalone"
[[ -L "$stable_root" ]] ||
  fail "install did not create the stable release-root link"
[[ -f "$stable_root/README.md" && -f "$stable_root/LICENSE" ]] ||
  fail "install omitted top-level archive payload"
[[ -f "$stable_root/examples/example.txt" &&
  -f "$stable_root/schemas/schema.json" ]] ||
  fail "install omitted nested archive payload"
[[ -x "$stable_root/bin/example-tool" ]] ||
  fail "install omitted the archive binary or its executable mode"
[[ -f "$control_root/owner" ]] ||
  fail "install did not mark its private control root"

command_link="$home/.local/bin/example-tool"
man_link="$data_home/man/man1/example-tool.1"
[[ -L "$command_link" ]] ||
  fail "install did not publish the command link"
[[ -L "$man_link" ]] ||
  fail "install did not publish the declared manpage link"
[[ $("$command_link") == first ]] ||
  fail "published command does not execute the installed archive"
grep -Fq '.TH EXAMPLE 1' "$man_link" ||
  fail "published manpage does not read the installed archive"

stable_alias="$tmp/stable-alias"
ln -s "$stable_root" "$stable_alias"
if HOME="$home" XDG_DATA_HOME="$data_home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  --bin-dir "$stable_alias/examples" --man-dir "$tmp/stable-alias-man" \
  >/dev/null 2>&1; then
  fail "symlinked ancestor alias into the stable release unexpectedly installed"
fi
[[ ! -e "$stable_root/examples/example-tool" &&
  ! -L "$stable_root/examples/example-tool" ]] ||
  fail "stable-release alias rejection allowed release-tree mutation"

first_current=$(readlink "$control_root/current")
first_release_count=$(find "$control_root/releases" -mindepth 1 -maxdepth 1 \
  -type d | wc -l | tr -d ' ')

# A failed checksum implementation must never turn two empty command-
# substitution results into apparent equality. Let the private archive hash
# succeed, then reject every retained-tree operand and require the installer to
# fail without changing the active release.
if real_hash_tool=$(command -v sha256sum); then
  hash_tool_name=sha256sum
else
  real_hash_tool=$(command -v shasum)
  hash_tool_name=shasum
fi
hash_failure_bin="$tmp/hash-failure-bin"
mkdir -p "$hash_failure_bin"
cat >"$hash_failure_bin/$hash_tool_name" <<'EOF'
#!/usr/bin/env bash
last_arg=
for last_arg in "$@"; do :; done
case $last_arg in
  */archive.snapshot) exec "$REAL_HASH_TOOL" "$@" ;;
  *) exit 96 ;;
esac
EOF
chmod 0755 "$hash_failure_bin/$hash_tool_name"
if HOME="$home" XDG_DATA_HOME="$data_home" \
  REAL_HASH_TOOL="$real_hash_tool" PATH="$hash_failure_bin:$PATH" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" \
  >/dev/null 2>&1; then
  fail "retained-tree checksum failures were accepted as equality"
fi
[[ $(readlink "$control_root/current") == "$first_current" ]] ||
  fail "retained-tree checksum failure changed the active release"

# A release installer is a bootstrap surface and must not quietly grow a
# dependency on diffutils. Minimal Arch images do not necessarily provide
# `cmp`; keep a hostile command at the front of PATH so the idempotence check
# proves byte comparison uses the already-required SHA-256 implementation.
no_cmp_bin="$tmp/no-cmp-bin"
mkdir -p "$no_cmp_bin"
cat >"$no_cmp_bin/cmp" <<'EOF'
#!/usr/bin/env bash
exit 97
EOF
chmod 0755 "$no_cmp_bin/cmp"
PATH="$no_cmp_bin:$PATH"
export PATH
HOME="$home" XDG_DATA_HOME="$data_home" \
  /bin/bash "$consumer/install.sh" --archive "$archive1" >/dev/null ||
  fail "idempotent offline reinstall failed"
[[ $(readlink "$control_root/current") == "$first_current" ]] ||
  fail "idempotent reinstall changed the active release"
[[ $(find "$control_root/releases" -mindepth 1 -maxdepth 1 -type d |
  wc -l | tr -d ' ') == "$first_release_count" ]] ||
  fail "idempotent reinstall created a duplicate release tree"

version2=20260810-130000-abcdef12
archive2=$(make_archive "$version2" linux-x86_64-musl second)
HOME="$home" XDG_DATA_HOME="$data_home" \
  /bin/bash "$consumer/install.sh" --archive "$archive2" >/dev/null ||
  fail "offline update failed"
[[ $("$command_link") == second ]] ||
  fail "offline update did not switch the public command"
[[ $(find "$control_root/releases" -mindepth 1 -maxdepth 1 -type d |
  wc -l | tr -d ' ') == 2 ]] ||
  fail "offline update did not retain exactly the old and new releases"
[[ -d "$control_root/releases/$version1-linux-x86_64-musl" ]] ||
  fail "offline update deleted the previous release"

swap_version=20260810-131000-feedbeef
swap_input_dir="$tmp/swap-input"
swap_bin="$tmp/swap-bin"
swap_root="$tmp/swap-root"
mkdir -p "$swap_input_dir" "$swap_bin" "$swap_root/home"
swap_built=$(make_archive "$swap_version" linux-x86_64-musl before-swap)
swap_source="$swap_input_dir/$(basename "$swap_built")"
cp "$swap_built" "$swap_source"
checksum_file "$swap_source"
swap_expected_sha=$(awk '{ print $1 }' "$swap_source.sha256")
swap_replacement_built=$(make_archive "$swap_version" linux-x86_64-musl after-swap)
swap_replacement="$tmp/swap-replacement.tar.gz"
cp "$swap_replacement_built" "$swap_replacement"
cat >"$swap_bin/sha256sum" <<'EOF'
#!/usr/bin/env bash
printf '%s  %s\n' "$RELEASE_INSTALLER_EXPECTED_SHA" "$1"
/bin/cp "$RELEASE_INSTALLER_SWAP_REPLACEMENT" \
  "$RELEASE_INSTALLER_SWAP_SOURCE"
EOF
cp "$swap_bin/sha256sum" "$swap_bin/shasum"
chmod 0755 "$swap_bin/sha256sum" "$swap_bin/shasum"
HOME="$swap_root/home" PATH="$swap_bin:$PATH" \
  RELEASE_INSTALLER_EXPECTED_SHA="$swap_expected_sha" \
  RELEASE_INSTALLER_SWAP_REPLACEMENT="$swap_replacement" \
  RELEASE_INSTALLER_SWAP_SOURCE="$swap_source" \
  /bin/bash "$consumer/install.sh" --archive "$swap_source" \
  --data-home "$swap_root/data" --bin-dir "$swap_root/bin" \
  --man-dir "$swap_root/man" >/dev/null ||
  fail "installer did not survive a source archive pathname swap"
[[ $("$swap_root/bin/example-tool") == before-swap ]] ||
  fail "archive pathname swap changed bytes after verification"

isolated_install_fails() {
  local archive=$1 checksum=$2 name=$3
  local isolated="$tmp/$name"

  mkdir -p "$isolated/home"
  if HOME="$isolated/home" XDG_DATA_HOME="$isolated/data" \
    /bin/bash "$consumer/install.sh" \
    --archive "$archive" --checksum "$checksum" \
    --bin-dir "$isolated/bin" --man-dir "$isolated/man" \
    >/dev/null 2>&1; then
    fail "$name unexpectedly installed"
  fi
  [[ ! -e "$isolated/data/cgraf78/.example-tool-standalone" ]] ||
    fail "$name changed the destination before validation completed"
}

bad_checksum="$tmp/bad.sha256"
printf '%064d  %s\n' 0 "$(basename "$archive1")" >"$bad_checksum"
isolated_install_fails "$archive1" "$bad_checksum" corrupt-checksum

init_validation_root="$tmp/init-validation-failure"
mkdir -p "$init_validation_root/home"
init_validation_marker="$init_validation_root/must-not-run"
if HOME="$init_validation_root/home" \
  XDG_DATA_HOME="$init_validation_root/data" \
  /bin/bash "$keyed_consumer/install.sh" --archive "$keyed_archive" \
  --checksum "$bad_checksum" --bin-dir "$init_validation_root/bin" \
  --man-dir "$init_validation_root/man" --init "$init_validation_marker" \
  >/dev/null 2>&1; then
  fail "invalid release unexpectedly reached post-install init"
fi
[[ ! -e "$init_validation_marker" ]] ||
  fail "failed pre-activation validation invoked post-install init"

wrong_name_checksum="$tmp/wrong-name.sha256"
printf '%s  %s\n' \
  "$(awk '{print $1}' "$archive1.sha256")" other-release.tar.gz \
  >"$wrong_name_checksum"
isolated_install_fails "$archive1" "$wrong_name_checksum" wrong-checksum-name

mismatch_version=20260810-140000-fedcba98
mismatch_archive=$(make_archive "$mismatch_version" linux-x86_64-musl \
  mismatch other/example-tool)
isolated_install_fails "$mismatch_archive" "$mismatch_archive.sha256" \
  metadata-mismatch


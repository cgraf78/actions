#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
install_sh="$root/.github/actions/rust-ci-prereqs/install.sh"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
log=$tmp/commands
mkdir "$tmp/bin"
for cmd in apt-get pacman-key sudo timeout sleep; do
  cat >"$tmp/bin/$cmd" <<'STUB'
#!/bin/sh
printf '%s %s\n' "${0##*/}" "$*" >>"$STUB_LOG"
STUB
  chmod +x "$tmp/bin/$cmd"
done
# `pacman -T` reports every target except bash as unsatisfied (status 127), as
# on an image that already ships bash; every call is logged.
cat >"$tmp/bin/pacman" <<'STUB'
#!/bin/sh
if [ "$1" = -T ]; then
  printf '%s %s\n' "${0##*/}" "$*" >>"$STUB_LOG"
  shift
  for target in "$@"; do
    [ "$target" = bash ] || printf '%s\n' "$target"
  done
  exit 127
fi
printf '%s %s\n' "${0##*/}" "$*" >>"$STUB_LOG"
STUB
chmod +x "$tmp/bin/pacman"
ln -s "$(command -v sh)" "$tmp/bin/sh"

env -i PATH="$tmp/bin" STUB_LOG="$log" MATRIX_NAME=Ubuntu \
  sh "$install_sh"
out=$(<"$log")
# Containers have no TERM or debconf frontend; without the noninteractive
# frontend every package configuration prints debconf fallback warnings.
[[ $out == *'timeout -k 5 120 sudo env DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::http::Timeout=30'* ]]
[[ $out == *'Acquire::Retries=3 update'* ]]
[[ $out == *'Acquire::Retries=3 install -y bash build-essential'* ]]

# pacman warns once per requested package the image already has current,
# whether it reinstalls it or (with --needed) skips it. Name only the targets
# `pacman -T` reports missing, and keep --needed against reinstalling.
: >"$log"
env -i PATH="$tmp/bin" STUB_LOG="$log" MATRIX_NAME=Arch \
  sh "$install_sh"
out=$(<"$log")
[[ $out == *'timeout -k 5 120 pacman -Syu --noconfirm --needed base-devel ca-certificates curl git pkgconf'* ]]
# Any pacman command before the database sync warns that each configured sync
# database is missing, so the sync must come before the `pacman -T` query.
first_pacman=$(grep -m 1 'pacman ' "$log" || true)
[[ $first_pacman == *'pacman -Sy --noconfirm --needed' ]] || {
  printf 'rust-prereqs-test: first pacman command was <%s>\n' "$first_pacman" >&2
  exit 1
}

printf 'rust-prereqs-test: ok\n'

  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$publish_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
  fail 'normal rerun did not finish a committed development transition'
[[ -d "$publish_root/.git" && ! -L "$publish_root" &&
  ! -e "$publish_transaction" && ! -L "$publish_transaction" &&
  ! -e "$publish_lock" && ! -L "$publish_lock" ]] ||
  fail 'published transition recovery left checkout transaction or lock state'
[[ ! -e "$publish_home/example-tool" &&
  ! -L "$publish_home/example-tool" ]] ||
  fail 'published transition recovery dereferenced the broken development target'

real_rm=$(type -P rm)
retirement_wrapper="$tmp/retirement-wrapper"
mkdir -p "$retirement_wrapper"
cat >"$retirement_wrapper/rm" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

kill_parent=false
for destination in "$@"; do
  if [[ -n ${CHECKOUT_DEVELOPMENT_KILL_DESTINATION:-} &&
    "$destination" == "$CHECKOUT_DEVELOPMENT_KILL_DESTINATION" ]] ||
    [[ -n ${CHECKOUT_DEVELOPMENT_KILL_DESTINATION_PREFIX:-} &&
    "$destination" == "$CHECKOUT_DEVELOPMENT_KILL_DESTINATION_PREFIX"* ]]; then
    kill_parent=true
  fi
done
"${CHECKOUT_DEVELOPMENT_REAL_RM:?}" "$@"
if [[ "$kill_parent" == true ]]; then
  kill -KILL "$PPID"
fi
EOF
chmod 0755 "$retirement_wrapper/rm"

real_rmdir=$(type -P rmdir)
rmdir_wrapper="$tmp/rmdir-wrapper"
mkdir -p "$rmdir_wrapper"
cat >"$rmdir_wrapper/rmdir" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

destination=${!#}
"${CHECKOUT_DEVELOPMENT_REAL_RMDIR:?}" "$@"
if [[ -n ${CHECKOUT_DEVELOPMENT_KILL_RMDIR:-} &&
  "$destination" == "$CHECKOUT_DEVELOPMENT_KILL_RMDIR" ]]; then
  kill -KILL "$PPID"
fi
EOF
chmod 0755 "$rmdir_wrapper/rmdir"

# Publication is already committed when the parked link is retired. Recovery
# must recognize the still-marked managed generation without recreating or
# touching the user-owned development target.
retire_home="$tmp/retire-development"
retire_root="$tmp/retire-recovery/example/example-tool"
retire_transaction="$tmp/retire-recovery/example/.example-tool.install.transaction"
retire_lock="$tmp/retire-recovery/example/.example-tool.install.lock"
mkdir -p "${retire_root%/*}"
ln -s "$retire_home/example-tool" "$retire_root"
set +e
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/retire-crash.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/retire-crash-post.log" \
  CHECKOUT_DEVELOPMENT_REAL_RM="$real_rm" \
  CHECKOUT_DEVELOPMENT_KILL_DESTINATION="$retire_transaction/previous" \
  PATH="$retirement_wrapper:$PATH" \
  SHDEPS_GIT_DEV_DIR="$retire_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$retire_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null 2>&1
retire_crash_status=$?
set -e
[[ "$retire_crash_status" -eq 137 && -d "$retire_root/.git" &&
  ! -L "$retire_root" && -d "$retire_transaction" &&
  ! -e "$retire_transaction/previous" &&
  ! -L "$retire_transaction/previous" ]] ||
  fail 'SIGKILL after old-link retirement lost the committed checkout state'
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/retire-recover.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/retire-recover-post.log" \
  SHDEPS_GIT_DEV_DIR="$retire_home" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$retire_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
  fail 'normal rerun did not recover after old-link retirement'
[[ -d "$retire_root/.git" && ! -L "$retire_root" &&
  ! -e "$retire_transaction" && ! -L "$retire_transaction" &&
  ! -e "$retire_lock" && ! -L "$retire_lock" ]] ||
  fail 'old-link retirement recovery left transaction or lock state'

# The hard-linked marker is intentionally self-contained after the transaction
# identity is removed. Killing at that boundary leaves candidate-head as the
# exact revision proof, exercising recordless transaction recovery.
final_home="$tmp/final-development"
final_root="$tmp/final-recovery/example/example-tool"
final_transaction="$tmp/final-recovery/example/.example-tool.install.transaction"
final_marker="$final_root/.git/cgraf78-update-next-identity"
final_lock="$tmp/final-recovery/example/.example-tool.install.lock"
mkdir -p "${final_root%/*}"
ln -s "$final_home/example-tool" "$final_root"
set +e
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/final-crash.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/final-crash-post.log" \
  CHECKOUT_DEVELOPMENT_REAL_RM="$real_rm" \
  CHECKOUT_DEVELOPMENT_KILL_DESTINATION_PREFIX="$final_transaction/identity." \
  PATH="$retirement_wrapper:$PATH" \
  SHDEPS_GIT_DEV_DIR="$final_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$final_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null 2>&1
final_crash_status=$?
set -e
[[ "$final_crash_status" -eq 137 && -d "$final_root/.git" &&
  ! -L "$final_root" && -d "$final_transaction" &&
  -f "$final_marker" && ! -L "$final_marker" ]] ||
  fail 'SIGKILL after identity retirement did not preserve orphan recovery proof'
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/final-recover.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/final-recover-post.log" \
  SHDEPS_GIT_DEV_DIR="$final_home" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$final_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
  fail 'normal rerun did not recover an orphaned candidate marker'
[[ -d "$final_root/.git" && ! -L "$final_root" &&
  ! -e "$final_transaction" && ! -L "$final_transaction" &&
  ! -e "$final_marker" && ! -L "$final_marker" &&
  ! -e "$final_lock" && ! -L "$final_lock" ]] ||
  fail 'orphan-marker recovery left transaction, marker, or lock state'

# On filesystems without hard links the still-private candidate receives an
# exact regular copy of the transaction identity. Killing when the transaction
# record is retired proves that copy remains a self-contained marker while the
# remaining candidate-head proof completes recordless transaction recovery.
fallback_final_home="$tmp/fallback-final-development"
fallback_final_root="$tmp/fallback-final-recovery/example/example-tool"
fallback_final_transaction="$tmp/fallback-final-recovery/example/.example-tool.install.transaction"
fallback_final_marker="$fallback_final_root/.git/cgraf78-update-next-identity"
fallback_final_lock="$tmp/fallback-final-recovery/example/.example-tool.install.lock"
mkdir -p "${fallback_final_root%/*}"
ln -s "$fallback_final_home/example-tool" "$fallback_final_root"
set +e
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/fallback-final-crash.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/fallback-final-crash-post.log" \
  CHECKOUT_DEVELOPMENT_REAL_LN="$real_ln" \
  CHECKOUT_DEVELOPMENT_REAL_RM="$real_rm" \
  CHECKOUT_DEVELOPMENT_KILL_DESTINATION_PREFIX="$fallback_final_transaction/identity." \
  PATH="$hardlink_wrapper:$retirement_wrapper:$PATH" \
  SHDEPS_GIT_DEV_DIR="$fallback_final_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$fallback_final_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null 2>&1
fallback_final_crash_status=$?
set -e
[[ "$fallback_final_crash_status" -eq 137 &&
  -d "$fallback_final_root/.git" && ! -L "$fallback_final_root" &&
  -d "$fallback_final_transaction" &&
  -f "$fallback_final_marker" && ! -L "$fallback_final_marker" ]] ||
  fail 'no-hardlink identity copy did not preserve orphan recovery proof'
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/fallback-final-recover.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/fallback-final-recover-post.log" \
  CHECKOUT_DEVELOPMENT_REAL_LN="$real_ln" \
  PATH="$hardlink_wrapper:$PATH" \
  SHDEPS_GIT_DEV_DIR="$fallback_final_home" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$fallback_final_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
  fail 'normal rerun did not recover a copied no-hardlink marker'
[[ -d "$fallback_final_root/.git" && ! -L "$fallback_final_root" &&
  ! -e "$fallback_final_transaction" && ! -L "$fallback_final_transaction" &&
  ! -e "$fallback_final_marker" && ! -L "$fallback_final_marker" &&
  ! -e "$fallback_final_lock" && ! -L "$fallback_final_lock" ]] ||
  fail 'no-hardlink recovery left transaction, marker, or lock state'

# Once the transaction identity has been retired, the regular candidate marker
# owns the committed generation. Removing its head proof is the next cleanup
# boundary: a death there must leave an empty transaction that recovery can
# retire for both inode-sharing and copied marker representations.
run_post_head_removal_case() {
  local name=$1 reject_hardlinks=$2
  local case_home="$tmp/$name-development"
  local case_root="$tmp/$name-recovery/example/example-tool"
  local case_transaction="$tmp/$name-recovery/example/.example-tool.install.transaction"
  local case_marker="$case_root/.git/cgraf78-update-next-identity"
  local case_lock="$tmp/$name-recovery/example/.example-tool.install.lock"
  local case_path="$retirement_wrapper:$PATH" case_recovery_path=$PATH
  local case_status

  if [[ "$reject_hardlinks" == true ]]; then
    case_path="$hardlink_wrapper:$case_path"
    case_recovery_path="$hardlink_wrapper:$case_recovery_path"
  fi

  mkdir -p "${case_root%/*}"
  ln -s "$case_home/example-tool" "$case_root"
  set +e
  CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/$name-crash.log" \
    CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/$name-crash-post.log" \
    CHECKOUT_DEVELOPMENT_REAL_LN="$real_ln" \
    CHECKOUT_DEVELOPMENT_REAL_RM="$real_rm" \
    CHECKOUT_DEVELOPMENT_KILL_DESTINATION="$case_transaction/candidate-head" \
    PATH="$case_path" \
    SHDEPS_GIT_DEV_DIR="$case_home" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$case_root" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
    "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null 2>&1
  case_status=$?
  set -e
  [[ "$case_status" -eq 137 && -d "$case_root/.git" &&
    ! -L "$case_root" && -d "$case_transaction" &&
    -f "$case_marker" && ! -L "$case_marker" &&
    ! -e "$case_transaction/candidate-head" &&
    ! -L "$case_transaction/candidate-head" ]] ||
    fail "$name cleanup did not reach the post-head-removal boundary"
  [[ -z $(LC_ALL=C ls -A1 "$case_transaction") ]] ||
    fail "$name cleanup retired head proof before transaction identity"

  CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/$name-recover.log" \
    CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/$name-recover-post.log" \
    CHECKOUT_DEVELOPMENT_REAL_LN="$real_ln" \
    PATH="$case_recovery_path" \
    SHDEPS_GIT_DEV_DIR="$case_home" \
    CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
    CGRAF78_CHECKOUT_INSTALL_DIR="$case_root" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
    "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
    fail "$name rerun did not recover after head-proof retirement"
  [[ -d "$case_root/.git" && ! -L "$case_root" &&
    ! -e "$case_transaction" && ! -L "$case_transaction" &&
    ! -e "$case_marker" && ! -L "$case_marker" &&
    ! -e "$case_lock" && ! -L "$case_lock" ]] ||
    fail "$name recovery left transaction, marker, or lock state"
}

run_post_head_removal_case post-head-hardlink false
run_post_head_removal_case post-head-copy true

# After the empty transaction directory is removed, only the regular copied
# marker remains. A death before marker cleanup must be handled by the separate
# orphan-marker path rather than either transaction parser.
orphan_home="$tmp/orphan-development"
orphan_root="$tmp/orphan-recovery/example/example-tool"
orphan_transaction="$tmp/orphan-recovery/example/.example-tool.install.transaction"
orphan_marker="$orphan_root/.git/cgraf78-update-next-identity"
orphan_lock="$tmp/orphan-recovery/example/.example-tool.install.lock"
mkdir -p "${orphan_root%/*}"
ln -s "$orphan_home/example-tool" "$orphan_root"
set +e
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/orphan-crash.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/orphan-crash-post.log" \
  CHECKOUT_DEVELOPMENT_REAL_LN="$real_ln" \
  CHECKOUT_DEVELOPMENT_REAL_RMDIR="$real_rmdir" \
  CHECKOUT_DEVELOPMENT_KILL_RMDIR="$orphan_transaction" \
  PATH="$hardlink_wrapper:$rmdir_wrapper:$PATH" \
  SHDEPS_GIT_DEV_DIR="$orphan_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$orphan_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null 2>&1
orphan_crash_status=$?
set -e
[[ "$orphan_crash_status" -eq 137 && -d "$orphan_root/.git" &&
  ! -L "$orphan_root" && ! -e "$orphan_transaction" &&
  ! -L "$orphan_transaction" && -f "$orphan_marker" &&
  ! -L "$orphan_marker" ]] ||
  fail 'post-transaction death did not preserve a regular orphan marker'
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/orphan-recover.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/orphan-recover-post.log" \
  CHECKOUT_DEVELOPMENT_REAL_LN="$real_ln" \
  PATH="$hardlink_wrapper:$PATH" \
  SHDEPS_GIT_DEV_DIR="$orphan_home" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$orphan_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
  fail 'normal rerun did not retire the orphaned candidate marker'
[[ -d "$orphan_root/.git" && ! -L "$orphan_root" &&
  ! -e "$orphan_transaction" && ! -L "$orphan_transaction" &&
  ! -e "$orphan_marker" && ! -L "$orphan_marker" &&
  ! -e "$orphan_lock" && ! -L "$orphan_lock" ]] ||
  fail 'orphan-marker recovery left transaction, marker, or lock state'

invalid_development_home="$tmp/invalid-development"
invalid_development="$invalid_development_home/example-tool"
invalid_managed_root="$tmp/invalid-fallback/example/example-tool"
mkdir -p "$invalid_development"
printf 'invalid development bytes\n' >"$invalid_development/sentinel"
set +e
invalid_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/invalid.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/invalid-post.log" \
  SHDEPS_GIT_DEV_DIR="$invalid_development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$invalid_managed_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s <"$source_checkout/install.sh" 2>&1)
invalid_status=$?
set -e
[[ "$invalid_status" -eq 0 &&
  "$invalid_output" == *'warning: ignoring invalid unselected development checkout'* ]] ||
  fail 'invalid unselected development checkout did not warn and fall back'
grep -Fqx 'invalid development bytes' "$invalid_development/sentinel" ||
  fail 'managed fallback changed an invalid unselected development checkout'
[[ -d "$invalid_managed_root/.git" && ! -L "$invalid_managed_root" ]] ||
  fail 'invalid development fallback did not publish a managed checkout'

printf 'checkout-installer-development-test: ok\n'

  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null 2>&1
nested_restore_reclaim_status=$?
set -e
[[ "$nested_restore_reclaim_status" -ne 0 &&
  -d "$nested_restore_root" && ! -e "$nested_restore_child" &&
  ! -L "$nested_restore_child" && -L "$nested_restore_previous" ]] ||

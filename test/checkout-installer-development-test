rmdir "$nested_restore_root"
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/nested-restore-recover.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/nested-restore-recover-post.log" \
  SHDEPS_GIT_DEV_DIR="$nested_restore_home" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$nested_restore_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null ||
  fail 'managed rerun did not converge after nested rollback collision removal'
[[ -d "$nested_restore_root/.git" && ! -L "$nested_restore_root" &&
  ! -e "$nested_restore_transaction" && ! -L "$nested_restore_transaction" ]] ||
  fail 'nested rollback recovery left transaction state'

publish_home="$tmp/publish-development"
publish_root="$tmp/publish-recovery/example/example-tool"
publish_transaction="$tmp/publish-recovery/example/.example-tool.install.transaction"
publish_lock="$tmp/publish-recovery/example/.example-tool.install.lock"
mkdir -p "${publish_root%/*}"
ln -s "$publish_home/example-tool" "$publish_root"
set +e
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/publish-crash.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/publish-crash-post.log" \
  CHECKOUT_DEVELOPMENT_REAL_MV="$real_mv" \
  CHECKOUT_DEVELOPMENT_KILL_DESTINATION="$publish_root" \
  PATH="$transition_wrapper:$PATH" \
  SHDEPS_GIT_DEV_DIR="$publish_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$publish_root" \

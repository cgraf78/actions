#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
tmp=$(cd -P -- "$tmp" && pwd -P)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
  printf 'checkout-installer-development-test: %s\n' "$*" >&2
  exit 1
}

write_config() {
  local consumer=$1

  mkdir -p "$consumer/scripts"
  cat >"$consumer/scripts/checkout-installer.conf" <<'EOF'
# shellcheck shell=bash
# shellcheck disable=SC2034
CHECKOUT_INSTALLER_ENABLED=true
CHECKOUT_INSTALLER_REPO=example/example-tool
EOF
}

write_delegate() {
  local consumer=$1

  mkdir -p "$consumer/support"
  cat >"$consumer/support/install-checkout.sh" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

checkout_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
{
  printf 'root=%s\n' "$checkout_root"
  if [[ -n ${CHECKOUT_DEVELOPMENT_TEST_LOCK:-} ]]; then
    if [[ -L "$CHECKOUT_DEVELOPMENT_TEST_LOCK" ||
      -d "$CHECKOUT_DEVELOPMENT_TEST_LOCK" ]]; then
      printf 'lock=held\n'
    else
      printf 'lock=absent\n'
    fi
  fi
  printf 'argc=%s\n' "$#"
  index=0
  for argument in "$@"; do
    index=$((index + 1))
    printf 'arg%s=%s\n' "$index" "$argument"
  done
} >"${CHECKOUT_DEVELOPMENT_TEST_LOG:?}"
if [[ -n ${CHECKOUT_DEVELOPMENT_TEST_RETARGET_LINK:-} ]]; then
  rm -f -- "${CHECKOUT_DEVELOPMENT_TEST_RETARGET_LINK:?}"
  ln -s "${CHECKOUT_DEVELOPMENT_TEST_RETARGET_TARGET:?}" \
    "$CHECKOUT_DEVELOPMENT_TEST_RETARGET_LINK"
fi
EOF
  chmod 0755 "$consumer/support/install-checkout.sh"
}

write_post_install() {
  local consumer=$1

  cat >"$consumer/support/post-install.sh" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

checkout_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
{
  printf 'root=%s\n' "$checkout_root"
  if [[ -n ${CHECKOUT_DEVELOPMENT_TEST_LOCK:-} ]]; then
    if [[ -L "$CHECKOUT_DEVELOPMENT_TEST_LOCK" ||
      -d "$CHECKOUT_DEVELOPMENT_TEST_LOCK" ]]; then
      printf 'lock=held\n'
    else
      printf 'lock=absent\n'
    fi
  fi
  printf 'argc=%s\n' "$#"
  index=0
  for argument in "$@"; do
    index=$((index + 1))
    printf 'arg%s=%s\n' "$index" "$argument"
  done
} >"${CHECKOUT_DEVELOPMENT_TEST_POST_LOG:?}"
EOF
  chmod 0755 "$consumer/support/post-install.sh"
}

render_must_fail() {
  local consumer=$1 description=$2

  if "$root/checkout-installer/render.sh" "$consumer" >/dev/null 2>&1; then
    fail "$description"
  fi
}

invalid_policy="$tmp/invalid-policy"
write_config "$invalid_policy"
write_delegate "$invalid_policy"
printf 'CHECKOUT_INSTALLER_DEVELOPMENT_POLICY=other\n' \
  >>"$invalid_policy/scripts/checkout-installer.conf"
render_must_fail "$invalid_policy" \
  'renderer accepted an unknown development policy'

missing_destination="$tmp/missing-destination"
write_config "$missing_destination"
write_delegate "$missing_destination"
printf '%s\n' \
  'CHECKOUT_INSTALLER_LOCK_PROTOCOL=v1' \
  'CHECKOUT_INSTALLER_DEVELOPMENT_POLICY=shdeps' \
  >>"$missing_destination/scripts/checkout-installer.conf"
render_must_fail "$missing_destination" \
  'renderer accepted development policy without the Shdeps destination'

missing_lock="$tmp/missing-lock"
write_config "$missing_lock"
write_delegate "$missing_lock"
printf '%s\n' \
  'CHECKOUT_INSTALLER_DEFAULT_DESTINATION=shdeps' \
  'CHECKOUT_INSTALLER_DEVELOPMENT_POLICY=shdeps' \
  >>"$missing_lock/scripts/checkout-installer.conf"
render_must_fail "$missing_lock" \
  'renderer accepted development policy without checkout lock v1'

ambient_policy="$tmp/ambient-policy"
write_config "$ambient_policy"
write_delegate "$ambient_policy"
CHECKOUT_INSTALLER_DEVELOPMENT_POLICY=shdeps \
  "$root/checkout-installer/render.sh" "$ambient_policy" >/dev/null ||
  fail 'ambient development policy broke an unopted consumer'
[[ "$(git hash-object "$ambient_policy/install.sh")" == b8e6f9ce5b9a6f352c976b4eee22dbf2feb79222 ]] ||
  fail 'ambient development policy changed legacy generated bytes'

# The installer and Shdeps consume the same narrow URL-identity vectors. Keep
# the generated function private while executing its exact template body here,
# so adding a transport spelling requires an explicit versioned fixture change.
[[ $(git hash-object \
  "$root/checkout-installer/fixtures/github-repo-identity-v1.tsv") == daacc4f30ff6c69866667619a85495ab621a7f8f ]] ||
  fail 'GitHub identity v1 fixture changed in place; add a new fixture version'
identity_function=$(sed -n \
  '/^  canonical_github_repo_url() {$/,/^  }$/p' \
  "$root/checkout-installer/install.sh.in")
[[ -n "$identity_function" ]] ||
  fail 'cannot locate the generated GitHub identity function'
eval "$identity_function"
while IFS=$'\t' read -r disposition url expected extra ||
  [[ -n ${disposition:-}${url:-}${expected:-}${extra:-} ]]; do
  case $disposition in
    '' | \#*) continue ;;
  esac
  [[ -z ${extra:-} ]] || fail "identity fixture has extra fields: $url"
  case $disposition in
    accept)
      actual=$(canonical_github_repo_url "$url") ||
        fail "identity fixture rejected supported URL: $url"
      [[ "$actual" == "$expected" ]] ||
        fail "identity fixture normalized $url to $actual instead of $expected"
      ;;
    reject)
      if canonical_github_repo_url "$url" >/dev/null; then
        fail "identity fixture accepted unsupported URL: $url"
      fi
      ;;
    *) fail "identity fixture has unknown disposition: $disposition" ;;
  esac
done <"$root/checkout-installer/fixtures/github-repo-identity-v1.tsv"

# Recovery authority must be a regular candidate marker. A symbolic alias can
# share the transaction identity's inode while still becoming dangling when
# that record is retired, so the development matcher must reject it before any
# state transition. A copied marker must also match every identity field; both
# files being independently well-formed is not sufficient authority.
for identity_function_name in \
  load_development_identity \
  update_identity_matches \
  development_identity_matches; do
  identity_function=$(sed -n \
    "/^  $identity_function_name() {\$/,/^  }\$/p" \
    "$root/checkout-installer/install.sh.in")
  [[ -n "$identity_function" ]] ||
    fail "cannot locate generated identity function: $identity_function_name"
  eval "$identity_function"
done
identity_match_root="$tmp/identity-match"
checkout_dir="$identity_match_root/managed/example-tool"
checkout_repo=example/example-tool
checkout_ref=main
expected_development_dir="$identity_match_root/development/example-tool"
update_identity="$identity_match_root/identity.record"
mkdir -p "$identity_match_root"
printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
  'cgraf78 checkout installer development-to-managed transaction v1' \
  "$checkout_dir" "$checkout_repo" "$checkout_ref" \
  "$expected_development_dir" 'support/install-checkout.sh' \
  'support/post-install.sh' >"$update_identity"

identity_symlink_marker="$identity_match_root/symlink-marker"
ln -s "$update_identity" "$identity_symlink_marker"
development_recorded_target=sentinel-target
update_recorded_delegate=sentinel-delegate
update_recorded_post_install_delegate=sentinel-post-delegate
set +e
development_identity_matches "$identity_symlink_marker"
identity_symlink_status=$?
set -e
[[ "$identity_symlink_status" -ne 0 ]] ||
  fail 'development identity matcher accepted a symbolic marker alias'
[[ "$development_recorded_target" == sentinel-target &&
  "$update_recorded_delegate" == sentinel-delegate &&
  "$update_recorded_post_install_delegate" == sentinel-post-delegate ]] ||
  fail 'rejected symbolic identity marker changed recorded identity state'

identity_different_marker="$identity_match_root/different-marker"
printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
  'cgraf78 checkout installer development-to-managed transaction v1' \
  "$checkout_dir" "$checkout_repo" "$checkout_ref" \
  "$expected_development_dir" 'support/different-install.sh' \
  'support/different-post.sh' >"$identity_different_marker"
development_recorded_target=sentinel-target
update_recorded_delegate=sentinel-delegate
update_recorded_post_install_delegate=sentinel-post-delegate
set +e
development_identity_matches "$identity_different_marker"
identity_different_status=$?
set -e
[[ "$identity_different_status" -ne 0 ]] ||
  fail 'development identity matcher accepted different valid identity fields'
[[ "$development_recorded_target" == sentinel-target &&
  "$update_recorded_delegate" == sentinel-delegate &&
  "$update_recorded_post_install_delegate" == sentinel-post-delegate ]] ||
  fail 'rejected copied identity changed recorded identity state'

# An unopted consumer owns the meaning of every argument. In particular, the
# provider must not globally reserve the recovery flag for unrelated tools.
legacy="$tmp/legacy"
write_config "$legacy"
write_delegate "$legacy"
"$root/checkout-installer/render.sh" "$legacy" >/dev/null
git -C "$legacy" init --quiet --initial-branch=main --template=''
git -C "$legacy" config core.hooksPath /dev/null
git -C "$legacy" config commit.gpgsign false
git -C "$legacy" config user.name 'Checkout Development Test'
git -C "$legacy" config user.email checkout-development@example.invalid
git -C "$legacy" add .
git -C "$legacy" commit --quiet -m fixture
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/legacy.log" \
  "$legacy/install.sh" --managed 'two words' >/dev/null
grep -Fqx 'argc=2' "$tmp/legacy.log" ||
  fail 'unopted consumer lost a caller argument'
grep -Fqx 'arg1=--managed' "$tmp/legacy.log" ||
  fail 'unopted consumer did not receive --managed'
grep -Fqx 'arg2=two words' "$tmp/legacy.log" ||
  fail 'unopted consumer argument order changed'

nocase_policy="$tmp/nocase-policy"
write_config "$nocase_policy"
write_delegate "$nocase_policy"
printf '%s\n' \
  'CHECKOUT_INSTALLER_DEFAULT_DESTINATION=shdeps' \
  'CHECKOUT_INSTALLER_LOCK_PROTOCOL=v1' \
  'CHECKOUT_INSTALLER_DEVELOPMENT_POLICY=shdeps' \
  >>"$nocase_policy/scripts/checkout-installer.conf"
"$root/checkout-installer/render.sh" "$nocase_policy" >/dev/null
git -C "$nocase_policy" init --quiet --initial-branch=main --template=''
git -C "$nocase_policy" config core.hooksPath /dev/null
git -C "$nocase_policy" config commit.gpgsign false
git -C "$nocase_policy" config user.name 'Checkout Development Test'
git -C "$nocase_policy" config user.email checkout-development@example.invalid
git -C "$nocase_policy" add .
git -C "$nocase_policy" commit --quiet -m fixture
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/nocase-policy.log" \
  "$BASH" -O nocasematch "$nocase_policy/install.sh" --MANAGED >/dev/null
grep -Fqx 'arg1=--MANAGED' "$tmp/nocase-policy.log" ||
  fail 'inherited nocasematch consumed a case-folded recovery flag'

source_checkout="$tmp/source"
source_remote="$tmp/source.git"
write_config "$source_checkout"
write_delegate "$source_checkout"
write_post_install "$source_checkout"
printf '%s\n' \
  'CHECKOUT_INSTALLER_DEFAULT_DESTINATION=shdeps' \
  'CHECKOUT_INSTALLER_POST_INSTALL_DELEGATE=support/post-install.sh' \
  'CHECKOUT_INSTALLER_LOCK_PROTOCOL=v1' \
  'CHECKOUT_INSTALLER_BASH_RESOLVER=v1' \
  'CHECKOUT_INSTALLER_DEVELOPMENT_POLICY=shdeps' \
  >>"$source_checkout/scripts/checkout-installer.conf"
"$root/checkout-installer/render.sh" "$source_checkout" >/dev/null
"$BASH" -n "$source_checkout/install.sh" \
  "$source_checkout/support/checkout-bash-v1.sh"
git -C "$source_checkout" init --quiet --initial-branch=main --template=''
git -C "$source_checkout" config core.hooksPath /dev/null
git -C "$source_checkout" config commit.gpgsign false
git -C "$source_checkout" config user.name 'Checkout Development Test'
git -C "$source_checkout" config user.email checkout-development@example.invalid
git -C "$source_checkout" add .
git -C "$source_checkout" commit --quiet -m fixture
git init --quiet --bare --initial-branch=main "$source_remote"
git -C "$source_checkout" remote add origin "$source_remote"
git -C "$source_checkout" push --quiet --set-upstream origin main

# The literal development target is a shared Actions/Shdeps interface. Exercise
# default HOME derivation and the root-directory edge without creating either
# target, then reject spellings that could normalize to a different path.
formula_home="$tmp/formula-home"
formula_root="$tmp/formula-default/example/example-tool"
mkdir -p "${formula_root%/*}"
ln -s "$formula_home/git/example-tool" "$formula_root"
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/formula-default.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/formula-default-post.log" \
  HOME="$formula_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$formula_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null ||
  fail 'default HOME development target was not recognized literally'
[[ -d "$formula_root/.git" && ! -L "$formula_root" &&
  ! -e "$formula_home/git/example-tool" &&
  ! -L "$formula_home/git/example-tool" ]] ||
  fail 'default HOME recovery changed the development target'

root_formula_root="$tmp/formula-root/example/example-tool"
mkdir -p "${root_formula_root%/*}"
ln -s /example-tool "$root_formula_root"
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/formula-root.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/formula-root-post.log" \
  SHDEPS_GIT_DEV_DIR=/ \
  CGRAF78_CHECKOUT_INSTALL_DIR="$root_formula_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
  "$BASH" -s -- --managed <"$source_checkout/install.sh" >/dev/null ||
  fail 'root development directory did not resolve to /example-tool'
[[ -d "$root_formula_root/.git" && ! -L "$root_formula_root" ]] ||
  fail 'root development-directory recovery did not publish a managed checkout'

for invalid_development_root in \
  relative/path \
  "$tmp/formula/../development"; do
  invalid_formula_root="$tmp/formula-invalid-${invalid_development_root##*/}/example/example-tool"
  set +e
  invalid_formula_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/formula-invalid.log" \
    CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/formula-invalid-post.log" \
    SHDEPS_GIT_DEV_DIR="$invalid_development_root" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$invalid_formula_root" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$source_remote" \
    "$BASH" -s <"$source_checkout/install.sh" 2>&1)
  invalid_formula_status=$?
  set -e
  [[ "$invalid_formula_status" -ne 0 &&
    "$invalid_formula_output" == *'development root must'* &&
    ! -e "$invalid_formula_root" && ! -L "$invalid_formula_root" ]] ||
    fail "invalid development root mutated the checkout: $invalid_development_root"
done

development_home="$tmp/development roots"
development_checkout="$development_home/example-tool"
mkdir -p "$development_home"
git clone --quiet "$source_remote" "$development_checkout"
git -C "$development_checkout" remote set-url origin \
  git@github.com:example/example-tool.git
git -C "$development_checkout" checkout --quiet --detach
cat >>"$development_checkout/support/install-checkout.sh" <<'EOF'
printf 'dirty-live-delegate=yes\n' >>"${CHECKOUT_DEVELOPMENT_TEST_LOG:?}"
EOF
git -C "$development_checkout" add support/install-checkout.sh

selected_root="$tmp/selected/example/example-tool"
selected_lock="$tmp/selected/example/.example-tool.install.lock"
mkdir -p "${selected_root%/*}"
ln -s "$development_checkout" "$selected_root"
selected_link_before=$(readlink "$selected_root")
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/selected.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/selected-post.log" \
  CHECKOUT_DEVELOPMENT_TEST_LOCK="$selected_lock" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  "$BASH" -s -- first 'two words' <"$source_checkout/install.sh" >/dev/null ||
  fail 'installer did not use a selected development checkout'
[[ -L "$selected_root" && $(readlink "$selected_root") == "$selected_link_before" ]] ||
  fail 'selected development link changed during a normal run'
grep -Fqx "root=$(cd "$development_checkout" && pwd -P)" \
  "$tmp/selected.log" ||
  fail 'primary delegate did not run from the development checkout'
grep -Fqx 'dirty-live-delegate=yes' "$tmp/selected.log" ||
  fail 'dirty tracked development delegate bytes were not served live'
grep -Fqx 'lock=held' "$tmp/selected.log" ||
  fail 'development primary delegate did not observe the shared lock'
grep -Fqx 'lock=absent' "$tmp/selected-post.log" ||
  fail 'development post-install delegate inherited the shared lock'
grep -Fqx 'arg1=first' "$tmp/selected-post.log" ||
  fail 'development post-install delegate lost caller arguments'
if git -C "$development_checkout" symbolic-ref -q HEAD >/dev/null 2>&1; then
  fail 'development validation attached the detached checkout'
fi
if git -C "$development_checkout" diff --cached --quiet; then
  fail 'development validation reset staged script edits'
fi
[[ ! -e "$development_checkout/.git/cgraf78-update-previous-identity" &&
  ! -e "$development_checkout/.git/cgraf78-update-next-identity" ]] ||
  fail 'development run wrote transaction state into the user checkout'

# The primary delegate is allowed to be live development code, so validate the
# selected link again before crossing into the unlocked post-install phase.
retarget_post_log="$tmp/retarget-post.log"
set +e
retarget_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/retarget.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$retarget_post_log" \
  CHECKOUT_DEVELOPMENT_TEST_RETARGET_LINK="$selected_root" \
  CHECKOUT_DEVELOPMENT_TEST_RETARGET_TARGET="$tmp/foreign-after-primary" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  "$BASH" -s <"$source_checkout/install.sh" 2>&1)
retarget_status=$?
set -e
[[ "$retarget_status" -ne 0 &&
  "$retarget_output" == *'selected development checkout changed before execution'* &&
  ! -e "$retarget_post_log" ]] ||
  fail 'development selection was not revalidated before post-install'
rm "$selected_root"
ln -s "$development_checkout" "$selected_root"

for origin in \
  https://github.com/example/example-tool.git \
  ssh://git@github.com/example/example-tool.git; do
  git -C "$development_checkout" remote set-url origin "$origin"
  origin_label=${origin%%:*}
  CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/selected-$origin_label.log" \
    CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/selected-$origin_label-post.log" \
    CHECKOUT_DEVELOPMENT_TEST_LOCK="$selected_lock" \
    SHDEPS_GIT_DEV_DIR="$development_home/" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
    "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
    fail "installer rejected supported development origin: $origin"
done

# A runtime override may choose a non-GitHub transport, but it must not use an
# exact URL match to change the configured repository identity. GitHub URLs
# still identify the declared owner/repository; opaque overrides match exactly.
foreign_github_origin=https://github.com/other/example-tool.git
git -C "$development_checkout" remote set-url origin "$foreign_github_origin"
set +e
foreign_override_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/foreign-override.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/foreign-override-post.log" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$foreign_github_origin" \
  "$BASH" -s <"$source_checkout/install.sh" 2>&1)
foreign_override_status=$?
set -e
[[ "$foreign_override_status" -ne 0 &&
  "$foreign_override_output" == *'configured repository differs'* ]] ||
  fail 'development validation let an override change GitHub repository identity'

local_override="file://$source_remote"
git -C "$development_checkout" remote set-url origin "$local_override"
CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/local-override.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/local-override-post.log" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$local_override" \
  "$BASH" -s <"$source_checkout/install.sh" >/dev/null ||
  fail 'development validation rejected an exact non-GitHub override'

git -C "$development_checkout" remote set-url origin \
  https://github.com/example/example-tool.git
git -C "$development_checkout" config \
  url.https://example.invalid/.insteadOf https://github.com/
set +e
rewritten_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/rewritten.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/rewritten-post.log" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  "$BASH" -s <"$source_checkout/install.sh" 2>&1)
rewritten_status=$?
set -e
[[ "$rewritten_status" -ne 0 &&
  "$rewritten_output" == *'effective origin differs'* &&
  "$rewritten_output" == *'--managed'* ]] ||
  fail 'development validation accepted a rewritten effective origin'
git -C "$development_checkout" config --unset-all \
  url.https://example.invalid/.insteadOf

git -C "$development_checkout" remote set-url --add origin \
  git@github.com:example/example-tool.git
set +e
multiple_origin_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/multiple-origin.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/multiple-origin-post.log" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  "$BASH" -s <"$source_checkout/install.sh" 2>&1)
multiple_origin_status=$?
set -e
[[ "$multiple_origin_status" -ne 0 &&
  "$multiple_origin_output" == *'local origin differs'* ]] ||
  fail 'development validation accepted multiple local origins'
git -C "$development_checkout" config --unset-all remote.origin.url
git -C "$development_checkout" config --add remote.origin.url \
  git@github.com:example/example-tool.git

mv "$development_checkout/support/install-checkout.sh" \
  "$development_checkout/support/install-checkout-target.sh"
ln -s install-checkout-target.sh \
  "$development_checkout/support/install-checkout.sh"
set +e
symlinked_delegate_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/symlinked-delegate.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/symlinked-delegate-post.log" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  "$BASH" -s <"$source_checkout/install.sh" 2>&1)
symlinked_delegate_status=$?
set -e
[[ "$symlinked_delegate_status" -ne 0 &&
  "$symlinked_delegate_output" == *'not a live regular file'* ]] ||
  fail 'development validation accepted a live delegate symlink'
rm "$development_checkout/support/install-checkout.sh"
mv "$development_checkout/support/install-checkout-target.sh" \
  "$development_checkout/support/install-checkout.sh"

mv "$development_checkout/support" "$development_checkout/support-real"
ln -s support-real "$development_checkout/support"
set +e
symlinked_parent_output=$(CHECKOUT_DEVELOPMENT_TEST_LOG="$tmp/symlinked-parent.log" \
  CHECKOUT_DEVELOPMENT_TEST_POST_LOG="$tmp/symlinked-parent-post.log" \
  SHDEPS_GIT_DEV_DIR="$development_home" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$selected_root" \
  "$BASH" -s <"$source_checkout/install.sh" 2>&1)
symlinked_parent_status=$?
set -e
[[ "$symlinked_parent_status" -ne 0 &&
  "$symlinked_parent_output" == *'symlinked parent'* ]] ||

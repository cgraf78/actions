#!/usr/bin/env bash

# Coverage for the shared musl build prerequisites action.
#
# The real work is package installation, so the commands it drives are stubbed
# and the test asserts on what it tried to run. That is the part consumers
# depend on: which packages, whether sudo is used, and when rustup is involved.

set -uo pipefail

root=$(CDPATH='' cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
install_sh="$root/.github/actions/musl-build-prereqs/install.sh"
step_sh="$root/.github/actions/package-manager/run.sh"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# shellcheck source=test/fixture-env.sh
. "$root/test/fixture-env.sh"
actions_fixture_path "$tmp" || exit "$?"
# shellcheck source=.github/actions/shared/infra-stall-markers.sh
. "$root/.github/actions/shared/infra-stall-markers.sh"

echo "=== musl build prerequisites ==="

_passes=0
_failures=0

_pass() {
  printf 'ok   - %s\n' "$1"
  _passes=$((_passes + 1))
}

_fail() {
  printf 'FAIL - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_contains() {
  local name=$1 needle=$2 haystack=$3
  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name (want '$needle' in '$haystack')"
  fi
}

_assert_missing() {
  local name=$1 needle=$2 haystack=$3
  if [[ "$haystack" != *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name (unexpected '$needle' in '$haystack')"
  fi
}

_run() {
  # usage: _run <log> <with_sudo> <expected_status> [env assignments...]
  local log=$1 with_sudo=$2 expected=$3 status=0 bin
  shift 3
  bin="$tmp/bin-$(basename "$log")"
  actions_fixture_apt_tools "$bin" "$with_sudo" || exit
  cat >"$bin/rustup" <<'EOF' || exit
#!/bin/sh
printf 'rustup %s\n' "$*" >>"$STUB_LOG"
EOF
  chmod 0755 "$bin/rustup" || exit
  : >"$log"
  env -i PATH="$bin" TMPDIR="$tmp" APT_MIRROR_LIST="$tmp/no-mirrorlist" \
    STUB_LOG="$log" "$@" sh "$step_sh" "$install_sh" >>"$log" 2>&1 || status=$?
  if [[ "$status" -eq "$expected" ]]; then
    _pass "${log##*/}: exits $expected"
  else
    _fail "${log##*/}: expected exit $expected, got $status"
    cat "$log" >&2
  fi
}

# --- Linux, no explicit target ----------------------------------------------

log="$tmp/linux.log"
_run "$log" 1 0 RUNNER_OS=Linux
out=$(<"$log")
_assert_contains "linux: refreshes the package index" "Acquire::Retries=3 update" "$out"
_assert_contains "linux: bounds apt transport" "Acquire::http::Timeout=30" "$out"
_assert_contains "linux: installs musl-tools" "musl-tools" "$out"
_assert_contains "linux: installs without recommends" "--no-install-recommends" "$out"
# The release matrix already installs its target through the toolchain action,
# so an unset RUST_TARGET must not trigger a redundant rustup call.
_assert_missing "linux: skips rustup when no target is given" "rustup" "$out"
_assert_contains "linux: escalates with sudo on hosted runners" \
  "sudo env DEBIAN_FRONTEND=noninteractive apt-get" "$out"

# --- Linux with an explicit target ------------------------------------------

log="$tmp/target.log"
_run "$log" 1 0 RUNNER_OS=Linux RUST_TARGET=x86_64-unknown-linux-musl
out=$(<"$log")
_assert_contains "target: adds the requested rust target" \
  "rustup target add x86_64-unknown-linux-musl" "$out"
_assert_contains "target: still installs musl-tools" "musl-tools" "$out"

# --- Container runners have no sudo -----------------------------------------

log="$tmp/nosudo.log"
_run "$log" 0 0 RUNNER_OS=Linux
out=$(<"$log")
_assert_contains "no sudo: still installs musl-tools" "--no-install-recommends musl-tools" "$out"
_assert_contains "no sudo: keeps debconf noninteractive" \
  "apt-get noninteractive -o" "$out"
_assert_missing "no sudo: does not invoke sudo" "sudo " "$out"

# A hung update must exercise the action's actual supervisor and stop setup
# before it tries the linker install or rustup.
log="$tmp/deadline.log"
_run "$log" 1 124 RUNNER_OS=Linux RUST_TARGET=x86_64-unknown-linux-musl \
  STUB_APT_HANG=1 PKG_RETRIES=1 PKG_COMMAND_TIMEOUT=1 PKG_COMMAND_KILL_AFTER=0.1
out=$(<"$log")
_assert_contains "deadline: starts apt update" "apt-get noninteractive -o" "$out"
_assert_contains "deadline: emits the package stall marker" "$PACKAGE_COMMAND_STALL_MARKER" "$out"
_assert_missing "deadline: skips linker installation" "musl-tools" "$out"
_assert_missing "deadline: skips rustup" "rustup" "$out"

# --- Non-Linux is a no-op ---------------------------------------------------

# musl targets only exist on Linux. The action stays safe to call from a matrix
# row that also covers macOS.
log="$tmp/macos.log"
_run "$log" 1 0 RUNNER_OS=macOS
out=$(<"$log")
_assert_missing "macos: installs nothing" "apt-get" "$out"
_assert_contains "macos: says why it skipped" "skipping on macOS" "$out"

printf '\n%d passed, %d failed\n' "$_passes" "$_failures"
[[ "$_failures" -eq 0 ]]

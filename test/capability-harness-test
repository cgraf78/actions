#!/usr/bin/env bash

# Contract coverage for the capability test harness that Dot overlay
# repositories vendor into test/lib. Every consumer inherits these bytes, so
# the edge cases live here instead of being re-tested in each overlay; the
# overlays' own runs then exercise the vendored copies on the full matrix.

set -uo pipefail

if [[ ${1:-} == --dot-latest-loopback ]]; then
  # Use real curl and its normal redirect handling without contacting GitHub.
  # Keep -q first so a host's curlrc cannot change the request.
  # shellcheck disable=SC2329 # The latest-release resolver calls this function.
  curl() {
    local disable_rc=$1
    shift
    command curl "$disable_rc" --noproxy '*' --cacert "$loopback_cert" \
      --connect-to "github.com:443:127.0.0.1:$loopback_port" "$@"
  }
  loopback_cert=$3 loopback_port=$4
  # shellcheck source=capability-harness/dot-release.sh
  . "$2"
  capability_dot_release_latest_tag cgraf78/dot
  exit $?
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Child shells below run with a stub-only PATH. A host startup file named by
# BASH_ENV would run first under that PATH and can fail or block before the
# code under test starts, so keep every child shell hermetic.
unset BASH_ENV ENV
harness="$root/capability-harness"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  printf 'capability-harness-test: %s\n' "$1" >&2
  exit 1
}

# Exercise the real release transport with only curl replaced.
(
  set -euo pipefail
  # shellcheck source=capability-harness/github-release.sh
  . "$harness/github-release.sh" || fail 'missing GitHub release transport'
  unset GH_TOKEN GITHUB_TOKEN
  mkdir "$tmp/release transport"
  download="$tmp/release transport/tar archive"
  log="$tmp/release transport/calls"
  fake_token=fixture-token
  case_url=https://github.com/owner/project/releases/download/v1/file%2Bname.tar

  # shellcheck disable=SC2329 # The shared transport invokes this seam.
  curl() {
    local output='' url='' config='' arg
    for arg; do
      [[ $arg != *"$fake_token"* ]] || return 90
    done
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --config)
          [[ $2 == - ]] || return 91
          config=$(cat)
          shift
          ;;
        --output)
          output=$2
          shift
          ;;
        https://*) url=$1 ;;
      esac
      shift
    done
    printf '%s\n' "$url" >>"$log"
    case "$url" in
      https://api.github.com/repos/owner/project/releases/tags/v1)
        [[ $config == *"Authorization: Bearer $fake_token"* ]] || return 92
        if [[ ${MOCK_RELEASE_STATUS:-200} != 200 ]]; then
          printf '%s' "$MOCK_RELEASE_STATUS"
          return 22
        fi
        printf '{"assets":[{"name":"file+name.tar","id":81}]}' >"$output"
        printf 200
        ;;
      https://api.github.com/repos/owner/project/releases/assets/81)
        [[ $config == *"Authorization: Bearer $fake_token"* ]] || return 93
        if [[ ${MOCK_ASSET_STATUS:-200} != 200 ]]; then
          printf '%s' "$MOCK_ASSET_STATUS"
          return "${MOCK_CURL_EXIT:-22}"
        fi
        printf '%s' verified >"$output"
        printf 200
        ;;
      "$case_url")
        [[ -z $config ]] || return 95
        if [[ ${MOCK_PUBLIC_STATUS:-200} != 200 ]]; then
          printf '%s' "$MOCK_PUBLIC_STATUS"
          return "${MOCK_CURL_EXIT:-22}"
        fi
        printf '%s' public >"$output"
        ;;
      *) return 96 ;;
    esac
  }

  run_download() {
    github_release_download owner/project v1 'file+name.tar' "$download" \
      --connect-timeout 1 --max-time 2 --retry 0
  }

  diagnostics=$(
    export GH_TOKEN=$fake_token GITHUB_TOKEN=other-fixture-token
    {
      set -x
      run_download
    } 2>&1
  )
  [[ $diagnostics != *"$fake_token"* && $(cat "$download") == verified ]] ||
    fail "authenticated transfer leaked credentials or returned unexpected bytes"
  [[ $(tail -n 1 "$log") == https://api.github.com/repos/owner/project/releases/assets/81 ]] ||
    fail "authenticated transfer did not request the REST asset"

  GH_TOKEN=$fake_token MOCK_RELEASE_STATUS=404 run_download
  [[ $(cat "$download") == public && $(tail -n 1 "$log") == "$case_url" ]] ||
    fail "unavailable cross-repo API did not fall back to the public asset"

  GH_TOKEN=$fake_token MOCK_ASSET_STATUS=403 run_download
  [[ $(cat "$download") == public && $(tail -n 1 "$log") == "$case_url" ]] ||
    fail "denied REST asset download did not fall back to the public asset"

  : >"$log"
  GITHUB_TOKEN='invalid config token' run_download
  [[ $(cat "$log") == "$case_url" ]] || fail "invalid token entered the REST API request"

  : >"$log"
  run_download
  [[ $(cat "$log") == "$case_url" ]] || fail "anonymous transfer used the REST API"

  : >"$log"
  rc=0
  GH_TOKEN=$fake_token MOCK_ASSET_STATUS=503 run_download || rc=$?
  [[ $rc == 22 && $(tail -n 1 "$log") == https://api.github.com/repos/owner/project/releases/assets/81 ]] ||
    fail "exhausted transport failure was hidden by a public download"

  # Some curl versions return exit zero with an error HTTP status when the
  # server's Retry-After would exceed the allowed retry window.
  rc=0
  GH_TOKEN=$fake_token MOCK_ASSET_STATUS=429 MOCK_CURL_EXIT=0 run_download || rc=$?
  [[ $rc == 22 ]] || fail "transport trusted curl exit zero over the REST response code"
  rc=0
  MOCK_PUBLIC_STATUS=503 MOCK_CURL_EXIT=0 run_download || rc=$?
  [[ $rc == 22 ]] || fail "transport trusted curl exit zero over the public response code"
  [[ -z $(find "$tmp/release transport" -name '*auth*') ]] ||
    fail "failed transfer left credentials in the fixture"
  [[ $(cat "$download") == public ]] ||
    fail "failed transfer replaced previously published bytes"
) || fail 'GitHub release transport failed'

# --- Executable self-tests ----------------------------------------------------

for entry in capability-fixture.sh suite-inventory.sh wait-github-state.sh; do
  [[ -x "$harness/$entry" ]] || fail "$entry must be executable"
  "$harness/$entry" --self-test || fail "$entry self-test failed"
done
for library in dot-release.sh github-release.sh workflow-contract.sh; do
  [[ ! -x "$harness/$library" ]] ||
    fail "$library is a sourced library and must not be executable"
done

# Consumers call self-tests from their own functions under strict mode. A
# cleanup trap that outlives its function would rerun in the caller with its
# local variable out of scope and abort under `set -u`.
for pair in capability-fixture.sh:capability_fixture_self_test \
  suite-inventory.sh:suite_inventory_self_test \
  wait-github-state.sh:wait_github_state_self_test; do
  out=$(bash -c 'set -euo pipefail; . "$1"; self_test=$2
    wrapper() { "$self_test"; echo wrapped; }
    wrapper
    [[ -z $(trap -p RETURN) ]] && echo trap-cleared' _ \
    "$harness/${pair%%:*}" "${pair#*:}" 2>&1) ||
    fail "${pair#*:} failed when called from a strict caller: $out"
  [[ "$out" == *wrapped*trap-cleared* ]] ||
    fail "${pair#*:} left a RETURN trap behind: $out"
done

# Bash's integer clock can tick between recording a start and polling an
# already-ready predicate. Advance it at that call to cover the boundary
# deterministically without delaying the predicate or replacing the poller.
out=$(bash -c 'set -euo pipefail; boundary_marker=$2; . "$1"
  eval "$(declare -f wait_github_state | sed '\''1s/wait_github_state/clock_boundary_poll/'\'')"
  wait_github_state() {
    local rc=0
    clock_boundary_poll "$@" || rc=$?
    if [[ $rc == 0 && ${3:-} == true ]]; then
      SECONDS=$((SECONDS + 1))
      printf applied >"$boundary_marker"
    fi
    return "$rc"
  }
  wait_github_state_self_test
  echo clock-boundary-passed' _ "$harness/wait-github-state.sh" "$tmp/clock-boundary" 2>&1) ||
  fail "ready-predicate self-test depends on the integer clock: $out"
[[ -f $tmp/clock-boundary ]] || fail 'ready-predicate clock boundary was not exercised'
[[ $out == *clock-boundary-passed* ]] ||
  fail 'ready-predicate self-test did not complete across the clock boundary'

# Sourced libraries must leave the caller's shell options alone. The overlay
# runners already choose strict mode; a library silently enabling it would
# change unrelated callers' error handling.
for library in capability-fixture.sh suite-inventory.sh wait-github-state.sh \
  dot-release.sh github-release.sh workflow-contract.sh; do
  opts=$(bash -c 'set +euo pipefail; . "$1"; printf "%s:%s" "$-" \
    "$(set -o | awk '"'"'$1 == "pipefail" { print $2 }'"'"')"' _ \
    "$harness/$library") || fail "sourcing $library failed"
  [[ "${opts%%:*}" != *e* && "${opts%%:*}" != *u* && "${opts#*:}" == off ]] ||
    fail "sourcing $library changed the caller's shell options: $opts"
done

# --- Capability fixture -------------------------------------------------------

fixture() {
  bash -c '. "$1"; shift; capability_fixture_create "$@"' _ \
    "$harness/capability-fixture.sh" "$@"
}

mkdir -p "$tmp/overlay"
rc=0
fixture relative/home "$tmp/overlay" 20-example.conf 2>/dev/null || rc=$?
[[ "$rc" == 2 ]] || fail "fixture accepted a relative home (rc $rc)"
rc=0
fixture "$tmp/home-no-descriptor" "$tmp/overlay" 2>/dev/null || rc=$?
[[ "$rc" == 2 ]] || fail "fixture accepted a missing descriptor (rc $rc)"
for descriptor in nvim.conf 2-nvim.conf 20-nvim 20-../x.conf 20-Nvim.conf; do
  rc=0
  fixture "$tmp/home-bad" "$tmp/overlay" "$descriptor" 2>/dev/null || rc=$?
  [[ "$rc" == 2 ]] || fail "fixture accepted descriptor $descriptor (rc $rc)"
done
[[ ! -e "$tmp/home-bad" ]] ||
  fail "fixture wrote files before rejecting its descriptor"
mkdir -p "$tmp/home-base/.dotfiles"
rc=0
fixture "$tmp/home-base" "$tmp/overlay" 20-example.conf 2>/dev/null || rc=$?
[[ "$rc" == 2 ]] || fail "fixture accepted a home with a base repository"

# A caller may already have created the extension root under a permissive
# umask. The fixture owns the trust boundary and must tighten it regardless.
mkdir -p "$tmp/home-open/.config/dot/extensions"
chmod 777 "$tmp/home-open/.config/dot/extensions"
fixture "$tmp/home-open" "$tmp/overlay" 30-example.conf ||
  fail "fixture failed over a pre-existing extension root"
mode=$(ls -ld "$tmp/home-open/.config/dot/extensions")
[[ "${mode:0:10}" == drwx------ ]] ||
  fail "fixture left a permissive extension root: ${mode:0:10}"
[[ $(<"$tmp/home-open/.config/dot/overlays.d/30-example.conf") == $'sync=none\npath='"$tmp/overlay" ]] ||
  fail "fixture wrote the wrong overlay descriptor"

# --- Suite inventory ----------------------------------------------------------

inventory_root="$tmp/inventory/home/.local/lib/dotfiles/tests"
mkdir -p "$inventory_root"
printf '#!/usr/bin/env bash\n' >"$inventory_root/alpha-test"
chmod +x "$inventory_root/alpha-test"
validate() {
  bash -c '. "$1"; validate_suite_inventory "$2" "$3" "$4"' _ \
    "$harness/suite-inventory.sh" "$inventory_root" "$1" "$tmp/inventory"
}
printf '# comment\n\nhome/.local/lib/dotfiles/tests/alpha-test\n' \
  >"$tmp/inventory/good"
[[ $(validate "$tmp/inventory/good") == alpha ]] ||
  fail "suite inventory did not print the declared suite name"
printf 'home/.local/lib/dotfiles/tests/../alpha-test\n' >"$tmp/inventory/bad"
validate "$tmp/inventory/bad" >/dev/null 2>&1 &&
  fail "suite inventory accepted a path outside the suite namespace"
printf 'home/.local/lib/dotfiles/tests/alpha-test\nhome/.local/lib/dotfiles/tests/missing-test\n' \
  >"$tmp/inventory/missing"
out=$(validate "$tmp/inventory/missing" 2>&1) &&
  fail "suite inventory accepted a missing suite"
[[ "$out" == *'missing executable suite'* ]] ||
  fail "suite inventory did not name the missing suite"

# --- Dot release --------------------------------------------------------------

stub_bin="$tmp/stub-bin"
assets="$tmp/assets"
mkdir -p "$stub_bin" "$assets"
# Resolve real tools first so the stubs below can shadow only curl and uname.
for tool in bash cat cp mkdir mktemp mv rm ls sed tar gzip sha256sum shasum awk dirname env; do
  tool_path=$(command -v "$tool" 2>/dev/null) || continue
  ln -s "$tool_path" "$stub_bin/$tool"
done
cat >"$stub_bin/curl" <<'EOF'
#!/usr/bin/env bash
# Serve release assets from a local directory and record each request.
set -euo pipefail
printf '%s\n' "$*" >>"$STUB_CURL_LOG"
url= out= head=false write_out=
while (($#)); do
  case $1 in
    -o | --output) out=$2; shift 2 ;;
    -w) write_out=$2; shift 2 ;;
    --connect-timeout | --max-time | --retry | --retry-delay | --retry-max-time | --proto | --proto-redir)
      shift 2
      ;;
    -fsSIL) head=true; shift ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
if [[ $head == true ]]; then
  [[ -n ${STUB_EFFECTIVE:-} ]] || exit 22
  case $write_out in
    '%{http_code} %{url_effective}') printf '%s' "${STUB_HTTP_STATUS:-200} $STUB_EFFECTIVE" ;;
    *) exit 98 ;;
  esac
  exit 0
fi
asset=$STUB_ASSETS/${url##*/}
[[ -f $asset ]] || exit 22
cp "$asset" "$out"
EOF
cat >"$stub_bin/uname" <<'EOF'
#!/usr/bin/env bash
case $1 in
  -s) printf '%s\n' "${STUB_UNAME_S:-Linux}" ;;
  -m) printf '%s\n' "${STUB_UNAME_M:-x86_64}" ;;
  -o) [[ -n ${STUB_UNAME_O:-} ]] || exit 1; printf '%s\n' "$STUB_UNAME_O" ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$stub_bin/curl" "$stub_bin/uname"
export STUB_CURL_LOG="$tmp/curl.log" STUB_ASSETS="$assets"

release_tag=20990101-000000-abcdef12
other_tag=20990202-000000-12345678
make_asset() {
  local tag=$1 platform=$2 extra=${3:-} staging
  staging=$(mktemp -d "$tmp/asset.XXXXXX")
  printf '#!/bin/sh\necho dot %s\n' "$tag" >"$staging/dot"
  chmod +x "$staging/dot"
  [[ -z "$extra" ]] || : >"$staging/$extra"
  tar -czf "$assets/dot-$tag-$platform.tar.gz" -C "$staging" .
  (cd "$assets" && if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "dot-$tag-$platform.tar.gz"
  else
    shasum -a 256 "dot-$tag-$platform.tar.gz"
  fi) >"$assets/dot-$tag-$platform.tar.gz.sha256"
}
make_asset "$release_tag" linux-x86_64-musl
make_asset "$other_tag" linux-x86_64-musl

# Run the composite's actual entry point in POSIX sh. Test atomic publication
# against a real digest so an integrity failure cannot replace an existing
# archive at the pathname that a subsequent workflow step will open.
(
  set -eu
  unset GH_TOKEN GITHUB_TOKEN
  export GITHUB_ACTION_PATH="$root/.github/actions/download-release-asset"
  export RELEASE_REPOSITORY=cgraf78/dot RELEASE_TAG="$release_tag"
  export RELEASE_ASSET=dot-$release_tag-linux-x86_64-musl.tar.gz
  export RELEASE_OUTPUT="$tmp/verified archive" RELEASE_MAX_TIME=3 RELEASE_RETRIES=0
  verify_release_asset() {
    PATH="$stub_bin:$PATH" RELEASE_SHA256="$1" sh "$GITHUB_ACTION_PATH/run.sh"
  }
  valid_sha=$(awk '{print $1}' "$assets/$RELEASE_ASSET.sha256")
  printf '%s' previous >"$RELEASE_OUTPUT"
  if verify_release_asset "$(printf '%064d' 0)"; then
    fail 'release action accepted incorrect SHA-256'
  fi
  [[ $(cat "$RELEASE_OUTPUT") == previous ]] ||
    fail 'release action replaced output before verifying SHA-256'
  verify_release_asset "$valid_sha" ||
    fail 'release action rejected valid SHA-256'
  grep -F -- '--retry-max-time 1' "$STUB_CURL_LOG" >/dev/null ||
    fail 'release action did not bound retry start times'
  cmp "$RELEASE_OUTPUT" "$assets/$RELEASE_ASSET" ||
    fail 'release action did not publish the verified bytes'
) || fail 'release action verification failed'

# Run one library function in a strict child shell with only the stubs on
# PATH, matching how consumer runners call it under `set -euo pipefail`.
release() {
  # shellcheck disable=SC2016 # The child shell expands its own arguments.
  env -u PREFIX PATH="$stub_bin" bash -c \
    'set -euo pipefail; . "$1"; shift; "$@"' _ "$harness/dot-release.sh" "$@"
}

platform_case() {
  local want=$1 got
  shift
  # shellcheck disable=SC2016 # The child shell expands its own arguments.
  got=$(env "$@" PATH="$stub_bin" bash -c \
    'set -euo pipefail; . "$1"; _capability_dot_release_platform' _ \
    "$harness/dot-release.sh" 2>/dev/null) || got=FAILED
  [[ "$got" == "$want" ]] || fail "platform for $* was $got, want $want"
}
platform_case linux-x86_64-musl -u PREFIX STUB_UNAME_S=Linux STUB_UNAME_M=x86_64
platform_case linux-aarch64-musl -u PREFIX STUB_UNAME_S=Linux STUB_UNAME_M=aarch64
platform_case macos-x86_64 -u PREFIX STUB_UNAME_S=Darwin STUB_UNAME_M=x86_64
platform_case macos-aarch64 -u PREFIX STUB_UNAME_S=Darwin STUB_UNAME_M=arm64
platform_case android-aarch64 -u PREFIX STUB_UNAME_S=Linux STUB_UNAME_M=aarch64 \
  STUB_UNAME_O=Android
platform_case android-x86_64 STUB_UNAME_S=Linux STUB_UNAME_M=x86_64 \
  PREFIX=/data/data/com.termux/files/usr
platform_case FAILED -u PREFIX STUB_UNAME_S=FreeBSD STUB_UNAME_M=x86_64
platform_case FAILED -u PREFIX STUB_UNAME_S=Linux STUB_UNAME_M=riscv64
platform_case FAILED STUB_UNAME_S=Linux STUB_UNAME_M=armv7l STUB_UNAME_O=Android

got=$(STUB_EFFECTIVE="https://github.com/cgraf78/dot/releases/tag/$release_tag" \
  release capability_dot_release_latest_tag cgraf78/dot) ||
  fail "latest-tag lookup failed on a valid redirect"
[[ "$got" == "$release_tag" ]] || fail "latest-tag lookup returned $got"
grep -F -e '--retry-all-errors' "$STUB_CURL_LOG" >/dev/null ||
  fail "latest-tag lookup does not retry transient failures"
grep -F -e '--connect-timeout 10 --max-time 30' "$STUB_CURL_LOG" >/dev/null ||
  fail "latest-tag lookup does not bound each transfer"
out=$(STUB_EFFECTIVE=https://github.com/cgraf78/dot/releases \
  release capability_dot_release_latest_tag cgraf78/dot 2>&1) &&
  fail "latest-tag lookup accepted a repository without releases"
[[ "$out" == *'has no releases yet'* ]] ||
  fail "latest-tag lookup did not explain a missing release"
out=$(STUB_EFFECTIVE=https://github.com/cgraf78/dot/releases/tag/v1.0 \
  release capability_dot_release_latest_tag cgraf78/dot 2>&1) &&
  fail "latest-tag lookup accepted a tag outside the release grammar"
[[ "$out" == *'unexpected latest-release redirect'* ]] ||
  fail "latest-tag lookup did not explain an unexpected redirect"
for wrong_base in https://example.invalid/cgraf78/dot https://github.com/example/dot \
  https://github.com/cgraf78/dot/extra; do
  out=$(STUB_EFFECTIVE="$wrong_base/releases/tag/$release_tag" \
    release capability_dot_release_latest_tag cgraf78/dot 2>&1) &&
    fail "latest-tag lookup accepted a redirect outside the requested repository ($wrong_base)"
  [[ "$out" == *'unexpected latest-release redirect'* ]] ||
    fail "latest-tag lookup did not explain the redirect outside the requested repository"
done
out=$(STUB_HTTP_STATUS=429 STUB_EFFECTIVE="https://github.com/cgraf78/dot/releases/tag/$release_tag" \
  release capability_dot_release_latest_tag cgraf78/dot 2>&1) &&
  fail 'latest-tag lookup accepted HTTP 429 after curl reported success'
[[ "$out" == *'HTTP 429'* ]] || fail 'latest-tag lookup did not report HTTP 429'

# A real HTTPS redirect reaches a long Retry-After only at its final URL.
# Some curl releases report exit zero when that retry would exceed the budget.
python3 - "$root/test/capability-harness-test" "$harness/dot-release.sh" "$tmp" "$release_tag" <<'PY' ||
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import ssl
import subprocess
import sys
from threading import Thread

runner, library, temp, tag = sys.argv[1:]
cert = Path(temp) / "loopback.pem"
key = Path(temp) / "loopback.key"
config = Path(temp) / "loopback.cnf"
config.write_text("[req]\nprompt = no\ndistinguished_name = dn\nx509_extensions = x509\n"
                  "[dn]\nCN = github.com\n[x509]\nsubjectAltName = DNS:github.com\n")
subprocess.run(["openssl", "req", "-x509", "-nodes", "-newkey", "rsa:2048", "-config", config,
                "-keyout", key, "-out", cert],
               check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

class Latest(BaseHTTPRequestHandler):
    def do_HEAD(self):
        if self.path == "/cgraf78/dot/releases/latest":
            self.send_response(302)
            self.send_header("Location", f"/cgraf78/dot/releases/tag/{tag}")
        else:
            self.send_response(self.server.final_status)
            self.send_header("Retry-After", "900")
        self.end_headers()

    def log_message(self, *_):
        pass

with ThreadingHTTPServer(("127.0.0.1", 0), Latest) as server:
    tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    tls.load_cert_chain(cert, key)
    server.socket = tls.wrap_socket(server.socket, server_side=True)
    thread = Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        command = ["bash", runner, "--dot-latest-loopback", library, cert,
                   str(server.server_port)]
        server.final_status = 200
        good = subprocess.run(command, capture_output=True, text=True, timeout=10)
        assert good.returncode == 0 and good.stdout.strip() == tag, good

        server.final_status = 429
        bad = subprocess.run(command, capture_output=True, text=True, timeout=10)
        assert bad.returncode != 0 and not bad.stdout and "HTTP 429" in bad.stderr, bad
    finally:
        server.shutdown()
        thread.join()
PY
  fail 'real curl latest-release redirect test failed'

# The default request floats to the newest release once per run.
: >"$STUB_CURL_LOG"
STUB_EFFECTIVE="https://github.com/cgraf78/dot/releases/tag/$release_tag" \
  release capability_dot_release_install "$tmp/dot-latest" ||
  fail "default install failed"
[[ $("$tmp/dot-latest/dot") == "dot $release_tag" ]] ||
  fail "default install did not extract the latest release"
grep -F 'https://github.com/cgraf78/dot/releases/latest' "$STUB_CURL_LOG" >/dev/null ||
  fail "default install did not resolve the latest release"

# An explicit tag selects that exact release without a latest lookup.
: >"$STUB_CURL_LOG"
DOT_TEST_DOT_RELEASE_TAG=$other_tag \
  release capability_dot_release_install "$tmp/dot-explicit" ||
  fail "explicit-tag install failed"
[[ $("$tmp/dot-explicit/dot") == "dot $other_tag" ]] ||
  fail "explicit-tag install extracted the wrong release"
if grep -F 'releases/latest' "$STUB_CURL_LOG" >/dev/null; then
  fail "explicit-tag install still resolved the latest release"
fi

out=$(DOT_TEST_DOT_RELEASE_TAG=latest-ish \
  release capability_dot_release_install "$tmp/dot-bad-tag" 2>&1) &&
  fail "install accepted a malformed explicit tag"
[[ "$out" == *'invalid Dot test release tag'* ]] ||
  fail "install did not explain a malformed tag"
for repo in 'dot' 'cgraf78/dot/extra' '../dot' 'cgraf78/' 'cg raf/dot'; do
  out=$(DOT_TEST_DOT_RELEASE_REPO=$repo DOT_TEST_DOT_RELEASE_TAG=$release_tag \
    release capability_dot_release_install "$tmp/dot-bad-repo" 2>&1) &&
    fail "install accepted repository $repo"
  [[ "$out" == *'invalid Dot test release repository'* ]] ||
    fail "install did not explain invalid repository $repo"
done

mkdir -p "$tmp/dot-nonempty"
: >"$tmp/dot-nonempty/keep"
out=$(DOT_TEST_DOT_RELEASE_TAG=$release_tag \
  release capability_dot_release_install "$tmp/dot-nonempty" 2>&1) &&
  fail "install extracted into a nonempty destination"
[[ "$out" == *'refusing to extract into a nonempty directory'* ]] ||
  fail "install did not explain a nonempty destination"

# A failed fetch must report its own error and return cleanly through the
# public wrapper. A stale RETURN trap would instead rerun cleanup with its
# local variable out of scope and abort the caller with `unbound variable`.
printf '0000  dot-%s-linux-x86_64-musl.tar.gz\n' "$release_tag" \
  >"$assets/dot-$release_tag-linux-x86_64-musl.tar.gz.sha256"
# shellcheck disable=SC2016 # The child shell expands its own arguments.
out=$(DOT_TEST_DOT_RELEASE_TAG=$release_tag release bash -c \
  'set -u; . "$1"; capability_dot_release_install "$2" || echo returned-cleanly' _ \
  "$harness/dot-release.sh" "$tmp/dot-mismatch" 2>&1)
[[ "$out" == *'checksum mismatch for'* ]] ||
  fail "install did not reject a checksum mismatch: $out"
[[ "$out" == *returned-cleanly* && "$out" != *'unbound variable'* ]] ||
  fail "failed fetch did not return cleanly through the wrapper: $out"
[[ ! -e "$tmp/dot-mismatch/dot" ]] ||
  fail "install extracted an archive that failed its checksum"

# Restore a valid sidecar, then cover both checksum tools and their absence
# with PATH variants that hide the other tool.
make_asset "$release_tag" linux-x86_64-musl
staged_name=dot-$release_tag-linux-x86_64-musl.tar.gz
staged_path=$tmp/staged/$staged_name
sidecar=$assets/$staged_name.sha256
record=$(cat "$sidecar")
digest=${record%% *}
# A stage is only the verified archive. Extraction is a separate operation
# so the worker need not receive download credentials.
printf '%s *%s\n' "$digest" "$staged_name" >"$sidecar"
staged=$(DOT_TEST_DOT_RELEASE_TAG=$release_tag \
  release capability_dot_release_stage "$tmp/staged") ||
  fail "could not stage the verified Dot archive"
[[ "$staged" == /* && "$staged" -ef "$staged_path" && ! -e "$tmp/staged/dot" ]] ||
  fail "Dot stage extracted instead of returning the archive"
cmp "$assets/$staged_name" "$staged" || fail "staged archive changed"
release capability_dot_release_extract "$staged" "$tmp/dot-staged" ||
  fail "could not extract the staged Dot archive"
[[ -x "$tmp/dot-staged/dot" ]] || fail "staged archive has no executable Dot"

for bad in wrong-file duplicate; do
  case $bad in
    wrong-file) printf '%s  %s\n' "$digest" "$assets/$staged_name" ;;
    duplicate) printf '%s\n' "$record" "$record" ;;
  esac >"$sidecar"
  out=$(DOT_TEST_DOT_RELEASE_TAG=$release_tag \
    release capability_dot_release_stage "$tmp/staged-$bad" 2>&1) &&
    fail "Dot stage accepted $bad checksum record"
  [[ "$out" == *'checksum mismatch for'* ]] ||
    fail "stage did not explain the rejected checksum for $bad"
  [[ ! -e "$tmp/staged-$bad/$staged_name" ]] ||
    fail "failed checksum published an archive for $bad"
done
printf '%s\n' "$record" >"$sidecar"

for sum_tool in sha256sum shasum; do
  sum_path=$(command -v "$sum_tool" 2>/dev/null) || continue
  sum_bin="$tmp/stub-$sum_tool"
  cp -R "$stub_bin" "$sum_bin"
  rm -f "$sum_bin/sha256sum" "$sum_bin/shasum"
  ln -s "$sum_path" "$sum_bin/$sum_tool"
  # shellcheck disable=SC2016 # The child shell expands its own arguments.
  env -u PREFIX PATH="$sum_bin" DOT_TEST_DOT_RELEASE_TAG=$release_tag bash -c \
    'set -euo pipefail; . "$1"; capability_dot_release_install "$2"' _ \
    "$harness/dot-release.sh" "$tmp/dot-$sum_tool" ||
    fail "install failed with only $sum_tool available"
  [[ -x "$tmp/dot-$sum_tool/dot" ]] ||
    fail "install with only $sum_tool did not extract the release"
done
nosum_bin="$tmp/stub-nosum"
cp -R "$stub_bin" "$nosum_bin"
rm -f "$nosum_bin/sha256sum" "$nosum_bin/shasum"
# shellcheck disable=SC2016 # The child shell expands its own arguments.
out=$(env -u PREFIX PATH="$nosum_bin" DOT_TEST_DOT_RELEASE_TAG=$release_tag bash -c \
  'set -euo pipefail; . "$1"; capability_dot_release_install "$2"' _ \
  "$harness/dot-release.sh" "$tmp/dot-nosum" 2>&1) &&
  fail "install succeeded without any checksum tool"
[[ "$out" == *'sha256sum or shasum is required'* ]] ||
  fail "install did not explain the missing checksum tool"

out=$(DOT_TEST_DOT_RELEASE_TAG=20990303-000000-00000000 \
  release capability_dot_release_install "$tmp/dot-missing" 2>&1) &&
  fail "install succeeded without a published asset"
[[ "$out" == *'could not download'* ]] ||
  fail "install did not explain a missing asset"

make_asset 20990404-000000-aaaaaaaa linux-x86_64-musl .shdeps-release-layout
out=$(DOT_TEST_DOT_RELEASE_TAG=20990404-000000-aaaaaaaa \
  release capability_dot_release_install "$tmp/dot-marker" 2>&1) &&
  fail "install accepted an archive with the reserved shdeps marker"
[[ "$out" == *'reserved shdeps marker'* ]] ||
  fail "install did not explain the reserved shdeps marker"

# --- Workflow contract --------------------------------------------------------

# Evaluate SNIPPET in a strict child shell from DIR after sourcing the
# library, matching how an overlay's workflow-test sources it after
# `cd "$repo_root"`.
contract() {
  local dir=$1 snippet=$2
  # shellcheck disable=SC2016 # The child shell expands its own arguments.
  (cd "$dir" && env -u GITHUB_REPOSITORY bash -c \
    'set -euo pipefail; . "$1"; eval "$2"' _ \
    "$harness/workflow-contract.sh" "$snippet")
}

name_case() {
  local want=$1 got
  shift
  # shellcheck disable=SC2016 # The child shell expands its own arguments.
  got=$(bash -c '. "$1"; shift; workflow_contract_repo_name "$@"' _ \
    "$harness/workflow-contract.sh" "$@")
  [[ "$got" == "$want" ]] || fail "repo name for $* was $got, want $want"
}
name_case dotfiles-dev /tmp/project cgraf78/dotfiles-dev \
  git@github.com:cgraf78/other.git
name_case dotfiles-dev /tmp/project '' git@github.com:cgraf78/dotfiles-dev.git
name_case dotfiles-nvim /tmp/project '' https://github.com/cgraf78/dotfiles-nvim
name_case project /tmp/project '' ''

overlay="$tmp/contract/branch-named-checkout"
mkdir -p "$overlay"
git -C "$overlay" init --quiet --template=''
git -C "$overlay" remote add origin git@github.com:cgraf78/dotfiles-example.git
cp "$root/LICENSE" "$overlay/LICENSE"
printf '.worktrees/\n' >"$overlay/.gitignore"

contract "$overlay" 'workflow_contract_init dotfiles-example' ||
  fail "init rejected the origin-derived repository name"
out=$(contract "$overlay" 'workflow_contract_init dotfiles-other' 2>&1) &&
  fail "init accepted an unexpected repository name"
[[ "$out" == 'workflow-test: unexpected repository name: dotfiles-example' ]] ||
  fail "init did not name the unexpected repository: $out"
out=$(GITHUB_REPOSITORY=cgraf78/dotfiles-ci bash -c \
  '. "$1"; cd "$2"; workflow_contract_init dotfiles-ci; echo "$WORKFLOW_CONTRACT_REPO"' _ \
  "$harness/workflow-contract.sh" "$overlay" 2>&1) ||
  fail "init ignored GitHub's repository identity: $out"
git -C "$overlay" remote remove origin
out=$(contract "$overlay" 'workflow_contract_init branch-named-checkout' 2>&1) ||
  fail "init without origin did not fall back to the checkout name: $out"
git -C "$overlay" remote add origin git@github.com:cgraf78/dotfiles-example.git

contract "$overlay" 'workflow_contract_count_run' ||
  fail "count_run failed without a counter file"
WORKFLOW_TEST_COUNT_FILE="$tmp/contract/count" contract "$overlay" \
  'workflow_contract_count_run; workflow_contract_count_run'
[[ $(<"$tmp/contract/count") == 2 ]] || fail "count_run did not increment its counter"

contract "$overlay" 'workflow_contract_check_files' ||
  fail "check_files rejected the canonical LICENSE and .gitignore"
printf 'extra\n' >>"$overlay/.gitignore"
out=$(contract "$overlay" 'workflow_contract_check_files' 2>&1) &&
  fail "check_files accepted an extended .gitignore"
[[ "$out" == *'.gitignore must contain only .worktrees/'* ]] ||
  fail "check_files did not explain the .gitignore drift"
printf '.worktrees/\n' >"$overlay/.gitignore"
printf ' ' >>"$overlay/LICENSE"
out=$(contract "$overlay" 'workflow_contract_check_files' 2>&1) &&
  fail "check_files accepted altered LICENSE bytes"
[[ "$out" == *'LICENSE bytes differ'* ]] ||
  fail "check_files did not explain the LICENSE drift"
cp "$root/LICENSE" "$overlay/LICENSE"

printf '# type<TAB>path\nprogram\ttest/run\n\nprogram\ttest/lib/x.sh\n' \
  >"$overlay/inventory"
contract "$overlay" 'workflow_contract_check_inventory_programs inventory' ||
  fail "inventory check rejected program-only rows"
printf 'fixture\ttest/run\n' >>"$overlay/inventory"
out=$(contract "$overlay" 'workflow_contract_check_inventory_programs inventory' 2>&1) &&
  fail "inventory check accepted an unlinted fixture row"
[[ "$out" == *'not a linted program: fixture test/run'* ]] ||
  fail "inventory check did not name the fixture row: $out"
out=$(contract "$overlay" 'workflow_contract_check_inventory_programs missing' 2>&1) &&
  fail "inventory check accepted a missing inventory"

# A stub gh answers from environment knobs so each remote rule fails alone.
gh_bin="$tmp/contract/gh-bin"
mkdir -p "$gh_bin"
cat >"$gh_bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "$*" in
  *'--jq .visibility'*) printf '%s\n' "${STUB_GH_VISIBILITY:-public}" ;;
  *'--jq .default_branch'*) printf '%s\n' "${STUB_GH_BRANCH:-main}" ;;
  *'--jq .license.spdx_id'*) printf '%s\n' "${STUB_GH_LICENSE:-MIT}" ;;
  *'contents/LICENSE'*) base64 <"$STUB_GH_LICENSE_FILE" ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$gh_bin/gh"
remote() {
  PATH="$gh_bin:$PATH" STUB_GH_LICENSE_FILE="${STUB_GH_LICENSE_FILE:-$root/LICENSE}" \
    contract "$overlay" "workflow_contract_init dotfiles-example; $1"
}
remote workflow_contract_remote_predicate ||
  fail "remote predicate rejected a conforming repository"
for knob in STUB_GH_VISIBILITY=private STUB_GH_BRANCH=master STUB_GH_LICENSE=Apache-2.0; do
  out=$(
    export "${knob?}"
    remote workflow_contract_remote_predicate 2>&1
  ) &&
    fail "remote predicate accepted $knob"
  [[ "$out" == workflow-test:* ]] || fail "remote predicate did not explain $knob: $out"
done
printf 'different\n' >"$tmp/contract/other-license"
out=$(STUB_GH_LICENSE_FILE="$tmp/contract/other-license" \
  remote workflow_contract_remote_predicate 2>&1) &&
  fail "remote predicate accepted a different published LICENSE"
[[ "$out" == *'remote license differs from the tested checkout'* ]] ||
  fail "remote predicate did not explain the LICENSE mismatch"
# Failed attempts must not leave downloads behind; polling retries them.
leak_tmp="$tmp/contract/leak-tmp"
mkdir -p "$leak_tmp"
TMPDIR="$leak_tmp" STUB_GH_LICENSE_FILE="$tmp/contract/other-license" \
  remote workflow_contract_remote_predicate >/dev/null 2>&1 &&
  fail "remote predicate accepted a different published LICENSE"
# Look only for the predicate's own download: host tools such as a git
# wrapper may legitimately write other files under TMPDIR.
[[ -z $(find "$leak_tmp" -name target-LICENSE -print) ]] ||
  fail "failed remote predicate leaked its download"
# Without gh on PATH the predicate must say so. GitHub's identity supplies the
# repository name because the stub-only PATH has no git either.
# shellcheck disable=SC2016 # The child shell expands its own arguments.
out=$(cd "$overlay" && PATH="$stub_bin" GITHUB_REPOSITORY=cgraf78/dotfiles-example \
  bash -c 'set -euo pipefail; . "$1"; workflow_contract_init dotfiles-example
    workflow_contract_remote_predicate' _ "$harness/workflow-contract.sh" 2>&1) &&
  fail "remote predicate passed without gh"
[[ "$out" == *'gh is required for remote validation'* ]] ||
  fail "remote predicate did not explain the missing gh: $out"

# The predicate is called from a strict caller's function; its cleanup trap
# must not survive to rerun there with its local variable out of scope.
# shellcheck disable=SC2016 # The child shell evaluates this snippet.
out=$(remote 'wrapper() { workflow_contract_remote_predicate; echo wrapped; }
  wrapper; [[ -z $(trap -p RETURN) ]] && echo trap-cleared' 2>&1) ||
  fail "remote predicate failed from a strict caller: $out"
[[ "$out" == *wrapped*trap-cleared* ]] ||
  fail "remote predicate left a RETURN trap behind: $out"

out=$(remote 'workflow_contract_dispatch_predicate --remote; echo continued' 2>&1) ||
  fail "dispatch failed a non-predicate argument: $out"
[[ "$out" == continued ]] || fail "dispatch did not return for other arguments: $out"
out=$(remote 'workflow_contract_dispatch_predicate --remote-predicate; echo continued' 2>&1) ||
  fail "dispatch failed the predicate mode: $out"
[[ "$out" != *continued* ]] || fail "dispatch did not exit after the predicate"

# Polling resolves the vendored poller beside the library, not from the cwd,
# and re-runs the contract script until it reports ready.
cat >"$tmp/contract/script" <<'EOF'
#!/usr/bin/env bash
[[ ${1:-} == --remote-predicate ]] || exit 9
state=${0%/*}/attempts
count=0
[[ ! -f $state ]] || count=$(<"$state")
printf '%s\n' "$((count + 1))" >"$state"
((count >= 1))
EOF
chmod +x "$tmp/contract/script"
contract "$tmp" "workflow_contract_poll_remote '$tmp/contract/script'" >/dev/null ||
  fail "poll_remote did not wait for a predicate that becomes ready"
[[ $(<"$tmp/contract/attempts") == 2 ]] ||
  fail "poll_remote did not retry the predicate"

printf 'capability-harness-test: ok\n'

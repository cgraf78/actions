#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH='' cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=.github/actions/package-manager/lib.sh
. "$root/.github/actions/package-manager/lib.sh"
# shellcheck source=.github/actions/shared/infra-stall-markers.sh
. "$root/.github/actions/shared/infra-stall-markers.sh"

[[ $PKG_COMMAND_TIMEOUT -eq 120 ]]

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# shellcheck source=test/fixture-env.sh
. "$root/test/fixture-env.sh"
actions_fixture_path "$tmp"

APT_MIRROR_LIST="$tmp/apt-mirrors.txt"
cat >"$APT_MIRROR_LIST" <<'EOF'
http://azure.archive.ubuntu.com/ubuntu
https://archive.ubuntu.com/ubuntu
EOF
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]

printf '%s\n' 'https://deb.debian.org/debian' >"$APT_MIRROR_LIST"
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == https://deb.debian.org/debian ]]

# AWS-hosted runners ship an EC2 regional mirrorlist instead of Azure's.
# The same stall applies: the mirror accepts connections but trickles, so
# the install dies on the bounded timeout. It must be replaced the same way.
printf '%s\n' 'http://us-east-2.ec2.archive.ubuntu.com/ubuntu' \
  >"$APT_MIRROR_LIST"
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]

# The same class covers GCE regional mirrors and port-qualified entries:
# the guard matches the cloud host, not the URL path.
printf '%s\n' 'http://us-central1.gce.archive.ubuntu.com/ubuntu' \
  >"$APT_MIRROR_LIST"
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]
printf '%s\n' 'http://us-east-2.ec2.archive.ubuntu.com:80/ubuntu' \
  >"$APT_MIRROR_LIST"
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]

# A mirrorlist already pointing at the official archive stays intact. The
# fixture carries a second entry so a guard firing on it (collapsing the
# file to the single archive line) fails the assertion instead of passing
# vacuously: rewriting an already-official file is a content no-op.
cat >"$APT_MIRROR_LIST" <<'EOF'
https://archive.ubuntu.com/ubuntu
https://deb.debian.org/debian
EOF
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == $'https://archive.ubuntu.com/ubuntu\nhttps://deb.debian.org/debian' ]]

# Official country mirrors are not cloud mirrors: they stay intact.
printf '%s\n' 'http://fr.archive.ubuntu.com/ubuntu' >"$APT_MIRROR_LIST"
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == http://fr.archive.ubuntu.com/ubuntu ]]

# Exercise retry_pkg with real deadlines and signals before the stubbed
# package-policy cases below. Neither PATH contains a package manager.
mkdir "$tmp/native" "$tmp/python"
for tool in ln mktemp rm sh sleep; do
  executable=$(type -P "$tool")
  ln -s "$executable" "$tmp/native/$tool"
  ln -s "$executable" "$tmp/python/$tool"
done
if executable=$(type -P setsid); then
  ln -s "$executable" "$tmp/native/setsid"
fi
ln -s "$(type -P python3)" "$tmp/python/python3"

cat >"$tmp/package-command" <<'EOF'
#!/bin/sh
case "$1" in
  exit-*) exit "${1#exit-}" ;;
  term-success) trap 'exit 0' TERM ;;
  ignore-term)
    trap '' TERM
    exec sleep 30
    ;;
  late-success)
    sleep 0.6
    exit 0
    ;;
  term-success-with-child)
    sh -c 'trap "" TERM; printf "%s\n" "$$" >"$1"; exec sleep 30' fixture "$2" &
    trap 'exit 0' TERM
    ;;
esac
while :; do sleep 0.02; done
EOF
chmod +x "$tmp/package-command"

mkdir "$tmp/slow-observer"
cat >"$tmp/slow-observer/sleep" <<'EOF'
#!/bin/sh
# Let the deadline and the later success both happen before the
# supervisor gets its next chance to observe either one.
case "$1" in
  0.05) exec "$REAL_SLEEP" 1.25 ;;
  *) exec "$REAL_SLEEP" "$@" ;;
esac
EOF
chmod +x "$tmp/slow-observer/sleep"

check_deadline() {
  local backend=$1 scenario=$2 expected=$3
  local status=0 pid state failed=0
  local err=$tmp/$backend-$scenario.err child_pid=$tmp/$backend-$scenario.pid
  local fixture_path=$tmp/$backend timeout=1
  if [[ $scenario == late-success ]]; then
    fixture_path="$tmp/slow-observer:$fixture_path"
    timeout=0.25
  fi
  # Use the same POSIX shell as the prereq action entrypoints.
  # shellcheck disable=SC2016 # The fresh shell expands its own arguments.
  REAL_SLEEP="$tmp/$backend/sleep" PATH="$fixture_path" PKG_RETRIES=1 \
    PKG_COMMAND_TIMEOUT="$timeout" PKG_COMMAND_KILL_AFTER=0.1 \
    sh -eu -c '. "$1"; shift; retry_pkg "$@"' test-package-manager \
    "$root/.github/actions/package-manager/lib.sh" \
    "$tmp/package-command" "$scenario" "$child_pid" 2>"$err" || status=$?
  if [[ $status -ne $expected ]]; then
    printf 'package-manager-test: %s/%s: expected status %s, got %s\n' \
      "$backend" "$scenario" "$expected" "$status" >&2
    failed=1
  fi
  if [[ $scenario == exit-* ]]; then
    if grep -Fq "$PACKAGE_COMMAND_STALL_MARKER" "$err"; then
      printf 'package-manager-test: %s/%s: native failure was infrastructure-classified\n' \
        "$backend" "$scenario" >&2
      failed=1
    fi
  elif ! grep -Fxq "$PACKAGE_COMMAND_STALL_MARKER" "$err"; then
    printf 'package-manager-test: %s/%s: deadline marker missing\n' "$backend" "$scenario" >&2
    failed=1
  fi
  if [[ $scenario == term-success-with-child ]]; then
    if ! read -r pid <"$child_pid"; then
      printf 'package-manager-test: %s/%s: descendant never started\n' "$backend" "$scenario" >&2
      return 1
    fi
    # The kernel can briefly keep a killed orphan as an init-owned zombie.
    # A live descendant here can hold package locks into the retry.
    state=$(ps -o stat= -p "$pid" 2>/dev/null || true)
    if [[ -n $state && $state != Z* ]]; then
      kill -KILL "$pid" 2>/dev/null || true
      printf 'package-manager-test: %s/%s: descendant %s survived the deadline\n' \
        "$backend" "$scenario" "$pid" >&2
      failed=1
    fi
  fi
  return "$failed"
}

deadline_failures=0
for backend in native python; do
  if [[ $backend == native && ! -x $tmp/native/setsid ]]; then
    continue
  fi
  check_deadline "$backend" term-success 124 || deadline_failures=1
  check_deadline "$backend" ignore-term 124 || deadline_failures=1
  check_deadline "$backend" term-success-with-child 124 || deadline_failures=1
  check_deadline "$backend" exit-124 124 || deadline_failures=1
  check_deadline "$backend" exit-137 137 || deadline_failures=1
  # The supervisor's classification FD must leave stdin and stdout usable.
  # shellcheck disable=SC2016 # The fixture reads its own input.
  received=$(printf 'package input\n' |
    PATH="$tmp/$backend" bounded sh -c 'IFS= read -r line; printf "%s\n" "$line"')
  [[ $received == 'package input' ]]
done
check_deadline python late-success 124 || deadline_failures=1
[[ $deadline_failures -eq 0 ]]

python3 "$root/test/package-step-test.py" "$root" "$tmp"

sleep() { :; }

# Log invocations so retry-path behavior (including dpkg recovery) can be
# asserted without touching the real package manager.
bounded() {
  printf '%s\n' "$*" >>"$tmp/bounded.calls"
  # The stub models the supervisor event separately from the child status.
  # shellcheck disable=SC2034
  _pkg_deadline=${BOUNDED_DEADLINE:-}
  return "$BOUNDED_STATUS"
}

# Recovery calls `bounded $SUDO env DEBIAN_FRONTEND=noninteractive dpkg
# --configure -a`; SUDO= keeps the call in-process and the `bounded` stub
# only logs it, so the real dpkg never runs in this test.
# shellcheck disable=SC2034
SUDO=
: >"$tmp/bounded.calls"

cat >"$APT_MIRROR_LIST" <<'EOF'
http://azure.archive.ubuntu.com/ubuntu
https://archive.ubuntu.com/ubuntu
EOF
BOUNDED_STATUS=0
retry_pkg sudo apt-get update
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]

# The retry path must rewrite the EC2 mirrorlist too: `apt-get update` is
# the only call that runs the mirror guard, so an install that follows it
# inherits the official archive.
printf '%s\n' 'http://us-east-2.ec2.archive.ubuntu.com/ubuntu' \
  >"$APT_MIRROR_LIST"
BOUNDED_STATUS=0
retry_pkg sudo apt-get update
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]

# Sourced retry_pkg consumes this public library setting.
# shellcheck disable=SC2034
PKG_RETRIES=2
BOUNDED_STATUS=100
if retry_pkg apt-get install >"$tmp/semantic.out" 2>"$tmp/semantic.err"; then
  echo 'package-manager-test: semantic failure unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 100 ]]
if grep -Fq 'infra-stall:' "$tmp/semantic.err"; then
  echo 'package-manager-test: semantic failure was infrastructure-classified' >&2
  exit 1
fi

# `apt-get update` installs nothing. In the prereq actions its sources
# are runner-owned, so an exhausted exit 100 is classified as
# infrastructure: a mirror answering with a 5xx page instead of
# stalling to the deadline must carry the same stall token, or the
# retry controller cannot recover it. This deliberately covers a
# permanent update failure too; the controller reruns at most once
# and it stays red after that. Any other update exit keeps its native
# status. Exercise the real invocation shape, with the `sudo` prefix
# and transport options the prereq actions pass.
BOUNDED_STATUS=100
if retry_pkg sudo env DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=3 update >"$tmp/update100.out" 2>"$tmp/update100.err"; then
  echo 'package-manager-test: update failure unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 100 ]]
grep -Fxq "$PACKAGE_COMMAND_STALL_MARKER" "$tmp/update100.err"

BOUNDED_STATUS=1
if retry_pkg apt-get update >"$tmp/update1.out" 2>"$tmp/update1.err"; then
  echo 'package-manager-test: update usage failure unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 1 ]]
if grep -Fq 'infra-stall:' "$tmp/update1.err"; then
  echo 'package-manager-test: update usage failure was infrastructure-classified' >&2
  exit 1
fi

BOUNDED_STATUS=124 BOUNDED_DEADLINE=deadline
if retry_pkg apt-get update >"$tmp/timeout.out" 2>"$tmp/timeout.err"; then
  echo 'package-manager-test: timeout unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 124 ]]
# The POSIX library cannot locate the shared marker file, so it prints the
# literal; this binds that copy to the token infra-retry classifies.
grep -Fxq "$PACKAGE_COMMAND_STALL_MARKER" "$tmp/timeout.err"

# A bounded-timeout kill can interrupt dpkg mid-unpack; the next install
# attempt then fails with exit 100 ("dpkg was interrupted") unless the retry
# recovers with `dpkg --configure -a` first. The recovery itself goes through
# `bounded` so it cannot hang the retry loop on a wedged dpkg lock.
: >"$tmp/bounded.calls"
BOUNDED_STATUS=124
if retry_pkg apt-get install -y bash git curl >"$tmp/recover.out" 2>"$tmp/recover.err"; then
  echo 'package-manager-test: install retry unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 124 ]]
# Recovery shares the noninteractive frontend with installs, so configuring
# packages in a container prints no debconf fallback warnings.
[[ $(grep -c -- '^env DEBIAN_FRONTEND=noninteractive dpkg --configure -a$' \
  "$tmp/bounded.calls") -eq 1 ]]

# apt-get update never touches dpkg, so no recovery runs for it.
: >"$tmp/bounded.calls"
BOUNDED_STATUS=124
if retry_pkg apt-get update >/dev/null 2>&1; then
  echo 'package-manager-test: update retry unexpectedly passed' >&2
  exit 1
fi
if grep -Fq -- 'dpkg' "$tmp/bounded.calls"; then
  echo 'package-manager-test: dpkg recovery ran for apt-get update' >&2
  exit 1
fi

printf 'package-manager-test: ok\n'

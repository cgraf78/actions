#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=.github/actions/package-manager/lib.sh
. "$root/.github/actions/package-manager/lib.sh"

[[ $PKG_COMMAND_TIMEOUT -eq 120 ]]

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

APT_MIRROR_LIST="$tmp/apt-mirrors.txt"
cat >"$APT_MIRROR_LIST" <<'EOF'
http://azure.archive.ubuntu.com/ubuntu
https://archive.ubuntu.com/ubuntu
EOF
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]

printf '%s\n' 'https://deb.debian.org/debian' >"$APT_MIRROR_LIST"
configure_ubuntu_archive_mirror
[[ $(<"$APT_MIRROR_LIST") == https://deb.debian.org/debian ]]

sleep() { :; }

# Log invocations so retry-path behavior (including dpkg recovery) can be
# asserted without touching the real package manager.
bounded() {
  printf '%s\n' "$*" >>"$tmp/bounded.calls"
  return "$BOUNDED_STATUS"
}

# Recovery calls `bounded $SUDO env DEBIAN_FRONTEND=noninteractive dpkg
# --configure -a`; SUDO= keeps the call in-process and the `bounded` stub
# only logs it, so the real dpkg never runs in this test.
# shellcheck disable=SC2034
SUDO=
: >"$tmp/bounded.calls"

cat >"$APT_MIRROR_LIST" <<'EOF'
http://azure.archive.ubuntu.com/ubuntu
https://archive.ubuntu.com/ubuntu
EOF
BOUNDED_STATUS=0
retry_pkg sudo apt-get update
[[ $(<"$APT_MIRROR_LIST") == https://archive.ubuntu.com/ubuntu ]]

# Sourced retry_pkg consumes this public library setting.
# shellcheck disable=SC2034
PKG_RETRIES=2
BOUNDED_STATUS=100
if retry_pkg apt-get install >"$tmp/semantic.out" 2>"$tmp/semantic.err"; then
  echo 'package-manager-test: semantic failure unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 100 ]]
if grep -Fq 'infra-stall:' "$tmp/semantic.err"; then
  echo 'package-manager-test: semantic failure was infrastructure-classified' >&2
  exit 1
fi

BOUNDED_STATUS=124
if retry_pkg apt-get update >"$tmp/timeout.out" 2>"$tmp/timeout.err"; then
  echo 'package-manager-test: timeout unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 124 ]]
grep -Fq 'infra-stall: package command exhausted bounded retries' \
  "$tmp/timeout.err"

# A bounded-timeout kill can interrupt dpkg mid-unpack; the next install
# attempt then fails with exit 100 ("dpkg was interrupted") unless the retry
# recovers with `dpkg --configure -a` first. The recovery itself goes through
# `bounded` so it cannot hang the retry loop on a wedged dpkg lock.
: >"$tmp/bounded.calls"
BOUNDED_STATUS=124
if retry_pkg apt-get install -y bash git curl >"$tmp/recover.out" 2>"$tmp/recover.err"; then
  echo 'package-manager-test: install retry unexpectedly passed' >&2
  exit 1
else
  status=$?
fi
[[ $status -eq 124 ]]
# Recovery shares the noninteractive frontend with installs, so configuring
# packages in a container prints no debconf fallback warnings.
[[ $(grep -c -- '^env DEBIAN_FRONTEND=noninteractive dpkg --configure -a$' \
  "$tmp/bounded.calls") -eq 1 ]]

# apt-get update never touches dpkg, so no recovery runs for it.
: >"$tmp/bounded.calls"
BOUNDED_STATUS=124
if retry_pkg apt-get update >/dev/null 2>&1; then
  echo 'package-manager-test: update retry unexpectedly passed' >&2
  exit 1
fi
if grep -Fq -- 'dpkg' "$tmp/bounded.calls"; then
  echo 'package-manager-test: dpkg recovery ran for apt-get update' >&2
  exit 1
fi

printf 'package-manager-test: ok\n'

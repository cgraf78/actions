#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
retry="$root/.github/actions/infra-retry/retry.sh"
# shellcheck source=.github/actions/shared/infra-stall-markers.sh
source "$root/.github/actions/shared/infra-stall-markers.sh"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  printf 'infra-retry-test: %s\n' "$*" >&2
  exit 1
}

write_jobs() {
  local destination=$1
  shift
  jq -cn --args '$ARGS.positional | map(
    split(":") | {
      id: (.[0] | tonumber),
      name: .[1],
      conclusion: .[2]
    }
  ) | {total_count: length, jobs: .}' -- "$@" >"$destination"
}

# Echo a step the way the runner does before executing it: the first script
# line in the group title, every script line in cyan, then its inputs and
# environment. Anything written in the step's YAML therefore reaches the log
# of every job that gets this far, whether or not that code path executes.
render_step() {
  local workflow=$1 step=$2 selector script line

  selector=".jobs.termux.steps[] | select(.name == \"$step\")"
  yq -e "$selector" "$root/.github/workflows/$workflow" >/dev/null ||
    fail "render_step: no step named $step in $workflow"
  script=$(yq -r "$selector | .run // \"\"" "$root/.github/workflows/$workflow")
  if [[ -n "$script" ]]; then
    printf '##[group]Run %s\n' "${script%%$'\n'*}"
    while IFS= read -r line; do
      printf '\033[36;1m%s\033[0m\n' "$line"
    done <<<"$script"
  else
    printf '##[group]Run %s\n' \
      "$(yq -r "$selector | .uses" "$root/.github/workflows/$workflow")"
  fi
  yq -r "$selector | ((.with // {}) * (.env // {})) | to_entries[] |
    \"  \" + .key + \": \" + (.value | tostring)" \
    "$root/.github/workflows/$workflow"
  printf '##[endgroup]\n'
}

# Prefix each line with a runner timestamp, as the job-log API returns it, so
# positive cases also prove a marker is found mid-line rather than anchored.
stamp() {
  sed 's/^/2026-10-17T03:25:13.6396758Z /'
}

# Everything the current Termux worker echoes before the caller command runs.
render_termux_setup() {
  render_step _termux-ci.yml 'Install Android SDK packages'
  render_step _termux-ci.yml 'Prepare Termux host runner'
  render_step _termux-ci.yml 'Run caller tests in Termux'
}

run_case() {
  local name=$1
  local jobs=$2
  local logs=$3
  local attempt=${4:-1}
  local conclusion=${5:-failure}
  local log_fetch_mode=${6:-normal}
  local case_dir="$tmp/$name"
  mkdir -p "$case_dir/bin"

  cat >"$case_dir/bin/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$FAKE_GH_CALLS"

case "$*" in
  *'/actions/runs/'*'/jobs?'*)
    cat "$FAKE_JOBS"
    ;;
  *'/actions/jobs/'*'/logs'*)
    case "${FAKE_LOG_FETCH_MODE:-normal}" in
      ansi-refusal)
        if [[ "$*" != *'--allow-escape-sequences'* ]]; then
          printf '%s\n' \
            'the response contains terminal escape sequences; pass --allow-escape-sequences to output it anyway' >&2
          exit 1
        fi
        ;;
      ansi-fallback-failure)
        if [[ "$*" == *'--allow-escape-sequences'* ]]; then
          printf 'fallback log request failed\n' >&2
        else
          printf '%s\n' \
            'the response contains terminal escape sequences; pass --allow-escape-sequences to output it anyway' >&2
        fi
        exit 1
        ;;
      unrelated-failure)
        printf 'unrelated log request failed\n' >&2
        exit 1
        ;;
    esac
    job_id=${*%/logs}
    job_id=${job_id##*/}
    cat "$FAKE_LOGS/$job_id.log"
    ;;
  *'/rerun-failed-jobs'*)
    ;;
  *)
    printf 'unexpected gh call: %s\n' "$*" >&2
    exit 2
    ;;
esac
EOF
  chmod +x "$case_dir/bin/gh"

  FAKE_GH_CALLS="$case_dir/gh-calls" \
    FAKE_JOBS="$jobs" \
    FAKE_LOGS="$logs" \
    FAKE_LOG_FETCH_MODE="$log_fetch_mode" \
    GH_TOKEN=test-token \
    TARGET_CONCLUSION="$conclusion" \
    TARGET_REPOSITORY=cgraf78/example \
    TARGET_RUN_ATTEMPT="$attempt" \
    TARGET_RUN_ID=12345 \
    PATH="$case_dir/bin:$PATH" \
    bash "$retry" >"$case_dir/stdout" 2>"$case_dir/stderr"
}

mkdir -p \
  "$tmp/infra-logs" \
  "$tmp/termux-logs" \
  "$tmp/sdk-logs" \
  "$tmp/termux-adb-logs" \
  "$tmp/shellcheck-http-logs" \
  "$tmp/shellcheck-connection-logs" \
  "$tmp/shellcheck-checksum-logs" \
  "$tmp/shellcheck-lint-logs" \
  "$tmp/ansi-app-logs" \
  "$tmp/app-logs" \
  "$tmp/mixed-logs"
write_jobs "$tmp/infra-jobs.json" \
  '11:shell / Platforms / Arch:failure' \
  '12:shell / Required:failure' \
  '13:shell / Platforms / Ubuntu:success'
cat >"$tmp/infra-logs/11.log" <<'EOF'
##[command]/usr/bin/docker pull archlinux:latest
Error response from daemon: Get "https://registry-1.docker.io/v2/": context deadline exceeded
##[warning]Docker pull failed with exit code 1, back off 3 seconds before retry.
##[error]Docker pull failed with exit code 1
EOF

run_case infra "$tmp/infra-jobs.json" "$tmp/infra-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/infra/gh-calls" ||
  fail "allowlisted infrastructure failure was not rerun"
[[ $(grep -Fc '/actions/jobs/11/logs' "$tmp/infra/gh-calls") -eq 1 ]] ||
  fail "normal log fetch did not stay on one request"
if grep -Fq -- '--allow-escape-sequences' "$tmp/infra/gh-calls"; then
  fail "normal log fetch used the escape-sequence opt-in"
fi
grep -Fq 'rerunning failed jobs once' "$tmp/infra/stdout" ||
  fail "retry decision was not reported"

# A runner warning can describe an early pull attempt that later worked. It
# must not cover up a repository failure once the container has started.
mkdir "$tmp/recovered-docker-logs"
cat >"$tmp/recovered-docker-logs/11.log" <<'EOF'
##[command]/usr/bin/docker pull archlinux:latest
Error response from daemon: TLS handshake timeout
##[warning]Docker pull failed with exit code 1, back off 3 seconds before retry.
##[command]/usr/bin/docker pull archlinux:latest
Status: Downloaded newer image for archlinux:latest
##[group]Run test/run
assertion failed: expected success, got 1
##[error]Process completed with exit code 1.
EOF
run_case recovered-docker "$tmp/infra-jobs.json" "$tmp/recovered-docker-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/recovered-docker/gh-calls"; then
  fail "a recovered Docker pull masked an application failure"
fi

# Newer GitHub CLI releases refuse to print logs containing terminal control
# bytes unless the caller explicitly opts in. The retry action never renders a
# downloaded log, so the exact refusal can safely retry the same private-file
# download. Keep the fallback exact and bounded so unrelated API failures do
# not gain a second request or broaden retry classification.
run_case ansi-log "$tmp/infra-jobs.json" "$tmp/infra-logs" \
  1 failure ansi-refusal
grep -Fq 'rerun-failed-jobs' "$tmp/ansi-log/gh-calls" ||
  fail "allowlisted ANSI-bearing infrastructure log was not rerun"
[[ $(grep -Fc '/actions/jobs/11/logs' "$tmp/ansi-log/gh-calls") -eq 2 ]] ||
  fail "ANSI refusal did not make exactly two log requests"
grep -Fq -- '--allow-escape-sequences' "$tmp/ansi-log/gh-calls" ||
  fail "ANSI refusal did not use the explicit log opt-in"

run_case unrelated-log-error "$tmp/infra-jobs.json" "$tmp/infra-logs" \
  1 failure unrelated-failure
if grep -Fq 'rerun-failed-jobs' "$tmp/unrelated-log-error/gh-calls"; then
  fail "unrelated log request failure was rerun"
fi
[[ $(grep -Fc '/actions/jobs/11/logs' \
  "$tmp/unrelated-log-error/gh-calls") -eq 1 ]] ||
  fail "unrelated log request failure gained a fallback request"
if grep -Fq -- '--allow-escape-sequences' \
  "$tmp/unrelated-log-error/gh-calls"; then
  fail "unrelated log request failure used the ANSI fallback"
fi

run_case ansi-fallback-failure "$tmp/infra-jobs.json" "$tmp/infra-logs" \
  1 failure ansi-fallback-failure
if grep -Fq 'rerun-failed-jobs' "$tmp/ansi-fallback-failure/gh-calls"; then
  fail "failed ANSI fallback was rerun"
fi
[[ $(grep -Fc '/actions/jobs/11/logs' \
  "$tmp/ansi-fallback-failure/gh-calls") -eq 2 ]] ||
  fail "failed ANSI fallback did not stop after two requests"

write_jobs "$tmp/termux-jobs.json" \
  '16:rust / Termux runtime / Runtime / Android / Termux x86_64:failure' \
  '17:rust / Termux runtime / Required:failure' \
  '18:rust / Required:failure'

# The runner echoes the worker's whole setup script, including the phrases of
# branches that never execute, into every Termux job log. A caller test
# failure after that echo is repository-owned and must stay red.
{
  render_termux_setup
  cat <<'EOF'
Waiting for Termux bootstrap
Copying caller checkout
Running caller command inside Termux
  FAIL: live watcher covers its key only (expected 'b', got 'ab')
Results: 230 passed, 1 failed
##[error]The process '/usr/bin/sh' failed with exit code 1
EOF
} | stamp >"$tmp/termux-logs/16.log"
run_case termux-caller-failure "$tmp/termux-jobs.json" "$tmp/termux-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/termux-caller-failure/gh-calls"; then
  fail "Termux caller failure was rerun because of the echoed setup script"
fi
grep -Fq 'not an allowlisted infrastructure failure' \
  "$tmp/termux-caller-failure/stdout" ||
  fail "Termux caller failure decision was not reported"

# The same failure recorded from a real job before the markers moved out of
# the YAML: its echoed script still spells the old bootstrap and package
# phrases, which must no longer opt anything into a retry.
cp "$root/test/fixtures/infra-retry/termux-caller-failure.log" \
  "$tmp/termux-logs/16.log"
run_case termux-recorded-caller-failure \
  "$tmp/termux-jobs.json" "$tmp/termux-logs"
if grep -Fq 'rerun-failed-jobs' \
  "$tmp/termux-recorded-caller-failure/gh-calls"; then
  fail "recorded Termux caller failure was rerun"
fi

# A bootstrap that never became ready is infrastructure only when the helper
# printed its runtime marker, which sits outside every YAML file.
{
  render_termux_setup
  printf '%s\n' \
    'Waiting for Termux bootstrap' \
    "$TERMUX_BOOTSTRAP_TIMEOUT_MARKER" \
    'Termux bootstrap was not ready after bounded polling' \
    "##[error]The process '/usr/bin/sh' failed with exit code 1"
} | stamp >"$tmp/termux-logs/16.log"
run_case termux-bootstrap "$tmp/termux-jobs.json" "$tmp/termux-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/termux-bootstrap/gh-calls" ||
  fail "Termux bootstrap stall was not rerun"
grep -Fq "allowlisted bounded infrastructure stall ($TERMUX_BOOTSTRAP_TIMEOUT_MARKER)" \
  "$tmp/termux-bootstrap/stdout" ||
  fail "Termux bootstrap retry decision did not name its marker"

# The bootstrap phrases alone are display text, not a runtime signal.
cat >"$tmp/termux-logs/16.log" <<'EOF'
Installing Termux APK
Waiting for Termux bootstrap
Termux bootstrap did not become ready
The process '/usr/bin/sh' failed with exit code 1
EOF
run_case termux-bootstrap-prose "$tmp/termux-jobs.json" "$tmp/termux-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/termux-bootstrap-prose/gh-calls"; then
  fail "Termux bootstrap prose without its marker was rerun"
fi

write_jobs "$tmp/termux-package-jobs.json" \
  '19:rust / Termux runtime / Runtime / Android / Termux x86_64:failure' \
  '20:rust / Termux runtime / Required:failure'
{
  render_termux_setup
  printf '%s\n' "$TERMUX_PACKAGE_COMMAND_MARKER" \
    'Error: Process completed with exit code 124.'
} | stamp >"$tmp/termux-logs/19.log"

run_case termux-package "$tmp/termux-package-jobs.json" "$tmp/termux-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/termux-package/gh-calls" ||
  fail "bounded Termux package failure was not rerun"

# The pre-v1 in-sandbox phrase was spelled out in the echoed script, so a run
# still on an older worker cannot prove a stall with it.
cat >"$tmp/termux-logs/19.log" <<'EOF'
infra-stall: Termux package command exhausted bounded retries
Error: Process completed with exit code 124.
EOF
run_case termux-package-legacy \
  "$tmp/termux-package-jobs.json" "$tmp/termux-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/termux-package-legacy/gh-calls"; then
  fail "legacy echoed Termux package phrase was rerun"
fi

# The emulator runner's own sdkmanager calls fail with one-shot download
# errors. The worker's bounded pre-install prints its marker only after every
# attempt failed; the third-party warning alone stays red.
write_jobs "$tmp/sdk-jobs.json" \
  '61:shell / Termux runtime / Runtime / Android / Termux x86_64:failure' \
  '62:shell / Required:failure'
{
  render_step _termux-ci.yml 'Install Android SDK packages'
  printf '%s\n' \
    'Warning: An error occurred while preparing SDK package Android Emulator: Error on ZipFile unknown archive.' \
    'android-sdk-packages: attempt 3/3 failed (exit 1); giving up' \
    "$ANDROID_SDK_INSTALL_MARKER" \
    'Error: Process completed with exit code 1.'
} | stamp >"$tmp/sdk-logs/61.log"
run_case android-sdk "$tmp/sdk-jobs.json" "$tmp/sdk-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/android-sdk/gh-calls" ||
  fail "exhausted Android SDK install was not rerun"

cat >"$tmp/sdk-logs/61.log" <<'EOF'
[command]/usr/bin/sh -c \sdkmanager --install emulator --channel=0 > /dev/null
Warning: An error occurred while preparing SDK package Android Emulator: Error on ZipFile unknown archive.
##[error]The process '/usr/bin/sh' failed with exit code 1
EOF
run_case android-sdk-unmarked "$tmp/sdk-jobs.json" "$tmp/sdk-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/android-sdk-unmarked/gh-calls"; then
  fail "unmarked sdkmanager failure was rerun"
fi

# Every token the producers print must be retryable on its own; a token added
# to the shared file but not classified would be a silent no-op. Messages
# name the index, never the token: a printed token would make a failure of
# this very test look retryable.
for index in "${!INFRA_STALL_MARKERS[@]}"; do
  printf '%s\n%s\n' "${INFRA_STALL_MARKERS[index]}" \
    'Error: Process completed with exit code 1.' | stamp \
    >"$tmp/sdk-logs/61.log"
  run_case marker-each "$tmp/sdk-jobs.json" "$tmp/sdk-logs"
  grep -Fq 'rerun-failed-jobs' "$tmp/marker-each/gh-calls" ||
    fail "INFRA_STALL_MARKERS[$index] was not rerun"
  rm -rf "$tmp/marker-each"
done
defined_markers=$(grep -c "^[A-Z_]*='infra-stall: " \
  "$root/.github/actions/shared/infra-stall-markers.sh")
[[ ${#INFRA_STALL_MARKERS[@]} -eq $defined_markers ]] ||
  fail "a shared infra-stall token is missing from INFRA_STALL_MARKERS"

# Every workflow and action file, echoed at once, followed by an ordinary
# test failure. No allowlist rule may fire on YAML text alone.
mkdir -p "$tmp/yaml-logs"
{
  cat "$root"/.github/workflows/*.yml "$root"/.github/actions/*/action.yml
  printf '%s\n' 'FAIL: ordinary test assertion' \
    'Error: Process completed with exit code 1.'
} >"$tmp/yaml-logs/61.log"
run_case all-yaml "$tmp/sdk-jobs.json" "$tmp/yaml-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/all-yaml/gh-calls"; then
  fail "workflow or action YAML text alone made a failure retryable"
fi

write_jobs "$tmp/termux-adb-jobs.json" \
  '37:rust / Termux runtime / Runtime / Android / Termux x86_64:failure' \
  '38:rust / Termux runtime / Required:failure' \
  '39:rust / Required:failure'
printf '%s\n%s\n' \
  "$TERMUX_ADB_SETUP_TIMEOUT_MARKER" \
  'Error: Process completed with exit code 124.' \
  >"$tmp/termux-adb-logs/37.log"

run_case termux-adb "$tmp/termux-adb-jobs.json" "$tmp/termux-adb-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/termux-adb/gh-calls" ||
  fail "bounded Termux ADB failure was not rerun"

printf '%s\n%s\n' \
  "$TERMUX_PACKAGE_SERVICE_MARKER" \
  "The process '/usr/bin/sh' failed with exit code 1" \
  >"$tmp/termux-adb-logs/37.log"
run_case termux-package-service \
  "$tmp/termux-adb-jobs.json" "$tmp/termux-adb-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/termux-package-service/gh-calls" ||
  fail "bounded Termux package-service failure was not rerun"

cat >"$tmp/termux-adb-logs/37.log" <<'EOF'
The adb subprocess returned status 124 without a supervisor timeout.
Error: Process completed with exit code 124.
EOF
run_case termux-adb-child-124 \
  "$tmp/termux-adb-jobs.json" "$tmp/termux-adb-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/termux-adb-child-124/gh-calls"; then
  fail "ordinary adb status 124 was infrastructure-rerun"
fi

cat >"$tmp/termux-adb-logs/37.log" <<'EOF'
timeout: sending signal TERM to command '/usr/bin/adb'
The repository test suite failed after emulator startup.
Error: Process completed with exit code 1.
EOF
run_case termux-adb-recovered-probe \
  "$tmp/termux-adb-jobs.json" "$tmp/termux-adb-logs"
if grep -Fq 'rerun-failed-jobs' \
  "$tmp/termux-adb-recovered-probe/gh-calls"; then
  fail "recovered adb timeout masked a repository test failure"
fi

cat >"$tmp/termux-logs/19.log" <<'EOF'
E: Unable to correct problems, you have held broken packages.
package command failed after 2 attempts (exit 100): apt-get install libandroid-utimes
Error: Process completed with exit code 100.
EOF
run_case termux-package-conflict \
  "$tmp/termux-package-jobs.json" "$tmp/termux-logs"
if grep -Fq 'rerun-failed-jobs' \
  "$tmp/termux-package-conflict/gh-calls"; then
  fail "Termux package conflict was infrastructure-rerun"
fi

# The pinned ShellCheck archive is downloaded by the shared prerequisite
# action before repository lint starts. Exhausted GitHub transport retries are
# safe to rerun, but the signature deliberately includes that action boundary
# so an arbitrary application curl failure cannot opt a job into retry.
write_jobs "$tmp/shellcheck-http-jobs.json" \
  '21:shell / ShellCheck:failure' \
  '22:shell / Required:failure'
cat >"$tmp/shellcheck-http-logs/21.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
Error: Process completed with exit code 22.
EOF

run_case shellcheck-http \
  "$tmp/shellcheck-http-jobs.json" "$tmp/shellcheck-http-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-http/gh-calls" ||
  fail "ShellCheck prerequisite HTTP failure was not rerun"
grep -Fq 'allowlisted ShellCheck prerequisite download failure' \
  "$tmp/shellcheck-http/stdout" ||
  fail "ShellCheck HTTP retry decision was not reported"

# Checkrun uses a larger named setup whose prerequisite downloads have a
# different contract. The shared ShellCheck classifier must not broaden to it
# merely because the job name and curl failure happen to look alike.
cat >"$tmp/shellcheck-http-logs/21.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: checkrun
curl: (22) The requested URL returned error: 503
Error: Process completed with exit code 22.
EOF

run_case shellcheck-other-setup \
  "$tmp/shellcheck-http-jobs.json" "$tmp/shellcheck-http-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-other-setup/gh-calls"; then
  fail "ShellCheck failure from another setup mode was rerun"
fi

write_jobs "$tmp/shellcheck-connection-jobs.json" \
  '25:shell / ShellCheck:failure' \
  '26:shell / Required:failure'
cat >"$tmp/shellcheck-connection-logs/25.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (56) Connection died, tried 5 times before giving up
Error: Process completed with exit code 56.
EOF

run_case shellcheck-connection \
  "$tmp/shellcheck-connection-jobs.json" \
  "$tmp/shellcheck-connection-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-connection/gh-calls" ||
  fail "ShellCheck prerequisite connection failure was not rerun"

# The shared curl guard exits 28 after its bounded transport retries.
# In the pinned ShellCheck action boundary that is the same retryable
# transport condition as a connection reset, not a repository-owned lint
# failure.
mkdir -p "$tmp/shellcheck-stall-logs"
write_jobs "$tmp/shellcheck-stall-jobs.json" \
  '35:shell / ShellCheck:failure' \
  '36:shell / Required:failure'
cat >"$tmp/shellcheck-stall-logs/35.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (28) Operation too slow. Less than 1024 bytes/sec transferred the last 30 seconds
Error: Process completed with exit code 28.
EOF

run_case shellcheck-stall \
  "$tmp/shellcheck-stall-jobs.json" "$tmp/shellcheck-stall-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-stall/gh-calls" ||
  fail "ShellCheck prerequisite bounded stall was not rerun"

# A recovered curl warning followed by an integrity failure is not transport
# infrastructure. Its final process exit does not match the earlier curl
# diagnostic, so it must stay red even though inventory has not begun yet.
write_jobs "$tmp/shellcheck-checksum-jobs.json" \
  '27:shell / ShellCheck:failure' \
  '28:shell / Required:failure'
cat >"$tmp/shellcheck-checksum-logs/27.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
shellcheck-v0.11.0.linux.x86_64.tar.xz: FAILED
sha256sum: WARNING: 1 computed checksum did NOT match
Error: Process completed with exit code 1.
EOF

run_case shellcheck-checksum \
  "$tmp/shellcheck-checksum-jobs.json" "$tmp/shellcheck-checksum-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-checksum/gh-calls"; then
  fail "ShellCheck checksum failure was rerun"
fi

# Curl exit 22 is shared by permanent HTTP failures. A transient warning from
# an earlier attempt cannot make a terminal 404 retryable because only the
# final curl diagnostic controls classification.
cat >"$tmp/shellcheck-checksum-logs/27.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
curl: (22) The requested URL returned error: 404
Error: Process completed with exit code 22.
EOF

run_case shellcheck-permanent-http \
  "$tmp/shellcheck-checksum-jobs.json" "$tmp/shellcheck-checksum-logs"
if grep -Fq 'rerun-failed-jobs' \
  "$tmp/shellcheck-permanent-http/gh-calls"; then
  fail "ShellCheck permanent HTTP failure was rerun"
fi

# A recovered download can leave curl warnings in an otherwise complete job.
# Once the inventory begins, a later failure is repository-owned lint and must
# remain red rather than being hidden behind the infrastructure retry budget.
write_jobs "$tmp/shellcheck-lint-jobs.json" \
  '23:shell / ShellCheck:failure' \
  '24:shell / Required:failure'
cat >"$tmp/shellcheck-lint-logs/23.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
=== repository ShellCheck inventory ===
In script line 4:
echo $value
     ^----^ SC2086 (info): Double quote to prevent globbing and word splitting.
Error: Process completed with exit code 1.
EOF


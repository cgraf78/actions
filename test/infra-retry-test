#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
retry="$root/.github/actions/infra-retry/retry.sh"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  printf 'infra-retry-test: %s\n' "$*" >&2
  exit 1
}

write_jobs() {
  local destination=$1
  shift
  jq -cn --args '$ARGS.positional | map(
    split(":") | {
      id: (.[0] | tonumber),
      name: .[1],
      conclusion: .[2]
    }
  ) | {total_count: length, jobs: .}' -- "$@" >"$destination"
}

run_case() {
  local name=$1
  local jobs=$2
  local logs=$3
  local attempt=${4:-1}
  local conclusion=${5:-failure}
  local log_fetch_mode=${6:-normal}
  local case_dir="$tmp/$name"
  mkdir -p "$case_dir/bin"

  cat >"$case_dir/bin/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$FAKE_GH_CALLS"

case "$*" in
  *'/actions/runs/'*'/jobs?'*)
    cat "$FAKE_JOBS"
    ;;
  *'/actions/jobs/'*'/logs'*)
    case "${FAKE_LOG_FETCH_MODE:-normal}" in
      ansi-refusal)
        if [[ "$*" != *'--allow-escape-sequences'* ]]; then
          printf '%s\n' \
            'the response contains terminal escape sequences; pass --allow-escape-sequences to output it anyway' >&2
          exit 1
        fi
        ;;
      ansi-fallback-failure)
        if [[ "$*" == *'--allow-escape-sequences'* ]]; then
          printf 'fallback log request failed\n' >&2
        else
          printf '%s\n' \
            'the response contains terminal escape sequences; pass --allow-escape-sequences to output it anyway' >&2
        fi
        exit 1
        ;;
      unrelated-failure)
        printf 'unrelated log request failed\n' >&2
        exit 1
        ;;
    esac
    job_id=${*%/logs}
    job_id=${job_id##*/}
    cat "$FAKE_LOGS/$job_id.log"
    ;;
  *'/rerun-failed-jobs'*)
    ;;
  *)
    printf 'unexpected gh call: %s\n' "$*" >&2
    exit 2
    ;;
esac
EOF
  chmod +x "$case_dir/bin/gh"

  FAKE_GH_CALLS="$case_dir/gh-calls" \
    FAKE_JOBS="$jobs" \
    FAKE_LOGS="$logs" \
    FAKE_LOG_FETCH_MODE="$log_fetch_mode" \
    GH_TOKEN=test-token \
    TARGET_CONCLUSION="$conclusion" \
    TARGET_REPOSITORY=cgraf78/example \
    TARGET_RUN_ATTEMPT="$attempt" \
    TARGET_RUN_ID=12345 \
    PATH="$case_dir/bin:$PATH" \
    bash "$retry" >"$case_dir/stdout" 2>"$case_dir/stderr"
}

mkdir -p \
  "$tmp/infra-logs" \
  "$tmp/termux-logs" \
  "$tmp/shellcheck-http-logs" \
  "$tmp/shellcheck-connection-logs" \
  "$tmp/shellcheck-checksum-logs" \
  "$tmp/shellcheck-lint-logs" \
  "$tmp/ansi-app-logs" \
  "$tmp/app-logs" \
  "$tmp/mixed-logs"
write_jobs "$tmp/infra-jobs.json" \
  '11:shell / Platforms / Arch:failure' \
  '12:shell / Required:failure' \
  '13:shell / Platforms / Ubuntu:success'
cat >"$tmp/infra-logs/11.log" <<'EOF'
##[command]/usr/bin/docker pull archlinux:latest
Error response from daemon: Get "https://registry-1.docker.io/v2/": context deadline exceeded
##[warning]Docker pull failed with exit code 1, back off 3 seconds before retry.
##[error]Docker pull failed with exit code 1
EOF

run_case infra "$tmp/infra-jobs.json" "$tmp/infra-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/infra/gh-calls" ||
  fail "allowlisted infrastructure failure was not rerun"
[[ $(grep -Fc '/actions/jobs/11/logs' "$tmp/infra/gh-calls") -eq 1 ]] ||
  fail "normal log fetch did not stay on one request"
if grep -Fq -- '--allow-escape-sequences' "$tmp/infra/gh-calls"; then
  fail "normal log fetch used the escape-sequence opt-in"
fi
grep -Fq 'rerunning failed jobs once' "$tmp/infra/stdout" ||
  fail "retry decision was not reported"

# Newer GitHub CLI releases refuse to print logs containing terminal control
# bytes unless the caller explicitly opts in. The retry action never renders a
# downloaded log, so the exact refusal can safely retry the same private-file
# download. Keep the fallback exact and bounded so unrelated API failures do
# not gain a second request or broaden retry classification.
run_case ansi-log "$tmp/infra-jobs.json" "$tmp/infra-logs" \
  1 failure ansi-refusal
grep -Fq 'rerun-failed-jobs' "$tmp/ansi-log/gh-calls" ||
  fail "allowlisted ANSI-bearing infrastructure log was not rerun"
[[ $(grep -Fc '/actions/jobs/11/logs' "$tmp/ansi-log/gh-calls") -eq 2 ]] ||
  fail "ANSI refusal did not make exactly two log requests"
grep -Fq -- '--allow-escape-sequences' "$tmp/ansi-log/gh-calls" ||
  fail "ANSI refusal did not use the explicit log opt-in"

run_case unrelated-log-error "$tmp/infra-jobs.json" "$tmp/infra-logs" \
  1 failure unrelated-failure
if grep -Fq 'rerun-failed-jobs' "$tmp/unrelated-log-error/gh-calls"; then
  fail "unrelated log request failure was rerun"
fi
[[ $(grep -Fc '/actions/jobs/11/logs' \
  "$tmp/unrelated-log-error/gh-calls") -eq 1 ]] ||
  fail "unrelated log request failure gained a fallback request"
if grep -Fq -- '--allow-escape-sequences' \
  "$tmp/unrelated-log-error/gh-calls"; then
  fail "unrelated log request failure used the ANSI fallback"
fi

run_case ansi-fallback-failure "$tmp/infra-jobs.json" "$tmp/infra-logs" \
  1 failure ansi-fallback-failure
if grep -Fq 'rerun-failed-jobs' "$tmp/ansi-fallback-failure/gh-calls"; then
  fail "failed ANSI fallback was rerun"
fi
[[ $(grep -Fc '/actions/jobs/11/logs' \
  "$tmp/ansi-fallback-failure/gh-calls") -eq 2 ]] ||
  fail "failed ANSI fallback did not stop after two requests"

write_jobs "$tmp/termux-jobs.json" \
  '16:rust / Termux runtime / Runtime / Android / Termux x86_64:failure' \
  '17:rust / Termux runtime / Required:failure' \
  '18:rust / Required:failure'
cat >"$tmp/termux-logs/16.log" <<'EOF'
Installing Termux APK
Waiting for Termux bootstrap
Termux bootstrap did not become ready
The process '/usr/bin/sh' failed with exit code 1
EOF

run_case termux "$tmp/termux-jobs.json" "$tmp/termux-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/termux/gh-calls" ||
  fail "allowlisted Termux bootstrap failure was not rerun"
grep -Fq 'allowlisted Termux bootstrap failure' "$tmp/termux/stdout" ||
  fail "Termux bootstrap retry decision was not reported"

# The pinned ShellCheck archive is downloaded by the shared prerequisite
# action before repository lint starts. Exhausted GitHub transport retries are
# safe to rerun, but the signature deliberately includes that action boundary
# so an arbitrary application curl failure cannot opt a job into retry.
write_jobs "$tmp/shellcheck-http-jobs.json" \
  '21:shell / ShellCheck:failure' \
  '22:shell / Required:failure'
cat >"$tmp/shellcheck-http-logs/21.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
Error: Process completed with exit code 22.
EOF

run_case shellcheck-http \
  "$tmp/shellcheck-http-jobs.json" "$tmp/shellcheck-http-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-http/gh-calls" ||
  fail "ShellCheck prerequisite HTTP failure was not rerun"
grep -Fq 'allowlisted ShellCheck prerequisite download failure' \
  "$tmp/shellcheck-http/stdout" ||
  fail "ShellCheck HTTP retry decision was not reported"

# Checkrun uses a larger named setup whose prerequisite downloads have a
# different contract. The shared ShellCheck classifier must not broaden to it
# merely because the job name and curl failure happen to look alike.
cat >"$tmp/shellcheck-http-logs/21.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: checkrun
curl: (22) The requested URL returned error: 503
Error: Process completed with exit code 22.
EOF

run_case shellcheck-other-setup \
  "$tmp/shellcheck-http-jobs.json" "$tmp/shellcheck-http-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-other-setup/gh-calls"; then
  fail "ShellCheck failure from another setup mode was rerun"
fi

write_jobs "$tmp/shellcheck-connection-jobs.json" \
  '25:shell / ShellCheck:failure' \
  '26:shell / Required:failure'
cat >"$tmp/shellcheck-connection-logs/25.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (56) Connection died, tried 5 times before giving up
Error: Process completed with exit code 56.
EOF

run_case shellcheck-connection \
  "$tmp/shellcheck-connection-jobs.json" \
  "$tmp/shellcheck-connection-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-connection/gh-calls" ||
  fail "ShellCheck prerequisite connection failure was not rerun"

# A recovered curl warning followed by an integrity failure is not transport
# infrastructure. Its final process exit does not match the earlier curl
# diagnostic, so it must stay red even though inventory has not begun yet.
write_jobs "$tmp/shellcheck-checksum-jobs.json" \
  '27:shell / ShellCheck:failure' \
  '28:shell / Required:failure'
cat >"$tmp/shellcheck-checksum-logs/27.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
shellcheck-v0.11.0.linux.x86_64.tar.xz: FAILED
sha256sum: WARNING: 1 computed checksum did NOT match
Error: Process completed with exit code 1.
EOF

run_case shellcheck-checksum \
  "$tmp/shellcheck-checksum-jobs.json" "$tmp/shellcheck-checksum-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-checksum/gh-calls"; then
  fail "ShellCheck checksum failure was rerun"
fi

# Curl exit 22 is shared by permanent HTTP failures. A transient warning from
# an earlier attempt cannot make a terminal 404 retryable because only the
# final curl diagnostic controls classification.
cat >"$tmp/shellcheck-checksum-logs/27.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
curl: (22) The requested URL returned error: 404
Error: Process completed with exit code 22.
EOF

run_case shellcheck-permanent-http \
  "$tmp/shellcheck-checksum-jobs.json" "$tmp/shellcheck-checksum-logs"
if grep -Fq 'rerun-failed-jobs' \
  "$tmp/shellcheck-permanent-http/gh-calls"; then
  fail "ShellCheck permanent HTTP failure was rerun"
fi

# A recovered download can leave curl warnings in an otherwise complete job.
# Once the inventory begins, a later failure is repository-owned lint and must
# remain red rather than being hidden behind the infrastructure retry budget.
write_jobs "$tmp/shellcheck-lint-jobs.json" \
  '23:shell / ShellCheck:failure' \
  '24:shell / Required:failure'
cat >"$tmp/shellcheck-lint-logs/23.log" <<'EOF'
Run cgraf78/actions/.github/actions/shell-ci-prereqs@8eaac8e384ae89e9c1aaf675dd23689cfe73fa7c
  profiles: base,shellcheck
  setup: none
curl: (22) The requested URL returned error: 503
=== repository ShellCheck inventory ===
In script line 4:
echo $value
     ^----^ SC2086 (info): Double quote to prevent globbing and word splitting.
Error: Process completed with exit code 1.
EOF

run_case shellcheck-lint \
  "$tmp/shellcheck-lint-jobs.json" "$tmp/shellcheck-lint-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-lint/gh-calls"; then
  fail "repository ShellCheck finding was rerun"
fi

write_jobs "$tmp/termux-partial-jobs.json" \
  '19:rust / Termux runtime / Runtime / Android / Termux x86_64:failure' \
  '20:rust / Required:failure'
cat >"$tmp/termux-logs/19.log" <<'EOF'
Run caller tests in Termux
Termux bootstrap did not become ready
Process completed with exit code 1.
EOF

run_case termux-partial "$tmp/termux-partial-jobs.json" "$tmp/termux-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/termux-partial/gh-calls"; then
  fail "partial Termux signature was rerun"
fi

# Runner timeouts have no action-owned marker. The bounded allowlist therefore
# needs both the exact named network bootstrap step and the runner's current
# timeout text; an application timeout must remain red.
mkdir -p "$tmp/shellcheck-timeout-logs" "$tmp/app-timeout-logs"
write_jobs "$tmp/shellcheck-timeout-jobs.json" \
  '29:shell / ShellCheck:failure' \
  '30:shell / Required:failure'
cat >"$tmp/shellcheck-timeout-logs/29.log" <<'EOF'
Install ShellCheck prerequisites
The action has timed out.
EOF

run_case shellcheck-timeout \
  "$tmp/shellcheck-timeout-jobs.json" "$tmp/shellcheck-timeout-logs"
grep -Fq 'rerun-failed-jobs' "$tmp/shellcheck-timeout/gh-calls" ||
  fail "ShellCheck prerequisite timeout was not rerun"

cat >"$tmp/app-timeout-logs/29.log" <<'EOF'
Run tests
The action has timed out.
EOF

run_case app-timeout "$tmp/shellcheck-timeout-jobs.json" "$tmp/app-timeout-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/app-timeout/gh-calls"; then
  fail "application timeout was rerun"
fi

write_jobs "$tmp/app-jobs.json" \
  '21:shell / Platforms / Arch:failure' \
  '22:shell / Required:failure'
cat >"$tmp/app-logs/21.log" <<'EOF'
Run tests
assertion failed: expected 1, got 2
Process completed with exit code 1.
EOF

run_case app "$tmp/app-jobs.json" "$tmp/app-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/app/gh-calls"; then
  fail "application failure was rerun"
fi
grep -Fq 'not an allowlisted infrastructure failure' "$tmp/app/stdout" ||
  fail "application failure decision was not reported"

printf '\033]0;PRIVATE_JOB_LOG_MARKER\007\033[31mRun tests\033[0m\nassertion failed: expected 1, got 2\n' \
  >"$tmp/ansi-app-logs/21.log"
run_case ansi-app "$tmp/app-jobs.json" "$tmp/ansi-app-logs" \
  1 failure ansi-refusal
if grep -Fq 'rerun-failed-jobs' "$tmp/ansi-app/gh-calls"; then
  fail "ANSI-bearing application failure was rerun"
fi
[[ $(grep -Fc '/actions/jobs/21/logs' "$tmp/ansi-app/gh-calls") -eq 2 ]] ||
  fail "ANSI-bearing application log did not use one bounded fallback"
if grep -Fq 'PRIVATE_JOB_LOG_MARKER' \
  "$tmp/ansi-app/stdout" "$tmp/ansi-app/stderr"; then
  fail "raw ANSI-bearing job log escaped the private temporary directory"
fi

write_jobs "$tmp/mixed-jobs.json" \
  '31:shell / Platforms / Arch:failure' \
  '32:rust / Quality / Ubuntu:failure' \
  '33:shell / Required:failure'
cp "$tmp/infra-logs/11.log" "$tmp/mixed-logs/31.log"
cp "$tmp/app-logs/21.log" "$tmp/mixed-logs/32.log"

run_case mixed "$tmp/mixed-jobs.json" "$tmp/mixed-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/mixed/gh-calls"; then
  fail "mixed infrastructure and application failures were rerun"
fi

mkdir -p "$tmp/unavailable-logs" "$tmp/aggregate-logs"
write_jobs "$tmp/unavailable-jobs.json" \
  '41:shell / Platforms / Arch:failure' \
  '42:shell / Required:failure'
run_case unavailable "$tmp/unavailable-jobs.json" "$tmp/unavailable-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/unavailable/gh-calls"; then
  fail "failure with an unavailable log was rerun"
fi
grep -Fq 'could not read failed job log' "$tmp/unavailable/stdout" ||
  fail "unavailable-log decision was not reported"

write_jobs "$tmp/aggregate-jobs.json" '51:shell / Required:failure'
run_case aggregate-only "$tmp/aggregate-jobs.json" "$tmp/aggregate-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/aggregate-only/gh-calls"; then
  fail "aggregate-only failure was rerun"
fi
grep -Fq 'no failed leaf jobs' "$tmp/aggregate-only/stdout" ||
  fail "aggregate-only decision was not reported"

jq '.total_count = 101' "$tmp/infra-jobs.json" >"$tmp/incomplete-jobs.json"
run_case incomplete "$tmp/incomplete-jobs.json" "$tmp/infra-logs"
if grep -Fq 'rerun-failed-jobs' "$tmp/incomplete/gh-calls"; then
  fail "run with an incomplete job listing was rerun"
fi
grep -Fq 'job list is incomplete' "$tmp/incomplete/stdout" ||
  fail "incomplete-job-list decision was not reported"

run_case second-attempt "$tmp/infra-jobs.json" "$tmp/infra-logs" 2
if [[ -s "$tmp/second-attempt/gh-calls" ]]; then
  fail "second attempt queried or reran the workflow"
fi
grep -Fq 'attempt 2 is not eligible' "$tmp/second-attempt/stdout" ||
  fail "second-attempt decision was not reported"

run_case success "$tmp/infra-jobs.json" "$tmp/infra-logs" 1 success
if [[ -s "$tmp/success/gh-calls" ]]; then
  fail "successful workflow queried or reran jobs"
fi

printf 'infra-retry-test: ok\n'

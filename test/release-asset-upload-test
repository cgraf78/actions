#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
upload="$root/.github/actions/upload-release-assets/upload.sh"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  printf 'release-asset-upload-test: %s\n' "$*" >&2
  exit 1
}

set +e
python3 "$root/.github/actions/upload-release-assets/run-with-timeout.py" \
  0 1 -- bash -c 'sleep 30' >/dev/null 2>&1
timeout_status=$?
set -e
[[ "$timeout_status" -eq 124 ]] ||
  fail "portable timeout exited $timeout_status instead of 124"

run_case() {
  local name=$1
  local scenario=$2
  local expected_status=$3
  local case_dir="$tmp/$name"
  mkdir -p "$case_dir/bin" "$case_dir/assets"
  printf 'archive-data\n' >"$case_dir/assets/tool.tar.gz"
  printf 'checksum-data\n' >"$case_dir/assets/tool.tar.gz.sha256"
  : >"$case_dir/calls"
  : >"$case_dir/remote"
  : >"$case_dir/view-count"

  cat >"$case_dir/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"$FAKE_CALLS"
case "$1:$2" in
  release:view)
    view_count=0
    [[ ! -s "$FAKE_DIR/view-count" ]] || view_count=$(<"$FAKE_DIR/view-count")
    view_count=$((view_count + 1))
    printf '%s\n' "$view_count" >"$FAKE_DIR/view-count"
    if [[ "$FAKE_SCENARIO:$view_count" == ambiguous-view-failure:2 ]]; then
      exit 1
    fi
    printf '{"assets":['
    first=true
    while IFS='|' read -r name size digest; do
      [[ -n "$name" ]] || continue
      if [[ "$first" == false ]]; then printf ','; fi
      first=false
      printf '{"name":"%s","size":%s,"digest":"%s"}' "$name" "$size" "$digest"
    done <"$FAKE_REMOTE"
    printf ']}\n'
    ;;
  release:upload)
    asset=$4
    name=${asset##*/}
    size=$(wc -c <"$asset" | tr -d ' ')
    digest="sha256:$(shasum -a 256 "$asset" | awk '{print $1}')"
    attempt_file="$FAKE_DIR/attempt-$name"
    attempt=0
    [[ ! -f "$attempt_file" ]] || attempt=$(<"$attempt_file")
    attempt=$((attempt + 1))
    printf '%s\n' "$attempt" >"$attempt_file"
    case "$FAKE_SCENARIO:$name:$attempt" in
      fail:*:*) exit 1 ;;
      ambiguous:tool.tar.gz:1 | ambiguous-view-failure:tool.tar.gz:1)
        printf '%s|%s|%s\n' "$name" "$size" "$digest" >>"$FAKE_REMOTE"
        exit 1
        ;;
    esac
    awk -F '|' -v name="$name" '$1 != name' "$FAKE_REMOTE" >"$FAKE_REMOTE.next"
    printf '%s|%s|%s\n' "$name" "$size" "$digest" >>"$FAKE_REMOTE.next"
    mv "$FAKE_REMOTE.next" "$FAKE_REMOTE"
    ;;
  *)
    printf 'unexpected gh call: %s\n' "$*" >&2
    exit 2
    ;;
esac
EOF
  cat >"$case_dir/bin/python3" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'python3 %s\n' "$*" >>"$FAKE_CALLS"
[[ "$2" == 120 && "$3" == 5 && "$4" == -- ]] || exit 98
shift 4
"$@"
EOF
  chmod +x "$case_dir/bin/gh" "$case_dir/bin/python3"

  case "$scenario" in
    existing)
      printf 'tool.tar.gz|%s|sha256:%s\n' \
        "$(wc -c <"$case_dir/assets/tool.tar.gz" | tr -d ' ')" \
        "$(shasum -a 256 "$case_dir/assets/tool.tar.gz" | awk '{print $1}')" \
        >"$case_dir/remote"
      ;;
    partial)
      printf 'tool.tar.gz|%s|sha256:%s\n' \
        "$(wc -c <"$case_dir/assets/tool.tar.gz" | tr -d ' ')" \
        "$(shasum -a 256 "$case_dir/assets/tool.tar.gz" | awk '{print $1}')" \
        >"$case_dir/remote"
      ;;
    mismatch)
      printf 'tool.tar.gz|1|sha256:wrong\n' >"$case_dir/remote"
      ;;
    same-size-mismatch)
      printf 'tool.tar.gz|%s|sha256:%064d\n' \
        "$(wc -c <"$case_dir/assets/tool.tar.gz" | tr -d ' ')" 0 \
        >"$case_dir/remote"
      ;;
  esac

  local glob="$case_dir/assets/tool.tar.gz"
  [[ "$scenario" != multi && "$scenario" != partial ]] || glob="$case_dir/assets/tool.tar.gz*"
  [[ "$scenario" != empty ]] || glob="$case_dir/assets/missing-*"
  local asset_paths=
  if [[ "$scenario" != empty ]]; then
    shopt -s nullglob
    # shellcheck disable=SC2206 # The fixture deliberately exercises glob expansion.
    local selected_assets=($glob)
    shopt -u nullglob
    printf -v asset_paths '%s\n' "${selected_assets[@]}"
  fi

  set +e
  ASSET_GLOB="$glob" \
    ASSET_PATHS="$asset_paths" \
    FAKE_CALLS="$case_dir/calls" \
    FAKE_DIR="$case_dir" \
    FAKE_REMOTE="$case_dir/remote" \
    FAKE_SCENARIO="$scenario" \
    GITHUB_ACTION_PATH="$root/.github/actions/upload-release-assets" \
    GITHUB_REPOSITORY=cgraf78/example \
    PATH="$case_dir/bin:$PATH" \
    RELEASE_UPLOAD_RETRY_DELAYS=0,0 \
    TAG=v1 \
    bash "$upload" >"$case_dir/stdout" 2>"$case_dir/stderr"
  status=$?
  set -e

  [[ "$status" -eq "$expected_status" ]] ||
    fail "$name exited $status, expected $expected_status: $(<"$case_dir/stderr")"
  CASE_DIR=$case_dir
}

run_case clean clean 0
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 1 ]] ||
  fail "clean upload did not upload once"

run_case existing existing 0
if grep -q '^release upload ' "$CASE_DIR/calls"; then
  fail "matching existing asset was uploaded again"
fi

run_case partial partial 0
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 1 ]] ||
  fail "partial rerun did not upload only the missing asset"

run_case ambiguous ambiguous 0
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 1 ]] ||
  fail "ambiguous successful upload was retried"

grep -q '^python3 .*run-with-timeout.py 120 5 -- gh release upload ' "$CASE_DIR/calls" ||
  fail "release upload was not bounded"

run_case ambiguous-view-failure ambiguous-view-failure 0
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 1 ]] ||
  fail "unknown verification state caused a successful upload to be clobbered"

run_case mismatch mismatch 0
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 1 ]] ||
  fail "mismatched asset was not replaced"

run_case same-size-mismatch same-size-mismatch 0
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 1 ]] ||
  fail "same-size digest mismatch was not replaced"

run_case failure fail 1
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 3 ]] ||
  fail "failed upload did not make exactly three attempts"

run_case empty empty 1
grep -q 'matched no files' "$CASE_DIR/stderr" ||
  fail "empty glob did not explain the failure"

run_case multiple multi 0
[[ $(grep -c '^release upload ' "$CASE_DIR/calls") -eq 2 ]] ||
  fail "multi-file batch did not upload each asset"

duplicate_dir="$tmp/duplicate"
mkdir -p "$duplicate_dir/a" "$duplicate_dir/b" "$duplicate_dir/bin"
printf 'a\n' >"$duplicate_dir/a/tool.tar.gz"
printf 'b\n' >"$duplicate_dir/b/tool.tar.gz"
cp "$tmp/clean/bin/gh" "$duplicate_dir/bin/gh"
: >"$duplicate_dir/calls"
: >"$duplicate_dir/remote"
: >"$duplicate_dir/view-count"
set +e
ASSET_GLOB="$duplicate_dir/*/tool.tar.gz" \
  FAKE_CALLS="$duplicate_dir/calls" \
  FAKE_DIR="$duplicate_dir" \
  FAKE_REMOTE="$duplicate_dir/remote" \
  FAKE_SCENARIO=duplicate \
  GITHUB_ACTION_PATH="$root/.github/actions/upload-release-assets" \
  GITHUB_REPOSITORY=cgraf78/example \
  PATH="$duplicate_dir/bin:$PATH" \
  RELEASE_UPLOAD_RETRY_DELAYS=0,0 \
  TAG=v1 \
  bash "$upload" >"$duplicate_dir/stdout" 2>"$duplicate_dir/stderr"
duplicate_status=$?
set -e
[[ "$duplicate_status" -eq 1 ]] || fail "duplicate basenames were accepted"
grep -q 'duplicate release asset name' "$duplicate_dir/stderr" ||
  fail "duplicate basename failure was not explained"
if grep -q '^release upload ' "$duplicate_dir/calls"; then
  fail "duplicate basename validation happened after an upload"
fi

printf 'release asset upload tests passed\n'

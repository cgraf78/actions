EOF
chmod 0755 "$migration_crash_bin/mv"
set +e
migration_parent=$(cd -P -- "${migration_managed%/*}" && pwd -P)
migration_previous_target="$migration_parent/.example-tool.install.transaction/previous"
{
  PATH="$migration_crash_bin:$platform_tool_path" \
    CHECKOUT_TEST_REAL_MV="$real_mv" \

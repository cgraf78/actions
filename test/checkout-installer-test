cp "$shdeps_handoff_sentinel_expected" \
  "$shdeps_handoff_journal/previous/sentinel"
CHECKOUT_TEST_LOG="$tmp/shdeps-handoff.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$shdeps_handoff" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  "$active_bash" -s <"$source_work/install.sh" >/dev/null ||
  fail "checkout installer could not fill an interrupted Shdeps handoff"

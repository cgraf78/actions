  >>"$migration_source/scripts/checkout-installer.conf"
"$root/checkout-installer/render.sh" "$migration_source" >/dev/null
git -C "$migration_source" add scripts/checkout-installer.conf install.sh
git -C "$migration_source" commit --quiet -m 'advance delegate after interruption'
git -C "$migration_source" push --quiet
rmdir "$migration_lock"
CHECKOUT_TEST_LOG="$tmp/migration.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$migration_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$migration_remote" \
  "$active_bash" -s <"$migration_source/install.sh" >/dev/null ||
  fail "piped update could not migrate the checkout delegate path"
[[ $(git -C "$migration_managed" rev-parse HEAD) == $(git -C "$migration_source" rev-parse HEAD) ]] ||
  fail "delegate path migration did not update the managed checkout"
grep -Fqx "root=$(cd "$migration_managed" && pwd -P)" \
  "$tmp/migration.log" ||
  fail "delegate path migration did not invoke the new delegate"
[[ -f "$migration_managed/support/install-new.sh" ]] ||
  fail "delegate path migration did not reach the post-interruption delegate"

missing_source="$tmp/missing-source"
missing_remote="$tmp/missing-delegate.git"
missing_managed="$tmp/missing-managed/example-tool"
missing_fresh="$tmp/missing-fresh/example-tool"
write_config "$missing_source"
write_delegate "$missing_source"
printf 'present\n' >"$missing_source/version.txt"
"$root/checkout-installer/render.sh" "$missing_source" >/dev/null
git -C "$missing_source" init --quiet --initial-branch=main --template=''
git -C "$missing_source" config core.hooksPath /dev/null
git -C "$missing_source" config commit.gpgsign false
git -C "$missing_source" config user.name 'Checkout Installer Test'
git -C "$missing_source" config user.email checkout-installer@example.invalid
git -C "$missing_source" add .
git -C "$missing_source" commit --quiet -m 'delegate present fixture'
git init --quiet --bare --initial-branch=main "$missing_remote"
git -C "$missing_source" remote add origin "$missing_remote"
git -C "$missing_source" push --quiet --set-upstream origin main
missing_repo_url="file://$missing_remote"
CHECKOUT_TEST_LOG="$tmp/missing-initial.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$missing_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$missing_repo_url" \
  "$active_bash" -s <"$missing_source/install.sh" >/dev/null ||
  fail "missing-delegate update fixture did not install initially"
missing_head=$(git -C "$missing_managed" rev-parse HEAD)
git -C "$missing_source" rm --quiet support/install-checkout.sh
git -C "$missing_source" commit --quiet -m 'remove delegate fixture'
git -C "$missing_source" push --quiet

set +e
missing_update_output=$(CHECKOUT_TEST_LOG="$tmp/missing-update.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$missing_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$missing_repo_url" \
  "$active_bash" -s <"$missing_source/install.sh" 2>&1)

  "$missing_update_output" == *'installer is missing'* ]] ||
  fail "update accepted a fetched revision without the delegate"
[[ $(git -C "$missing_managed" rev-parse HEAD) == "$missing_head" ]] ||
  fail "update changed revision before rejecting a missing delegate"

set +e
missing_fresh_output=$(CHECKOUT_TEST_LOG="$tmp/missing-fresh.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$missing_fresh" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$missing_repo_url" \
  "$active_bash" -s <"$missing_source/install.sh" 2>&1)
missing_fresh_status=$?
set -e
[[ "$missing_fresh_status" -ne 0 &&
  "$missing_fresh_output" == *'installer is missing'* ]] ||
  fail "fresh clone accepted a revision without the delegate"
[[ ! -e "$missing_fresh" && ! -L "$missing_fresh" ]] ||
  fail "fresh clone published a checkout without the delegate"

set +e
CHECKOUT_TEST_LOG="$pipe_log" CHECKOUT_TEST_EXIT=29 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  "$active_bash" -s <"$source_work/install.sh" >/dev/null 2>&1
pipe_status=$?
set -e
[[ "$pipe_status" -eq 29 ]] ||
  fail "piped install did not preserve delegate status"

printf 'dirty\n' >>"$managed/version.txt"
dirty_head=$(git -C "$managed" rev-parse HEAD)
set +e
dirty_output=$(CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  "$active_bash" -s <"$source_work/install.sh" 2>&1)
dirty_status=$?
set -e
[[ "$dirty_status" -ne 0 && "$dirty_output" == *'dirty'* ]] ||
  fail "piped reinstall did not reject a dirty managed checkout"
[[ $(git -C "$managed" rev-parse HEAD) == "$dirty_head" ]] ||
  fail "dirty managed checkout changed revision before rejection"


printf 'owned elsewhere\n' >"$foreign/sentinel"
set +e
foreign_output=$(CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$foreign" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \

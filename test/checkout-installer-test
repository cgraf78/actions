migration_source="$tmp/migration-source"
migration_remote="$tmp/migration.git"
migration_managed="$tmp/migration-managed/example-tool"
write_config "$migration_source"
write_delegate "$migration_source"
mv "$migration_source/support/install-checkout.sh" \
  "$migration_source/support/install-old.sh"
printf 'CHECKOUT_INSTALLER_DELEGATE=support/install-old.sh\n' \
  >>"$migration_source/scripts/checkout-installer.conf"
"$root/checkout-installer/render.sh" "$migration_source" >/dev/null
git -C "$migration_source" init --quiet --initial-branch=main --template=''
git -C "$migration_source" config core.hooksPath /dev/null
git -C "$migration_source" config commit.gpgsign false
git -C "$migration_source" config user.name 'Checkout Installer Test'
git -C "$migration_source" config user.email checkout-installer@example.invalid
git -C "$migration_source" add .
git -C "$migration_source" commit --quiet -m 'old delegate path fixture'
git init --quiet --bare --initial-branch=main "$migration_remote"
git -C "$migration_source" remote add origin "$migration_remote"
git -C "$migration_source" push --quiet --set-upstream origin main
git clone --quiet --depth 1 --single-branch --branch main \
  "file://$migration_remote" "$migration_managed"
git -C "$migration_source" mv support/install-old.sh \
  support/install-checkout.sh
sed '/^CHECKOUT_INSTALLER_DELEGATE=/d' \
  "$migration_source/scripts/checkout-installer.conf" \
  >"$migration_source/scripts/checkout-installer.conf.tmp"
mv "$migration_source/scripts/checkout-installer.conf.tmp" \
  "$migration_source/scripts/checkout-installer.conf"
"$root/checkout-installer/render.sh" "$migration_source" >/dev/null
git -C "$migration_source" add scripts/checkout-installer.conf install.sh
git -C "$migration_source" commit --quiet -m 'migrate delegate path fixture'
git -C "$migration_source" push --quiet
migration_crash_bin="$tmp/migration-crash-bin"
mkdir -p "$migration_crash_bin"
cat >"$migration_crash_bin/mv" <<'EOF'
#!/usr/bin/env bash

target=${!#}
"${CHECKOUT_TEST_REAL_MV:?}" "$@"
move_status=$?
if [[ "$target" == "${CHECKOUT_TEST_OLD_MOVED_TARGET:?}" &&
  "$move_status" -eq 0 ]]; then

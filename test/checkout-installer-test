# Dot opts into the Shdeps destination contract. The generated installer must
# use the same base-root precedence as Shdeps itself: SHDEPS_INSTALL_DIR wins,
# otherwise HOME/.local/share is used, and XDG_DATA_HOME is irrelevant.
printf 'CHECKOUT_INSTALLER_DEFAULT_DESTINATION=shdeps\n' \
  >>"$source_work/scripts/checkout-installer.conf"

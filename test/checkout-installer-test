  "$tmp/shdeps-handoff.log" ||
  fail "checkout installer delegated from the wrong handoff generation"
grep -Fqx 'checkout_lock_kind=v1' "$tmp/shdeps-handoff.log" ||
  fail "Shdeps handoff did not use the shared v1 checkout lock"
files_identical "$shdeps_handoff_record_expected" "$shdeps_handoff_journal/record" ||
  fail "checkout installer changed Shdeps transition authority"
files_identical "$shdeps_handoff_sentinel_expected" \
  "$shdeps_handoff_journal/previous/sentinel" ||
  fail "checkout installer changed Shdeps parked generation"
[[ $(LC_ALL=C ls -A1 "$shdeps_handoff_journal") == $'previous\nrecord' ]] ||
  fail "checkout installer added state to the Shdeps transition journal"
[[ $(LC_ALL=C ls -A1 "$shdeps_handoff_journal/previous") == sentinel ]] ||

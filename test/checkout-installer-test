#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
blocking_pid=
blocking_release=
signal_pid=
signal_release=
signal_delegate_child_file=
network_signal_pid=
network_signal_release=

cleanup() {
  if [[ -n "$blocking_release" ]]; then
    : >"$blocking_release"
  fi
  if [[ -n "$blocking_pid" ]]; then
    wait "$blocking_pid" 2>/dev/null || true
  fi
  if [[ -n "$signal_release" ]]; then
    : >"$signal_release"
  fi
  if [[ -n "$signal_delegate_child_file" &&
    -f "$signal_delegate_child_file" ]]; then
    signal_delegate_child=$(sed -n '1p' "$signal_delegate_child_file")
    kill -TERM "$signal_delegate_child" 2>/dev/null || true
  fi
  if [[ -n "$signal_pid" ]]; then
    wait "$signal_pid" 2>/dev/null || true
  fi
  if [[ -n "$network_signal_release" ]]; then
    : >"$network_signal_release"
  fi
  if [[ -n "$network_signal_pid" ]]; then
    wait "$network_signal_pid" 2>/dev/null || true
  fi
  rm -rf "$tmp"
}

trap cleanup EXIT

fail() {
  printf 'checkout-installer-test: %s\n' "$1" >&2
  exit 1
}

write_delegate() {
  local consumer=$1

  mkdir -p "$consumer/support"
  cat >"$consumer/support/install-checkout.sh" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

checkout_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
{
  printf 'root=%s\n' "$checkout_root"
  printf 'prefix=%s\n' "${PREFIX:-}"
  printf 'bin_dir=%s\n' "${BIN_DIR:-}"
  printf 'umask=%s\n' "$(umask)"
  printf 'lc_all=%s\n' "${LC_ALL-unset}"
  printf 'git_terminal_prompt=%s\n' "${GIT_TERMINAL_PROMPT-unset}"
  printf 'git_dir=%s\n' "${GIT_DIR-unset}"
  printf 'git_work_tree=%s\n' "${GIT_WORK_TREE-unset}"
  printf 'git_index_file=%s\n' "${GIT_INDEX_FILE-unset}"
  printf 'argc=%s\n' "$#"
  argument_index=0
  for argument in "$@"; do
    argument_index=$((argument_index + 1))
    printf 'arg%s=%s\n' "$argument_index" "$argument"
  done
  if [[ -f "$checkout_root/version.txt" ]]; then
    printf 'version=%s\n' "$(sed -n '1p' "$checkout_root/version.txt")"
  fi
} >"${CHECKOUT_TEST_LOG:?}"

if [[ -n ${CHECKOUT_TEST_BLOCK_READY:-} ]]; then
  printf '%s\n' "$$" >"$CHECKOUT_TEST_BLOCK_READY"
  if [[ -n ${CHECKOUT_TEST_BLOCK_CHILD_FILE:-} ]]; then
    sleep 86400 &
    block_child_pid=$!
    printf '%s\n' "$block_child_pid" >"$CHECKOUT_TEST_BLOCK_CHILD_FILE"
    wait "$block_child_pid"
  else
    while [[ ! -e ${CHECKOUT_TEST_BLOCK_RELEASE:?} ]]; do
      sleep 0.05
    done
  fi
fi

exit "${CHECKOUT_TEST_EXIT:-0}"
EOF
  chmod 0755 "$consumer/support/install-checkout.sh"
}

write_config() {
  local consumer=$1

  mkdir -p "$consumer/scripts"
  cat >"$consumer/scripts/checkout-installer.conf" <<'EOF'
# shellcheck shell=bash
# shellcheck disable=SC2034
CHECKOUT_INSTALLER_ENABLED=true
CHECKOUT_INSTALLER_REPO=example/example-tool
EOF
}

set +e
render_usage=$("$root/checkout-installer/render.sh" 2>&1)
render_usage_status=$?
set -e
[[ "$render_usage_status" -eq 2 && "$render_usage" == *'usage:'* ]] ||
  fail "renderer without a consumer did not return an actionable usage error"

consumer="$tmp/consumer"
write_config "$consumer"
write_delegate "$consumer"
printf 'direct\n' >"$consumer/version.txt"

"$root/checkout-installer/render.sh" "$consumer" >/dev/null ||
  fail "renderer did not generate an opted-in installer"
[[ -f "$consumer/install.sh" && ! -L "$consumer/install.sh" ]] ||
  fail "renderer did not create a regular top-level install.sh"
[[ -x "$consumer/install.sh" ]] ||
  fail "generated installer is not executable"
if grep -Eq '@[A-Z][A-Z0-9_]*@' "$consumer/install.sh"; then
  fail "generated installer retained a template token"
fi
grep -Fq '# Generated by cgraf78/actions checkout-installer. Do not edit.' \
  "$consumer/install.sh" ||
  fail "generated installer does not identify its provider"
[[ $(sed -n '9p' "$consumer/install.sh") == '  set -euo pipefail' ]] ||
  fail "generated installer is not formatter-stable inside its truncation guard"

git -C "$consumer" init --quiet --initial-branch=main --template=''
git -C "$consumer" config core.hooksPath /dev/null
git -C "$consumer" config commit.gpgsign false
git -C "$consumer" config user.name 'Checkout Installer Test'
git -C "$consumer" config user.email checkout-installer@example.invalid
git -C "$consumer" add .
git -C "$consumer" commit --quiet -m 'direct fixture'

safe_git_bin="$tmp/safe-git-bin"
safe_git_log="$tmp/safe-git.log"
safe_real_git=$(PATH=/usr/bin:/bin command -v git)
mkdir -p "$safe_git_bin"
cat >"$safe_git_bin/git" <<'EOF'
#!/usr/bin/env bash

safe_directory_seen=0
for git_argument in "$@"; do
  if [[ "$git_argument" == \
    "safe.directory=${CHECKOUT_TEST_SAFE_DIRECTORY:?}" ]]; then
    safe_directory_seen=1
    break
  fi
done
if [[ "$safe_directory_seen" -ne 1 ]]; then
  exit 128
fi
printf '<%s>' "$@" >>"$CHECKOUT_TEST_SAFE_GIT_LOG"
printf '\n' >>"$CHECKOUT_TEST_SAFE_GIT_LOG"
exec "$CHECKOUT_TEST_REAL_GIT" "$@"
EOF
chmod 0755 "$safe_git_bin/git"

direct_log="$tmp/direct.log"
(
  umask 0027
  CHECKOUT_TEST_LOG="$direct_log" PREFIX="$tmp/direct-prefix" \
    BIN_DIR="$tmp/direct-bin" LC_ALL=POSIX PATH="$safe_git_bin:$PATH" \
    CHECKOUT_TEST_REAL_GIT="$safe_real_git" \
    CHECKOUT_TEST_SAFE_DIRECTORY="$(cd "$consumer" && pwd -P)" \
    CHECKOUT_TEST_SAFE_GIT_LOG="$safe_git_log" \
    /bin/bash "$consumer/install.sh" \
    first 'two words' >/dev/null
) ||
  fail "direct checkout install did not delegate"
[[ $(wc -l <"$safe_git_log") -eq 2 ]] ||
  fail "direct checkout inspection did not scope every Git trust override"
grep -Fqx "root=$(cd "$consumer" && pwd -P)" "$direct_log" ||
  fail "direct checkout install delegated from the wrong root"
grep -Fqx "prefix=$tmp/direct-prefix" "$direct_log" ||
  fail "direct checkout install did not preserve PREFIX"
grep -Fqx "bin_dir=$tmp/direct-bin" "$direct_log" ||
  fail "direct checkout install did not preserve BIN_DIR"
grep -Fqx 'umask=0027' "$direct_log" ||
  fail "direct checkout install did not preserve the caller umask"
grep -Fqx 'lc_all=POSIX' "$direct_log" ||
  fail "direct checkout install did not preserve LC_ALL"
grep -Fqx 'argc=2' "$direct_log" ||
  fail "direct checkout install did not preserve the argument count"
grep -Fqx 'arg2=two words' "$direct_log" ||
  fail "direct checkout install did not preserve argument boundaries"

set +e
CHECKOUT_TEST_LOG="$direct_log" CHECKOUT_TEST_EXIT=23 \
  /bin/bash "$consumer/install.sh" >/dev/null 2>&1
direct_status=$?
set -e
[[ "$direct_status" -eq 23 ]] ||
  fail "direct checkout install did not preserve delegate status"

"$root/checkout-installer/render.sh" --check "$consumer" >/dev/null ||
  fail "freshly generated installer did not pass the render check"
printf '\n# local drift\n' >>"$consumer/install.sh"
if "$root/checkout-installer/render.sh" --check "$consumer" \
  >/dev/null 2>&1; then
  fail "drifted generated installer unexpectedly passed the render check"
fi
"$root/checkout-installer/render.sh" "$consumer" >/dev/null ||
  fail "renderer did not restore a drifted installer"

owned_consumer="$tmp/owned-consumer"
write_config "$owned_consumer"
write_delegate "$owned_consumer"
printf '#!/usr/bin/env bash\nprintf "consumer owned\\n"\n' \
  >"$owned_consumer/install.sh"
chmod 0755 "$owned_consumer/install.sh"
if "$root/checkout-installer/render.sh" "$owned_consumer" \
  >/dev/null 2>&1; then
  fail "renderer overwrote a consumer-owned installer"
fi
[[ $(/bin/bash "$owned_consumer/install.sh") == 'consumer owned' ]] ||
  fail "renderer changed a consumer-owned installer"

invalid_consumer="$tmp/invalid-consumer"
write_config "$invalid_consumer"
write_delegate "$invalid_consumer"
printf 'CHECKOUT_INSTALLER_DELEGATE=../outside.sh\n' \
  >>"$invalid_consumer/scripts/checkout-installer.conf"
if "$root/checkout-installer/render.sh" "$invalid_consumer" \
  >/dev/null 2>&1; then
  fail "renderer accepted a delegate outside the checkout"
fi
[[ ! -e "$invalid_consumer/install.sh" ]] ||
  fail "invalid delegate left a generated installer"

invalid_repo_consumer="$tmp/invalid-repo-consumer"
write_config "$invalid_repo_consumer"
write_delegate "$invalid_repo_consumer"
sed 's#example/example-tool#../source-tool#' \
  "$invalid_repo_consumer/scripts/checkout-installer.conf" \
  >"$invalid_repo_consumer/scripts/checkout-installer.conf.tmp"
mv "$invalid_repo_consumer/scripts/checkout-installer.conf.tmp" \
  "$invalid_repo_consumer/scripts/checkout-installer.conf"
if "$root/checkout-installer/render.sh" "$invalid_repo_consumer" \
  >/dev/null 2>&1; then
  fail "renderer accepted a dot-segment repository owner"
fi
[[ ! -e "$invalid_repo_consumer/install.sh" ]] ||
  fail "invalid repository owner left a generated installer"

option_delegate_consumer="$tmp/option-delegate-consumer"
write_config "$option_delegate_consumer"
printf 'CHECKOUT_INSTALLER_DELEGATE=--stage\n' \
  >>"$option_delegate_consumer/scripts/checkout-installer.conf"
printf '#!/usr/bin/env bash\n' >"$option_delegate_consumer/--stage"
chmod 0755 "$option_delegate_consumer/--stage"
if "$root/checkout-installer/render.sh" "$option_delegate_consumer" \
  >/dev/null 2>&1; then
  fail "renderer accepted an option-like delegate path"
fi
[[ ! -e "$option_delegate_consumer/install.sh" ]] ||
  fail "option-like delegate left a generated installer"

source_work="$tmp/source-work"
remote="$tmp/example-tool.git"
write_config "$source_work"
write_delegate "$source_work"
printf 'one\n' >"$source_work/version.txt"
"$root/checkout-installer/render.sh" "$source_work" >/dev/null
git -C "$source_work" init --quiet --initial-branch=main --template=''
git -C "$source_work" config core.hooksPath /dev/null
git -C "$source_work" config commit.gpgsign false
git -C "$source_work" config user.name 'Checkout Installer Test'
git -C "$source_work" config user.email checkout-installer@example.invalid
git -C "$source_work" add .
git -C "$source_work" commit --quiet -m 'initial fixture'
git init --quiet --bare --initial-branch=main "$remote"
git -C "$source_work" remote add origin "$remote"
git -C "$source_work" push --quiet --set-upstream origin main

standalone="$tmp/standalone"
standalone_marker="$tmp/standalone-delegate-ran"
mkdir -p "$standalone/support"
cp "$source_work/install.sh" "$standalone/install.sh"
cat >"$standalone/support/install-checkout.sh" <<EOF
#!/usr/bin/env bash
printf 'unexpected\n' >'$standalone_marker'
EOF
chmod 0755 "$standalone/support/install-checkout.sh"
set +e
CHECKOUT_TEST_LOG="$tmp/standalone.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$tmp/standalone-managed/example-tool" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$tmp/missing-standalone.git" \
  /bin/bash "$standalone/install.sh" >/dev/null 2>&1
standalone_status=$?
set -e
[[ "$standalone_status" -ne 0 ]] ||
  fail "downloaded installer with an adjacent stray delegate skipped bootstrap"
[[ ! -e "$standalone_marker" ]] ||
  fail "downloaded installer executed an adjacent stray delegate"

repo_url="file://$remote"
managed="$tmp/managed/example-tool"
pipe_log="$tmp/pipe.log"

truncated="$tmp/truncated-install.sh"
sed '$d' "$source_work/install.sh" >"$truncated"
set +e
CHECKOUT_TEST_LOG="$tmp/truncated.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$tmp/truncated-managed/example-tool" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$truncated" >/dev/null 2>&1
truncated_status=$?
set -e
[[ "$truncated_status" -ne 0 ]] ||
  fail "truncated piped installer reported success"
[[ ! -e "$tmp/truncated-managed/example-tool" ]] ||
  fail "truncated piped installer published a checkout"
[[ ! -e "$tmp/truncated.log" ]] ||
  fail "truncated piped installer invoked the delegate"

git_probe_bin="$tmp/git-probe-bin"
git_probe_marker="$tmp/git-consumed-installer-input"
git_probe_env_log="$tmp/git-bootstrap-environment"
real_git=$(PATH=/usr/bin:/bin command -v git)
mkdir -p "$git_probe_bin"
cat >"$git_probe_bin/git" <<'EOF'
#!/usr/bin/env bash

for git_argument in "$@"; do
  case "$git_argument" in
    clone | fetch)
      {
        printf 'askpass=%s\n' "${GIT_ASKPASS-unset}"
        printf 'ssh_askpass=%s\n' "${SSH_ASKPASS-unset}"
        printf 'git_ssh_command=%s\n' "${GIT_SSH_COMMAND-unset}"
        printf 'args='
        printf '<%s>' "$@"
        printf '\n'
      } >>"$CHECKOUT_TEST_GIT_ENV_LOG"
      if IFS= read -r stolen_installer_line; then
        printf '%s\n' "$stolen_installer_line" >"$CHECKOUT_TEST_GIT_STDIN_MARKER"
      fi
      break
      ;;
  esac
done
exec "$CHECKOUT_TEST_REAL_GIT" "$@"
EOF
chmod 0755 "$git_probe_bin/git"
(
  umask 0037
  CHECKOUT_TEST_LOG="$pipe_log" PREFIX="$tmp/pipe-prefix" \
    LC_ALL=POSIX \
    PATH="$git_probe_bin:$PATH" \
    CHECKOUT_TEST_REAL_GIT="$real_git" \
    CHECKOUT_TEST_GIT_STDIN_MARKER="$git_probe_marker" \
    CHECKOUT_TEST_GIT_ENV_LOG="$git_probe_env_log" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
    /bin/bash -s -- first 'two words' <"$source_work/install.sh" >/dev/null
) ||
  fail "piped install did not create a managed checkout"
[[ -d "$managed/.git" && ! -L "$managed" ]] ||
  fail "piped install did not retain a regular Git checkout"
grep -Fqx "root=$(cd "$managed" && pwd -P)" "$pipe_log" ||
  fail "piped install did not delegate from the managed checkout"
grep -Fqx "prefix=$tmp/pipe-prefix" "$pipe_log" ||
  fail "piped install did not preserve PREFIX"
grep -Fqx 'umask=0037' "$pipe_log" ||
  fail "piped install did not preserve the caller umask"
grep -Fqx 'lc_all=POSIX' "$pipe_log" ||
  fail "piped install did not preserve LC_ALL"
grep -Fqx 'git_terminal_prompt=unset' "$pipe_log" ||
  fail "piped install leaked bootstrap-only Git environment"
[[ ! -e "$git_probe_marker" ]] ||
  fail "piped install let Git consume installer input"
grep -Fqx 'askpass=/bin/false' "$git_probe_env_log" ||
  fail "piped install did not disable Git askpass"
grep -Fqx 'ssh_askpass=/bin/false' "$git_probe_env_log" ||
  fail "piped install did not disable SSH askpass"
grep -Fqx 'git_ssh_command=ssh -oBatchMode=yes' "$git_probe_env_log" ||
  fail "piped install did not force noninteractive SSH"
grep -Fq '<credential.helper=>' "$git_probe_env_log" ||
  fail "piped install did not disable Git credential helpers"
grep -Fqx 'arg2=two words' "$pipe_log" ||
  fail "piped install did not preserve argument boundaries"
[[ $(git -C "$managed" remote get-url origin) == "$repo_url" ]] ||
  fail "managed checkout retained the wrong origin"
[[ $(git -C "$managed" branch --show-current) == main ]] ||
  fail "managed checkout retained the wrong branch"

printf 'two\n' >"$source_work/version.txt"
git -C "$source_work" add version.txt
git -C "$source_work" commit --quiet -m 'update fixture'
git -C "$source_work" push --quiet
CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null ||
  fail "piped reinstall did not fast-forward a clean managed checkout"
[[ $(git -C "$managed" rev-parse HEAD) == $(git -C "$source_work" rev-parse HEAD) ]] ||
  fail "piped reinstall did not update to the remote main commit"
grep -Fqx 'version=two' "$pipe_log" ||
  fail "piped reinstall did not invoke the updated delegate"

blocking_ready="$tmp/blocking.ready"
blocking_release="$tmp/blocking.release"
CHECKOUT_TEST_LOG="$tmp/blocking.log" \
  CHECKOUT_TEST_BLOCK_READY="$blocking_ready" \
  CHECKOUT_TEST_BLOCK_RELEASE="$blocking_release" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >"$tmp/blocking.out" 2>&1 &
blocking_pid=$!
for _ in {1..100}; do
  [[ -e "$blocking_ready" ]] && break
  kill -0 "$blocking_pid" 2>/dev/null || break
  sleep 0.05
done
[[ -e "$blocking_ready" ]] ||
  fail "blocking delegate did not start"

printf 'three\n' >"$source_work/version.txt"
git -C "$source_work" add version.txt
git -C "$source_work" commit --quiet -m 'concurrent update fixture'
git -C "$source_work" push --quiet
blocked_head=$(git -C "$managed" rev-parse HEAD)
set +e
blocked_output=$(CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" 2>&1)
blocked_status=$?
set -e
[[ "$blocked_status" -ne 0 && "$blocked_output" == *'install.lock'* ]] ||
  fail "concurrent piped install did not respect the active delegate lock"
[[ $(git -C "$managed" rev-parse HEAD) == "$blocked_head" ]] ||
  fail "concurrent piped install updated the checkout during delegation"

: >"$blocking_release"
wait "$blocking_pid" ||
  fail "blocking delegate did not finish successfully"
blocking_pid=
blocking_release=
CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null ||
  fail "piped install did not update after the delegate released its lock"
grep -Fqx 'version=three' "$pipe_log" ||
  fail "post-lock piped install did not invoke the updated delegate"

signal_ready="$tmp/signal.ready"
signal_release="$tmp/signal.release"
signal_delegate_child_file="$tmp/signal.delegate-child"
CHECKOUT_TEST_LOG="$tmp/signal.log" \
  CHECKOUT_TEST_BLOCK_READY="$signal_ready" \
  CHECKOUT_TEST_BLOCK_RELEASE="$signal_release" \
  CHECKOUT_TEST_BLOCK_CHILD_FILE="$signal_delegate_child_file" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >"$tmp/signal.out" 2>&1 &
signal_pid=$!
for _ in {1..100}; do
  [[ -e "$signal_ready" && -e "$signal_delegate_child_file" ]] && break
  kill -0 "$signal_pid" 2>/dev/null || break
  sleep 0.05
done
[[ -e "$signal_ready" && -e "$signal_delegate_child_file" ]] ||
  fail "signal-forwarding delegate did not start"
signal_delegate_pid=$(sed -n '1p' "$signal_ready")
signal_delegate_child=$(sed -n '1p' "$signal_delegate_child_file")
kill -TERM "$signal_pid"
for _ in {1..100}; do
  ! kill -0 "$signal_pid" 2>/dev/null && break
  sleep 0.05
done
if kill -0 "$signal_pid" 2>/dev/null; then
  : >"$signal_release"
  wait "$signal_pid" 2>/dev/null || true
  fail "bootstrap did not forward TERM to its active delegate"
fi
set +e
wait "$signal_pid"
signal_status=$?
set -e
[[ "$signal_status" -eq 143 ]] ||
  fail "TERM did not produce bootstrap status 143"
signal_pid=
signal_release=
! kill -0 "$signal_delegate_pid" 2>/dev/null ||
  fail "bootstrap left its delegate running after TERM"
! kill -0 "$signal_delegate_child" 2>/dev/null ||
  fail "bootstrap left a delegate child running after TERM"
signal_delegate_child_file=
[[ ! -e "$tmp/managed/.example-tool.install.lock" ]] ||
  fail "bootstrap left its lock after TERM"

network_signal_bin="$tmp/network-signal-bin"
network_signal_ready="$tmp/network-signal.ready"
network_signal_release="$tmp/network-signal.release"
network_signal_managed="$tmp/network-signal-managed/example-tool"
mkdir -p "$network_signal_bin"
cat >"$network_signal_bin/git" <<'EOF'
#!/usr/bin/env bash

for git_argument in "$@"; do
  if [[ "$git_argument" == clone ]]; then
    printf '%s\n' "$$" >"$CHECKOUT_TEST_NETWORK_SIGNAL_READY"
    while [[ ! -e $CHECKOUT_TEST_NETWORK_SIGNAL_RELEASE ]]; do
      sleep 0.05
    done
    exit 1
  fi
done
exec "$CHECKOUT_TEST_REAL_GIT" "$@"
EOF
chmod 0755 "$network_signal_bin/git"
PATH="$network_signal_bin:$PATH" \
  CHECKOUT_TEST_REAL_GIT="$real_git" \
  CHECKOUT_TEST_NETWORK_SIGNAL_READY="$network_signal_ready" \
  CHECKOUT_TEST_NETWORK_SIGNAL_RELEASE="$network_signal_release" \
  CHECKOUT_TEST_LOG="$tmp/network-signal.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$network_signal_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" \
  >"$tmp/network-signal.out" 2>&1 &
network_signal_pid=$!
for _ in {1..100}; do
  [[ -e "$network_signal_ready" ]] && break
  kill -0 "$network_signal_pid" 2>/dev/null || break
  sleep 0.05
done
[[ -e "$network_signal_ready" ]] ||
  fail "network signal fixture did not reach Git clone"
network_git_pid=$(sed -n '1p' "$network_signal_ready")
kill -TERM "$network_signal_pid"
for _ in {1..100}; do
  ! kill -0 "$network_signal_pid" 2>/dev/null && break
  sleep 0.05
done
if kill -0 "$network_signal_pid" 2>/dev/null; then
  : >"$network_signal_release"
  wait "$network_signal_pid" 2>/dev/null || true
  fail "bootstrap did not forward TERM to active network Git"
fi
set +e
wait "$network_signal_pid"
network_signal_status=$?
set -e
[[ "$network_signal_status" -eq 143 ]] ||
  fail "TERM during network Git did not produce status 143"
network_signal_pid=
network_signal_release=
! kill -0 "$network_git_pid" 2>/dev/null ||
  fail "bootstrap left network Git running after TERM"
[[ ! -e "$network_signal_managed" && ! -L "$network_signal_managed" ]] ||
  fail "TERM during clone published a managed checkout"
[[ ! -e "$tmp/network-signal-managed/.example-tool.install.lock" ]] ||
  fail "TERM during clone left its install lock"
if compgen -G \
  "$tmp/network-signal-managed/.example-tool.clone.*" >/dev/null; then
  fail "TERM during clone left a staging checkout"
fi

poison="$tmp/poison"
poison_managed="$tmp/poison-managed/example-tool"
mkdir -p "$poison"
git -C "$poison" init --quiet --initial-branch=main --template=''
git -C "$poison" config core.hooksPath /dev/null
git -C "$poison" config commit.gpgsign false
git -C "$poison" config user.name 'Checkout Installer Test'
git -C "$poison" config user.email checkout-installer@example.invalid
printf 'poison\n' >"$poison/poison.txt"
git -C "$poison" add poison.txt
git -C "$poison" commit --quiet -m 'poison fixture'
poison_git_dir=$(git -C "$poison" rev-parse --absolute-git-dir)
poison_git_index="$poison_git_dir/index"
GIT_DIR="$poison_git_dir" \
  GIT_WORK_TREE="$poison" \
  GIT_INDEX_FILE="$poison_git_index" \
  GIT_IMPLICIT_WORK_TREE=0 \
  GIT_CONFIG_COUNT=1 \
  GIT_CONFIG_KEY_0=protocol.file.allow \
  GIT_CONFIG_VALUE_0=never \
  CHECKOUT_TEST_LOG="$tmp/poison.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$poison_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null ||
  fail "piped install did not isolate bootstrap Git repository variables"
grep -Fqx "root=$(cd "$poison_managed" && pwd -P)" "$tmp/poison.log" ||
  fail "Git environment poison redirected the managed checkout"
grep -Fqx "git_dir=$poison_git_dir" "$tmp/poison.log" ||
  fail "piped install did not restore GIT_DIR for the delegate"
grep -Fqx "git_work_tree=$poison" "$tmp/poison.log" ||
  fail "piped install did not restore GIT_WORK_TREE for the delegate"
grep -Fqx "git_index_file=$poison_git_index" "$tmp/poison.log" ||
  fail "piped install did not restore GIT_INDEX_FILE for the delegate"

race_bin="$tmp/race-bin"
race_managed="$tmp/race-managed/example-tool"
race_marker="$tmp/race-delegate-ran"
real_mv=$(PATH=/usr/bin:/bin command -v mv)
mkdir -p "$race_bin"
cat >"$race_bin/mv" <<'EOF'
#!/usr/bin/env bash

target=${!#}
mkdir -p "$target/support"
cat >"$target/support/install-checkout.sh" <<INNER
#!/usr/bin/env bash
printf 'unexpected\n' >'$CHECKOUT_TEST_RACE_MARKER'
INNER
chmod 0755 "$target/support/install-checkout.sh"
"$CHECKOUT_TEST_REAL_MV" "$@"
move_status=$?
if [[ ${CHECKOUT_TEST_RACE_TERM_PARENT:-0} == 1 ]]; then
  kill -TERM "$PPID"
fi
exit "$move_status"
EOF
chmod 0755 "$race_bin/mv"
set +e
race_output=$(PATH="$race_bin:$PATH" \
  CHECKOUT_TEST_REAL_MV="$real_mv" \
  CHECKOUT_TEST_RACE_MARKER="$race_marker" \
  CHECKOUT_TEST_LOG="$tmp/race.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$race_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" 2>&1)
race_status=$?
set -e
[[ "$race_status" -ne 0 && "$race_output" == *'publication'* ]] ||
  fail "piped install did not reject a destination publication race"
[[ ! -e "$race_marker" ]] ||
  fail "piped install executed a delegate planted during publication"
[[ -f "$race_managed/support/install-checkout.sh" ]] ||
  fail "publication-race rejection changed the foreign destination"
if compgen -G "$race_managed/.example-tool.clone.*" >/dev/null; then
  fail "publication-race rejection left its staged checkout nested"
fi

race_term_managed="$tmp/race-term-managed/example-tool"
set +e
PATH="$race_bin:$PATH" \
  CHECKOUT_TEST_REAL_MV="$real_mv" \
  CHECKOUT_TEST_RACE_MARKER="$race_marker" \
  CHECKOUT_TEST_RACE_TERM_PARENT=1 \
  CHECKOUT_TEST_LOG="$tmp/race-term.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$race_term_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null 2>&1
race_term_status=$?
set -e
[[ "$race_term_status" -eq 143 ]] ||
  fail "TERM during raced publication did not preserve status 143"
[[ ! -e "$race_marker" ]] ||
  fail "TERM during publication executed a planted delegate"
[[ -f "$race_term_managed/support/install-checkout.sh" ]] ||
  fail "TERM during publication changed the foreign destination"
if compgen -G "$race_term_managed/.example-tool.clone.*" >/dev/null; then
  fail "TERM during publication left its checkout nested"
fi
if compgen -G "$tmp/race-term-managed/.example-tool.publish.*" >/dev/null; then
  fail "TERM during publication left its identity file"
fi

migration_source="$tmp/migration-source"
migration_remote="$tmp/migration.git"
migration_managed="$tmp/migration-managed/example-tool"
write_config "$migration_source"
write_delegate "$migration_source"
mv "$migration_source/support/install-checkout.sh" \
  "$migration_source/support/install-old.sh"
printf 'CHECKOUT_INSTALLER_DELEGATE=support/install-old.sh\n' \
  >>"$migration_source/scripts/checkout-installer.conf"
"$root/checkout-installer/render.sh" "$migration_source" >/dev/null
git -C "$migration_source" init --quiet --initial-branch=main --template=''
git -C "$migration_source" config core.hooksPath /dev/null
git -C "$migration_source" config commit.gpgsign false
git -C "$migration_source" config user.name 'Checkout Installer Test'
git -C "$migration_source" config user.email checkout-installer@example.invalid
git -C "$migration_source" add .
git -C "$migration_source" commit --quiet -m 'old delegate path fixture'
git init --quiet --bare --initial-branch=main "$migration_remote"
git -C "$migration_source" remote add origin "$migration_remote"
git -C "$migration_source" push --quiet --set-upstream origin main
git clone --quiet --depth 1 --single-branch --branch main \
  "file://$migration_remote" "$migration_managed"
git -C "$migration_source" mv support/install-old.sh \
  support/install-checkout.sh
sed '/^CHECKOUT_INSTALLER_DELEGATE=/d' \
  "$migration_source/scripts/checkout-installer.conf" \
  >"$migration_source/scripts/checkout-installer.conf.tmp"
mv "$migration_source/scripts/checkout-installer.conf.tmp" \
  "$migration_source/scripts/checkout-installer.conf"
"$root/checkout-installer/render.sh" "$migration_source" >/dev/null
git -C "$migration_source" add scripts/checkout-installer.conf install.sh
git -C "$migration_source" commit --quiet -m 'migrate delegate path fixture'
git -C "$migration_source" push --quiet
CHECKOUT_TEST_LOG="$tmp/migration.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$migration_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$migration_remote" \
  /bin/bash -s <"$migration_source/install.sh" >/dev/null ||
  fail "piped update could not migrate the checkout delegate path"
[[ $(git -C "$migration_managed" rev-parse HEAD) == $(git -C "$migration_source" rev-parse HEAD) ]] ||
  fail "delegate path migration did not update the managed checkout"
grep -Fqx "root=$(cd "$migration_managed" && pwd -P)" \
  "$tmp/migration.log" ||
  fail "delegate path migration did not invoke the new delegate"

missing_source="$tmp/missing-source"
missing_remote="$tmp/missing-delegate.git"
missing_managed="$tmp/missing-managed/example-tool"
missing_fresh="$tmp/missing-fresh/example-tool"
write_config "$missing_source"
write_delegate "$missing_source"
printf 'present\n' >"$missing_source/version.txt"
"$root/checkout-installer/render.sh" "$missing_source" >/dev/null
git -C "$missing_source" init --quiet --initial-branch=main --template=''
git -C "$missing_source" config core.hooksPath /dev/null
git -C "$missing_source" config commit.gpgsign false
git -C "$missing_source" config user.name 'Checkout Installer Test'
git -C "$missing_source" config user.email checkout-installer@example.invalid
git -C "$missing_source" add .
git -C "$missing_source" commit --quiet -m 'delegate present fixture'
git init --quiet --bare --initial-branch=main "$missing_remote"
git -C "$missing_source" remote add origin "$missing_remote"
git -C "$missing_source" push --quiet --set-upstream origin main
missing_repo_url="file://$missing_remote"
CHECKOUT_TEST_LOG="$tmp/missing-initial.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$missing_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$missing_repo_url" \
  /bin/bash -s <"$missing_source/install.sh" >/dev/null ||
  fail "missing-delegate update fixture did not install initially"
missing_head=$(git -C "$missing_managed" rev-parse HEAD)
git -C "$missing_source" rm --quiet support/install-checkout.sh
git -C "$missing_source" commit --quiet -m 'remove delegate fixture'
git -C "$missing_source" push --quiet

set +e
missing_update_output=$(CHECKOUT_TEST_LOG="$tmp/missing-update.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$missing_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$missing_repo_url" \
  /bin/bash -s <"$missing_source/install.sh" 2>&1)
missing_update_status=$?
set -e
[[ "$missing_update_status" -ne 0 &&
  "$missing_update_output" == *'installer is missing'* ]] ||
  fail "update accepted a fetched revision without the delegate"
[[ $(git -C "$missing_managed" rev-parse HEAD) == "$missing_head" ]] ||
  fail "update changed revision before rejecting a missing delegate"

set +e
missing_fresh_output=$(CHECKOUT_TEST_LOG="$tmp/missing-fresh.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$missing_fresh" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$missing_repo_url" \
  /bin/bash -s <"$missing_source/install.sh" 2>&1)
missing_fresh_status=$?
set -e
[[ "$missing_fresh_status" -ne 0 &&
  "$missing_fresh_output" == *'installer is missing'* ]] ||
  fail "fresh clone accepted a revision without the delegate"
[[ ! -e "$missing_fresh" && ! -L "$missing_fresh" ]] ||
  fail "fresh clone published a checkout without the delegate"

set +e
CHECKOUT_TEST_LOG="$pipe_log" CHECKOUT_TEST_EXIT=29 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null 2>&1
pipe_status=$?
set -e
[[ "$pipe_status" -eq 29 ]] ||
  fail "piped install did not preserve delegate status"

printf 'dirty\n' >>"$managed/version.txt"
dirty_head=$(git -C "$managed" rev-parse HEAD)
set +e
dirty_output=$(CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" 2>&1)
dirty_status=$?
set -e
[[ "$dirty_status" -ne 0 && "$dirty_output" == *'dirty'* ]] ||
  fail "piped reinstall did not reject a dirty managed checkout"
[[ $(git -C "$managed" rev-parse HEAD) == "$dirty_head" ]] ||
  fail "dirty managed checkout changed revision before rejection"

foreign="$tmp/foreign/example-tool"
mkdir -p "$foreign"
printf 'owned elsewhere\n' >"$foreign/sentinel"
set +e
foreign_output=$(CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$foreign" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" 2>&1)
foreign_status=$?
set -e
[[ "$foreign_status" -ne 0 && "$foreign_output" == *'managed Git checkout'* ]] ||
  fail "piped install did not reject a foreign destination"
grep -Fqx 'owned elsewhere' "$foreign/sentinel" ||
  fail "foreign destination changed before rejection"

failed="$tmp/failed/example-tool"
set +e
CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$failed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$tmp/missing.git" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null 2>&1
failed_status=$?
set -e
[[ "$failed_status" -ne 0 ]] ||
  fail "piped install unexpectedly cloned a missing repository"
[[ ! -e "$failed" && ! -L "$failed" ]] ||
  fail "failed clone published a partial managed checkout"
if compgen -G "$tmp/failed/.example-tool.clone.*" >/dev/null; then
  fail "failed clone left a staging checkout"
fi

printf 'checkout-installer-test: ok\n'

[[ -L "$lock_claim_path" && ! -e "$lock_claim_path" ]] ||
  fail "killed claimant did not leave the canonical lock safely dangling"
lock_claim_target=$(readlink "$lock_claim_path")
[[ ! -e "$lock_claim_parent/$lock_claim_target" ]] ||
  fail "killed claimant left the owner at its pre-claim path"
compgen -G "$lock_claim_parent/.example-tool.install.lock.claim.*.*/owner/owner-v1" \
  >/dev/null ||
  fail "killed claimant did not preserve the nested owner record"

lock_claim_original=$(compgen -G \
  "$lock_claim_parent/.example-tool.install.lock.claim.*.*" || true)
lock_claim_original=${lock_claim_original%%$'\n'*}
: >"$lock_claim_original/unexpected-child"
set +e
lock_claim_extra_output=$(CHECKOUT_TEST_LOG="$tmp/lock-claim-extra.log" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=0 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_claim_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" 2>&1)
lock_claim_extra_status=$?
set -e
[[ "$lock_claim_extra_status" -ne 0 &&
  "$lock_claim_extra_output" == *'managed checkout lock is malformed'* ]] ||
  fail "v1 checkout lock accepted an unexpected active-claim child"
[[ -L "$lock_claim_path" && -f "$lock_claim_original/unexpected-child" ]] ||
  fail "unexpected active-claim rejection changed the diagnostic state"
rm -f "$lock_claim_original/unexpected-child"

lock_claim_base=${lock_claim_original##*/}
lock_claim_rest=${lock_claim_base#*.example-tool.install.lock.claim.}
lock_claim_owner_nonce=${lock_claim_rest%%.*}
lock_claim_second_nonce=11111111111111111111111111111111
lock_claim_second="$lock_claim_parent/.example-tool.install.lock.claim.${lock_claim_owner_nonce}.${lock_claim_second_nonce}"
cp -R "$lock_claim_original" "$lock_claim_second"
sed "s/^nonce=.*/nonce=$lock_claim_second_nonce/" \
  "$lock_claim_second/claim-v1" >"$lock_claim_second/claim-v1.next"
mv "$lock_claim_second/claim-v1.next" "$lock_claim_second/claim-v1"
chmod 0600 "$lock_claim_second/claim-v1"
set +e
lock_multiple_claims_output=$(CHECKOUT_TEST_LOG="$tmp/lock-multiple-claims.log" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=0 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_claim_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" 2>&1)
lock_multiple_claims_status=$?
set -e
[[ "$lock_multiple_claims_status" -ne 0 &&
  "$lock_multiple_claims_output" == *'managed checkout lock is malformed'* ]] ||
  fail "v1 checkout lock did not fail closed for multiple owner-bearing claims"
[[ -L "$lock_claim_path" && ! -e "$lock_claim_path" ]] ||
  fail "multiple-claim rejection changed the dangling canonical lock"
rm -f "$lock_claim_second/owner/owner-v1"
rmdir "$lock_claim_second/owner"
rm -f "$lock_claim_second/claim-v1"
rmdir "$lock_claim_second"

lock_claim_cleanup_bin="$tmp/lock-claim-cleanup-bin"
mkdir -p "$lock_claim_cleanup_bin"
cat >"$lock_claim_cleanup_bin/rmdir" <<'EOF'
#!/bin/sh
if [ "${1:-}" = "${CHECKOUT_TEST_FAIL_RMDIR:-}" ]; then
  exit 1
fi
exec "$CHECKOUT_TEST_REAL_RMDIR" "$@"
EOF
chmod 0755 "$lock_claim_cleanup_bin/rmdir"
CHECKOUT_TEST_LOG="$tmp/lock-claim-recover.log" \
  CHECKOUT_TEST_FAIL_RMDIR="$lock_claim_original" \
  CHECKOUT_TEST_REAL_RMDIR="$(command -v rmdir)" \
  PATH="$lock_claim_cleanup_bin:$platform_tool_path" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_claim_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" >/dev/null ||
  fail "v1 checkout lock did not recover a killed pre-detachment claimant"
[[ ! -e "$lock_claim_path" && ! -L "$lock_claim_path" ]] ||
  fail "claimant recovery left the canonical lock"
[[ -d "$lock_claim_original" &&
  -z $(ls -A "$lock_claim_original" 2>/dev/null) ]] ||
  fail "claimant recovery did not leave only the inert failed-cleanup claim"
lock_claim_remaining=$(compgen -G \
  "$lock_claim_parent/.example-tool.install.lock.claim.*" || true)
[[ "$lock_claim_remaining" == "$lock_claim_original" ]] ||
  fail "claimant recovery left an active or unrelated claim directory"
rmdir "$lock_claim_original"

# Both canonical reads follow a successful `-L` probe. Detachment between that
# probe and read 1 invalidates the outer classification snapshot; detachment at
# read 2 invalidates the claimant-count snapshot. A failed read while the path
# still appears to be a symlink is equally ambiguous because a new generation
# may already have replaced the detached one. Exercise all three boundaries
# with the same condition-based gate.
for lock_recheck_case in detach-1 detach-2 fail-1; do
  lock_recheck_mode=${lock_recheck_case%-*}
  lock_recheck_call=${lock_recheck_case#*-}
  lock_recheck_parent="$tmp/lock-recheck-$lock_recheck_case"
  lock_recheck_managed="$lock_recheck_parent/example-tool"
  lock_recheck_path="$lock_recheck_parent/.example-tool.install.lock"
  set +e
  CHECKOUT_TEST_LOG="$tmp/lock-recheck-kill.log" \
    PATH="$lock_claim_kill_bin:$platform_tool_path" \
    CHECKOUT_TEST_REAL_MV="$lock_real_mv" \
    CHECKOUT_TEST_LOCK_MV_KILL_MODE=claim \
    CHECKOUT_TEST_LOCK_MV_CANONICAL="$lock_recheck_path" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$lock_recheck_managed" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
    "$active_bash" -s <"$lock_source/install.sh" >/dev/null 2>&1
  lock_recheck_kill_status=$?
  set -e
  [[ "$lock_recheck_kill_status" -eq 137 ]] ||
    fail "canonical recheck fixture did not SIGKILL its claimant"
  lock_recheck_owner_record=$(compgen -G \
    "$lock_recheck_parent/.example-tool.install.lock.claim.*.*/owner/owner-v1" || true)
  lock_recheck_owner_record=${lock_recheck_owner_record%%$'\n'*}
  [[ -f "$lock_recheck_owner_record" && -L "$lock_recheck_path" ]] ||
    fail "canonical recheck fixture did not leave one attached dead claim"
  lock_recheck_claim=${lock_recheck_owner_record%/owner/owner-v1}
  lock_recheck_tombstone="$lock_recheck_claim/owner/canonical"

  lock_recheck_bin="$tmp/lock-recheck-bin"
  lock_recheck_count="$tmp/lock-recheck-$lock_recheck_case.count"
  lock_recheck_ready="$tmp/lock-recheck-$lock_recheck_case.ready"
  lock_recheck_release="$tmp/lock-recheck-$lock_recheck_case.release"
  lock_real_readlink=$(PATH="$platform_tool_path" command -v readlink)
  mkdir -p "$lock_recheck_bin"
  cat >"$lock_recheck_bin/readlink" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

target=${!#}
if [[ "$target" == "${CHECKOUT_TEST_RECHECK_CANONICAL:?}" ]]; then
  count=0
  if [[ -f "${CHECKOUT_TEST_RECHECK_COUNT:?}" ]]; then
    IFS= read -r count <"$CHECKOUT_TEST_RECHECK_COUNT"
  fi
  count=$((count + 1))
  printf '%s\n' "$count" >"$CHECKOUT_TEST_RECHECK_COUNT"
  if [[ "$count" -eq "${CHECKOUT_TEST_RECHECK_BLOCK_CALL:?}" ]]; then
    : >"${CHECKOUT_TEST_RECHECK_READY:?}"
    for _ in {1..500}; do
      [[ -e "${CHECKOUT_TEST_RECHECK_RELEASE:?}" ]] && break
      sleep 0.01
    done
    [[ -e "$CHECKOUT_TEST_RECHECK_RELEASE" ]] || exit 75
    if [[ "${CHECKOUT_TEST_RECHECK_MODE:?}" == fail ]]; then
      exit 1
    fi
  fi
fi
exec "${CHECKOUT_TEST_REAL_READLINK:?}" "$@"
EOF
  chmod 0755 "$lock_recheck_bin/readlink"

  CHECKOUT_TEST_LOG="$tmp/lock-recheck-recover.log" \
    PATH="$lock_recheck_bin:$platform_tool_path" \
    CHECKOUT_TEST_REAL_READLINK="$lock_real_readlink" \
    CHECKOUT_TEST_RECHECK_BLOCK_CALL="$lock_recheck_call" \
    CHECKOUT_TEST_RECHECK_MODE="$lock_recheck_mode" \
    CHECKOUT_TEST_RECHECK_CANONICAL="$lock_recheck_path" \
    CHECKOUT_TEST_RECHECK_COUNT="$lock_recheck_count" \
    CHECKOUT_TEST_RECHECK_READY="$lock_recheck_ready" \
    CHECKOUT_TEST_RECHECK_RELEASE="$lock_recheck_release" \
    CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=5 \
    CGRAF78_CHECKOUT_INSTALL_DIR="$lock_recheck_managed" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
    "$active_bash" -s <"$lock_source/install.sh" \
    >"$tmp/lock-recheck-recover.out" 2>&1 &
  lock_wait_pid=$!
  for _ in {1..500}; do
    [[ -e "$lock_recheck_ready" ]] && break
    sleep 0.01
  done
  if [[ ! -e "$lock_recheck_ready" ]]; then
    : >"$lock_recheck_release"
    wait "$lock_wait_pid" 2>/dev/null || true
    lock_wait_pid=
    fail "canonical recheck fixture did not reach $lock_recheck_case"
  fi
  if [[ "$lock_recheck_mode" == detach ]]; then
    "$lock_real_mv" "$lock_recheck_path" "$lock_recheck_tombstone" ||
      fail "canonical recheck fixture could not commit detachment"
  fi
  : >"$lock_recheck_release"
  set +e
  wait "$lock_wait_pid"
  lock_recheck_status=$?
  set -e
  lock_wait_pid=
  if [[ "$lock_recheck_status" -ne 0 ]]; then
    sed -n '1,120p' "$tmp/lock-recheck-recover.out" >&2
    fail "canonical ambiguity at $lock_recheck_case was treated as malformed"
  fi
  if grep -Fq 'managed checkout lock is malformed' \
    "$tmp/lock-recheck-recover.out"; then
    fail "canonical recheck emitted a malformed-lock diagnostic"
  fi
  grep -Fqx 'checkout_lock_kind=v1' "$tmp/lock-recheck-recover.log" ||
    fail "canonical recheck recovery did not acquire checkout lock v1"
  [[ ! -e "$lock_recheck_path" && ! -L "$lock_recheck_path" ]] ||
    fail "canonical recheck recovery left the canonical lock"
  if compgen -G "$lock_recheck_parent/.example-tool.install.lock.claim.*" \
    >/dev/null; then
    fail "canonical recheck recovery left a claim directory"
  fi
done

lock_detach_managed="$tmp/lock-detach/example-tool"
lock_detach_parent="$tmp/lock-detach"
lock_detach_path="$lock_detach_parent/.example-tool.install.lock"
set +e
CHECKOUT_TEST_LOG="$tmp/lock-detach.log" \
  PATH="$lock_claim_kill_bin:$platform_tool_path" \
  CHECKOUT_TEST_REAL_MV="$lock_real_mv" \
  CHECKOUT_TEST_LOCK_MV_KILL_MODE=detach \
  CHECKOUT_TEST_LOCK_MV_CANONICAL="$lock_detach_path" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_detach_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" >/dev/null 2>&1
lock_detach_kill_status=$?
set -e
[[ "$lock_detach_kill_status" -eq 137 ]] ||
  fail "v1 checkout lock detach fixture did not SIGKILL its claimant"
[[ ! -e "$lock_detach_path" && ! -L "$lock_detach_path" ]] ||
  fail "killed post-detachment claimant republished the canonical lock"
compgen -G "$lock_detach_parent/.example-tool.install.lock.claim.*.*/owner/canonical" \
  >/dev/null ||
  fail "killed post-detachment claimant did not preserve its tombstone"

# These two recovery processes each perform a complete managed checkout update
# after the detached claim has been reclaimed.  The second must wait for the
# first live generation, and macOS can take longer than the former five-second
# test ceiling to clone the local fixture.  Keep the race bounded without
# treating correct serialization as a lock failure.
lock_detach_timeout=30
CHECKOUT_TEST_LOG="$tmp/lock-detach-recover-one.log" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS="$lock_detach_timeout" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_detach_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" \
  >"$tmp/lock-detach-recover-one.out" 2>&1 &
lock_detach_one_pid=$!
CHECKOUT_TEST_LOG="$tmp/lock-detach-recover-two.log" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS="$lock_detach_timeout" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_detach_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" \
  >"$tmp/lock-detach-recover-two.out" 2>&1 &
lock_detach_two_pid=$!
set +e
wait "$lock_detach_one_pid"
lock_detach_one_status=$?
wait "$lock_detach_two_pid"
lock_detach_two_status=$?
set -e
if [[ "$lock_detach_one_status" -ne 0 ||
  "$lock_detach_two_status" -ne 0 ]]; then
  sed -n '1,120p' "$tmp/lock-detach-recover-one.out" >&2
  sed -n '1,120p' "$tmp/lock-detach-recover-two.out" >&2
  fail "two v1 cleaners did not serialize a committed detached claim"
fi
[[ ! -e "$lock_detach_path" && ! -L "$lock_detach_path" ]] ||
  fail "post-detachment cleanup changed the next lock generation"
if compgen -G "$lock_detach_parent/.example-tool.install.lock.claim.*" \
  >/dev/null; then
  fail "post-detachment cleanup left a claim directory"
fi

# Recover a real interrupted publication only after the dead v1 owner has been
# reclaimed and a fresh canonical generation is held. This couples the lock
# boundary to the existing transaction protocol instead of testing each in
# isolation.
lock_transaction_managed="$tmp/lock-transaction/example-tool"
lock_transaction_parent="$tmp/lock-transaction"
lock_transaction_path="$lock_transaction_parent/.example-tool.install.transaction"
lock_transaction_lock="$lock_transaction_parent/.example-tool.install.lock"
CHECKOUT_TEST_LOG="$tmp/lock-transaction-initial.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_transaction_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" >/dev/null ||
  fail "v1 transaction fixture could not install its initial checkout"
printf 'lock-transaction-v2\n' >"$lock_source/version.txt"
git -C "$lock_source" add version.txt
git -C "$lock_source" commit --quiet -m 'v1 interrupted transaction fixture'
git -C "$lock_source" push --quiet
lock_transaction_bin="$tmp/lock-transaction-bin"
mkdir -p "$lock_transaction_bin"
cat >"$lock_transaction_bin/mv" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

destination=${!#}
"${CHECKOUT_TEST_REAL_MV:?}" "$@"
status=$?
if [[ "$status" -eq 0 &&
  "$destination" == "${CHECKOUT_TEST_TRANSACTION_DESTINATION:?}" ]]; then
  kill -KILL "$PPID"
fi
exit "$status"
EOF
chmod 0755 "$lock_transaction_bin/mv"
set +e
CHECKOUT_TEST_LOG="$tmp/lock-transaction-crash.log" \
  PATH="$lock_transaction_bin:$platform_tool_path" \
  CHECKOUT_TEST_REAL_MV="$lock_real_mv" \
  CHECKOUT_TEST_TRANSACTION_DESTINATION="$lock_transaction_managed" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_transaction_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" >/dev/null 2>&1
lock_transaction_crash_status=$?
set -e
[[ "$lock_transaction_crash_status" -eq 137 ]] ||
  fail "v1 transaction fixture did not SIGKILL after publication"
[[ -L "$lock_transaction_lock" &&
  -d "$lock_transaction_path/previous/.git" &&
  -d "$lock_transaction_managed/.git" ]] ||
  fail "v1 transaction crash did not preserve its lock and both revisions"
CHECKOUT_TEST_LOG="$tmp/lock-transaction-recover.log" \
  CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS=2 \
  CGRAF78_CHECKOUT_INSTALL_DIR="$lock_transaction_managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$lock_remote" \
  "$active_bash" -s <"$lock_source/install.sh" >/dev/null ||
  fail "v1 stale-lock recovery did not finish the interrupted transaction"
[[ ! -e "$lock_transaction_lock" && ! -L "$lock_transaction_lock" &&
  ! -e "$lock_transaction_path" && ! -L "$lock_transaction_path" ]] ||
  fail "v1 transaction recovery left lock or transaction state"
grep -Fqx 'version=lock-transaction-v2' \
  "$tmp/lock-transaction-recover.log" ||
  fail "v1 transaction recovery did not delegate from the committed revision"

# Execute the shared vectors against the same fragment rendered into consumer
# installers. Shdeps vendors these exact TSV bytes, so this is the provider-side
# guard against either implementation quietly assigning them different meaning.
# shellcheck source=checkout-installer/lock-v1.sh.in
. "$root/checkout-installer/lock-v1.sh.in"

# Classification must snapshot a canonical symlink before probing the object
# forms that can replace it. This DEBUG trap is deliberately structural: the
# old missing -> directory -> symlink order reaches the directory probe, where
# the trap commits detachment and exposes the false `malformed` result. With
# symlink-first classification the directory probe is never reached for this
# generation; the readlink boundary is covered by the gated integration cases
# above.
lock_preread_parent="$tmp/lock-preread"
checkout_dir="$lock_preread_parent/example-tool"
checkout_parent=$lock_preread_parent
checkout_name=example-tool
lock_dir="$checkout_parent/.example-tool.install.lock"
mkdir -p "$checkout_parent"
# These globals are the sourced lock helper's state interface. ShellCheck sees
# only the fixture's direct references, not the helper's indirect reads/writes.
# shellcheck disable=SC2034
lock_held=0
# shellcheck disable=SC2034
lock_owner_nonce=
lock_owner_target=
# shellcheck disable=SC2034
lock_owner_dir=
# shellcheck disable=SC2034
lock_claim_dir=
checkout_lock_prepare_owner ||
  fail "pre-read classification fixture could not prepare an owner"
ln -s "$lock_owner_target" "$lock_dir" ||
  fail "pre-read classification fixture could not publish its owner"
# shellcheck disable=SC2034 # Consumed by release_checkout_lock_v1_strict.
lock_held=1
lock_preread_armed=1
lock_preread_detached="$lock_preread_parent/detached-canonical"
lock_preread_debug() {
  # shellcheck disable=SC2016 # Match the literal command text seen by DEBUG.
  if [[ "$lock_preread_armed" -eq 1 &&
    "$BASH_COMMAND" == '[[ -d "$lock_dir" && ! -L "$lock_dir" ]]' ]]; then
    lock_preread_armed=0
    mv "$lock_dir" "$lock_preread_detached"
  fi
}
set -T
trap lock_preread_debug DEBUG
checkout_lock_classify
trap - DEBUG
set +T
[[ "$lock_preread_armed" -eq 1 &&
  "$CHECKOUT_LOCK_STATE" == owner-live ]] ||
  fail "checkout lock inspected non-symlink forms before its symlink snapshot"
release_checkout_lock_v1_strict ||
  fail "pre-read classification fixture could not release its owner"

checkout_lock_parse_timeout 08 ||
  fail "checkout lock rejected a valid leading-zero decimal timeout"
[[ "$CHECKOUT_LOCK_TIMEOUT" -eq 8 ]] ||
  fail "checkout lock did not normalize a leading-zero decimal timeout"
if checkout_lock_parse_timeout 9999999999; then
  fail "checkout lock accepted a timeout outside its arithmetic bound"
fi

# shellcheck disable=SC2034,SC2329 # Overrides are called by the sourced fragment.
if ! (
  checkout_lock_process_identity() {
    # shellcheck disable=SC2030 # This probe is intentionally subshell-local.
    CHECKOUT_LOCK_START_KIND_HEX=70732d6c7374617274
    # shellcheck disable=SC2030 # This probe is intentionally subshell-local.
    CHECKOUT_LOCK_START_TOKEN_HEX=313233
    CHECKOUT_LOCK_PROCESS_STATE=S
  }
  CHECKOUT_LOCK_RECORD_HOST_HEX=$(checkout_lock_hex \
    "$(LC_ALL=C command uname -n)")
  # shellcheck disable=SC2030 # This probe is intentionally subshell-local.
  CHECKOUT_LOCK_RECORD_PID=1
  CHECKOUT_LOCK_RECORD_START_KIND_HEX=70726f632d73746174
  CHECKOUT_LOCK_RECORD_START_TOKEN_HEX=313233
  checkout_lock_record_liveness
  [[ "$CHECKOUT_LOCK_LIVENESS" == unknown ]]
); then
  fail "checkout lock treated a process-probe backend change as PID reuse"
fi

# shellcheck disable=SC2329 # Overrides are called by the sourced fragment.
if ! (
  # A failed signal probe is not proof of death: EPERM and policy restrictions
  # can hide a process whose PID is still observable. Use this test shell rather
  # than system PID 1 because Android may hide system processes from Termux even
  # though the app's own processes remain visible. Force that ambiguity and
  # require the liveness layer to stay fail-closed.
  checkout_lock_process_identity() { return 1; }
  kill() { return 1; }
  CHECKOUT_LOCK_RECORD_HOST_HEX=$(checkout_lock_hex \
    "$(LC_ALL=C command uname -n)")
  # shellcheck disable=SC2030 # This probe is intentionally subshell-local.
  CHECKOUT_LOCK_RECORD_PID=$$
  CHECKOUT_LOCK_RECORD_START_KIND_HEX=70726f632d73746174
  CHECKOUT_LOCK_RECORD_START_TOKEN_HEX=30
  checkout_lock_record_liveness
  [[ "$CHECKOUT_LOCK_LIVENESS" == unknown ]]
); then
  fail "checkout lock treated an ambiguous process probe as positive death"
fi

lock_probe_bin="$tmp/lock-probe-bin"
mkdir -p "$lock_probe_bin"
cat >"$lock_probe_bin/ps" <<'EOF'
#!/usr/bin/env bash
exit 2
EOF
chmod 0755 "$lock_probe_bin/ps"
# shellcheck disable=SC2329 # Overrides are called by the sourced fragment.
if ! (
  checkout_lock_process_identity() { return 1; }
  checkout_lock_procfs_authoritative() { return 1; }
  kill() { return 1; }
  PATH="$lock_probe_bin:$PATH"
  CHECKOUT_LOCK_RECORD_HOST_HEX=$(checkout_lock_hex \
    "$(LC_ALL=C command uname -n)")
  # shellcheck disable=SC2030 # This probe is intentionally subshell-local.
  CHECKOUT_LOCK_RECORD_PID=1
  CHECKOUT_LOCK_RECORD_START_KIND_HEX=70732d6c7374617274
  CHECKOUT_LOCK_RECORD_START_TOKEN_HEX=30
  checkout_lock_record_liveness
  [[ "$CHECKOUT_LOCK_LIVENESS" == unknown ]]
); then
  fail "checkout lock trusted a non-authoritative procfs absence"
fi

# shellcheck disable=SC2034 # Record globals are read by the sourced fragment.
if ! (
  zombie_parent=
  trap 'if [[ -n "$zombie_parent" ]]; then
          kill -CONT "$zombie_parent" 2>/dev/null || true
          wait "$zombie_parent" 2>/dev/null || true
        fi' EXIT
  zombie_pid_file="$tmp/lock-zombie.pid"
  # shellcheck disable=SC2016 # The child shell owns these expansions.
  "$active_bash" -c '
    sleep 0.05 &
    child=$!
    printf "%s\n" "$child" >"$1"
    kill -STOP "$$"
    wait "$child"
  ' _ "$zombie_pid_file" &
  zombie_parent=$!
  for _ in {1..100}; do
    [[ -s "$zombie_pid_file" ]] && break
    sleep 0.01
  done
  [[ -s "$zombie_pid_file" ]] || exit 1
  zombie_pid=$(sed -n '1p' "$zombie_pid_file")
  zombie_state=
  for _ in {1..100}; do
    zombie_state=$(LC_ALL=C command ps -o stat= -p "$zombie_pid" \
      2>/dev/null | command awk 'NR == 1 { print substr($1, 1, 1) }')
    [[ "$zombie_state" == Z ]] && break
    sleep 0.01
  done
  [[ "$zombie_state" == Z ]] || exit 1
  checkout_lock_process_identity "$zombie_pid" || exit 1
  CHECKOUT_LOCK_RECORD_HOST_HEX=$(checkout_lock_hex \
    "$(LC_ALL=C command uname -n)")
  # shellcheck disable=SC2030 # This probe is intentionally subshell-local.
  CHECKOUT_LOCK_RECORD_PID=$zombie_pid
  # shellcheck disable=SC2031 # Values were freshly set by the real probe above.

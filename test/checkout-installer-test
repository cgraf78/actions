race_term_managed="$tmp/race-term-managed/example-tool"
set +e
PATH="$race_path" \
  CHECKOUT_TEST_REAL_LN="$real_ln" \
  CHECKOUT_TEST_REAL_MV="$real_mv" \
  CHECKOUT_TEST_RACE_MARKER="$race_marker" \

#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
blocking_pid=
blocking_release=
signal_pid=
signal_release=
signal_delegate_child_file=
network_signal_pid=
network_signal_release=
interrupt_killer_pid=

cleanup() {
  if [[ -n "$blocking_release" ]]; then
    : >"$blocking_release"
  fi
  if [[ -n "$blocking_pid" ]]; then
    wait "$blocking_pid" 2>/dev/null || true
  fi
  if [[ -n "$signal_release" ]]; then
    : >"$signal_release"
  fi
  if [[ -n "$signal_delegate_child_file" &&
    -f "$signal_delegate_child_file" ]]; then
    signal_delegate_child=$(sed -n '1p' "$signal_delegate_child_file")
    kill -TERM "$signal_delegate_child" 2>/dev/null || true
  fi
  if [[ -n "$signal_pid" ]]; then
    wait "$signal_pid" 2>/dev/null || true
  fi
  if [[ -n "$network_signal_release" ]]; then
    : >"$network_signal_release"
  fi
  if [[ -n "$network_signal_pid" ]]; then
    wait "$network_signal_pid" 2>/dev/null || true
  fi
  if [[ -n "$interrupt_killer_pid" ]]; then
    kill -TERM "$interrupt_killer_pid" 2>/dev/null || true
    wait "$interrupt_killer_pid" 2>/dev/null || true
  fi
  rm -rf "$tmp"
}

trap cleanup EXIT

fail() {
  printf 'checkout-installer-test: %s\n' "$1" >&2
  exit 1
}

interrupt_parent_of_ready_child() {
  local ready=$1 timeout_marker=$2 child parent

  for _ in {1..100}; do
    [[ -e "$ready" ]] && break
    sleep 0.05
  done
  [[ -e "$ready" ]] || return 1
  child=$(sed -n '1p' "$ready")
  parent=$(ps -o ppid= -p "$child" 2>/dev/null || true)
  parent=${parent//[[:space:]]/}
  if [[ -z "$parent" ]]; then
    : >"$timeout_marker"
    kill -TERM "$child" 2>/dev/null || true
    return 1
  fi

  kill -INT "$parent"
  for _ in {1..100}; do
    ! kill -0 "$parent" 2>/dev/null && return 0
    sleep 0.05
  done

  : >"$timeout_marker"
  kill -TERM "$child" 2>/dev/null || true
  kill -TERM "$parent" 2>/dev/null || true
}

write_delegate() {
  local consumer=$1

  mkdir -p "$consumer/support"
  cat >"$consumer/support/install-checkout.sh" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

checkout_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
{
  printf 'root=%s\n' "$checkout_root"
  printf 'prefix=%s\n' "${PREFIX:-}"
  printf 'bin_dir=%s\n' "${BIN_DIR:-}"
  printf 'umask=%s\n' "$(umask)"
  printf 'lc_all=%s\n' "${LC_ALL-unset}"
  printf 'git_terminal_prompt=%s\n' "${GIT_TERMINAL_PROMPT-unset}"
  printf 'git_dir=%s\n' "${GIT_DIR-unset}"
  printf 'git_work_tree=%s\n' "${GIT_WORK_TREE-unset}"
  printf 'git_index_file=%s\n' "${GIT_INDEX_FILE-unset}"
  printf 'bash=%s\n' "$BASH"
  printf 'argc=%s\n' "$#"
  argument_index=0
  for argument in "$@"; do
    argument_index=$((argument_index + 1))
    printf 'arg%s=%s\n' "$argument_index" "$argument"
  done
  if [[ -f "$checkout_root/version.txt" ]]; then
    printf 'version=%s\n' "$(sed -n '1p' "$checkout_root/version.txt")"
  fi
} >"${CHECKOUT_TEST_LOG:?}"

if [[ -n ${CHECKOUT_TEST_BLOCK_READY:-} ]]; then
  printf '%s\n' "$$" >"$CHECKOUT_TEST_BLOCK_READY"
  if [[ -n ${CHECKOUT_TEST_BLOCK_CHILD_FILE:-} ]]; then
    sleep 86400 &
    block_child_pid=$!
    printf '%s\n' "$block_child_pid" >"$CHECKOUT_TEST_BLOCK_CHILD_FILE"
    wait "$block_child_pid"
  else
    while [[ ! -e ${CHECKOUT_TEST_BLOCK_RELEASE:?} ]]; do
      sleep 0.05
    done
  fi
fi

exit "${CHECKOUT_TEST_EXIT:-0}"
EOF
  chmod 0755 "$consumer/support/install-checkout.sh"
}

write_config() {
  local consumer=$1

  mkdir -p "$consumer/scripts"
  cat >"$consumer/scripts/checkout-installer.conf" <<'EOF'
# shellcheck shell=bash
# shellcheck disable=SC2034
CHECKOUT_INSTALLER_ENABLED=true
CHECKOUT_INSTALLER_REPO=example/example-tool
EOF
}

set +e
render_usage=$("$root/checkout-installer/render.sh" 2>&1)
render_usage_status=$?
set -e
[[ "$render_usage_status" -eq 2 && "$render_usage" == *'usage:'* ]] ||
  fail "renderer without a consumer did not return an actionable usage error"

consumer="$tmp/consumer"
write_config "$consumer"
write_delegate "$consumer"
printf 'direct\n' >"$consumer/version.txt"

"$root/checkout-installer/render.sh" "$consumer" >/dev/null ||
  fail "renderer did not generate an opted-in installer"
[[ -f "$consumer/install.sh" && ! -L "$consumer/install.sh" ]] ||
  fail "renderer did not create a regular top-level install.sh"
[[ -x "$consumer/install.sh" ]] ||
  fail "generated installer is not executable"
if grep -Eq '@[A-Z][A-Z0-9_]*@' "$consumer/install.sh"; then
  fail "generated installer retained a template token"
fi
grep -Fq '# Generated by cgraf78/actions checkout-installer. Do not edit.' \
  "$consumer/install.sh" ||
  fail "generated installer does not identify its provider"
[[ $(sed -n '9p' "$consumer/install.sh") == '  set -euo pipefail' ]] ||
  fail "generated installer is not formatter-stable inside its truncation guard"
if command -v shfmt >/dev/null 2>&1; then
  shfmt_diff="$tmp/generated-installer.shfmt.diff"
  if ! shfmt -d -i 2 -ci "$consumer/install.sh" >"$shfmt_diff"; then
    sed -n '1,80p' "$shfmt_diff" >&2
    fail "generated installer is not stable under the repository formatter"
  fi
fi

git -C "$consumer" init --quiet --initial-branch=main --template=''
git -C "$consumer" config core.hooksPath /dev/null
git -C "$consumer" config commit.gpgsign false
git -C "$consumer" config user.name 'Checkout Installer Test'
git -C "$consumer" config user.email checkout-installer@example.invalid
git -C "$consumer" add .
git -C "$consumer" commit --quiet -m 'direct fixture'

safe_git_bin="$tmp/safe-git-bin"
safe_git_log="$tmp/safe-git.log"
safe_real_git=$(PATH=/usr/bin:/bin command -v git)
mkdir -p "$safe_git_bin"
cat >"$safe_git_bin/git" <<'EOF'
#!/usr/bin/env bash

safe_directory_seen=0
for git_argument in "$@"; do
  if [[ "$git_argument" == \
    "safe.directory=${CHECKOUT_TEST_SAFE_DIRECTORY:?}" ]]; then
    safe_directory_seen=1
    break
  fi
done
if [[ "$safe_directory_seen" -ne 1 ]]; then
  exit 128
fi
printf '<%s>' "$@" >>"$CHECKOUT_TEST_SAFE_GIT_LOG"
printf '\n' >>"$CHECKOUT_TEST_SAFE_GIT_LOG"
exec "$CHECKOUT_TEST_REAL_GIT" "$@"
EOF
chmod 0755 "$safe_git_bin/git"

direct_log="$tmp/direct.log"
(
  umask 0027
  CHECKOUT_TEST_LOG="$direct_log" PREFIX="$tmp/direct-prefix" \
    BIN_DIR="$tmp/direct-bin" LC_ALL=POSIX PATH="$safe_git_bin:$PATH" \
    CHECKOUT_TEST_REAL_GIT="$safe_real_git" \
    CHECKOUT_TEST_SAFE_DIRECTORY="$(cd "$consumer" && pwd -P)" \
    CHECKOUT_TEST_SAFE_GIT_LOG="$safe_git_log" \
    /bin/bash "$consumer/install.sh" \
    first 'two words' >/dev/null
) ||
  fail "direct checkout install did not delegate"
[[ $(wc -l <"$safe_git_log") -eq 2 ]] ||
  fail "direct checkout inspection did not scope every Git trust override"
grep -Fqx "root=$(cd "$consumer" && pwd -P)" "$direct_log" ||
  fail "direct checkout install delegated from the wrong root"
grep -Fqx "prefix=$tmp/direct-prefix" "$direct_log" ||
  fail "direct checkout install did not preserve PREFIX"
grep -Fqx "bin_dir=$tmp/direct-bin" "$direct_log" ||
  fail "direct checkout install did not preserve BIN_DIR"
grep -Fqx 'umask=0027' "$direct_log" ||
  fail "direct checkout install did not preserve the caller umask"
grep -Fqx 'lc_all=POSIX' "$direct_log" ||
  fail "direct checkout install did not preserve LC_ALL"
grep -Fqx 'argc=2' "$direct_log" ||
  fail "direct checkout install did not preserve the argument count"
grep -Fqx 'arg2=two words' "$direct_log" ||
  fail "direct checkout install did not preserve argument boundaries"

alternate_bash="$tmp/alternate-bash"
ln -s "$BASH" "$alternate_bash"
alternate_direct_log="$tmp/alternate-direct.log"
CHECKOUT_TEST_LOG="$alternate_direct_log" \
  "$alternate_bash" "$consumer/install.sh" >/dev/null ||
  fail "direct checkout install failed under an alternate Bash path"
grep -Fqx "bash=$alternate_bash" "$alternate_direct_log" ||
  fail "direct checkout install did not preserve the selected Bash interpreter"

set +e
CHECKOUT_TEST_LOG="$direct_log" CHECKOUT_TEST_EXIT=23 \
  /bin/bash "$consumer/install.sh" >/dev/null 2>&1
direct_status=$?
set -e
[[ "$direct_status" -eq 23 ]] ||
  fail "direct checkout install did not preserve delegate status"

"$root/checkout-installer/render.sh" --check "$consumer" >/dev/null ||
  fail "freshly generated installer did not pass the render check"
printf '\n# local drift\n' >>"$consumer/install.sh"
if "$root/checkout-installer/render.sh" --check "$consumer" \
  >/dev/null 2>&1; then
  fail "drifted generated installer unexpectedly passed the render check"
fi
"$root/checkout-installer/render.sh" "$consumer" >/dev/null ||
  fail "renderer did not restore a drifted installer"

owned_consumer="$tmp/owned-consumer"
write_config "$owned_consumer"
write_delegate "$owned_consumer"
printf '#!/usr/bin/env bash\nprintf "consumer owned\\n"\n' \
  >"$owned_consumer/install.sh"
chmod 0755 "$owned_consumer/install.sh"
if "$root/checkout-installer/render.sh" "$owned_consumer" \
  >/dev/null 2>&1; then
  fail "renderer overwrote a consumer-owned installer"
fi
[[ $(/bin/bash "$owned_consumer/install.sh") == 'consumer owned' ]] ||
  fail "renderer changed a consumer-owned installer"

invalid_consumer="$tmp/invalid-consumer"
write_config "$invalid_consumer"
write_delegate "$invalid_consumer"
printf 'CHECKOUT_INSTALLER_DELEGATE=../outside.sh\n' \
  >>"$invalid_consumer/scripts/checkout-installer.conf"
if "$root/checkout-installer/render.sh" "$invalid_consumer" \
  >/dev/null 2>&1; then
  fail "renderer accepted a delegate outside the checkout"
fi
[[ ! -e "$invalid_consumer/install.sh" ]] ||
  fail "invalid delegate left a generated installer"

self_delegate_consumer="$tmp/self-delegate-consumer"
write_config "$self_delegate_consumer"
write_delegate "$self_delegate_consumer"
"$root/checkout-installer/render.sh" "$self_delegate_consumer" >/dev/null
cp "$self_delegate_consumer/install.sh" \
  "$self_delegate_consumer/install.sh.before"
printf 'CHECKOUT_INSTALLER_DELEGATE=install.sh\n' \
  >>"$self_delegate_consumer/scripts/checkout-installer.conf"
set +e
self_delegate_output=$("$root/checkout-installer/render.sh" \
  "$self_delegate_consumer" 2>&1)
self_delegate_status=$?
set -e
[[ "$self_delegate_status" -ne 0 &&
  "$self_delegate_output" == *'must not be install.sh'* ]] ||
  fail "renderer accepted install.sh as its own delegate"
cmp -s "$self_delegate_consumer/install.sh.before" \
  "$self_delegate_consumer/install.sh" ||
  fail "self-delegate rejection changed the previous generated installer"

invalid_repo_consumer="$tmp/invalid-repo-consumer"
write_config "$invalid_repo_consumer"
write_delegate "$invalid_repo_consumer"
sed 's#example/example-tool#../source-tool#' \
  "$invalid_repo_consumer/scripts/checkout-installer.conf" \
  >"$invalid_repo_consumer/scripts/checkout-installer.conf.tmp"
mv "$invalid_repo_consumer/scripts/checkout-installer.conf.tmp" \
  "$invalid_repo_consumer/scripts/checkout-installer.conf"
if "$root/checkout-installer/render.sh" "$invalid_repo_consumer" \
  >/dev/null 2>&1; then
  fail "renderer accepted a dot-segment repository owner"
fi
[[ ! -e "$invalid_repo_consumer/install.sh" ]] ||
  fail "invalid repository owner left a generated installer"

option_delegate_consumer="$tmp/option-delegate-consumer"
write_config "$option_delegate_consumer"
printf 'CHECKOUT_INSTALLER_DELEGATE=--stage\n' \
  >>"$option_delegate_consumer/scripts/checkout-installer.conf"
printf '#!/usr/bin/env bash\n' >"$option_delegate_consumer/--stage"
chmod 0755 "$option_delegate_consumer/--stage"
if "$root/checkout-installer/render.sh" "$option_delegate_consumer" \
  >/dev/null 2>&1; then
  fail "renderer accepted an option-like delegate path"
fi
[[ ! -e "$option_delegate_consumer/install.sh" ]] ||
  fail "option-like delegate left a generated installer"

source_work="$tmp/source-work"
remote="$tmp/example-tool.git"
write_config "$source_work"
write_delegate "$source_work"
printf 'one\n' >"$source_work/version.txt"
"$root/checkout-installer/render.sh" "$source_work" >/dev/null
git -C "$source_work" init --quiet --initial-branch=main --template=''
git -C "$source_work" config core.hooksPath /dev/null
git -C "$source_work" config commit.gpgsign false
git -C "$source_work" config user.name 'Checkout Installer Test'
git -C "$source_work" config user.email checkout-installer@example.invalid
git -C "$source_work" add .
git -C "$source_work" commit --quiet -m 'initial fixture'
git init --quiet --bare --initial-branch=main "$remote"
git -C "$source_work" remote add origin "$remote"
git -C "$source_work" push --quiet --set-upstream origin main

standalone="$tmp/standalone"
standalone_marker="$tmp/standalone-delegate-ran"
mkdir -p "$standalone/support"
cp "$source_work/install.sh" "$standalone/install.sh"
cat >"$standalone/support/install-checkout.sh" <<EOF
#!/usr/bin/env bash
printf 'unexpected\n' >'$standalone_marker'
EOF
chmod 0755 "$standalone/support/install-checkout.sh"
set +e
CHECKOUT_TEST_LOG="$tmp/standalone.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$tmp/standalone-managed/example-tool" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$tmp/missing-standalone.git" \
  /bin/bash "$standalone/install.sh" >/dev/null 2>&1
standalone_status=$?
set -e
[[ "$standalone_status" -ne 0 ]] ||
  fail "downloaded installer with an adjacent stray delegate skipped bootstrap"
[[ ! -e "$standalone_marker" ]] ||
  fail "downloaded installer executed an adjacent stray delegate"

repo_url="file://$remote"
managed="$tmp/managed/example-tool"
pipe_log="$tmp/pipe.log"

truncated="$tmp/truncated-install.sh"
sed '$d' "$source_work/install.sh" >"$truncated"
set +e
CHECKOUT_TEST_LOG="$tmp/truncated.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$tmp/truncated-managed/example-tool" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$truncated" >/dev/null 2>&1
truncated_status=$?
set -e
[[ "$truncated_status" -ne 0 ]] ||
  fail "truncated piped installer reported success"
[[ ! -e "$tmp/truncated-managed/example-tool" ]] ||
  fail "truncated piped installer published a checkout"
[[ ! -e "$tmp/truncated.log" ]] ||
  fail "truncated piped installer invoked the delegate"

git_probe_bin="$tmp/git-probe-bin"
git_probe_marker="$tmp/git-consumed-installer-input"
git_probe_env_log="$tmp/git-bootstrap-environment"
real_git=$(PATH=/usr/bin:/bin command -v git)
real_mv=$(PATH=/usr/bin:/bin command -v mv)
mkdir -p "$git_probe_bin"
cat >"$git_probe_bin/git" <<'EOF'
#!/usr/bin/env bash

for git_argument in "$@"; do
  case "$git_argument" in
    clone | fetch)
      {
        printf 'askpass=%s\n' "${GIT_ASKPASS-unset}"
        printf 'ssh_askpass=%s\n' "${SSH_ASKPASS-unset}"
        printf 'git_ssh_command=%s\n' "${GIT_SSH_COMMAND-unset}"
        printf 'args='
        printf '<%s>' "$@"
        printf '\n'
      } >>"$CHECKOUT_TEST_GIT_ENV_LOG"
      if IFS= read -r stolen_installer_line; then
        printf '%s\n' "$stolen_installer_line" >"$CHECKOUT_TEST_GIT_STDIN_MARKER"
      fi
      break
      ;;
  esac
done
exec "$CHECKOUT_TEST_REAL_GIT" "$@"
EOF
chmod 0755 "$git_probe_bin/git"
(
  umask 0037
  CHECKOUT_TEST_LOG="$pipe_log" PREFIX="$tmp/pipe-prefix" \
    LC_ALL=POSIX \
    PATH="$git_probe_bin:$PATH" \
    CHECKOUT_TEST_REAL_GIT="$real_git" \
    CHECKOUT_TEST_GIT_STDIN_MARKER="$git_probe_marker" \
    CHECKOUT_TEST_GIT_ENV_LOG="$git_probe_env_log" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
    /bin/bash -s -- first 'two words' <"$source_work/install.sh" >/dev/null
) ||
  fail "piped install did not create a managed checkout"
[[ -d "$managed/.git" && ! -L "$managed" ]] ||
  fail "piped install did not retain a regular Git checkout"
grep -Fqx "root=$(cd "$managed" && pwd -P)" "$pipe_log" ||
  fail "piped install did not delegate from the managed checkout"
grep -Fqx "prefix=$tmp/pipe-prefix" "$pipe_log" ||
  fail "piped install did not preserve PREFIX"
grep -Fqx 'umask=0037' "$pipe_log" ||
  fail "piped install did not preserve the caller umask"
grep -Fqx 'lc_all=POSIX' "$pipe_log" ||
  fail "piped install did not preserve LC_ALL"
grep -Fqx 'git_terminal_prompt=unset' "$pipe_log" ||
  fail "piped install leaked bootstrap-only Git environment"
[[ ! -e "$git_probe_marker" ]] ||
  fail "piped install let Git consume installer input"
grep -Fqx 'askpass=/bin/false' "$git_probe_env_log" ||
  fail "piped install did not disable Git askpass"
grep -Fqx 'ssh_askpass=/bin/false' "$git_probe_env_log" ||
  fail "piped install did not disable SSH askpass"
grep -Fqx 'git_ssh_command=ssh -oBatchMode=yes' "$git_probe_env_log" ||
  fail "piped install did not force noninteractive SSH"
grep -Fq '<credential.helper=>' "$git_probe_env_log" ||
  fail "piped install did not disable Git credential helpers"
grep -Fq '<protocol.allow=never>' "$git_probe_env_log" ||
  fail "piped install did not deny unapproved Git transports"
grep -Fq '<protocol.file.allow=always>' "$git_probe_env_log" ||
  fail "piped install did not explicitly allow local Git remotes"
grep -Fq '<protocol.https.allow=always>' "$git_probe_env_log" ||
  fail "piped install did not explicitly allow HTTPS Git remotes"
grep -Fq '<protocol.ssh.allow=always>' "$git_probe_env_log" ||
  fail "piped install did not explicitly allow SSH Git remotes"
grep -Fqx 'arg2=two words' "$pipe_log" ||
  fail "piped install did not preserve argument boundaries"
[[ $(git -C "$managed" remote get-url origin) == "$repo_url" ]] ||
  fail "managed checkout retained the wrong origin"
[[ $(git -C "$managed" branch --show-current) == main ]] ||
  fail "managed checkout retained the wrong branch"
managed_parent=$(cd -P -- "${managed%/*}" && pwd -P)
managed_canonical="$managed_parent/${managed##*/}"

alternate_pipe_log="$tmp/alternate-pipe.log"
CHECKOUT_TEST_LOG="$alternate_pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  "$alternate_bash" -s <"$source_work/install.sh" >/dev/null ||
  fail "piped reinstall failed under an alternate Bash path"
grep -Fqx "bash=$alternate_bash" "$alternate_pipe_log" ||
  fail "piped reinstall did not preserve the selected Bash interpreter"

printf 'two\n' >"$source_work/version.txt"
git -C "$source_work" add version.txt
git -C "$source_work" commit --quiet -m 'update fixture'
git -C "$source_work" push --quiet
CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null ||
  fail "piped reinstall did not fast-forward a clean managed checkout"
[[ $(git -C "$managed" rev-parse HEAD) == $(git -C "$source_work" rev-parse HEAD) ]] ||
  fail "piped reinstall did not update to the remote main commit"
grep -Fqx 'version=two' "$pipe_log" ||
  fail "piped reinstall did not invoke the updated delegate"

printf 'swap-safe\n' >"$source_work/version.txt"
git -C "$source_work" add version.txt
git -C "$source_work" commit --quiet -m 'atomic swap fixture'
git -C "$source_work" push --quiet
swap_old_head=$(git -C "$managed" rev-parse HEAD)
swap_old_version=$(sed -n '1p' "$managed/version.txt")
swap_bin="$tmp/swap-bin"
mkdir -p "$swap_bin"
cat >"$swap_bin/mv" <<'EOF'
#!/usr/bin/env bash

target=${!#}
if [[ "$target" == "${CHECKOUT_TEST_SWAP_TARGET:?}" &&
  ! -e "${CHECKOUT_TEST_SWAP_FAILED:?}" ]]; then
  : >"$CHECKOUT_TEST_SWAP_FAILED"
  exit 73
fi
exec "${CHECKOUT_TEST_REAL_MV:?}" "$@"
EOF
chmod 0755 "$swap_bin/mv"
set +e
swap_output=$(PATH="$swap_bin:/usr/bin:/bin" \
  CHECKOUT_TEST_REAL_MV="$real_mv" \
  CHECKOUT_TEST_SWAP_TARGET="$managed_canonical" \
  CHECKOUT_TEST_SWAP_FAILED="$tmp/swap.failed" \
  CHECKOUT_TEST_LOG="$tmp/swap.log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" 2>&1)
swap_status=$?
set -e
[[ "$swap_status" -ne 0 && "$swap_output" == *'managed checkout'* ]] ||
  fail "failed update publication unexpectedly succeeded"
[[ $(git -C "$managed" rev-parse HEAD) == "$swap_old_head" ]] ||
  fail "failed update publication changed the managed checkout revision"
[[ $(sed -n '1p' "$managed/version.txt") == "$swap_old_version" ]] ||
  fail "failed update publication mixed managed checkout contents"
[[ -z $(git -C "$managed" status --porcelain --untracked-files=normal) ]] ||
  fail "failed update publication left the managed checkout dirty"
[[ ! -e "$tmp/managed/.example-tool.install.transaction" ]] ||
  fail "failed update publication left its transaction directory"

CHECKOUT_TEST_LOG="$pipe_log" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
  /bin/bash -s <"$source_work/install.sh" >/dev/null ||
  fail "piped reinstall did not recover after a failed update publication"
grep -Fqx 'version=swap-safe' "$pipe_log" ||
  fail "recovered update did not invoke the newly published delegate"

printf 'crash-safe\n' >"$source_work/version.txt"
git -C "$source_work" add version.txt
git -C "$source_work" commit --quiet -m 'interrupted swap fixture'
git -C "$source_work" push --quiet
crash_swap_bin="$tmp/crash-swap-bin"
mkdir -p "$crash_swap_bin"
cat >"$crash_swap_bin/mv" <<'EOF'
#!/usr/bin/env bash

target=${!#}
"${CHECKOUT_TEST_REAL_MV:?}" "$@"
move_status=$?
if [[ "$target" == "${CHECKOUT_TEST_SWAP_TARGET:?}" &&
  "$move_status" -eq 0 ]]; then
  kill -KILL "$PPID"
fi
exit "$move_status"
EOF
chmod 0755 "$crash_swap_bin/mv"
set +e
{
  PATH="$crash_swap_bin:/usr/bin:/bin" \
    CHECKOUT_TEST_REAL_MV="$real_mv" \
    CHECKOUT_TEST_SWAP_TARGET="$managed_canonical" \
    CHECKOUT_TEST_LOG="$tmp/crash-swap.log" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="$repo_url" \
    /bin/bash -s <"$source_work/install.sh" >/dev/null 2>&1
} 2>/dev/null
crash_swap_status=$?
set -e

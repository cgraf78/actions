# shellcheck shell=bash
# Shared Bash runtime resolver v1.
#
# The checkout installer embeds this fragment because a piped first-stage
# installer cannot source files from a checkout that does not exist yet. The
# renderer also publishes these exact function bytes as
# support/checkout-bash-v1.sh so a checkout-owned trampoline can use the same
# selection and validation contract. Keep this file compatible with stock
# macOS Bash 3.2 and free of consumer-specific policy.

_checkout_bash_v1_error() {
  printf 'checkout Bash resolver: %s\n' "$*" >&2
}

_checkout_bash_v1_normalized_absolute() {
  case $1 in
    '' | / | */ | *//* | */./* | */. | */../* | */.. | *$'\n'* | *$'\r'*)
      return 1
      ;;
    /*) return 0 ;;
    *) return 1 ;;
  esac
}

_checkout_bash_v1_probe() {
  local candidate=$1 output major

  _checkout_bash_v1_normalized_absolute "$candidate" || return 1
  [[ -f "$candidate" && -x "$candidate" ]] || return 1
  # shellcheck disable=SC2016 # Expanded only by the candidate interpreter.
  output=$(BASH_ENV='' ENV='' "$candidate" --noprofile --norc -c \
    'printf "cgraf78-checkout-bash-v1:%s\n" "${BASH_VERSINFO[0]-}"' \
    2>/dev/null) || return 1
  case $output in
    cgraf78-checkout-bash-v1:*) major=${output#*:} ;;
    *) return 1 ;;
  esac
  [[ "$major" =~ ^[0-9]+$ && "$major" -ge 4 ]] || return 1
}

_checkout_bash_v1_hint_path() {
  local namespace=$1 state_root

  case $namespace in
    '' | . | .. | *[!A-Za-z0-9._-]*)
      _checkout_bash_v1_error "invalid state namespace: $namespace"
      return 2
      ;;
  esac
  if [[ -n ${XDG_STATE_HOME:-} ]]; then
    state_root=$XDG_STATE_HOME
  else
    [[ -n ${HOME:-} ]] || {
      _checkout_bash_v1_error 'HOME is required when XDG_STATE_HOME is unset'
      return 1
    }
    state_root=$HOME/.local/state
  fi
  _checkout_bash_v1_normalized_absolute "$state_root" || {
    _checkout_bash_v1_error "state root must be a normalized absolute path: $state_root"
    return 1
  }
  printf '%s/%s/bash-v1\n' "$state_root" "$namespace"
}

_checkout_bash_v1_read_hint() {
  local hint=$1 header interpreter _extra='' size parse_ok=true

  [[ -e "$hint" || -L "$hint" ]] || return 1
  if [[ ! -f "$hint" || -L "$hint" ]]; then
    _checkout_bash_v1_error "refusing non-regular runtime hint: $hint"
    return 2
  fi
  size=$(wc -c <"$hint" 2>/dev/null) || size=
  size=${size//[[:space:]]/}
  case $size in
    '' | *[!0-9]*) size=4097 ;;
  esac
  if [[ ${#size} -gt 4 || "$size" -gt 4096 ]]; then
    _checkout_bash_v1_error "malformed runtime hint: $hint"
    return 2
  fi
  {
    IFS= read -r header || parse_ok=false
    IFS= read -r interpreter || parse_ok=false
    if IFS= read -r _extra || [[ -n "$_extra" ]]; then
      parse_ok=false
    fi
  } <"$hint"
  if [[ "$parse_ok" != true ]]; then
    _checkout_bash_v1_error "malformed runtime hint: $hint"
    return 2
  fi
  if [[ "$header" != 'cgraf78 checkout Bash runtime v1' ]] ||
    ! _checkout_bash_v1_normalized_absolute "$interpreter"; then
    _checkout_bash_v1_error "malformed runtime hint: $hint"
    return 2
  fi
  printf '%s\n' "$interpreter"
}

_checkout_bash_v1_write_hint() {
  local hint=$1 interpreter=$2 had_hint=$3 prior=$4
  local parent temporary temporary_name old_umask current

  parent=${hint%/*}
  old_umask=$(umask)
  umask 077
  if ! mkdir -p "$parent" || [[ ! -d "$parent" || -L "$parent" ]] ||
    ! chmod 0700 "$parent"; then
    umask "$old_umask"
    _checkout_bash_v1_error "cannot create private runtime state: $parent"
    return 1
  fi
  if [[ "$had_hint" == true ]]; then
    current=$(_checkout_bash_v1_read_hint "$hint") || {
      umask "$old_umask"
      return 1
    }
    if [[ "$current" != "$prior" ]]; then
      umask "$old_umask"
      _checkout_bash_v1_error "runtime hint changed during selection: $hint"
      return 1
    fi
  elif [[ -e "$hint" || -L "$hint" ]]; then
    umask "$old_umask"
    _checkout_bash_v1_error "refusing to replace a late runtime hint: $hint"
    return 1
  fi
  temporary=$(mktemp "$parent/.bash-v1.XXXXXX") || {
    umask "$old_umask"
    _checkout_bash_v1_error "cannot allocate runtime hint beside: $hint"
    return 1
  }
  if ! printf 'cgraf78 checkout Bash runtime v1\n%s\n' "$interpreter" \
    >"$temporary" || ! chmod 0600 "$temporary"; then
    rm -f "$temporary"
    umask "$old_umask"
    _checkout_bash_v1_error "cannot publish runtime hint: $hint"
    return 1
  fi
  temporary_name=${temporary##*/}
  if [[ "$had_hint" == true ]]; then
    # Replacing a file with our exact v1 format is the only destructive hint
    # operation. The second read above ensures malformed or foreign state is
    # never used as replacement authority.
    if ! mv -f "$temporary" "$hint"; then
      rm -f "$temporary"
      umask "$old_umask"
      _checkout_bash_v1_error "cannot publish runtime hint: $hint"
      return 1
    fi
  else
    # A hard-link publication cannot overwrite a late regular file. Portable ln
    # may still place the temp inside a late directory; the canonical-result
    # validation below detects that shape and removes only our unique child.
    if ! ln "$temporary" "$hint" 2>/dev/null; then
      rm -f "$temporary"
      umask "$old_umask"
      _checkout_bash_v1_error "runtime hint appeared during selection: $hint"
      return 1
    fi
    rm -f "$temporary"
  fi
  umask "$old_umask"
  current=$(_checkout_bash_v1_read_hint "$hint") || {
    # If a directory won a race against an owned-file replacement, portable
    # mv may have nested our uniquely named temp inside it. Retire only that
    # exact generated child and leave the foreign canonical object untouched.
    if [[ -d "$hint" && ! -L "$hint" &&
      -f "$hint/$temporary_name" && ! -L "$hint/$temporary_name" ]]; then
      rm -f "$hint/$temporary_name"
    fi
    return 1
  }
  [[ "$current" == "$interpreter" ]] || {
    _checkout_bash_v1_error "published runtime hint did not verify: $hint"
    return 1
  }
}

# Selects and persists one Bash 4+ interpreter.
#
# Usage: checkout_bash_v1_select STATE_NAMESPACE EXPLICIT_OVERRIDE
# Success sets CHECKOUT_BASH_V1_INTERPRETER and clears the runtime output until
# checkout_bash_v1_bind validates the exact script to execute. An explicit
# override is strict: an invalid override never falls back to another Bash.
checkout_bash_v1_select() {
  local namespace=${1:-} explicit=${2:-} hint hinted candidate path_entry
  local hint_present=false hint_selected=false path_remaining path_more

  CHECKOUT_BASH_V1_INTERPRETER=
  CHECKOUT_BASH_V1_RUNTIME=
  [[ $# -eq 2 ]] || {
    _checkout_bash_v1_error 'usage: checkout_bash_v1_select STATE_NAMESPACE EXPLICIT_OVERRIDE'
    return 2
  }
  hint=$(_checkout_bash_v1_hint_path "$namespace") || return $?

  if [[ -e "$hint" || -L "$hint" ]]; then
    hinted=$(_checkout_bash_v1_read_hint "$hint") || return 1
    hint_present=true
  fi

  if [[ -n "$explicit" ]]; then
    if ! _checkout_bash_v1_probe "$explicit"; then
      _checkout_bash_v1_error "explicit interpreter is not Bash 4 or newer: $explicit"
      return 1
    fi
    candidate=$explicit
  else
    if [[ -n ${hinted:-} ]] && _checkout_bash_v1_probe "$hinted"; then
      candidate=$hinted
      hint_selected=true
    fi

    if [[ -z ${candidate:-} ]] &&
      _checkout_bash_v1_probe "${BASH:-}"; then
      candidate=$BASH
    fi

    if [[ -z ${candidate:-} ]]; then
      path_remaining=${PATH-}
      while :; do
        case $path_remaining in
          *:*)
            path_entry=${path_remaining%%:*}
            path_remaining=${path_remaining#*:}
            path_more=true
            ;;
          *)
            path_entry=$path_remaining
            path_more=false
            ;;
        esac
        case $path_entry in
          /*) ;;
          *) path_entry= ;;
        esac
        if [[ -n "$path_entry" ]] &&
          _checkout_bash_v1_probe "$path_entry/bash"; then
          candidate=$path_entry/bash
          break
        fi
        [[ "$path_more" == true ]] || break
      done
    fi

    if [[ -z ${candidate:-} ]]; then
      if [[ -n ${PREFIX:-} ]] && _checkout_bash_v1_probe "$PREFIX/bin/bash"; then
        candidate=$PREFIX/bin/bash
      fi
    fi

    if [[ -z ${candidate:-} ]]; then
      for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash \
        /opt/local/bin/bash /usr/bin/bash /bin/bash; do
        if _checkout_bash_v1_probe "$candidate"; then
          break
        fi
        candidate=
      done
    fi
  fi

  if [[ -z ${candidate:-} ]]; then
    _checkout_bash_v1_error 'Bash 4 or newer was not found; install it and retry'
    return 1
  fi
  if [[ "$hint_selected" != true &&
    ("$hint_present" != true || "$hinted" != "$candidate") ]]; then
    _checkout_bash_v1_write_hint \
      "$hint" "$candidate" "$hint_present" "${hinted:-}" || return 1
  fi
  CHECKOUT_BASH_V1_INTERPRETER=$candidate
}

# Binds a selected interpreter to one exact checkout-relative runtime script.
#
# Usage: checkout_bash_v1_bind ABSOLUTE_RUNTIME
# Success publishes CHECKOUT_BASH_V1_INTERPRETER and CHECKOUT_BASH_V1_RUNTIME
# together. The interpreter is re-probed so replacement between selection and
# execution fails closed, and the runtime may not be a symlink.
checkout_bash_v1_bind() {
  local runtime=${1:-} interpreter=${CHECKOUT_BASH_V1_INTERPRETER:-}

  CHECKOUT_BASH_V1_INTERPRETER=
  CHECKOUT_BASH_V1_RUNTIME=
  [[ $# -eq 1 ]] || {
    _checkout_bash_v1_error 'usage: checkout_bash_v1_bind ABSOLUTE_RUNTIME'
    return 2
  }
  if ! _checkout_bash_v1_probe "$interpreter"; then
    _checkout_bash_v1_error 'selected Bash interpreter changed before execution'
    return 1
  fi
  if ! _checkout_bash_v1_normalized_absolute "$runtime" ||
    [[ ! -f "$runtime" || -L "$runtime" || ! -r "$runtime" ]]; then
    _checkout_bash_v1_error "runtime is not a readable regular file: $runtime"
    return 1
  fi
  CHECKOUT_BASH_V1_INTERPRETER=$interpreter
  # shellcheck disable=SC2034 # Public output consumed by the sourcing caller.
  CHECKOUT_BASH_V1_RUNTIME=$runtime
}

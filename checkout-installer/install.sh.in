#!/usr/bin/env bash
# Generated by cgraf78/actions checkout-installer. Do not edit.
#
# This file is deliberately self-contained. From a real repository checkout it
# delegates immediately. When downloaded or piped to Bash, it creates or safely
# updates a durable checkout and delegates to the same repository-owned script.

{
  set -euo pipefail
  # An inherited CDPATH may make a successful `cd` print to stdout, corrupting
  # command substitutions that resolve the installer and checkout roots.
  CDPATH=
  # Exported BASHOPTS can otherwise make reserved CLI tokens case-insensitive.
  shopt -u nocasematch
  caller_umask=$(umask)
  umask 077

  checkout_repo='@CHECKOUT_REPO@'
  checkout_slug='@CHECKOUT_SLUG@'
  checkout_ref='@CHECKOUT_REF@'
  checkout_delegate='@CHECKOUT_DELEGATE@'
  checkout_default_destination='@CHECKOUT_DEFAULT_DESTINATION@'
  # @CHECKOUT_DEVELOPMENT_BEGIN@
  checkout_force_managed=false
  if [[ ${1:-} == --managed ]]; then
    checkout_force_managed=true
    shift
  fi
  # @CHECKOUT_DEVELOPMENT_END@
  # @CHECKOUT_POST_INSTALL_BEGIN@
  checkout_post_install_delegate='@CHECKOUT_POST_INSTALL_DELEGATE@'
  active_child_pid=
  # @CHECKOUT_POST_INSTALL_END@
  # @CHECKOUT_LOCK_V1_BEGIN@
  # shellcheck disable=SC2034 # Used by the rendered lock-v1 fragment.
  checkout_lock_timeout_default=1800
  # @CHECKOUT_LOCK_V1_END@
  default_repo_url="https://github.com/${checkout_repo}.git"

  die() {
    printf 'install.sh: %s\n' "$*" >&2
    exit 1
  }

  checkout_installer_git=
  select_bootstrap_git() {
    local home_physical directory physical_directory candidate
    local -a path_directories=()

    checkout_installer_git=
    case $HOME in
      '' | */ | *//* | */./* | */. | */../* | */.. | *$'\n'* | *$'\r'*)
        return 1
        ;;
      /*) ;;
      *) return 1 ;;
    esac
    home_physical=$(cd -P -- "$HOME" 2>/dev/null && pwd -P) ||
      home_physical=$HOME
    IFS=: read -r -a path_directories <<<"${PATH:-}"
    for directory in "${path_directories[@]}"; do
      [[ $directory == /* ]] || continue
      physical_directory=$(cd -P -- "$directory" 2>/dev/null && pwd -P) ||
        continue
      candidate=${physical_directory%/}/git
      [[ $physical_directory == / ]] && candidate=/git
      [[ -f $candidate && ! -L $candidate && -x $candidate ]] || continue
      if [[ $home_physical == / || $candidate == "$home_physical" ||
        $candidate == "$home_physical/"* ]]; then
        continue
      fi
      checkout_installer_git=$candidate
      return 0
    done
    return 1
  }

  select_bootstrap_git ||
    die 'host Git is unavailable outside HOME'

  resolve_default_checkout_dir() {
    local data_home install_home

    case "$checkout_default_destination" in
      xdg)
        if [[ ${XDG_DATA_HOME:-} == /* ]]; then
          data_home=$XDG_DATA_HOME
        else
          data_home=$HOME/.local/share
        fi
        printf '%s/cgraf78/checkouts/%s\n' "$data_home" "$checkout_slug"
        ;;
      shdeps)
        # Shdeps treats its install root as a product-wide contract rather
        # than an XDG data root. Matching that precedence here prevents a
        # bootstrap checkout and the steady-state provider from diverging.
        install_home=${SHDEPS_INSTALL_DIR:-$HOME/.local/share}
        case "$install_home" in
          /) printf '/%s\n' "$checkout_repo" ;;
          */) printf '%s/%s\n' "${install_home%/}" "$checkout_repo" ;;
          *) printf '%s/%s\n' "$install_home" "$checkout_repo" ;;
        esac
        ;;
      *)
        die "unsupported generated default destination: $checkout_default_destination"
        ;;
    esac
  }

  # @CHECKOUT_DEVELOPMENT_BEGIN@
  resolve_expected_development_dir() {
    local development_home

    development_home=${SHDEPS_GIT_DEV_DIR:-$HOME/git}
    while [[ "$development_home" != / && "$development_home" == */ ]]; do
      development_home=${development_home%/}
    done
    case $development_home in
      '' | *//* | */./* | */. | */../* | */.. | *$'\n'* | *$'\r'*)
        die "Shdeps development root must be a normalized absolute path: $development_home"
        ;;
      /*) ;;
      *)
        die "Shdeps development root must be absolute: $development_home"
        ;;
    esac
    if [[ "$development_home" == / ]]; then
      printf '/%s\n' "$checkout_slug"
    else
      printf '%s/%s\n' "$development_home" "$checkout_slug"
    fi
  }

  # @CHECKOUT_DEVELOPMENT_END@
  require_delegate() {
    local checkout_root=$1 delegate_path=${2:-$checkout_delegate} delegate

    delegate="$checkout_root/$delegate_path"
    [[ -f "$delegate" && ! -L "$delegate" ]] ||
      die "checkout installer is missing: $delegate"
  }
  # @CHECKOUT_POST_INSTALL_BEGIN@
  require_post_install_delegate() {
    local checkout_root=$1
    local post_install_path=${2:-$checkout_post_install_delegate} post_install

    post_install="$checkout_root/$post_install_path"
    [[ -f "$post_install" && ! -L "$post_install" ]] ||
      die "checkout installer post-install command is missing: $post_install"
  }

  # Opting into a second phase means the installer can no longer exec the
  # primary delegate directly. Preserve the existing cancellation guarantee by
  # supervising that child and its descendants until the post-install exec.
  # shellcheck disable=SC2329 # Reached through the direct-phase signal traps.
  post_install_wait_for_pid_exit() {
    local pid=$1

    for _ in {1..100}; do
      kill -0 "$pid" 2>/dev/null || return 0
      command sleep 0.01
    done
    return 1
  }

  # shellcheck disable=SC2329 # Reached through the direct-phase signal traps.
  post_install_terminate_child() {
    local child=$1 parent=$2 signal=$3

    kill -s "$signal" "$child" 2>/dev/null || true
    post_install_wait_for_pid_exit "$child" && return 0
    kill -s KILL "$child" 2>/dev/null || true
    post_install_wait_for_pid_exit "$child" && return 0
    printf 'install.sh: child process %s was not reaped by parent %s after %s and KILL\n' \
      "$child" "$parent" "$signal" >&2
    return 1
  }

  # shellcheck disable=SC2329 # Reached through the direct-phase signal traps.
  post_install_signal_descendants() {
    local parent=$1 signal=$2 snapshot=$3 child children live_parent failed=0

    children=$(printf '%s\n' "$snapshot" |
      command awk -v parent="$parent" '$2 == parent { print $1 }')
    for child in $children; do
      post_install_signal_descendants "$child" "$signal" "$snapshot" ||
        failed=1
      live_parent=$(command ps -o ppid= -p "$child" 2>/dev/null || true)
      live_parent=${live_parent//[[:space:]]/}
      if [[ "$live_parent" == "$parent" ]]; then
        post_install_terminate_child "$child" "$parent" "$signal" || failed=1
      fi
    done
    return "$failed"
  }

  # shellcheck disable=SC2329 # Reached through the direct-phase signal traps.
  post_install_signal_process_tree() {
    local root=$1 signal=$2 snapshot failed=0

    snapshot=$(command ps -eo pid=,ppid= 2>/dev/null || true)
    post_install_signal_descendants "$root" "$signal" "$snapshot" || failed=1
    kill -s "$signal" "$root" 2>/dev/null || true
    return "$failed"
  }

  # shellcheck disable=SC2329 # Installed as the direct-phase signal traps.
  post_install_forward_signal() {
    local signal=$1 status=$2 child_signal=$1

    trap - HUP INT TERM
    if [[ -n "$active_child_pid" ]]; then
      # Background Bash children inherit ignored SIGINT outside job-control.
      # TERM remains catchable while the installer reports conventional 130.
      [[ "$signal" == INT ]] && child_signal=TERM
      if ! post_install_signal_process_tree \
        "$active_child_pid" "$child_signal"; then
        printf 'install.sh: process-tree cleanup was incomplete after %s\n' \
          "$signal" >&2
      fi
      wait "$active_child_pid" 2>/dev/null || true
      active_child_pid=
    fi
    exit "$status"
  }
  # @CHECKOUT_POST_INSTALL_END@
  # @CHECKOUT_LOCK_V1_BEGIN@
  # @CHECKOUT_LOCK_V1_LIBRARY@
  # @CHECKOUT_LOCK_V1_END@
  # @CHECKOUT_BASH_RESOLVER_BEGIN@
  # @CHECKOUT_BASH_RESOLVER_LIBRARY@
  # @CHECKOUT_BASH_RESOLVER_END@

  exec_bootstrap_git() {
    [[ -n ${CHECKOUT_INSTALLER_GIT_HOME:-} ]] ||
      die 'internal Git configuration home is not set'
    unset GIT_ALTERNATE_OBJECT_DIRECTORIES
    unset GIT_COMMON_DIR
    unset GIT_CEILING_DIRECTORIES
    unset GIT_CONFIG
    unset GIT_CONFIG_COUNT
    unset GIT_CONFIG_GLOBAL
    unset GIT_CONFIG_NOSYSTEM
    unset GIT_CONFIG_PARAMETERS
    unset GIT_CONFIG_SYSTEM
    unset GIT_DIR
    unset GIT_DISCOVERY_ACROSS_FILESYSTEM
    unset GIT_EXEC_PATH
    unset GIT_GRAFT_FILE
    unset GIT_IMPLICIT_WORK_TREE
    unset GIT_INDEX_FILE
    unset GIT_INTERNAL_SUPER_PREFIX
    unset GIT_NAMESPACE
    unset GIT_NO_REPLACE_OBJECTS
    unset GIT_OBJECT_DIRECTORY
    unset GIT_PREFIX
    unset GIT_PROXY_COMMAND
    unset GIT_ALLOW_PROTOCOL
    unset GIT_PROTOCOL_FROM_USER
    unset GIT_REPLACE_REF_BASE
    unset GIT_SHALLOW_FILE
    unset GIT_SSH
    unset GIT_SSH_VARIANT
    unset GIT_SSL_NO_VERIFY
    unset GIT_TEMPLATE_DIR
    unset GIT_WORK_TREE
    GIT_CONFIG_GLOBAL=/dev/null \
      GIT_CONFIG_NOSYSTEM=1 \
      GIT_PROTOCOL_FROM_USER=0 \
      GIT_TERMINAL_PROMPT=0 \
      HOME="$CHECKOUT_INSTALLER_GIT_HOME" \
      XDG_CONFIG_HOME="$CHECKOUT_INSTALLER_GIT_HOME/xdg" \
      exec "$checkout_installer_git" \
      -c core.hooksPath=/dev/null \
      -c core.fsmonitor=false \
      -c submodule.recurse=false \
      -c fetch.recurseSubmodules=false \
      -c protocol.allow=never \
      -c protocol.file.allow=always \
      -c protocol.https.allow=always \
      -c protocol.ssh.allow=always \
      "$@"
  }

  bootstrap_git() {
    local isolated_home status

    isolated_home=$(mktemp -d \
      "${TMPDIR:-/tmp}/cgraf78-checkout-installer.git.XXXXXX") ||
      die 'cannot create isolated Git configuration home'
    if (CHECKOUT_INSTALLER_GIT_HOME="$isolated_home" \
      exec_bootstrap_git "$@"); then
      status=0
    else
      status=$?
    fi
    rm -rf -- "$isolated_home"
    return "$status"
  }

  trusted_checkout_git() {
    local checkout_root=$1
    shift

    bootstrap_git -c "safe.directory=$checkout_root" \
      -C "$checkout_root" "$@"
  }

  network_git() {
    local status

    active_git_home=$(mktemp -d \
      "${TMPDIR:-/tmp}/cgraf78-checkout-installer.git.XXXXXX") ||
      die 'cannot create isolated Git configuration home'

    (
      GIT_ASKPASS=/bin/false
      SSH_ASKPASS=/bin/false
      GIT_SSH_COMMAND='ssh -oBatchMode=yes'
      CHECKOUT_INSTALLER_GIT_HOME=$active_git_home
      export CHECKOUT_INSTALLER_GIT_HOME
      export GIT_ASKPASS SSH_ASKPASS GIT_SSH_COMMAND
      exec_bootstrap_git -c credential.helper= "$@"
    ) </dev/null &
    active_child_pid=$!
    set +e
    wait "$active_child_pid"
    status=$?
    active_child_pid=
    set -e
    rm -rf -- "$active_git_home"
    active_git_home=
    return "$status"
  }

  require_tracked_delegate() {
    local checkout_root=$1 delegate_path=${2:-$checkout_delegate}

    require_delegate "$checkout_root" "$delegate_path"
    bootstrap_git -C "$checkout_root" ls-files --error-unmatch -- \
      "$delegate_path" >/dev/null 2>&1 ||
      die "checkout installer is not tracked: $checkout_root/$delegate_path"
  }
  # @CHECKOUT_POST_INSTALL_BEGIN@
  require_tracked_post_install_delegate() {
    local checkout_root=$1
    local post_install_path=${2:-$checkout_post_install_delegate}

    require_post_install_delegate "$checkout_root" "$post_install_path"
    bootstrap_git -C "$checkout_root" ls-files --error-unmatch -- \
      "$post_install_path" >/dev/null 2>&1 ||
      die "checkout installer post-install command is not tracked: $checkout_root/$post_install_path"
  }
  # @CHECKOUT_POST_INSTALL_END@

  require_tree_delegate() {
    local checkout_root=$1 revision=$2
    local delegate_path=${3:-$checkout_delegate} entry mode type object path

    entry=$(bootstrap_git -C "$checkout_root" ls-tree "$revision" -- \
      "$delegate_path") ||
      die "cannot inspect checkout installer in revision $revision"
    IFS=$' \t' read -r mode type object path <<<"$entry"
    [[ ("$mode" == 100644 || "$mode" == 100755) &&
      "$type" == blob && -n "$object" && "$path" == "$delegate_path" ]] ||
      die "checkout installer is missing from revision $revision: $delegate_path"
  }
  # @CHECKOUT_POST_INSTALL_BEGIN@
  require_tree_post_install_delegate() {
    local checkout_root=$1 revision=$2
    local post_install_path=${3:-$checkout_post_install_delegate}
    local entry mode type object path

    entry=$(bootstrap_git -C "$checkout_root" ls-tree "$revision" -- \
      "$post_install_path") ||
      die "cannot inspect checkout post-install command in revision $revision"
    IFS=$' \t' read -r mode type object path <<<"$entry"
    [[ ("$mode" == 100644 || "$mode" == 100755) &&
      "$type" == blob && -n "$object" && "$path" == "$post_install_path" ]] ||
      die "checkout post-install command is missing from revision $revision: $post_install_path"
  }
  # @CHECKOUT_POST_INSTALL_END@

  checkout_source_root() {
    local source_path=$1 script_dir top

    [[ -f "$source_path" && ! -L "$source_path" ]] || return 1
    [[ ${source_path##*/} == install.sh ]] || return 1
    script_dir=$(cd -P -- "$(dirname "$source_path")" && pwd -P) || return 1
    top=$(trusted_checkout_git "$script_dir" \
      rev-parse --show-toplevel 2>/dev/null) ||
      return 1
    top=$(cd -P -- "$top" && pwd -P) || return 1
    [[ "$top" == "$script_dir" ]] || return 1
    [[ -f "$top/install.sh" && ! -L "$top/install.sh" ]] || return 1
    [[ -f "$top/$checkout_delegate" && ! -L "$top/$checkout_delegate" ]] ||
      return 1
    # @CHECKOUT_POST_INSTALL_BEGIN@
    if [[ ! -f "$top/$checkout_post_install_delegate" ||
      -L "$top/$checkout_post_install_delegate" ]]; then
      return 1
    fi
    # @CHECKOUT_POST_INSTALL_END@
    trusted_checkout_git "$top" ls-files --error-unmatch -- \
      install.sh "$checkout_delegate" >/dev/null 2>&1 || return 1
    # @CHECKOUT_POST_INSTALL_BEGIN@
    trusted_checkout_git "$top" ls-files --error-unmatch -- \
      "$checkout_post_install_delegate" >/dev/null 2>&1 || return 1
    # @CHECKOUT_POST_INSTALL_END@
    printf '%s\n' "$top"
  }

  exec_delegate() {
    local checkout_root=$1
    shift

    require_delegate "$checkout_root"
    umask "$caller_umask"
    # @CHECKOUT_BASH_EXEC_ROOT_DELEGATE@
  }
  # @CHECKOUT_POST_INSTALL_BEGIN@
  run_direct_install_with_post() {
    local checkout_root=$1 status
    shift

    require_delegate "$checkout_root"
    require_post_install_delegate "$checkout_root"
    umask "$caller_umask"

    trap 'post_install_forward_signal HUP 129' HUP
    trap 'post_install_forward_signal INT 130' INT
    trap 'post_install_forward_signal TERM 143' TERM
    set +e
    # @CHECKOUT_BASH_RUN_ROOT_DELEGATE@
    active_child_pid=$!
    wait "$active_child_pid"
    status=$?
    active_child_pid=
    set -e
    trap - HUP INT TERM
    [[ "$status" -eq 0 ]] || exit "$status"
    # @CHECKOUT_BASH_EXEC_ROOT_POST@
  }
  # @CHECKOUT_POST_INSTALL_END@
  # @CHECKOUT_BASH_RESOLVER_BEGIN@
  checkout_bash_v1_select "$checkout_slug" \
    "${CGRAF78_CHECKOUT_INSTALL_BASH:-}" ||
    die 'Bash 4 or newer is required before checkout installation'
  # @CHECKOUT_BASH_RESOLVER_END@

  # A generated installer committed at the repository root keeps ordinary
  # checkout installs fast and offline. Piped Bash has no regular source file,
  # while a downloaded standalone copy has no adjacent delegate; both continue
  # into the managed-checkout bootstrap below.
  script_source=${BASH_SOURCE[0]:-}
  # @CHECKOUT_DEVELOPMENT_BEGIN@
  if [[ "$checkout_force_managed" == true ]]; then
    script_source=
  fi
  # @CHECKOUT_DEVELOPMENT_END@
  if [[ -n "$script_source" ]] &&
    script_dir=$(checkout_source_root "$script_source"); then
    # @CHECKOUT_POST_INSTALL_BEGIN@
    run_direct_install_with_post "$script_dir" "$@"
    # @CHECKOUT_POST_INSTALL_END@
    exec_delegate "$script_dir" "$@"
  fi

  command -v git >/dev/null 2>&1 || die 'git is required for a piped install'
  [[ -n ${HOME:-} ]] || die 'HOME is not set'

  repo_url=${CGRAF78_CHECKOUT_INSTALL_REPO_URL:-$default_repo_url}
  checkout_dir=${CGRAF78_CHECKOUT_INSTALL_DIR:-}
  if [[ -z "$checkout_dir" ]]; then
    checkout_dir=$(resolve_default_checkout_dir)
  fi
  # @CHECKOUT_DEVELOPMENT_BEGIN@
  expected_development_dir=$(resolve_expected_development_dir)
  # @CHECKOUT_DEVELOPMENT_END@

  case "$checkout_dir" in
    '' | / | */ | *//* | */./* | */. | */../* | */..)
      die "managed checkout path must be a normalized absolute path: $checkout_dir"
      ;;
    /*) ;;
    *)
      die "managed checkout path must be absolute: $checkout_dir"
      ;;
  esac
  [[ "$checkout_dir" != *$'\n'* && "$checkout_dir" != *$'\r'* ]] ||
    die 'managed checkout path must not contain line breaks'

  checkout_parent=${checkout_dir%/*}
  checkout_name=${checkout_dir##*/}
  [[ -n "$checkout_parent" ]] || checkout_parent=/
  mkdir -p "$checkout_parent" ||
    die "cannot create managed checkout parent: $checkout_parent"
  [[ -d "$checkout_parent" ]] ||
    die "managed checkout parent is not a directory: $checkout_parent"
  checkout_parent=$(cd -P -- "$checkout_parent" && pwd -P) ||
    die "cannot resolve managed checkout parent: $checkout_parent"
  checkout_dir="$checkout_parent/$checkout_name"

  staging=
  publish_identity=
  active_child_pid=
  active_git_home=
  lock_dir="$checkout_parent/.${checkout_name}.install.lock"
  update_transaction="$checkout_parent/.${checkout_name}.install.transaction"
  update_identity=
  update_next="$update_transaction/next"
  update_previous="$update_transaction/previous"
  update_candidate_head="$update_transaction/candidate-head"
  update_previous_head="$update_transaction/previous-head"
  update_recorded_delegate=
  # @CHECKOUT_POST_INSTALL_BEGIN@
  update_recorded_post_install_delegate=
  # @CHECKOUT_POST_INSTALL_END@
  update_next_marker=.git/cgraf78-update-next-identity
  update_previous_marker=.git/cgraf78-update-previous-identity
  update_transaction_created=0
  # @CHECKOUT_DEVELOPMENT_BEGIN@
  development_checkout_selected=false
  development_checkout_recovered=false
  development_validation_error=
  development_recorded_target=
  update_transaction_kind=managed
  checkout_runtime_root=$checkout_dir
  : "$development_checkout_recovered" "$checkout_runtime_root"
  # @CHECKOUT_DEVELOPMENT_END@
  lock_held=0

  # @CHECKOUT_LEGACY_LOCK_BEGIN@
  # shellcheck disable=SC2329 # Called by cleanup through the EXIT trap.
  release_lock() {
    if [[ "$lock_held" -eq 1 ]]; then
      rmdir "$lock_dir" 2>/dev/null || true
      lock_held=0
    fi
  }
  # @CHECKOUT_LEGACY_LOCK_END@
  # @CHECKOUT_LOCK_V1_BEGIN@
  # shellcheck disable=SC2329 # Called by cleanup through the EXIT trap.
  release_lock() {
    release_checkout_lock_v1 || true
  }
  # @CHECKOUT_LOCK_V1_END@
  # @CHECKOUT_POST_INSTALL_BEGIN@
  # The ordinary EXIT cleanup remains deliberately best effort. The transition
  # to post-install is different: nested tooling may need this exact lock, so
  # failing to prove its removal must stop before any second-phase code runs.
  release_lock_for_post_install() {
    if declare -F release_checkout_lock_v1_strict >/dev/null 2>&1; then
      release_checkout_lock_v1_strict
      return
    fi
    [[ "$lock_held" -eq 1 ]] || return 0
    rmdir "$lock_dir" 2>/dev/null || return 1
    lock_held=0
  }
  # @CHECKOUT_POST_INSTALL_END@

  # shellcheck disable=SC2329 # Installed as the EXIT trap below.
  recover_staging_location() {
    local expected nested

    [[ -n "$publish_identity" && -f "$publish_identity" &&
      ! -L "$publish_identity" ]] || return 0
    expected="$checkout_dir/.git/cgraf78-publish-identity"
    nested="$checkout_dir/${staging##*/}/.git/cgraf78-publish-identity"
    if [[ -f "$expected" && "$publish_identity" -ef "$expected" ]]; then
      staging=$checkout_dir
    elif [[ -n "$staging" && -f "$nested" &&
      "$publish_identity" -ef "$nested" ]]; then
      staging=${nested%/.git/cgraf78-publish-identity}
    fi
  }

  create_identity_marker() {
    local identity=$1 marker=$2

    if ln "$identity" "$marker" 2>/dev/null; then
      return 0
    fi
    [[ ! -e "$marker" && ! -L "$marker" ]] || return 1
    ln -s "$identity" "$marker"
  }

  # @CHECKOUT_DEVELOPMENT_BEGIN@
  create_development_identity_marker() {
    local identity=$1 marker=$2

    if ln "$identity" "$marker" 2>/dev/null; then
      return 0
    fi
    [[ ! -e "$marker" && ! -L "$marker" ]] || return 1
    # The candidate is still private and disposable here. Android app-data
    # filesystems reject hard links, so publish an independent regular copy
    # before any user-owned link moves. Unlike the generic symlink fallback,
    # this copy remains usable if recovery later retires the transaction-side
    # identity immediately before an uncatchable process death.
    # Bash noclobber gives this fallback the same fail-if-present publication
    # property as ln: a late regular file, symlink, or directory is preserved.
    (
      umask 077
      set -C
      command cat "$identity" >"$marker"
    ) || return 1
    [[ -f "$marker" && ! -L "$marker" ]] || return 1
    development_identity_matches "$marker"
  }

  # @CHECKOUT_DEVELOPMENT_END@
  validate_managed_checkout() {
    local candidate=$1 top branch origin status

    [[ -d "$candidate" && ! -L "$candidate" ]] ||
      die "destination is not a managed Git checkout: $candidate"
    top=$(bootstrap_git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) ||
      die "destination is not a managed Git checkout: $candidate"
    top=$(cd -P -- "$top" && pwd -P) ||
      die "cannot resolve managed Git checkout: $candidate"
    candidate=$(cd -P -- "$candidate" && pwd -P) ||
      die "cannot resolve managed Git checkout: $candidate"
    [[ "$top" == "$candidate" ]] ||
      die "destination is not the root of its Git checkout: $candidate"

    origin=$(bootstrap_git -C "$candidate" remote get-url origin 2>/dev/null) ||
      die "managed Git checkout has no origin: $candidate"
    [[ "$origin" == "$repo_url" ]] ||
      die "managed Git checkout origin differs: $origin"
    branch=$(bootstrap_git -C "$candidate" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
      die "managed Git checkout is detached: $candidate"
    [[ "$branch" == "$checkout_ref" ]] ||
      die "managed Git checkout branch differs: $branch"
    status=$(bootstrap_git -C "$candidate" status --porcelain \
      --untracked-files=normal) ||
      die "cannot inspect managed Git checkout: $candidate"
    [[ -z "$status" ]] ||
      die "managed Git checkout is dirty; refusing to update: $candidate"
  }

  # @CHECKOUT_DEVELOPMENT_BEGIN@
  canonical_github_repo_url() {
    local url=$1 rest host path owner repository host_lower

    case $url in
      https://*)
        rest=${url#https://}
        host=${rest%%/*}
        [[ "$rest" != "$host" ]] || return 1
        path=${rest#*/}
        ;;
      ssh://git@*)
        rest=${url#ssh://git@}
        host=${rest%%/*}
        [[ "$rest" != "$host" ]] || return 1
        path=${rest#*/}
        ;;
      git@*:*)
        rest=${url#git@}
        host=${rest%%:*}
        [[ "$rest" != "$host" ]] || return 1
        path=${rest#*:}
        ;;
      *) return 1 ;;
    esac
    host_lower=$(printf '%s' "$host" | command tr '[:upper:]' '[:lower:]') ||
      return 1
    [[ "$host_lower" == github.com ]] || return 1
    case $path in
      '' | /* | */ | *//* | *$'\n'* | *$'\r'* | *[!A-Za-z0-9._/-]*)
        return 1
        ;;
    esac
    owner=${path%%/*}
    [[ "$path" != "$owner" ]] || return 1
    repository=${path#*/}
    [[ "$repository" != */* ]] || return 1
    case $owner:$repository in
      .:* | ..:* | *:. | *:..) return 1 ;;
    esac
    case $repository in
      *.git) repository=${repository%.git} ;;
    esac
    [[ -n "$repository" && "$repository" != . && "$repository" != .. ]] ||
      return 1
    printf '%s/%s\n' "$owner" "$repository"
  }

  development_origin_matches() {
    local origin=$1 configured canonical

    if configured=$(canonical_github_repo_url "$repo_url"); then
      [[ "$configured" == "$checkout_repo" ]] || return 1
      canonical=$(canonical_github_repo_url "$origin") || return 1
      [[ "$canonical" == "$configured" ]]
    else
      [[ "$origin" == "$repo_url" ]]
    fi
  }

  development_git() {
    # Development validation may read the checkout's own config and object
    # store, but it must not let replace refs reinterpret HEAD. Optional locks
    # keep these proof-only calls from writing refresh state into a dirty tree.
    GIT_OPTIONAL_LOCKS=0 bootstrap_git --no-replace-objects "$@"
  }

  validate_development_file() {
    local candidate=$1 relative=$2 remaining component parent entry
    local mode type object path

    case $relative in
      '' | -* | . | .. | /* | ./* | */./* | */. | *//* | ../* | */../* | */..)
        development_validation_error="unsafe tracked path: $relative"
        return 1
        ;;
    esac
    parent=$candidate
    remaining=$relative
    while [[ "$remaining" == */* ]]; do
      component=${remaining%%/*}
      remaining=${remaining#*/}
      parent=$parent/$component
      if [[ ! -d "$parent" || -L "$parent" ]]; then
        development_validation_error="tracked path has a non-directory or symlinked parent: $relative"
        return 1
      fi
    done
    if [[ ! -f "$candidate/$relative" || -L "$candidate/$relative" ||
      ! -r "$candidate/$relative" ]]; then
      development_validation_error="tracked path is not a live regular file: $relative"
      return 1
    fi
    # This proves repository ownership and path type, not byte equality.
    # Development mode intentionally executes tracked live edits, including
    # dirty or staged delegate changes.
    entry=$(development_git -C "$candidate" ls-tree HEAD -- \
      "$relative" 2>/dev/null) || {
      development_validation_error="cannot inspect tracked path at HEAD: $relative"
      return 1
    }
    IFS=$' \t' read -r mode type object path <<<"$entry"
    if [[ ("$mode" != 100644 && "$mode" != 100755) ||
      "$type" != blob || -z "$object" || "$path" != "$relative" ]]; then
      development_validation_error="tracked path is not a regular blob at HEAD: $relative"
      return 1
    fi
  }

  validate_development_checkout() {
    local candidate=$1 top candidate_physical configured_repo raw_origin
    local effective_origin

    development_validation_error=
    if [[ ! -d "$candidate" ]]; then
      development_validation_error='path is not a directory'
      return 1
    fi
    if [[ (! -d "$candidate/.git" && ! -f "$candidate/.git") ||
      -L "$candidate/.git" ]]; then
      development_validation_error='.git is not regular checkout metadata'
      return 1
    fi
    top=$(development_git -C "$candidate" \
      rev-parse --show-toplevel 2>/dev/null) || {
      development_validation_error='path is not a Git checkout'
      return 1
    }
    top=$(cd -P -- "$top" 2>/dev/null && pwd -P) || {
      development_validation_error='cannot resolve Git checkout root'
      return 1
    }
    candidate_physical=$(cd -P -- "$candidate" 2>/dev/null && pwd -P) || {
      development_validation_error='cannot resolve development checkout'
      return 1
    }
    if [[ "$top" != "$candidate_physical" ]]; then
      development_validation_error='path is not the root of its Git checkout'
      return 1
    fi
    if configured_repo=$(canonical_github_repo_url "$repo_url") &&
      [[ "$configured_repo" != "$checkout_repo" ]]; then
      development_validation_error='configured repository differs'
      return 1
    fi
    raw_origin=$(development_git -C "$candidate" config --local --no-includes \
      --get-all remote.origin.url 2>/dev/null) || {
      development_validation_error='checkout has no local origin'
      return 1
    }
    if [[ -z "$raw_origin" || "$raw_origin" == *$'\n'* ]] ||
      ! development_origin_matches "$raw_origin"; then
      development_validation_error='checkout local origin differs'
      return 1
    fi
    effective_origin=$(development_git -C "$candidate" remote get-url --all \
      origin 2>/dev/null) || {
      development_validation_error='cannot resolve effective checkout origin'
      return 1
    }
    if [[ -z "$effective_origin" || "$effective_origin" == *$'\n'* ]] ||
      ! development_origin_matches "$effective_origin"; then
      development_validation_error='checkout effective origin differs'
      return 1
    fi
    validate_development_file "$candidate" install.sh || return 1
    validate_development_file "$candidate" "$checkout_delegate" || return 1
    if [[ -n ${checkout_post_install_delegate:-} ]]; then
      validate_development_file \
        "$candidate" "$checkout_post_install_delegate" || return 1
    fi
  }

  development_symlink_matches() {
    local link=$1 expected=$2 encoded actual

    [[ -L "$link" ]] || return 1
    # Command substitution strips trailing newlines. Append a non-newline
    # sentinel so readlink's terminator remains observable and a newline-bearing
    # target cannot normalize to the expected path.
    encoded=$({ readlink "$link" && printf '\034'; }) || return 1
    case $encoded in
      *$'\034') encoded=${encoded%$'\034'} ;;
      *) return 1 ;;
    esac
    [[ "$encoded" == *$'\n' ]] || return 1
    actual=${encoded%$'\n'}
    [[ "$actual" == "$expected" ]]
  }

  # shellcheck disable=SC2329 # Emitted through renderer call markers.
  revalidate_selected_development_checkout() {
    [[ "$development_checkout_selected" == true ]] || return 0
    if ! development_symlink_matches \
      "$checkout_dir" "$expected_development_dir" ||
      ! validate_development_checkout "$expected_development_dir"; then
      die "selected development checkout changed before execution: $expected_development_dir: ${development_validation_error:-link target changed}"
    fi
    checkout_runtime_root=$expected_development_dir
  }

  load_development_identity() {
    local identity=$1 header

    [[ -f "$identity" && ! -L "$identity" ]] || return 1
    header=$(sed -n '1p' "$identity")
    [[ "$header" == 'cgraf78 checkout installer development-to-managed transaction v1' ]] ||
      return 1
    development_recorded_target=$(sed -n '5p' "$identity")
    update_recorded_delegate=$(sed -n '6p' "$identity")
    update_recorded_post_install_delegate=$(sed -n '7p' "$identity")
    case "$update_recorded_delegate" in
      '' | install.sh | -* | . | .. | /* | ./* | */./* | */. | *[!A-Za-z0-9._/-]* | *//* | ../* | */../* | */..)
        return 1
        ;;
    esac
    if [[ -n "$update_recorded_post_install_delegate" ]]; then
      case "$update_recorded_post_install_delegate" in
        install.sh | -* | . | .. | /* | ./* | */./* | */. | *[!A-Za-z0-9._/-]* | *//* | ../* | */../* | */..)
          return 1
          ;;
      esac
      [[ "$update_recorded_post_install_delegate" != "$update_recorded_delegate" ]] ||
        return 1
    fi
    [[ $(wc -l <"$identity" | command tr -d '[:space:]') == 7 &&
    $(sed -n '2p' "$identity") == "$checkout_dir" &&
    $(sed -n '3p' "$identity") == "$checkout_repo" &&
    $(sed -n '4p' "$identity") == "$checkout_ref" &&
    "$development_recorded_target" == "$expected_development_dir" ]]
  }

  # @CHECKOUT_DEVELOPMENT_END@
  locate_update_identity() {
    local candidate count=0

    update_identity=
    for candidate in "$update_transaction"/identity.*; do
      [[ -e "$candidate" || -L "$candidate" ]] || continue
      count=$((count + 1))
      update_identity=$candidate
    done
    [[ "$count" -eq 1 && -f "$update_identity" &&
      ! -L "$update_identity" ]] || return 1
    # @CHECKOUT_DEVELOPMENT_BEGIN@
    update_transaction_kind=managed
    if [[ $(sed -n '1p' "$update_identity") == 'cgraf78 checkout installer development-to-managed transaction v1' ]]; then
      load_development_identity "$update_identity" || return 1
      update_transaction_kind=development
      return 0
    fi
    # @CHECKOUT_DEVELOPMENT_END@
    update_recorded_delegate=$(sed -n '5p' "$update_identity")
    case "$update_recorded_delegate" in
      '' | install.sh | -* | . | .. | /* | ./* | */./* | */. | *[!A-Za-z0-9._/-]* | *//* | ../* | */../* | */..)
        return 1
        ;;
    esac
    # @CHECKOUT_POST_INSTALL_BEGIN@
    update_recorded_post_install_delegate=$(sed -n '6p' "$update_identity")
    if [[ -n "$update_recorded_post_install_delegate" ]]; then
      case "$update_recorded_post_install_delegate" in
        install.sh | -* | . | .. | /* | ./* | */./* | */. | *[!A-Za-z0-9._/-]* | *//* | ../* | */../* | */..)
          return 1
          ;;
      esac
      [[ "$update_recorded_post_install_delegate" != "$update_recorded_delegate" ]] ||
        return 1
    fi
    # @CHECKOUT_POST_INSTALL_END@
    [[ $(sed -n '1p' "$update_identity") == 'cgraf78 checkout installer update transaction v1' &&
    $(sed -n '2p' "$update_identity") == "$checkout_dir" &&
    $(sed -n '3p' "$update_identity") == "$checkout_repo" &&
    $(sed -n '4p' "$update_identity") == "$checkout_ref" ]]
  }

  update_identity_matches() {
    local marker=$1

    [[ -f "$update_identity" && ! -L "$update_identity" &&
      -f "$marker" &&
      "$update_identity" -ef "$marker" ]]
  }

  # @CHECKOUT_DEVELOPMENT_BEGIN@
  development_identity_matches() {
    local marker=$1 line index
    local -a identity_lines=() marker_lines=()

    [[ -f "$update_identity" && ! -L "$update_identity" &&
      -f "$marker" && ! -L "$marker" ]] || return 1
    if update_identity_matches "$marker"; then
      return 0
    fi
    # Validate both records with the existing seven-line grammar in subshells
    # so a rejected candidate cannot replace the transaction's loaded delegate
    # state. Then compare every line with Bash builtins; this avoids adding a
    # bootstrap utility dependency while still catching a valid record whose
    # delegate or post-delegate differs.
    (load_development_identity "$update_identity") &&
      (load_development_identity "$marker") || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
      identity_lines[${#identity_lines[@]}]=$line
    done <"$update_identity"
    line=
    while IFS= read -r line || [[ -n "$line" ]]; do
      marker_lines[${#marker_lines[@]}]=$line
    done <"$marker"
    [[ ${#identity_lines[@]} -eq ${#marker_lines[@]} ]] || return 1
    for ((index = 0; index < ${#identity_lines[@]}; index++)); do
      [[ "${identity_lines[index]}" == "${marker_lines[index]}" ]] ||
        return 1
    done
  }

  reclaim_nested_development_checkout() {
    local nested=$1 destination=$2 marker=$3

    [[ ! -e "$destination" && ! -L "$destination" ]] || return 1
    development_identity_matches "$nested/$marker" || return 1
    mv -n "$nested" "$destination" || return 1
    development_identity_matches "$destination/$marker"
  }

  # @CHECKOUT_DEVELOPMENT_END@
  reclaim_nested_update_checkout() {
    local nested=$1 destination=$2 marker=$3

    [[ ! -e "$destination" && ! -L "$destination" ]] || return 1
    update_identity_matches "$nested/$marker" || return 1
    mv -n "$nested" "$destination" || return 1
    update_identity_matches "$destination/$marker"
  }

  validate_recorded_checkout() {
    local candidate=$1 head_file=$2 require_recorded_delegate=$3 actual expected

    [[ -f "$head_file" && ! -L "$head_file" ]] || return 1
    expected=$(sed -n '1p' "$head_file")
    [[ "$expected" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || return 1
    if ! (
      validate_managed_checkout "$candidate"
      if [[ "$require_recorded_delegate" == true ]]; then
        require_tree_delegate "$candidate" HEAD "$update_recorded_delegate"
        require_tracked_delegate "$candidate" "$update_recorded_delegate"
        # @CHECKOUT_POST_INSTALL_BEGIN@
        if [[ -n "$update_recorded_post_install_delegate" ]]; then
          require_tree_post_install_delegate "$candidate" HEAD \
            "$update_recorded_post_install_delegate"
          require_tracked_post_install_delegate "$candidate" \
            "$update_recorded_post_install_delegate"
        fi
        # @CHECKOUT_POST_INSTALL_END@
      fi
    ); then
      return 1
    fi
    actual=$(bootstrap_git -C "$candidate" rev-parse HEAD) || return 1
    [[ "$actual" == "$expected" ]]
  }

  # @CHECKOUT_DEVELOPMENT_BEGIN@
  recover_development_preparation() {
    local entry name preparation_count=0 current_marker
    local candidate_head_present=false

    current_marker="$checkout_dir/$update_next_marker"
    for entry in "$update_transaction"/* "$update_transaction"/.[!.]* \
      "$update_transaction"/..?*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      name=${entry##*/}
      case $name in
        .identity.prepare.*)
          [[ -f "$entry" && ! -L "$entry" ]] || return 1
          preparation_count=$((preparation_count + 1))
          ;;
        candidate-head)
          [[ -f "$entry" && ! -L "$entry" ]] || return 1
          candidate_head_present=true
          ;;
        identity.* | next | previous)
          return 2
          ;;
        *) return 2 ;;
      esac
    done

    if [[ "$preparation_count" -eq 0 &&
      -d "$checkout_dir" && ! -L "$checkout_dir" &&
      -f "$current_marker" && ! -L "$current_marker" ]] &&
      load_development_identity "$current_marker"; then
      if [[ "$candidate_head_present" == true ]]; then
        validate_recorded_checkout \
          "$checkout_dir" "$update_candidate_head" true || return 1
        rm -f -- "$update_candidate_head" || return 1
      else
        validate_managed_checkout "$checkout_dir" || return 1
        require_tracked_delegate "$checkout_dir" "$update_recorded_delegate"
        if [[ -n "$update_recorded_post_install_delegate" ]]; then
          require_tracked_post_install_delegate \
            "$checkout_dir" "$update_recorded_post_install_delegate"
        fi
      fi
      rmdir "$update_transaction" || return 1
      rm -f -- "$current_marker" || return 1
      update_transaction_created=0
      return 0
    fi

    development_symlink_matches \
      "$checkout_dir" "$expected_development_dir" || return 2
    for entry in "$update_transaction"/.identity.prepare.*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      rm -f -- "$entry" || return 1
    done
    rmdir "$update_transaction" || return 1
    update_transaction_created=0
    return 0
  }

  recover_orphaned_development_marker() {
    local marker="$checkout_dir/$update_next_marker" header

    [[ -e "$update_transaction" || -L "$update_transaction" ]] && return 0
    [[ -d "$checkout_dir" && ! -L "$checkout_dir" ]] || return 0
    [[ -f "$marker" && ! -L "$marker" ]] || return 0
    header=$(sed -n '1p' "$marker")
    [[ "$header" == 'cgraf78 checkout installer development-to-managed transaction v1' ]] ||
      return 0
    load_development_identity "$marker" || return 1
    validate_managed_checkout "$checkout_dir" || return 1
    require_tracked_delegate "$checkout_dir" "$update_recorded_delegate"
    if [[ -n "$update_recorded_post_install_delegate" ]]; then
      require_tracked_post_install_delegate \
        "$checkout_dir" "$update_recorded_post_install_delegate"
    fi
    rm -f -- "$marker"
  }

  validate_development_transaction_entries() {
    local entry name

    for entry in "$update_transaction"/* "$update_transaction"/.[!.]* \
      "$update_transaction"/..?*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      name=${entry##*/}
      case $name in
        identity.* | next | previous | candidate-head) ;;
        *)
          printf 'install.sh: development transaction has unexpected state: %s\n' \
            "$entry" >&2
          return 1
          ;;
      esac
    done
  }

  reclaim_nested_development_links() {
    local nested_parked="$update_previous/$checkout_name"
    local nested_rollback="$checkout_dir/${update_previous##*/}"

    # Portable mv nests a symlink when a directory wins at its destination.
    # Restore only the exact recorded link to the side it came from. The late
    # directory remains in place so the main classifier fails closed instead
    # of treating a same-UID collision as transaction authority.
    if [[ -d "$update_previous" && ! -L "$update_previous" &&
      ! -e "$checkout_dir" && ! -L "$checkout_dir" &&
      -L "$nested_parked" ]] &&
      development_symlink_matches \
        "$nested_parked" "$development_recorded_target"; then
      mv -n "$nested_parked" "$checkout_dir" || return 1
      development_symlink_matches \
        "$checkout_dir" "$development_recorded_target" || return 1
    fi
    if [[ ! -e "$update_previous" && ! -L "$update_previous" &&
      -d "$checkout_dir" && ! -L "$checkout_dir" &&
      -L "$nested_rollback" ]] &&
      development_symlink_matches \
        "$nested_rollback" "$development_recorded_target"; then
      mv -n "$nested_rollback" "$update_previous" || return 1
      development_symlink_matches \
        "$update_previous" "$development_recorded_target" || return 1
    fi
  }

  recover_development_transaction() {
    local current_marker nested_next committed=false

    validate_development_transaction_entries || return 1
    current_marker="$checkout_dir/$update_next_marker"
    nested_next="$checkout_dir/${update_next##*/}"

    if [[ ! -e "$update_next" && ! -L "$update_next" &&
      -d "$nested_next" && ! -L "$nested_next" ]] &&
      development_identity_matches "$nested_next/$update_next_marker"; then
      reclaim_nested_development_checkout "$nested_next" "$update_next" \
        "$update_next_marker" || return 1
    fi
    reclaim_nested_development_links || return 1

    if [[ -e "$update_previous" || -L "$update_previous" ]]; then
      if ! development_symlink_matches \
        "$update_previous" "$development_recorded_target"; then
        printf 'install.sh: development rollback link differs: %s\n' \
          "$update_previous" >&2
        return 1
      fi
      if development_identity_matches "$current_marker"; then
        validate_recorded_checkout \
          "$checkout_dir" "$update_candidate_head" true || return 1
        committed=true
        rm -f -- "$update_previous" || return 1
      elif [[ ! -e "$checkout_dir" && ! -L "$checkout_dir" ]]; then
        mv -n "$update_previous" "$checkout_dir" || return 1
        if ! development_symlink_matches \
          "$checkout_dir" "$development_recorded_target"; then
          reclaim_nested_development_links || return 1
          printf 'install.sh: cannot restore development checkout link: %s\n' \
            "$checkout_dir" >&2
          return 1
        fi
      else
        printf 'install.sh: cannot safely recover development transition: %s\n' \
          "$checkout_dir" >&2
        return 1
      fi
    elif development_symlink_matches \
      "$checkout_dir" "$development_recorded_target"; then
      :
    elif development_identity_matches "$current_marker"; then
      validate_recorded_checkout \
        "$checkout_dir" "$update_candidate_head" true || return 1
      committed=true
    else
      printf 'install.sh: development transaction does not match checkout: %s\n' \
        "$checkout_dir" >&2
      return 1
    fi

    if [[ -e "$update_next" || -L "$update_next" ]]; then
      [[ -d "$update_next" && ! -L "$update_next" ]] || return 1
      rm -rf -- "$update_next" || return 1
    fi
    [[ ! -e "$update_previous" && ! -L "$update_previous" ]] || return 1
    if [[ "$committed" == true ]]; then
      # Once publication commits, the regular candidate marker owns the exact
      # generation. Retire the transaction-side identity first, while the head
      # proof remains available to validate a crash at this boundary. A later
      # death after head removal leaves an empty transaction that the same
      # marker can finish retiring.
      rm -f -- "$update_identity" || return 1
      rm -f -- "$update_candidate_head" "$update_previous_head" || return 1
    else
      # Before publication the transaction identity is the only authority for
      # its staged candidate, so keep it until that candidate's head record is
      # gone.
      rm -f -- "$update_candidate_head" "$update_previous_head" || return 1
      rm -f -- "$update_identity" || return 1
    fi
    rmdir "$update_transaction" || return 1
    update_transaction_created=0
    if [[ "$committed" == true ]]; then
      rm -f -- "$current_marker" || return 1
    fi
  }

  # @CHECKOUT_DEVELOPMENT_END@
  # Finish or roll back an update transaction using inode identity markers.
  # Hard links are preferred, with symbolic links as a fallback on filesystems
  # that reject hard links. This also handles a transaction left after SIGKILL
  # once the user has confirmed no installer is active and removed the stale
  # directory lock.
  recover_update_transaction() {
    local current_next current_previous nested_next nested_previous
    local previous_next previous_previous
    # @CHECKOUT_DEVELOPMENT_BEGIN@
    local development_preparation_status
    # @CHECKOUT_DEVELOPMENT_END@

    [[ -e "$update_transaction" || -L "$update_transaction" ]] || return 0
    if [[ ! -d "$update_transaction" || -L "$update_transaction" ]]; then
      printf 'install.sh: update transaction is not a regular directory: %s\n' \
        "$update_transaction" >&2
      return 1
    fi
    # @CHECKOUT_DEVELOPMENT_BEGIN@
    if recover_development_preparation; then
      return 0
    else
      development_preparation_status=$?
      [[ "$development_preparation_status" -eq 2 ]] || return 1
    fi
    # @CHECKOUT_DEVELOPMENT_END@
    if ! locate_update_identity; then
      if [[ "$update_transaction_created" -eq 1 ]] &&
        rmdir "$update_transaction" 2>/dev/null; then
        update_transaction_created=0
        return 0
      fi
      printf 'install.sh: update transaction has no valid ownership identity: %s\n' \
        "$update_transaction" >&2
      return 1
    fi
    # @CHECKOUT_DEVELOPMENT_BEGIN@
    if [[ "$update_transaction_kind" == development ]]; then
      recover_development_transaction
      return
    fi
    # @CHECKOUT_DEVELOPMENT_END@

    current_next="$checkout_dir/$update_next_marker"
    current_previous="$checkout_dir/$update_previous_marker"
    nested_next="$checkout_dir/${update_next##*/}"
    nested_previous="$checkout_dir/${update_previous##*/}"
    previous_next="$update_previous/$update_next_marker"
    previous_previous="$update_previous/$update_previous_marker"

    # Portable mv nests a source when a same-UID race creates the target
    # directory. Reclaim only a child carrying this transaction's identity,
    # and leave the foreign target itself untouched.
    if [[ ! -e "$update_next" && ! -L "$update_next" &&
      -d "$nested_next" && ! -L "$nested_next" ]] &&
      update_identity_matches "$nested_next/$update_next_marker"; then
      reclaim_nested_update_checkout "$nested_next" "$update_next" \
        "$update_next_marker" || return 1
    fi
    if [[ ! -e "$update_previous" && ! -L "$update_previous" &&
      -d "$nested_previous" && ! -L "$nested_previous" ]] &&
      update_identity_matches "$nested_previous/$update_previous_marker"; then
      reclaim_nested_update_checkout "$nested_previous" "$update_previous" \
        "$update_previous_marker" || return 1
    fi

    if [[ -e "$update_previous" || -L "$update_previous" ]]; then
      if [[ ! -d "$update_previous" || -L "$update_previous" ]]; then
        printf 'install.sh: update rollback is not a regular directory: %s\n' \
          "$update_previous" >&2
        return 1
      fi
      if update_identity_matches "$current_next"; then
        # The fully validated candidate reached the stable path. Publication
        # is the commit point, so finish retiring the old checkout.
        validate_recorded_checkout "$checkout_dir" \
          "$update_candidate_head" true ||
          return 1
        rm -rf -- "$update_previous" || return 1
        rm -f -- "$current_next" || return 1
      elif [[ ! -e "$checkout_dir" && ! -L "$checkout_dir" ]] &&
        update_identity_matches "$previous_previous"; then
        # The old checkout moved but candidate publication did not complete.
        validate_recorded_checkout "$update_previous" \
          "$update_previous_head" false || return 1
        mv -n "$update_previous" "$checkout_dir" || return 1
        if ! update_identity_matches "$current_previous"; then
          if [[ -d "$nested_previous" && ! -L "$nested_previous" ]]; then
            reclaim_nested_update_checkout "$nested_previous" \
              "$update_previous" "$update_previous_marker" || return 1
          fi
          return 1
        fi
        rm -f -- "$current_previous" || return 1
      else
        printf 'install.sh: cannot safely recover managed checkout update: %s\n' \
          "$checkout_dir" >&2
        return 1
      fi
    elif update_identity_matches "$current_previous"; then
      # The transaction stopped before moving the old checkout.
      validate_recorded_checkout "$checkout_dir" \
        "$update_previous_head" false ||
        return 1
      rm -f -- "$current_previous" || return 1
    elif update_identity_matches "$current_next"; then
      # The old checkout was already retired; finish the committed update.
      validate_recorded_checkout "$checkout_dir" \
        "$update_candidate_head" true ||
        return 1
      rm -f -- "$current_next" || return 1
    elif [[ -e "$current_next" || -L "$current_next" ||
      -e "$current_previous" || -L "$current_previous" ||
      -e "$previous_next" || -L "$previous_next" ||
      -e "$previous_previous" || -L "$previous_previous" ]]; then
      printf 'install.sh: update transaction identity does not match checkout: %s\n' \
        "$checkout_dir" >&2
      return 1
    fi

    if [[ -e "$update_next" || -L "$update_next" ]]; then
      if [[ ! -d "$update_next" || -L "$update_next" ]]; then
        printf 'install.sh: staged update is not a regular directory: %s\n' \
          "$update_next" >&2
        return 1
      fi
      rm -rf -- "$update_next" || return 1
    fi
    [[ ! -e "$update_previous" && ! -L "$update_previous" ]] || return 1
    rm -f -- "$update_candidate_head" "$update_previous_head" || return 1
    rm -f -- "$update_identity" || return 1
    rmdir "$update_transaction" || return 1
    update_transaction_created=0
  }

  # @CHECKOUT_DEVELOPMENT_BEGIN@
  begin_development_to_managed() {
    local identity_preparation identity_suffix current_marker
    local nested_next candidate_head

    development_symlink_matches \
      "$checkout_dir" "$expected_development_dir" ||
      die "development checkout link changed before managed recovery: $checkout_dir"
    mkdir "$update_transaction" ||
      die "cannot create development recovery transaction: $update_transaction"
    update_transaction_created=1
    identity_preparation=$(mktemp \
      "$update_transaction/.identity.prepare.XXXXXX") ||
      die "cannot create development recovery identity: $update_transaction"
    if ! printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
      'cgraf78 checkout installer development-to-managed transaction v1' \
      "$checkout_dir" "$checkout_repo" "$checkout_ref" \
      "$expected_development_dir" "$checkout_delegate" \
      "${checkout_post_install_delegate:-}" >"$identity_preparation" ||
      ! chmod 0600 "$identity_preparation"; then
      die "cannot write development recovery identity: $update_transaction"
    fi
    identity_suffix=${identity_preparation##*.}
    update_identity="$update_transaction/identity.$identity_suffix"
    mv -n "$identity_preparation" "$update_identity" ||
      die "cannot publish development recovery identity: $update_transaction"
    [[ -f "$update_identity" && ! -L "$update_identity" &&
      ! -e "$identity_preparation" && ! -L "$identity_preparation" ]] ||
      die "cannot verify development recovery identity: $update_transaction"
    locate_update_identity && [[ "$update_transaction_kind" == development ]] ||
      die "cannot validate development recovery identity: $update_transaction"

    network_git -c init.templateDir= \
      clone --quiet --depth 1 --single-branch --branch "$checkout_ref" \
      --no-tags -- "$repo_url" "$update_next" </dev/null ||
      die "cannot clone $checkout_repo branch $checkout_ref for managed recovery"
    validate_managed_checkout "$update_next"
    require_tree_delegate "$update_next" HEAD
    require_tracked_delegate "$update_next"
    if [[ -n ${checkout_post_install_delegate:-} ]]; then
      require_tree_post_install_delegate "$update_next" HEAD
      require_tracked_post_install_delegate "$update_next"
    fi
    candidate_head=$(bootstrap_git -C "$update_next" rev-parse HEAD) ||
      die "cannot resolve managed recovery revision: $update_next"
    printf '%s\n' "$candidate_head" >"$update_candidate_head" ||
      die "cannot record managed recovery revision: $candidate_head"
    # Make candidate authority self-contained while the clone is still private
    # and before the user-owned development link moves. The development helper
    # preserves inode identity where supported and uses a verified regular copy
    # on Android filesystems that reject hard links.
    create_development_identity_marker \
      "$update_identity" "$update_next/$update_next_marker" ||
      die 'cannot prepare managed recovery candidate identity'

    mv -n "$checkout_dir" "$update_previous" ||
      die "cannot park development checkout link: $checkout_dir"
    if ! development_symlink_matches \
      "$update_previous" "$expected_development_dir"; then
      reclaim_nested_development_links || true
      die "cannot verify parked development checkout link: $update_previous"
    fi
    [[ ! -e "$checkout_dir" && ! -L "$checkout_dir" ]] ||
      die "managed checkout destination remained after parking development link: $checkout_dir"

    mv -n "$update_next" "$checkout_dir" ||
      die "cannot publish managed recovery checkout: $checkout_dir"
    current_marker="$checkout_dir/$update_next_marker"
    if ! development_identity_matches "$current_marker"; then
      nested_next="$checkout_dir/${update_next##*/}"
      if [[ ! -e "$update_next" && ! -L "$update_next" &&
        -d "$nested_next" && ! -L "$nested_next" ]] &&
        development_identity_matches "$nested_next/$update_next_marker"; then
        reclaim_nested_development_checkout "$nested_next" "$update_next" \
          "$update_next_marker" || true
      fi
      die "cannot verify published managed recovery checkout: $checkout_dir"
    fi
    recover_update_transaction ||
      die "cannot finish development-to-managed recovery: $update_transaction"
    development_checkout_recovered=true
    checkout_runtime_root=$checkout_dir
  }

  # @CHECKOUT_DEVELOPMENT_END@
  # shellcheck disable=SC2329 # Installed as the EXIT trap below.
  cleanup() {
    local status=$?

    trap - EXIT HUP INT TERM
    recover_update_transaction || true
    recover_staging_location
    if [[ -n "$active_git_home" && -d "$active_git_home" &&
      ! -L "$active_git_home" ]]; then
      rm -rf -- "$active_git_home"
    fi
    if [[ -n "$staging" && -d "$staging" && ! -L "$staging" ]]; then
      rm -rf -- "$staging"
    fi
    if [[ -n "$publish_identity" && -f "$publish_identity" &&
      ! -L "$publish_identity" ]]; then
      rm -f -- "$publish_identity"
    fi
    release_lock
    exit "$status"
  }

  # shellcheck disable=SC2329 # Reached by the signal-trap call chain below.
  wait_for_pid_exit() {
    local pid=$1

    for _ in {1..100}; do
      kill -0 "$pid" 2>/dev/null || return 0
      command sleep 0.01
    done
    return 1
  }

  # shellcheck disable=SC2329 # Reached by the signal-trap call chain below.
  terminate_snapshot_child() {
    local child=$1 parent=$2 signal=$3

    # Keep the parent alive long enough to reap the child. Killing a whole tree
    # in one fire-and-forget pass can orphan a still-exiting descendant, which
    # remains observable as a zombie under minimal container init processes.
    kill -s "$signal" "$child" 2>/dev/null || true
    wait_for_pid_exit "$child" && return 0
    kill -s KILL "$child" 2>/dev/null || true
    wait_for_pid_exit "$child" && return 0
    printf 'install.sh: child process %s was not reaped by parent %s after %s and KILL\n' \
      "$child" "$parent" "$signal" >&2
    return 1
  }

  # shellcheck disable=SC2329 # Reached by the signal-trap call chain below.
  signal_snapshot_children() {
    local parent=$1 signal=$2 snapshot=$3 child children live_parent failed=0

    children=$(printf '%s\n' "$snapshot" |
      command awk -v parent="$parent" '$2 == parent { print $1 }')
    for child in $children; do
      signal_snapshot_children "$child" "$signal" "$snapshot" || failed=1
      live_parent=$(command ps -o ppid= -p "$child" 2>/dev/null || true)
      live_parent=${live_parent//[[:space:]]/}
      if [[ "$live_parent" == "$parent" ]]; then
        terminate_snapshot_child "$child" "$parent" "$signal" || failed=1
      fi
    done
    return "$failed"
  }

  # shellcheck disable=SC2329 # Reached by the signal-trap call chain below.
  signal_process_tree() {
    local root=$1 signal=$2 snapshot

    local failed=0

    snapshot=$(command ps -eo pid=,ppid= 2>/dev/null || true)
    signal_snapshot_children "$root" "$signal" "$snapshot" || failed=1
    # Cancellation must not leave the active delegate running. If an
    # uncooperative parent failed to reap a descendant even after escalation,
    # the caller above reports that limitation before this final best-effort
    # root termination.
    kill -s "$signal" "$root" 2>/dev/null || true
    return "$failed"
  }

  # shellcheck disable=SC2329 # Installed as the signal traps below.
  forward_signal() {
    local signal=$1 status=$2 child_signal=$1

    trap - HUP INT TERM
    if [[ -n "$active_child_pid" ]]; then
      # Non-job-control Bash starts asynchronous children with SIGINT ignored.
      # Use a catchable termination signal for those owned children while the
      # bootstrap still reports the conventional interrupt status to callers.
      [[ "$signal" == INT ]] && child_signal=TERM
      if ! signal_process_tree "$active_child_pid" "$child_signal"; then
        printf 'install.sh: process-tree cleanup was incomplete after %s\n' \
          "$signal" >&2
      fi
      wait "$active_child_pid" 2>/dev/null || true
      active_child_pid=
    fi
    exit "$status"
  }

  trap cleanup EXIT
  trap 'forward_signal HUP 129' HUP
  trap 'forward_signal INT 130' INT
  trap 'forward_signal TERM 143' TERM

  # @CHECKOUT_LOCK_V1_BEGIN@
  acquire_checkout_lock_v1 ||
    die "cannot acquire managed checkout lock: $lock_dir"
  # @CHECKOUT_LOCK_V1_END@
  # @CHECKOUT_LEGACY_LOCK_BEGIN@
  if ! mkdir "$lock_dir" 2>/dev/null; then
    die "another install may be using the managed checkout lock: $lock_dir; if no install is running, remove that exact empty directory with rmdir and retry"
  fi
  lock_held=1
  # @CHECKOUT_LEGACY_LOCK_END@

  recover_update_transaction ||
    die "cannot recover interrupted managed checkout update: $update_transaction"
  # @CHECKOUT_DEVELOPMENT_BEGIN@
  recover_orphaned_development_marker ||
    die "cannot recover completed development-to-managed transaction: $checkout_dir"

  checkout_runtime_root=$checkout_dir
  development_checkout_selected=false
  development_checkout_recovered=false
  if [[ -L "$checkout_dir" ]]; then
    if ! development_symlink_matches \
      "$checkout_dir" "$expected_development_dir"; then
      die "managed checkout is a foreign symbolic link: $checkout_dir"
    fi
    if [[ "$checkout_force_managed" == true ]]; then
      begin_development_to_managed
    elif validate_development_checkout "$expected_development_dir"; then
      development_checkout_selected=true
      checkout_runtime_root=$expected_development_dir
      printf 'install.sh: using development checkout %s\n' \
        "$expected_development_dir"
    else
      die "selected development checkout is invalid: $expected_development_dir: $development_validation_error; rerun install.sh --managed to restore a managed checkout"
    fi
  elif [[ "$checkout_force_managed" != true &&
    (-e "$expected_development_dir" || -L "$expected_development_dir") ]] &&
    ! validate_development_checkout "$expected_development_dir"; then
    printf 'install.sh: warning: ignoring invalid unselected development checkout %s: %s\n' \
      "$expected_development_dir" "$development_validation_error" >&2
  fi
  # @CHECKOUT_DEVELOPMENT_END@

  if [[ -e "$checkout_dir" || -L "$checkout_dir" ]]; then # @CHECKOUT_MANAGED_DESTINATION_IF@
    validate_managed_checkout "$checkout_dir"
    printf 'install.sh: updating %s\n' "$checkout_dir"
    mkdir "$update_transaction" ||
      die "cannot create update transaction: $update_transaction"
    update_transaction_created=1
    update_identity=$(mktemp "$update_transaction/identity.XXXXXX") ||
      die "cannot create update transaction identity: $update_identity"
    if ! printf '%s\n%s\n%s\n%s\n%s\n' \
      'cgraf78 checkout installer update transaction v1' \
      "$checkout_dir" "$checkout_repo" "$checkout_ref" \
      "$checkout_delegate" >"$update_identity"; then
      rm -f -- "$update_identity"
      die "cannot write update transaction identity: $update_transaction"
    fi
    # @CHECKOUT_POST_INSTALL_BEGIN@
    if ! printf '%s\n' "$checkout_post_install_delegate" >>"$update_identity"; then
      rm -f -- "$update_identity"
      die "cannot record checkout post-install command: $update_transaction"
    fi
    # @CHECKOUT_POST_INSTALL_END@
    update_recorded_delegate=$checkout_delegate
    # @CHECKOUT_POST_INSTALL_BEGIN@
    update_recorded_post_install_delegate=$checkout_post_install_delegate
    # @CHECKOUT_POST_INSTALL_END@
    network_git -c init.templateDir= \
      clone --quiet --single-branch --branch "$checkout_ref" \
      --no-tags -- "$repo_url" "$update_next" </dev/null ||
      die "cannot clone $checkout_repo branch $checkout_ref for update"
    validate_managed_checkout "$update_next"
    require_tree_delegate "$update_next" HEAD
    require_tracked_delegate "$update_next"
    # @CHECKOUT_POST_INSTALL_BEGIN@
    require_tree_post_install_delegate "$update_next" HEAD
    require_tracked_post_install_delegate "$update_next"
    # @CHECKOUT_POST_INSTALL_END@
    current_head=$(bootstrap_git -C "$checkout_dir" rev-parse HEAD) ||
      die "cannot resolve managed checkout revision: $checkout_dir"
    candidate_head=$(bootstrap_git -C "$update_next" rev-parse HEAD) ||
      die "cannot resolve staged managed checkout revision: $update_next"
    bootstrap_git -C "$update_next" merge-base --is-ancestor \
      "$current_head" "$candidate_head" ||
      die "managed Git checkout cannot fast-forward: $checkout_dir"
    if [[ "$current_head" != "$candidate_head" ]]; then
      printf '%s\n' "$candidate_head" >"$update_candidate_head" ||
        die "cannot record staged managed checkout revision: $candidate_head"
      printf '%s\n' "$current_head" >"$update_previous_head" ||
        die "cannot record previous managed checkout revision: $current_head"
      create_identity_marker \
        "$update_identity" "$update_next/$update_next_marker" ||
        die 'cannot prepare staged update identity'
      create_identity_marker \
        "$update_identity" "$checkout_dir/$update_previous_marker" ||
        die 'cannot prepare managed checkout rollback identity'
      mv -n "$checkout_dir" "$update_previous" ||
        die "cannot stage previous managed checkout: $checkout_dir"
      update_identity_matches "$update_previous/$update_previous_marker" ||
        die "cannot verify previous managed checkout identity: $update_previous"
      mv -n "$update_next" "$checkout_dir" ||
        die "cannot publish managed checkout update: $checkout_dir"
      update_identity_matches "$checkout_dir/$update_next_marker" ||
        die "cannot verify published managed checkout update: $checkout_dir"
    fi
    recover_update_transaction ||
      die "cannot finish managed checkout update: $update_transaction"
    validate_managed_checkout "$checkout_dir"
    require_tracked_delegate "$checkout_dir"
    # @CHECKOUT_POST_INSTALL_BEGIN@
    require_tracked_post_install_delegate "$checkout_dir"
    # @CHECKOUT_POST_INSTALL_END@
  else
    staging=$(mktemp -d "$checkout_parent/.${checkout_slug}.clone.XXXXXX") ||
      die "cannot create checkout staging directory under $checkout_parent"
    printf 'install.sh: cloning %s to %s\n' "$checkout_repo" "$checkout_dir"
    network_git -c init.templateDir= \
      clone --quiet --depth 1 --single-branch --branch "$checkout_ref" \
      --no-tags -- "$repo_url" "$staging" </dev/null ||
      die "cannot clone $checkout_repo branch $checkout_ref"
    validate_managed_checkout "$staging"
    require_tree_delegate "$staging" HEAD
    require_tracked_delegate "$staging"
    # @CHECKOUT_POST_INSTALL_BEGIN@
    require_tree_post_install_delegate "$staging" HEAD
    require_tracked_post_install_delegate "$staging"
    # @CHECKOUT_POST_INSTALL_END@
    [[ ! -e "$checkout_dir" && ! -L "$checkout_dir" ]] ||
      die "managed checkout destination appeared during clone: $checkout_dir"
    publish_identity=$(mktemp "$checkout_parent/.${checkout_slug}.publish.XXXXXX") ||
      die "cannot create checkout publication identity under $checkout_parent"
    create_identity_marker \
      "$publish_identity" "$staging/.git/cgraf78-publish-identity" ||
      die 'cannot prepare checkout publication identity'
    mv -n "$staging" "$checkout_dir" ||
      die "cannot publish managed checkout: $checkout_dir"
    if [[ ! -f "$checkout_dir/.git/cgraf78-publish-identity" ||
      ! "$publish_identity" -ef "$checkout_dir/.git/cgraf78-publish-identity" ]]; then
      recover_staging_location
      die "managed checkout destination appeared during publication: $checkout_dir"
    fi
    rm -f -- "$checkout_dir/.git/cgraf78-publish-identity" "$publish_identity"
    publish_identity=
    staging=
    validate_managed_checkout "$checkout_dir"
    require_tracked_delegate "$checkout_dir"
    # @CHECKOUT_POST_INSTALL_BEGIN@
    require_tracked_post_install_delegate "$checkout_dir"
    # @CHECKOUT_POST_INSTALL_END@
  fi
  # @CHECKOUT_POST_INSTALL_BEGIN@
  # @CHECKOUT_DEVELOPMENT_REVALIDATE@
  require_delegate "@CHECKOUT_RUNTIME_ROOT@"
  require_post_install_delegate "@CHECKOUT_RUNTIME_ROOT@"
  umask "$caller_umask"
  set +e
  # @CHECKOUT_BASH_RUN_DIR_DELEGATE@
  active_child_pid=$!
  wait "$active_child_pid"
  delegate_status=$?
  active_child_pid=
  set -e
  [[ "$delegate_status" -eq 0 ]] || exit "$delegate_status"
  # @CHECKOUT_DEVELOPMENT_REVALIDATE@

  # Every checkout mutation and recovery resource must be settled before the
  # lock is released. The post-install delegate can then safely invoke another
  # manager for the same checkout without inherited transaction state.
  [[ -z "$staging" && -z "$publish_identity" && -z "$active_git_home" &&
    "$update_transaction_created" -eq 0 &&
    ! -e "$update_transaction" && ! -L "$update_transaction" ]] ||
    die 'cannot enter post-install with active checkout transaction state'
  release_lock_for_post_install ||
    die "cannot release managed checkout lock before post-install: $lock_dir"
  trap - EXIT HUP INT TERM
  # @CHECKOUT_BASH_EXEC_DIR_POST@
  # @CHECKOUT_POST_INSTALL_END@

  # @CHECKOUT_DEVELOPMENT_REVALIDATE@
  require_delegate "@CHECKOUT_RUNTIME_ROOT@"
  umask "$caller_umask"
  set +e
  # @CHECKOUT_BASH_RUN_DIR_DELEGATE@
  active_child_pid=$!
  wait "$active_child_pid"
  delegate_status=$?
  active_child_pid=
  set -e
  exit "$delegate_status"
}

# shellcheck shell=bash
# Embedded checkout mutation lock v1 implementation.
#
# The renderer includes this file only for opted-in consumers. Keep it
# self-contained and compatible with stock macOS Bash 3.2; the generated
# installer cannot source another file when it is piped from the network.
# shellcheck disable=SC2154 # Runtime paths are defined by the parent template.

checkout_lock_hex() {
  LC_ALL=C printf '%s' "$1" |
    command od -An -tx1 |
    command tr -d ' \n'
}

checkout_lock_nonce() {
  local nonce

  nonce=$(command od -An -N16 -tx1 /dev/urandom 2>/dev/null |
    command tr -d ' \n') || return 1
  [[ "$nonce" =~ ^[0-9a-f]{32}$ ]] || return 1
  printf '%s\n' "$nonce"
}

checkout_lock_normalize_ps_lstart() {
  # BSD ps pads this field for display. Collapse every locale-C whitespace run
  # to one ASCII space so independent implementations derive identical bytes.
  LC_ALL=C command awk '{$1=$1; print}'
}

checkout_lock_procfs_authoritative() {
  # Some BSD-like systems expose an empty or compatibility /proc directory.
  # Only use PID-path absence as proof when this process has a Linux-style stat
  # record in the same mounted namespace.
  [[ -r /proc/self/stat ]]
}

checkout_lock_process_identity() {
  local pid=$1 stat_line stat_rest state token lstart ps_state

  if [[ -r "/proc/$pid/stat" ]] &&
    IFS= read -r stat_line <"/proc/$pid/stat"; then
    stat_rest=${stat_line##*) }
    # shellcheck disable=SC2086 # /proc stat fields are deliberately split.
    set -- $stat_rest
    [[ $# -ge 20 ]] || return 1
    state=$1
    shift 19
    token=$1
    [[ "$token" =~ ^[0-9]+$ ]] || return 1
    CHECKOUT_LOCK_START_KIND_HEX=70726f632d73746174
    CHECKOUT_LOCK_START_TOKEN_HEX=$(checkout_lock_hex "$token") || return 1
    CHECKOUT_LOCK_PROCESS_STATE=$state
    return 0
  fi

  lstart=$(LC_ALL=C command ps -o lstart= -p "$pid" 2>/dev/null |
    checkout_lock_normalize_ps_lstart) || return 1
  [[ -n "$lstart" ]] || return 1
  ps_state=$(LC_ALL=C command ps -o stat= -p "$pid" 2>/dev/null |
    command awk 'NR == 1 { print $1 }') || return 1
  [[ -n "$ps_state" ]] || return 1
  CHECKOUT_LOCK_START_KIND_HEX=70732d6c7374617274
  CHECKOUT_LOCK_START_TOKEN_HEX=$(checkout_lock_hex "$lstart") || return 1
  CHECKOUT_LOCK_PROCESS_STATE=${ps_state:0:1}
}

checkout_lock_current_identity() {
  local host

  host=$(LC_ALL=C command uname -n 2>/dev/null) || return 1
  [[ -n "$host" ]] || return 1
  CHECKOUT_LOCK_HOST_HEX=$(checkout_lock_hex "$host") || return 1
  checkout_lock_process_identity "$$"
}

checkout_lock_stat_private() {
  local path=$1 expected_mode=$2 output uid mode

  if output=$(command stat -c '%u %a' "$path" 2>/dev/null); then
    :
  elif output=$(command stat -f '%u %Lp' "$path" 2>/dev/null); then
    :
  else
    return 1
  fi
  read -r uid mode <<<"$output"
  [[ "$uid" == "$(id -u)" && "$mode" == "$expected_mode" ]]
}

checkout_lock_even_hex() {
  local value=$1 max_length=$2

  [[ -n "$value" && ${#value} -le "$max_length" &&
    $((${#value} % 2)) -eq 0 && "$value" != *[!0-9a-f]* ]]
}

checkout_lock_record_has_exact_text_framing() {
  local record=$1 last_byte

  # Bash variables cannot represent NUL, so `read` would silently erase one
  # and make malformed wire bytes look valid. Inspect the raw file first, then
  # require the fixed record to end with its ninth line terminator.
  LC_ALL=C command od -An -tx1 "$record" 2>/dev/null |
    command awk '{ for (i = 1; i <= NF; i++) if ($i == "00") nul = 1 }
                 END { exit nul ? 1 : 0 }' || return 1
  last_byte=$(LC_ALL=C command tail -c 1 "$record" 2>/dev/null) || return 1
  [[ -z "$last_byte" ]]
}

checkout_lock_directory_has_only() {
  local directory=$1 first=$2 second=${3:-} candidate base
  local first_count=0 second_count=0

  [[ -d "$directory" && ! -L "$directory" ]] || return 1
  for candidate in \
    "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
    [[ -e "$candidate" || -L "$candidate" ]] || continue
    base=${candidate##*/}
    if [[ "$base" == "$first" ]]; then
      first_count=$((first_count + 1))
    elif [[ -n "$second" && "$base" == "$second" ]]; then
      second_count=$((second_count + 1))
    else
      return 1
    fi
  done
  [[ "$first_count" -eq 1 ]] || return 1
  if [[ -n "$second" ]]; then
    [[ "$second_count" -eq 1 ]]
  else
    [[ "$second_count" -eq 0 ]]
  fi
}

checkout_lock_write_record() {
  local record=$1 role=$2 nonce=$3 owner_nonce=$4 role_hex checkout_hex

  case "$role" in
    owner) role_hex=6f776e6572 ;;
    claim) role_hex=636c61696d ;;
    *) return 1 ;;
  esac
  checkout_lock_current_identity || return 1
  checkout_hex=$(checkout_lock_hex "$checkout_dir") || return 1
  {
    printf '%s\n' 'cgraf78 checkout mutation lock v1'
    printf 'role=%s\n' "$role_hex"
    printf 'nonce=%s\n' "$nonce"
    printf 'owner_nonce=%s\n' "$owner_nonce"
    printf 'pid=%s\n' "$$"
    printf 'host_hex=%s\n' "$CHECKOUT_LOCK_HOST_HEX"
    printf 'start_kind_hex=%s\n' "$CHECKOUT_LOCK_START_KIND_HEX"
    printf 'start_token_hex=%s\n' "$CHECKOUT_LOCK_START_TOKEN_HEX"
    printf 'checkout_hex=%s\n' "$checkout_hex"
  } >"$record" || return 1
  chmod 0600 "$record"
}

checkout_lock_load_record() {
  local record=$1 expected_role=$2 expected_nonce=$3 expected_owner_nonce=$4
  local line line_count=0 header role nonce owner_nonce pid host_hex start_kind_hex
  local start_token_hex checkout_hex expected_role_hex expected_checkout_hex

  [[ -f "$record" && ! -L "$record" ]] || return 1
  checkout_lock_stat_private "$record" 600 || return 1
  checkout_lock_record_has_exact_text_framing "$record" || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_count=$((line_count + 1))
    case "$line_count" in
      1) header=$line ;;
      2)
        [[ "$line" == role=* ]] || return 1
        role=${line#role=}
        ;;
      3)
        [[ "$line" == nonce=* ]] || return 1
        nonce=${line#nonce=}
        ;;
      4)
        [[ "$line" == owner_nonce=* ]] || return 1
        owner_nonce=${line#owner_nonce=}
        ;;
      5)
        [[ "$line" == pid=* ]] || return 1
        pid=${line#pid=}
        ;;
      6)
        [[ "$line" == host_hex=* ]] || return 1
        host_hex=${line#host_hex=}
        ;;
      7)
        [[ "$line" == start_kind_hex=* ]] || return 1
        start_kind_hex=${line#start_kind_hex=}
        ;;
      8)
        [[ "$line" == start_token_hex=* ]] || return 1
        start_token_hex=${line#start_token_hex=}
        ;;
      9)
        [[ "$line" == checkout_hex=* ]] || return 1
        checkout_hex=${line#checkout_hex=}
        ;;
      *) return 1 ;;
    esac
  done 2>/dev/null <"$record" || return 1
  [[ "$line_count" -eq 9 ]] || return 1
  [[ "$header" == 'cgraf78 checkout mutation lock v1' ]] || return 1
  case "$expected_role" in
    owner) expected_role_hex=6f776e6572 ;;
    claim) expected_role_hex=636c61696d ;;
    *) return 1 ;;
  esac
  [[ "$role" == "$expected_role_hex" && "$nonce" == "$expected_nonce" &&
    "$owner_nonce" == "$expected_owner_nonce" ]] || return 1
  [[ "$nonce" =~ ^[0-9a-f]{32}$ && "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  if [[ "$expected_role" == owner ]]; then
    [[ -z "$owner_nonce" ]] || return 1
  else
    [[ "$owner_nonce" =~ ^[0-9a-f]{32}$ ]] || return 1
  fi
  checkout_lock_even_hex "$host_hex" 512 || return 1
  checkout_lock_even_hex "$start_token_hex" 2048 || return 1
  case "$start_kind_hex" in
    70726f632d73746174 | 70732d6c7374617274) ;;
    *) return 1 ;;
  esac
  expected_checkout_hex=$(checkout_lock_hex "$checkout_dir") || return 1
  [[ "$checkout_hex" == "$expected_checkout_hex" ]] || return 1
  checkout_lock_even_hex "$checkout_hex" 8192 || return 1

  CHECKOUT_LOCK_RECORD_PID=$pid
  CHECKOUT_LOCK_RECORD_HOST_HEX=$host_hex
  CHECKOUT_LOCK_RECORD_START_KIND_HEX=$start_kind_hex
  CHECKOUT_LOCK_RECORD_START_TOKEN_HEX=$start_token_hex
}

checkout_lock_record_liveness() {
  local current_host observed_pid probe_status

  current_host=$(LC_ALL=C command uname -n 2>/dev/null) || {
    CHECKOUT_LOCK_LIVENESS=unknown
    return 0
  }
  current_host=$(checkout_lock_hex "$current_host") || {
    CHECKOUT_LOCK_LIVENESS=unknown
    return 0
  }
  if [[ "$current_host" != "$CHECKOUT_LOCK_RECORD_HOST_HEX" ]]; then
    CHECKOUT_LOCK_LIVENESS=unknown
    return 0
  fi

  if checkout_lock_process_identity "$CHECKOUT_LOCK_RECORD_PID"; then
    if [[ "$CHECKOUT_LOCK_PROCESS_STATE" == Z ]]; then
      CHECKOUT_LOCK_LIVENESS=dead
    elif [[ "$CHECKOUT_LOCK_START_KIND_HEX" != "$CHECKOUT_LOCK_RECORD_START_KIND_HEX" ]]; then
      # A host can move between /proc and ps visibility without the process
      # changing. Tokens from different backends are not comparable, so this
      # is ambiguity rather than positive PID-reuse evidence.
      CHECKOUT_LOCK_LIVENESS=unknown
    elif [[ "$CHECKOUT_LOCK_START_TOKEN_HEX" == "$CHECKOUT_LOCK_RECORD_START_TOKEN_HEX" ]]; then
      CHECKOUT_LOCK_LIVENESS=live
    else
      # A live PID with a different start token is a reused process ID, not the
      # recorded lock owner. This is positive evidence that the owner is gone.
      CHECKOUT_LOCK_LIVENESS=dead
    fi
    return 0
  fi

  # Failure to read a process identity is not itself evidence of death. A
  # signal probe may fail with EPERM, so use an independent platform presence
  # check before reclaiming. Linux and Termux make absence in a mounted /proc
  # positive evidence; BSD ps uses status 1 with no row for a missing PID.
  if kill -0 "$CHECKOUT_LOCK_RECORD_PID" 2>/dev/null; then
    CHECKOUT_LOCK_LIVENESS=unknown
  elif checkout_lock_procfs_authoritative; then
    if [[ -e "/proc/$CHECKOUT_LOCK_RECORD_PID" ||
      -d "/proc/$CHECKOUT_LOCK_RECORD_PID" ]]; then
      CHECKOUT_LOCK_LIVENESS=unknown
    else
      CHECKOUT_LOCK_LIVENESS=dead
    fi
  elif observed_pid=$(LC_ALL=C command ps -o pid= \
    -p "$CHECKOUT_LOCK_RECORD_PID" 2>/dev/null); then
    observed_pid=${observed_pid//[[:space:]]/}
    CHECKOUT_LOCK_LIVENESS=unknown
  else
    probe_status=$?
    observed_pid=${observed_pid//[[:space:]]/}
    if [[ "$probe_status" -eq 1 && -z "$observed_pid" ]]; then
      CHECKOUT_LOCK_LIVENESS=dead
    else
      CHECKOUT_LOCK_LIVENESS=unknown
    fi
  fi
}

checkout_lock_prepare_owner() {
  local nonce prepare final owner_basename target record

  nonce=$(checkout_lock_nonce) || return 1
  prepare=$(mktemp -d \
    "$checkout_parent/.${checkout_name}.install.lock.owner.prepare.XXXXXX") ||
    return 1
  chmod 0700 "$prepare" || return 1
  record="$prepare/owner-v1"
  if ! checkout_lock_write_record "$record" owner "$nonce" ''; then
    rm -f -- "$record"
    rmdir "$prepare" 2>/dev/null || true
    return 1
  fi
  owner_basename=".${checkout_name}.install.lock.owner.${nonce}"
  # The `/.` is part of the wire format. If a legacy directory wins between
  # classification and publication, portable ln tries to create its basename
  # `.` inside that directory and fails instead of polluting the winner.
  target="$owner_basename/."
  final="$checkout_parent/$owner_basename"
  [[ ! -e "$final" && ! -L "$final" ]] || return 1
  mv "$prepare" "$final" || return 1
  checkout_lock_stat_private "$final" 700 || return 1
  checkout_lock_directory_has_only "$final" owner-v1 || return 1
  checkout_lock_load_record "$final/owner-v1" owner "$nonce" '' || return 1

  lock_owner_nonce=$nonce
  lock_owner_target=$target
  lock_owner_dir=$final
}

checkout_lock_discard_unpublished_owner() {
  [[ -n ${lock_owner_dir:-} && -d "$lock_owner_dir" &&
    ! -L "$lock_owner_dir" ]] || return 0
  rm -f -- "$lock_owner_dir/owner-v1" || return 1
  rmdir "$lock_owner_dir"
}

checkout_lock_prepare_claim() {
  local owner_nonce=$1 claim_nonce prepare final record

  claim_nonce=$(checkout_lock_nonce) || return 1
  prepare=$(mktemp -d \
    "$checkout_parent/.${checkout_name}.install.lock.claim.prepare.XXXXXX") ||
    return 1
  chmod 0700 "$prepare" || return 1
  record="$prepare/claim-v1"
  if ! checkout_lock_write_record \
    "$record" claim "$claim_nonce" "$owner_nonce"; then
    rm -f -- "$record"
    rmdir "$prepare" 2>/dev/null || true
    return 1
  fi
  final="$checkout_parent/.${checkout_name}.install.lock.claim.${owner_nonce}.${claim_nonce}"
  [[ ! -e "$final" && ! -L "$final" ]] || return 1
  mv "$prepare" "$final" || return 1
  checkout_lock_stat_private "$final" 700 || return 1
  checkout_lock_directory_has_only "$final" claim-v1 || return 1
  checkout_lock_load_record \
    "$final/claim-v1" claim "$claim_nonce" "$owner_nonce" || return 1

  lock_claim_dir=$final
}

checkout_lock_cleanup_retired_claim() {
  local claim_dir=$1 retired_dir="$1/retired"

  [[ -d "$claim_dir" && ! -L "$claim_dir" ]] || return 1
  [[ -d "$retired_dir" && ! -L "$retired_dir" ]] || return 1
  rm -f -- "$retired_dir/canonical" || return 1
  rm -f -- "$retired_dir/owner-v1" || return 1
  rmdir "$retired_dir" || return 1
  rm -f -- "$claim_dir/claim-v1" || return 1
  rmdir "$claim_dir"
}

checkout_lock_retire_and_cleanup_claim() {
  local claim_dir=$1 owner_dir="$1/owner" retired_dir="$1/retired"

  [[ -d "$claim_dir" && ! -L "$claim_dir" ]] || return 1
  [[ -d "$owner_dir" && ! -L "$owner_dir" ]] || return 1
  checkout_lock_directory_has_only "$claim_dir" claim-v1 owner || return 1
  checkout_lock_directory_has_only \
    "$owner_dir" owner-v1 canonical || return 1
  [[ ! -e "$retired_dir" && ! -L "$retired_dir" ]] || return 1
  # Moving the complete detached owner out of the active `owner` slot is the
  # cleanup commit point. A concurrent acquirer can ignore `retired`, while a
  # SIGKILL during the following leaf removals leaves only inert private debris
  # instead of a half-valid claim that can be mistaken for active ownership.
  mv "$owner_dir" "$retired_dir" || return 1
  [[ ! -e "$owner_dir" && ! -L "$owner_dir" &&
    -d "$retired_dir" && ! -L "$retired_dir" ]] || return 1
  checkout_lock_cleanup_retired_claim "$claim_dir"
}

checkout_lock_cleanup_empty_claim() {
  local claim_dir=$1

  [[ -d "$claim_dir" && ! -L "$claim_dir" &&
    ! -e "$claim_dir/owner" && ! -L "$claim_dir/owner" ]] || return 1
  rm -f -- "$claim_dir/claim-v1" || return 1
  rmdir "$claim_dir"
}

checkout_lock_claim_name() {
  local claim_dir=$1 base prefix rest owner_nonce claim_nonce

  base=${claim_dir##*/}
  prefix=".${checkout_name}.install.lock.claim."
  case "$base" in
    "$prefix"*) rest=${base#"$prefix"} ;;
    *) return 1 ;;
  esac
  owner_nonce=${rest%%.*}
  claim_nonce=${rest#*.}
  [[ "$owner_nonce" =~ ^[0-9a-f]{32}$ &&
    "$claim_nonce" =~ ^[0-9a-f]{32}$ &&
    "$claim_nonce" != *.* ]] || return 1
  CHECKOUT_LOCK_NAME_OWNER_NONCE=$owner_nonce
  CHECKOUT_LOCK_NAME_CLAIM_NONCE=$claim_nonce
}

checkout_lock_load_claim() {
  local claim_dir=$1 expected_owner_nonce=$2

  checkout_lock_claim_name "$claim_dir" || return 1
  [[ "$CHECKOUT_LOCK_NAME_OWNER_NONCE" == "$expected_owner_nonce" ]] ||
    return 1
  [[ -d "$claim_dir" && ! -L "$claim_dir" ]] || return 1
  checkout_lock_stat_private "$claim_dir" 700 || return 1
  checkout_lock_load_record \
    "$claim_dir/claim-v1" claim "$CHECKOUT_LOCK_NAME_CLAIM_NONCE" \
    "$expected_owner_nonce"
}

checkout_lock_find_claimed_owner() {
  local owner_nonce=$1 expected_target=$2 candidate count=0
  local claim_liveness claim_pid current_target nested_owner tombstone

  CHECKOUT_LOCK_CLAIM_DIR=
  for candidate in \
    "$checkout_parent/.${checkout_name}.install.lock.claim.${owner_nonce}."*; do
    [[ -e "$candidate" || -L "$candidate" ]] || continue
    nested_owner="$candidate/owner"
    # Empty preparation claims and claims that have atomically retired their
    # owner are outside arbitration. Validate only an owner-bearing claim.
    [[ -e "$nested_owner" || -L "$nested_owner" ]] || continue
    if ! checkout_lock_directory_has_only \
      "$candidate" claim-v1 owner; then
      [[ ! -e "$nested_owner" && ! -L "$nested_owner" ]] && return 2
      return 1
    fi
    if ! checkout_lock_load_claim "$candidate" "$owner_nonce"; then
      [[ ! -e "$candidate" && ! -L "$candidate" ]] && return 2
      if [[ ! -L "$lock_dir" ]] ||
        [[ $(readlink "$lock_dir" 2>/dev/null || true) != "$expected_target" ]]; then
        return 2
      fi
      return 1
    fi
    checkout_lock_record_liveness
    claim_liveness=$CHECKOUT_LOCK_LIVENESS
    claim_pid=$CHECKOUT_LOCK_RECORD_PID
    if [[ ! -e "$nested_owner" && ! -L "$nested_owner" ]]; then
      return 2
    fi
    if [[ ! -d "$nested_owner" || -L "$nested_owner" ]] ||
      ! checkout_lock_stat_private "$nested_owner" 700 ||
      ! checkout_lock_directory_has_only "$nested_owner" owner-v1 ||
      ! checkout_lock_load_record \
        "$nested_owner/owner-v1" owner "$owner_nonce" ''; then
      [[ ! -e "$nested_owner" && ! -L "$nested_owner" ]] && return 2
      if [[ ! -L "$lock_dir" ]] ||
        [[ $(readlink "$lock_dir" 2>/dev/null || true) != "$expected_target" ]]; then
        return 2
      fi
      return 1
    fi
    tombstone="$nested_owner/canonical"
    if [[ -e "$tombstone" || -L "$tombstone" ]]; then
      if [[ ! -L "$lock_dir" ]] ||
        [[ $(readlink "$lock_dir" 2>/dev/null || true) != "$expected_target" ]]; then
        return 2
      fi
      return 1
    fi
    count=$((count + 1))
    CHECKOUT_LOCK_CLAIM_DIR=$candidate
    CHECKOUT_LOCK_CLAIM_LIVENESS=$claim_liveness
    CHECKOUT_LOCK_CLAIM_PID=$claim_pid
  done
  # Claim cardinality is meaningful only while the canonical path still names
  # the generation we scanned. Release atomically moves that symlink into the
  # claimant after `-L` can succeed, so a failed or changed read is a transient
  # handoff snapshot rather than stable malformation.
  [[ -L "$lock_dir" ]] || return 2
  current_target=$(readlink "$lock_dir" 2>/dev/null) || return 2
  [[ "$current_target" == "$expected_target" ]] || return 2
  [[ "$count" -ne 0 ]] || return 2
  [[ "$count" -eq 1 ]] || return 1
  return 0
}

checkout_lock_detach_claimed_owner() {
  local claim_dir=$1 owner_target=$2 owner_nonce=$3
  local nested_owner="$1/owner" tombstone="$1/owner/canonical"

  checkout_lock_load_claim "$claim_dir" "$owner_nonce" || return 1
  [[ -d "$nested_owner" && ! -L "$nested_owner" ]] || return 1
  checkout_lock_directory_has_only "$claim_dir" claim-v1 owner || return 1
  checkout_lock_stat_private "$nested_owner" 700 || return 1
  checkout_lock_directory_has_only "$nested_owner" owner-v1 || return 1
  checkout_lock_load_record \
    "$nested_owner/owner-v1" owner "$owner_nonce" '' || return 1
  [[ ! -e "$tombstone" && ! -L "$tombstone" ]] || return 1
  [[ -L "$lock_dir" && $(readlink "$lock_dir") == "$owner_target" ]] ||
    return 1
  mv "$lock_dir" "$tombstone" || return 1
  [[ ! -e "$lock_dir" && ! -L "$lock_dir" && -L "$tombstone" &&
    $(readlink "$tombstone") == "$owner_target" ]] || return 1

  # Detachment is committed. Never inspect or mutate the canonical path after
  # this point; a new writer may already own a different generation there.
  checkout_lock_retire_and_cleanup_claim "$claim_dir"
}

checkout_lock_claim_and_detach() {
  local owner_dir=$1 owner_target=$2 owner_nonce=$3
  local nested_owner

  checkout_lock_prepare_claim "$owner_nonce" || return 1
  nested_owner="$lock_claim_dir/owner"
  [[ ! -e "$nested_owner" && ! -L "$nested_owner" ]] || return 1
  if ! mv "$owner_dir" "$nested_owner"; then
    checkout_lock_cleanup_empty_claim "$lock_claim_dir" || true
    return 1
  fi
  checkout_lock_detach_claimed_owner \
    "$lock_claim_dir" "$owner_target" "$owner_nonce"
}

release_checkout_lock_v1_strict() {
  [[ "$lock_held" -eq 1 ]] || return 0
  [[ -n ${lock_owner_nonce:-} && -n ${lock_owner_target:-} &&
    -n ${lock_owner_dir:-} ]] || return 1
  [[ -L "$lock_dir" && $(readlink "$lock_dir") == "$lock_owner_target" ]] ||
    return 1
  checkout_lock_stat_private "$lock_owner_dir" 700 || return 1
  checkout_lock_directory_has_only "$lock_owner_dir" owner-v1 || return 1
  checkout_lock_load_record \
    "$lock_owner_dir/owner-v1" owner "$lock_owner_nonce" '' || return 1
  checkout_lock_claim_and_detach \
    "$lock_owner_dir" "$lock_owner_target" "$lock_owner_nonce" || return 1
  lock_held=0
  lock_owner_nonce=
  lock_owner_target=
  lock_owner_dir=
  lock_claim_dir=
}

# shellcheck disable=SC2329 # Generated consumers reach this through trap cleanup.
release_checkout_lock_v1() {
  release_checkout_lock_v1_strict
}

checkout_lock_classify() {
  local target prefix nonce owner_basename owner_dir claim_status

  CHECKOUT_LOCK_STATE=
  CHECKOUT_LOCK_STATE_DETAIL=
  if [[ -L "$lock_dir" ]]; then
    if ! target=$(readlink "$lock_dir" 2>/dev/null); then
      # The canonical symlink may have been detached or replaced after the
      # type snapshot. Any failed read is therefore ambiguous: retrying
      # validates the current generation, while a stable unreadable object
      # stays fail-closed behind the bounded acquisition timeout.
      CHECKOUT_LOCK_STATE=retry
      return 0
    fi
  else
    # Snapshot symlinks first. Probing through `-e` or `-d` follows a live
    # symlink; if release detaches it between those probes, an otherwise valid
    # handoff can look like an unsupported object and be falsely rejected.
    if [[ ! -e "$lock_dir" && ! -L "$lock_dir" ]]; then
      CHECKOUT_LOCK_STATE=missing
      return 0
    fi
    if [[ -d "$lock_dir" && ! -L "$lock_dir" ]]; then
      CHECKOUT_LOCK_STATE=legacy
      return 0
    fi
    if [[ -L "$lock_dir" || ! -e "$lock_dir" || -d "$lock_dir" ]]; then
      CHECKOUT_LOCK_STATE=retry
    else
      CHECKOUT_LOCK_STATE=malformed
    fi
    return 0
  fi
  prefix=".${checkout_name}.install.lock.owner."
  case "$target" in
    "$prefix"*'/.')
      nonce=${target#"$prefix"}
      nonce=${nonce%/.}
      ;;
    *)
      CHECKOUT_LOCK_STATE=malformed
      return 0
      ;;
  esac
  owner_basename="${prefix}${nonce}"
  [[ "$target" == "$owner_basename/." &&
    "$nonce" =~ ^[0-9a-f]{32}$ ]] || {
    CHECKOUT_LOCK_STATE=malformed
    return 0
  }
  owner_dir="$checkout_parent/$owner_basename"
  if [[ ! -e "$owner_dir" && ! -L "$owner_dir" ]]; then
    checkout_lock_find_claimed_owner "$nonce" "$target"
    claim_status=$?
    if [[ "$claim_status" -eq 0 ]]; then
      CHECKOUT_LOCK_STATE="claim-$CHECKOUT_LOCK_CLAIM_LIVENESS"
      CHECKOUT_LOCK_STATE_DETAIL=$CHECKOUT_LOCK_CLAIM_PID
      CHECKOUT_LOCK_CLASSIFIED_OWNER_TARGET=$target
      CHECKOUT_LOCK_CLASSIFIED_OWNER_NONCE=$nonce
    elif [[ "$claim_status" -eq 2 ]]; then
      CHECKOUT_LOCK_STATE=retry
    else
      CHECKOUT_LOCK_STATE=malformed
    fi
    return 0
  fi
  if [[ ! -e "$owner_dir" && ! -L "$owner_dir" ]]; then
    # Release first moves the complete owner into its claim while the
    # canonical symlink still names the old location. That atomic transition
    # is transient, not malformed; the next classification will inspect the
    # owner-bearing claim.
    CHECKOUT_LOCK_STATE=retry
    return 0
  fi
  [[ -d "$owner_dir" && ! -L "$owner_dir" ]] || {
    CHECKOUT_LOCK_STATE=malformed
    return 0
  }
  if ! checkout_lock_stat_private "$owner_dir" 700; then
    if [[ ! -e "$owner_dir" && ! -L "$owner_dir" ]]; then
      CHECKOUT_LOCK_STATE=retry
      return 0
    fi
    CHECKOUT_LOCK_STATE=malformed
    return 0
  fi
  if ! checkout_lock_directory_has_only "$owner_dir" owner-v1; then
    if [[ ! -e "$owner_dir" && ! -L "$owner_dir" ]]; then
      CHECKOUT_LOCK_STATE=retry
      return 0
    fi
    CHECKOUT_LOCK_STATE=malformed
    return 0
  fi
  if ! checkout_lock_load_record "$owner_dir/owner-v1" owner "$nonce" ''; then
    if [[ ! -e "$owner_dir" && ! -L "$owner_dir" ]]; then
      CHECKOUT_LOCK_STATE=retry
      return 0
    fi
    CHECKOUT_LOCK_STATE=malformed
    return 0
  fi
  checkout_lock_record_liveness
  CHECKOUT_LOCK_STATE="owner-$CHECKOUT_LOCK_LIVENESS"
  CHECKOUT_LOCK_STATE_DETAIL=$CHECKOUT_LOCK_RECORD_PID
  CHECKOUT_LOCK_CLASSIFIED_OWNER_DIR=$owner_dir
  CHECKOUT_LOCK_CLASSIFIED_OWNER_TARGET=$target
  CHECKOUT_LOCK_CLASSIFIED_OWNER_NONCE=$nonce
}

checkout_lock_recover_dead_owner() {
  checkout_lock_load_record \
    "$CHECKOUT_LOCK_CLASSIFIED_OWNER_DIR/owner-v1" owner \
    "$CHECKOUT_LOCK_CLASSIFIED_OWNER_NONCE" '' || return 1
  checkout_lock_record_liveness
  [[ "$CHECKOUT_LOCK_LIVENESS" == dead ]] || return 1
  checkout_lock_claim_and_detach \
    "$CHECKOUT_LOCK_CLASSIFIED_OWNER_DIR" \
    "$CHECKOUT_LOCK_CLASSIFIED_OWNER_TARGET" \
    "$CHECKOUT_LOCK_CLASSIFIED_OWNER_NONCE"
}

checkout_lock_recover_dead_claim() {
  local old_claim=$CHECKOUT_LOCK_CLAIM_DIR
  local old_owner="$CHECKOUT_LOCK_CLAIM_DIR/owner" new_owner

  checkout_lock_load_claim \
    "$old_claim" "$CHECKOUT_LOCK_CLASSIFIED_OWNER_NONCE" || return 1
  checkout_lock_record_liveness
  [[ "$CHECKOUT_LOCK_LIVENESS" == dead ]] || return 1
  [[ -d "$old_owner" && ! -L "$old_owner" &&
    ! -e "$old_owner/canonical" && ! -L "$old_owner/canonical" ]] ||
    return 1
  checkout_lock_directory_has_only "$old_claim" claim-v1 owner || return 1
  checkout_lock_directory_has_only "$old_owner" owner-v1 || return 1
  [[ -L "$lock_dir" &&
    $(readlink "$lock_dir") == "$CHECKOUT_LOCK_CLASSIFIED_OWNER_TARGET" ]] ||
    return 1

  checkout_lock_prepare_claim "$CHECKOUT_LOCK_CLASSIFIED_OWNER_NONCE" ||
    return 1
  new_owner="$lock_claim_dir/owner"
  if ! mv "$old_owner" "$new_owner"; then
    checkout_lock_cleanup_empty_claim "$lock_claim_dir" || true
    return 1
  fi
  # The owner has already moved into our new claim, so the old claimant no
  # longer participates in arbitration. Treat leaf cleanup as best effort;
  # otherwise a harmless unlink failure makes us wait on our own live claim.
  checkout_lock_cleanup_empty_claim "$old_claim" || true
  checkout_lock_detach_claimed_owner \
    "$lock_claim_dir" "$CHECKOUT_LOCK_CLASSIFIED_OWNER_TARGET" \
    "$CHECKOUT_LOCK_CLASSIFIED_OWNER_NONCE"
}

checkout_lock_cleanup_detached_claims() {
  local candidate owner_nonce claim_liveness nested_owner tombstone target

  [[ ! -e "$lock_dir" && ! -L "$lock_dir" ]] || return 2
  for candidate in \
    "$checkout_parent/.${checkout_name}.install.lock.claim."*; do
    [[ -e "$candidate" || -L "$candidate" ]] || continue
    nested_owner="$candidate/owner"
    # A claim with no active owner is either still being prepared or has
    # atomically entered retired cleanup. Neither state can own the canonical
    # path, so it must not delay publication of a fresh generation.
    [[ -e "$nested_owner" || -L "$nested_owner" ]] || continue
    if ! checkout_lock_directory_has_only "$candidate" claim-v1 owner; then
      if [[ -e "$lock_dir" || -L "$lock_dir" ||
        (! -e "$candidate" && ! -L "$candidate") ||
        (! -e "$nested_owner" && ! -L "$nested_owner") ]]; then
        return 2
      fi
      return 1
    fi
    if ! checkout_lock_claim_name "$candidate"; then
      [[ -e "$lock_dir" || -L "$lock_dir" ||
        (! -e "$candidate" && ! -L "$candidate") ]] && return 2
      return 1
    fi
    owner_nonce=$CHECKOUT_LOCK_NAME_OWNER_NONCE
    if ! checkout_lock_load_claim "$candidate" "$owner_nonce"; then
      if [[ -e "$lock_dir" || -L "$lock_dir" ||
        (! -e "$candidate" && ! -L "$candidate") ||
        (! -e "$nested_owner" && ! -L "$nested_owner") ]]; then
        return 2
      fi
      return 1
    fi
    checkout_lock_record_liveness
    claim_liveness=$CHECKOUT_LOCK_LIVENESS
    [[ -e "$nested_owner" || -L "$nested_owner" ]] || return 2
    if [[ ! -d "$nested_owner" || -L "$nested_owner" ]] ||
      ! checkout_lock_stat_private "$nested_owner" 700 ||
      ! checkout_lock_directory_has_only \
        "$nested_owner" owner-v1 canonical ||
      ! checkout_lock_load_record \
        "$nested_owner/owner-v1" owner "$owner_nonce" ''; then
      if [[ -e "$lock_dir" || -L "$lock_dir" ||
        (! -e "$candidate" && ! -L "$candidate") ||
        (! -e "$nested_owner" && ! -L "$nested_owner") ]]; then
        return 2
      fi
      return 1
    fi
    tombstone="$nested_owner/canonical"
    if [[ ! -L "$tombstone" ]]; then
      if [[ -e "$lock_dir" || -L "$lock_dir" ||
        (! -e "$nested_owner" && ! -L "$nested_owner") ]]; then
        return 2
      fi
      return 1
    fi
    target=".${checkout_name}.install.lock.owner.${owner_nonce}/."
    if [[ $(readlink "$tombstone" 2>/dev/null || true) != "$target" ]]; then
      if [[ -e "$lock_dir" || -L "$lock_dir" ||
        (! -e "$tombstone" && ! -L "$tombstone") ]]; then
        return 2
      fi
      return 1
    fi
    if [[ "$claim_liveness" == dead ]]; then
      if ! checkout_lock_retire_and_cleanup_claim "$candidate"; then
        if [[ -e "$lock_dir" || -L "$lock_dir" ||
          (! -e "$candidate" && ! -L "$candidate") ||
          (! -e "$nested_owner" && ! -L "$nested_owner") ]]; then
          return 2
        fi
        return 1
      fi
    fi
  done
}

checkout_lock_timeout_message() {
  local timeout=$1

  printf 'install.sh: timed out after %ss waiting for managed checkout lock: %s' \
    "$timeout" "$lock_dir" >&2
  if [[ ("$CHECKOUT_LOCK_STATE" == owner-* ||
    "$CHECKOUT_LOCK_STATE" == claim-*) &&
    "$CHECKOUT_LOCK_STATE_DETAIL" =~ ^[1-9][0-9]*$ ]]; then
    printf ' (holder pid %s)' "$CHECKOUT_LOCK_STATE_DETAIL" >&2
  fi
  if [[ "$CHECKOUT_LOCK_STATE" == legacy ]]; then
    printf '; if no install is running, remove that exact empty directory with rmdir and retry' >&2
  fi
  printf '\n' >&2
}

checkout_lock_parse_timeout() {
  local value=$1

  [[ "$value" =~ ^[0-9]+$ ]] || return 1
  while [[ ${#value} -gt 1 && "$value" == 0* ]]; do
    value=${value#0}
  done
  # Bound arithmetic before Bash interprets it. Nine decimal digits are far
  # beyond a practical installer wait while staying safe on supported shells.
  [[ ${#value} -le 9 ]] || return 1
  CHECKOUT_LOCK_TIMEOUT=$value
}

acquire_checkout_lock_v1() {
  local timeout_input=${CGRAF78_CHECKOUT_INSTALL_LOCK_TIMEOUT_SECS:-$checkout_lock_timeout_default}
  local timeout cleanup_status
  local started=$SECONDS waiting_reported=0 elapsed

  checkout_lock_parse_timeout "$timeout_input" || {
    printf 'install.sh: checkout lock timeout must be a nonnegative integer of at most 9 decimal digits: %s\n' \
      "$timeout_input" >&2
    return 1
  }
  timeout=$CHECKOUT_LOCK_TIMEOUT
  while :; do
    checkout_lock_classify || return 1
    case "$CHECKOUT_LOCK_STATE" in
      missing)
        cleanup_status=0
        checkout_lock_cleanup_detached_claims || cleanup_status=$?
        if [[ "$cleanup_status" -eq 0 ]]; then
          lock_owner_nonce=
          lock_owner_target=
          lock_owner_dir=
          lock_claim_dir=
          checkout_lock_prepare_owner || return 1
          if ln -s "$lock_owner_target" "$lock_dir"; then
            [[ -L "$lock_dir" &&
              $(readlink "$lock_dir") == "$lock_owner_target" ]] || return 1
            checkout_lock_load_record \
              "$lock_owner_dir/owner-v1" owner "$lock_owner_nonce" '' ||
              return 1
            lock_held=1
            return 0
          fi
          checkout_lock_discard_unpublished_owner || true
        elif [[ "$cleanup_status" -ne 2 ]]; then
          return 1
        fi
        ;;
      owner-dead)
        if checkout_lock_recover_dead_owner; then
          continue
        fi
        ;;
      claim-dead)
        if checkout_lock_recover_dead_claim; then
          continue
        fi
        ;;
      owner-live | owner-unknown | claim-live | claim-unknown | legacy)
        ;;
      malformed)
        printf 'install.sh: managed checkout lock is malformed; refusing to change it: %s\n' \
          "$lock_dir" >&2
        return 1
        ;;
      retry) ;;
      *) return 1 ;;
    esac

    elapsed=$((SECONDS - started))
    if [[ "$elapsed" -ge "$timeout" ]]; then
      # Classification can change while a publication or claim handoff loses
      # its race. Refresh once before the terminal diagnostic so timeout zero
      # still reports the actual winner without granting another acquisition
      # attempt.
      checkout_lock_classify || return 1
      if [[ "$CHECKOUT_LOCK_STATE" == malformed ]]; then
        printf 'install.sh: managed checkout lock is malformed; refusing to change it: %s\n' \
          "$lock_dir" >&2
        return 1
      fi
      checkout_lock_timeout_message "$timeout"
      return 1
    fi
    if [[ "$waiting_reported" -eq 0 ]]; then
      printf 'install.sh: waiting for managed checkout lock: %s\n' \
        "$lock_dir" >&2
      waiting_reported=1
    fi
    command sleep 0.1
  done
}
